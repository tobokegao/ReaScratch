      g_hover_help = "key of this sample as it sounds (lit = the key knob turned, ? = unsure): click or U = KEY SYNC to the other deck's key, Shift+click or Shift+U = the key knob back to 0";
      g_hover_val = slider217 != 0 ? sprintf(#g_kyd, slider217 > 0 ? "key knob +%d" : "key knob %d", slider217) : "";
      g_click ? ((mouse_cap & 8) ? (slider217 = 0; sliderchange(slider217)) : ky_sync(); g_click = 0);
    );
