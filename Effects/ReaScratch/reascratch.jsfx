);
function pmn_subl(title, a, b, last) ( pmn_head(title, a, b, last); pmn_items(a, b, 1); );
function pmn_sub(title, a, b) ( pmn_subl(title, a, b, 0); );
function pmn_menu(sl) (   // sl = 1 (Preset) or 230 (2nd controller, ⚪110: its first item "none")
  pmn_sl = sl; pmn_cur = slider(sl);
  strcpy(#pmn_m, ""); pmn_items(1, 1, 0);
  // makers A-Z (user's request 2026-10-08); Pioneer DJ / AlphaTheta: one maker with two series inside (2026-10-07)
  pmn_sub("Akai", 2, 5); pmn_sub("Behringer", 6, 7); pmn_sub("Denon DJ", 8, 11); pmn_sub("Gemini", 12, 13);
  pmn_sub("Hercules", 14, 37); pmn_sub("ION", 38, 41); pmn_sub("Korg", 42, 43); pmn_sub("Native Instruments", 44, 45);
  pmn_sub("Numark", 46, 65);
  pmn_head("Pioneer DJ / AlphaTheta", 66, 101, 0); pmn_subl("DDJ", 66, 95, 0); pmn_subl("CDJ / XDJ", 96, 101, 1);
  pmn_sub("Reloop", 102, 123); pmn_sub("Turntables / DVS", 124, 133); pmn_sub("Test", 134, 134);
  str_setlen(#pmn_m, strlen(#pmn_m) - 1);   // no empty item after the last "|"
  #pmn_m;
);
// ((⚪128) the setup rows over 300: slider (row - 197), since ⚪129 (rows 301-303 = sliders 104-106); (⚪135) rows 304-306 =
// the video FX LFO (variables kept in @serialize). (CVM [301 ..] is past its end: rows over 300 never read it)
function g_get(s) ( s == 320 ? mt_me() : s >= 321 && s <= 324 ? mt_g(s - 320) : s == 318 ? ag_on : s == 319 ? ag_tgt : s == 315 ? vhs_col : s == 316 ? vhs_osd : s == 317 ? dk_tone : s >= 307 && s <= 314 ? fk_ty(s - 307) - 1 : s == 304 ? lf_shape : s == 305 ? lf_rate : s == 306 ? lf_depth : s > 300 ? slider(s - 197) : sv(s); );
// ((⚪151) a setting written from the window while @block had the second controller's values in CV (cx_swap(1), while
// its MIDI is read) went to the second controller, or was undone by the swap back: then it goes to the first's store)
function g_cvset(s, v) local(i, hit) (
  hit = -1; cx_cur ? (i = 0; loop(CXN, CXL[i] == s ? hit = i; i += 1));
  hit >= 0 ? CXA[hit] = v : CV[s] = v;
);
function g_set(s, v) (
  g_rowdef(s);
  v = max(g_min, min(g_kind == 1 ? g_n - 1 : g_max, g_kind == 1 ? floor(v + 0.5) : g_min + floor((v - g_min) / g_step + 0.5) * g_step));
  s >= 320 && s <= 324 ? mt_put(s - 320, v) :   // ((⚪191) deck B: a request to deck A (see mt_on)
  s == 315 ? (vhs_col = v; mc_dirty = 1) :   // ((⚪158))
  s == 316 ? (vhs_osd = v; mc_dirty = 1) :
  s == 318 ? (ag_on = v > 0.5; mc_dirty = 1) : s == 319 ? (ag_tgt = floor(v + 0.5); mc_dirty = 1) :   // ((⚪185))
  s == 317 ? (dk_tone = v; mc_dirty = 1) :   // ((⚪162))   // ((⚪160))
  s >= 307 && s <= 314 ? (fk_tyset(s - 307, v + 1); mc_dirty = 1) :
  s >= 304 ? (s == 304 ? lf_shape = v : s == 305 ? lf_rate = v : lf_depth = v; mc_dirty = 1) :   // ((⚪135) undo point, project changed)
  CVM[s] ? (g_cvset(s, v); mc_dirty = 1; ap_req = 1) : (   // ((⚪129) a setting in CV: mc_dirty = undo point, project changed)
  s > 300 ? (s -= 197; slider(s) = v) : (slider(s) = v);   // (rows 301-303 = sliders 104-106)
  s == 104 ? (sliderchange(slider104); slider_automate(slider104)) :
  s == 105 ? (sliderchange(slider105); slider_automate(slider105)) :
  s == 106 ? (sliderchange(slider106); slider_automate(slider106)) :
  s == 77 ? (sliderchange(slider77); slider_automate(slider77)) :
  s == 78 ? (sliderchange(slider78); slider_automate(slider78)) :
  s == 79 ? (sliderchange(slider79); slider_automate(slider79)) :
  s == 80 ? (sliderchange(slider80); slider_automate(slider80)) :
  s == 81 ? (sliderchange(slider81); slider_automate(slider81)) :
  s == 82 ? (sliderchange(slider82); slider_automate(slider82)) :
  s == 249 ? (sliderchange(slider249); slider_automate(slider249)) :
  s == 250 ? (sliderchange(slider250); slider_automate(slider250)) :
  s == 83 ? (sliderchange(slider83); slider_automate(slider83)) :
  s == 84 ? (sliderchange(slider84); slider_automate(slider84)) :
  s == 85 ? (sliderchange(slider85); slider_automate(slider85)) :
  s == 86 ? (sliderchange(slider86); slider_automate(slider86)) :
  s == 87 ? (sliderchange(slider87); slider_automate(slider87)) :
  s == 89 ? (sliderchange(slider89); slider_automate(slider89); slider91 ? (slider91 = 0; sliderchange(slider91))) :   // by hand: SYNC off
  s == 90 ? (sliderchange(slider90); slider_automate(slider90); te_tk = 1; te_mlast = -1000) :
  s == 91 ? (sliderchange(slider91); slider_automate(slider91); slider91 ? te_sync(1)) :
  s == 109 ? (sliderchange(slider109); slider_automate(slider109)) :
  (sliderchange(2 ^ (s - 1)); slider_automate(2 ^ (s - 1)));   // the mask reaches slider 64 only
  );
  gui_dirty = 1;
);
// mouse handling for one control. mode: 0 knob (vertical drag), 1 form slider (horizontal drag over trk_w px),
// 2 switch (toggle on release), 3 menu (popup on release)
function g_input(s, x, y, w, h, mode, trk_w) local(v, now, r) (
  g_rowdef(s); v = g_get(s); r = g_max - g_min;
  g_inside(x, y, w, h) ? (g_hover = s; g_hover_help = g_help);
  g_click && g_inside(x, y, w, h) ? (
    now = time_precise();
    mode < 2 && g_last_s == s && now - g_last_t < 0.3 ? (g_set(s, g_def); g_drag = 0) : (
      mode < 2 ? (g_drag = s; g_drag_mode = mode; g_drag_x = g_mx; g_drag_y = g_my; g_drag_v = v; g_drag_w = trk_w) : g_press = s;
    );
    g_last_s = s; g_last_t = now;
  );
  g_release && g_press == s && g_inside(x, y, w, h) ? (
    mode == 2 ? (s == 19 ? g_set(s, v == 4 ? 2 : 4) : g_set(s, (v + 1) % g_n)) :
    mode == 3 ? (gfx_dest = -1; gfx_x = g_ox + x * g_k; gfx_y = g_oy + (y + h) * g_k; r = gfx_showmenu(s == 1 || s == 230 ? pmn_menu(s) : g_menustr(s)); gfx_dest = 20; r > 0 ? g_set(s, s == 1 || s == 230 ? pmn_val(r) : r - 1));   // menu in window coordinates; Preset: by maker
  );
  g_rclick && g_inside(x, y, w, h) ? g_set(s, g_def);
  g_drag == s && (g_mx != g_prev_mx || g_my != g_prev_my) ? (
    g_drag_mode == 0 ? g_set(s, g_drag_v + (g_drag_y - g_my) / 160 * r * ((mouse_cap & 8) ? 0.1 : 1))
                     : g_set(s, g_drag_v + (g_mx - g_drag_x) / max(1, g_drag_w) * r * ((mouse_cap & 8) ? 0.1 : 1));
  );
  g_wheel != 0 && g_inside(x, y, w, h) && mode < 2 ? g_set(s, v + (g_wheel > 0 ? 1 : -1) * g_step * (s == 63 || s == 89 ? 10 : 1) * ((mouse_cap & 8) ? 10 : 1));
);

// ---------------------------------------------------------------- pixel shading (light from straight above)
// 6-tone ramps, dark -> light (cool shadow ... warm light), 2 px cells, 2x2 Bayer dither between tones
function g_ramps() local(r, k, f, i, a, b) (
  G_RAMP = 20000; G_ANC = 20200;
  // anchors, dark -> light: 0 silver, 1 frame, 2 dark panel, 3 lamp off, 4 lamp yellow, 5 lamp blue
  G_ANC[0] = 0x262a38; G_ANC[1] = 0x4a5263; G_ANC[2] = 0x7a8494; G_ANC[3] = 0xa9b1bb; G_ANC[4] = 0xd8d9d1; G_ANC[5] = 0xfff2cf;
  G_ANC[8] = 0x585e6b; G_ANC[9] = 0x787f8b; G_ANC[10] = 0x979ea8; G_ANC[11] = 0xb4b9bf; G_ANC[12] = 0xcfd1cf; G_ANC[13] = 0xe7e4d9;
  G_ANC[16] = 0x06080a; G_ANC[17] = 0x0b0e12; G_ANC[18] = 0x10141a; G_ANC[19] = 0x161b21; G_ANC[20] = 0x1c2229; G_ANC[21] = 0x242b33;
  G_ANC[24] = 0x040506; G_ANC[25] = 0x0c0f13; G_ANC[26] = 0x171c22; G_ANC[27] = 0x242a31; G_ANC[28] = 0x353d46; G_ANC[29] = 0x59636e;
  G_ANC[32] = 0x4f3500; G_ANC[33] = 0x8f6200; G_ANC[34] = 0xd29c00; G_ANC[35] = 0xfbd743; G_ANC[36] = 0xffe98a; G_ANC[37] = 0xfffbea;
  G_ANC[40] = 0x06223a; G_ANC[41] = 0x0e4266; G_ANC[42] = 0x1d6c9c; G_ANC[43] = 0x4fb3e0; G_ANC[44] = 0x8fd3f2; G_ANC[45] = 0xe6f7ff;
  r = 0;
  loop(6,
    k = 0;
    loop(8,
      f = k * 5 / 7; i = min(4, floor(f)); f -= i;
      a = G_ANC[r * 8 + i]; b = G_ANC[r * 8 + i + 1];
      G_RAMP[r * 8 + k] = (floor(((a >> 16) & 255) * (1 - f) + ((b >> 16) & 255) * f + 0.5) << 16) |
                          (floor(((a >> 8) & 255) * (1 - f) + ((b >> 8) & 255) * f + 0.5) << 8) |
                           floor((a & 255) * (1 - f) + (b & 255) * f + 0.5);
      k += 1;
    );
    r += 1;
  );
);
function g_tone(r, k) ( g_hex(G_RAMP[r * 8 + max(0, min(7, k))]); );
function g_bayer(ix, iy) ( (iy & 1) ? ((ix & 1) ? 0.375 : 0.875) : ((ix & 1) ? 0.625 : 0.125); );
// value 0..1 -> tone 0..7 with ordered dither at cell (ix, iy)
function g_dk(v, ix, iy) local(f, i) ( f = max(0, min(1, v)) * 7; i = floor(f); min(7, i + ((f - i) > g_bayer(ix, iy) ? 1 : 0)); );
G_P = 1;   // pixel cell size for the shading (1 = fine, 2 = chunky); must never be 0 (the loops step by it)
function g_cell(x, y) ( gfx_rect(x, y, G_P, G_P); );
// vertical-gradient block (top lit) with brush dabs; edges: top lit (raised) or top shadowed (inset)
function g_block(x, y, w, h, ramp, lo, hi, inset) local(cx, cy, nx, ny, v, k, j, s, l, d) (
  nx = floor(w / G_P); ny = floor(h / G_P);
  cy = 0;
  loop(ny,
    v = lo + (hi - lo) * (1 - cy / max(1, ny - 1));
    cx = 0;
    loop(nx, k = g_dk(v, cx, cy); g_tone(ramp, k); g_cell(x + cx * G_P, y + cy * G_P); cx += 1);
    // brush dabs: a few horizontal runs of 2-4 cells, one tone up or down
    j = 0;
    g_flat == 0 ? loop(max(1, floor(nx / 48)),   // (skipped for buttons: they are redrawn every frame, random dabs would flicker)
      s = floor(rand(nx)); l = (2 + floor(rand(3))) * 2 / G_P; d = rand(1) < 0.5 ? 1 : -1;
      k = g_dk(v, s, cy) + d; g_tone(ramp, k); gfx_rect(x + s * G_P, y + cy * G_P, min(l, nx - s) * G_P, G_P);
      j += 1;
    );
    cy += 1;
  );
  // selective outline: light comes from above
  g_tone(ramp, inset ? 0 : 7); gfx_rect(x, y, w, 2);
  g_tone(ramp, inset ? 7 : 0); gfx_rect(x, y + h - 2, w, 2);
);
// ball / knob body in 2 px cells: top lit + pillow, lit rim on top, darkest rim at the bottom,
// 2-step shadow cast straight down onto the panel
function g_ball(cx, cy, r, ramp, shadow) local(xx, yy, dx, dy, d, v, k, ix, iy, x0, y0) (
  x0 = floor((cx - r) / G_P) * G_P; y0 = floor((cy - r) / G_P) * G_P;
  yy = y0;
  while (yy <= cy + r + 4) (
    xx = x0;
    while (xx <= cx + r) (
      dx = xx + G_P / 2 - cx; dy = yy + G_P / 2 - cy; d = sqrt(dx * dx + dy * dy);
      ix = floor(xx / G_P); iy = floor(yy / G_P);
      d <= r ? (
        v = 0.62 * (1 - (dy + r) / (2 * r)) + 0.38 * (1 - (d / r) * (d / r));
        k = g_dk(v, ix, iy);
        d > r - 2 ? (k = dy < 0 ? 6 : 0);
        g_tone(ramp, k); g_cell(xx, yy);
      ) : shadow && dy > 0 ? (
        sqrt(dx * dx + (dy - 2) * (dy - 2)) <= r ? (g_tone(2, 0); g_cell(xx, yy)) :
        sqrt(dx * dx + (dy - 4) * (dy - 4)) <= r && ((ix + iy) & 1) ? (g_tone(2, 0); g_cell(xx, yy));
      );
      xx += G_P;
    );
    yy += G_P;
  );
);

// ---------------------------------------------------------------- front panel parts
// knob = a cylinder seen slightly from the front, light from straight above:
//   side wall: the cylinder's height shows as a band below the top face (H px); it gets little light,
//              darker toward the bottom, with fine vertical knurl lines
//   top face: almost even, a touch lighter at the top; a narrow chamfer around it, lit on its upper half
//              and dark on its lower half; the face sits H px above the base circle
//   shadow:    2 steps straight down from the base
function g_hh(r) ( max(2, floor(r * 0.12)); );   // knob side wall height (gentle tilt; same rule as the knob image)
function g_cyl(cx, cy, r) local(xx, yy, dx, dy, d, db, v, k, ix, iy, rf, ny, hh, top) (
  hh = g_hh(r); top = cy - hh / 2;   // face centre; base centre is top + hh
  rf = r - max(2, floor(r * 0.10));                   // narrow chamfer: about 10 % of the radius
  yy = floor(top - r);
  while (yy <= top + hh + r + 4) (
    xx = floor(cx - r);
    while (xx <= cx + r) (
      dx = xx + 0.5 - cx; dy = yy + 0.5 - top; d = sqrt(dx * dx + dy * dy);
      db = sqrt(dx * dx + (dy - hh) * (dy - hh));    // distance from the base circle centre
      ix = floor(xx); iy = floor(yy);
      d <= r ? (
        ny = d > 0 ? -dy / d : 0;
        v = d <= rf ? 0.64 + 0.08 * (-dy / rf) : 0.48 + 0.46 * ny;
        k = g_dk(v, ix, iy);
        d > r - 1.2 ? (k = dy < 0 ? 7 : (k > 3 ? 3 : k));
        g_tone(0, k); gfx_rect(xx, yy, 1, 1);
      ) : (dy > 0 && (db <= r || (abs(dx) <= r && dy <= hh))) ? (
        // side wall: below the face, inside the swept outline
        v = 0.30 - 0.18 * (dy / (hh + r * 0.3)) + 0.10 * (1 - abs(dx) / r);
        (ix % 3) == 0 ? v -= 0.08;                    // knurl
        k = g_dk(v, ix, iy);
        db > r - 1.2 && dy > hh ? k = 0;              // darkest outline at the very bottom
        g_tone(0, k); gfx_rect(xx, yy, 1, 1);
      ) : dy > hh ? (
        sqrt(dx * dx + (dy - hh - 2) * (dy - hh - 2)) <= r ? (g_tone(2, 0); gfx_rect(xx, yy, 1, 1)) :
        sqrt(dx * dx + (dy - hh - 4) * (dy - hh - 4)) <= r && ((ix + iy) & 1) ? (g_tone(2, 0); gfx_rect(xx, yy, 1, 1));
      );
      xx += 1;
    );
    yy += 1;
  );
);
// knob: c = 1 draws a C-shaped LED ring open to the right (value runs from the lower right, round the
// left, to the upper right) and puts the label in the opening; otherwise the label goes underneath
function g_knob(s, cx, cy, r, c, lab) local(v, f, a, a0, i, n, px, py, col, fy, tw, th) (
  g_input(s, cx - r - 14, cy - r - 14, 2 * r + 28, 2 * r + 28, 0, 0);
  g_rowdef(s); v = g_get(s); f = g_max > g_min ? (v - g_min) / (g_max - g_min) : 0;
  fy = floor(cy - g_hh(r) / 2);   // centre of the top face (it sits above the side wall)
  a0 = c ? 0.75 * $pi : -0.75 * $pi;
  c ? (
    n = 13; i = 0; col = slider32 ? 5 : 4;
    loop(n,
      a = a0 + i / (n - 1) * 1.5 * $pi; px = floor(cx + sin(a) * (r + 11)) - 3; py = floor(fy + g_hh(r) - cos(a) * (r + 11)) - 3;   // centred on the base centre (where the cylinder meets the panel), 6 px dot
      i / (n - 1) <= f + 0.0001 ? (
        // round 6 px dot (pixel circle: corners cut), lit from above, with a soft glow
        g_tone(col, 3); gfx_a = 0.35; gfx_rect(px - 1, py, 8, 6); gfx_rect(px, py - 1, 6, 8); gfx_a = 1;
        g_tone(col, 7); gfx_rect(px + 1, py, 4, 1); g_tone(col, 6); gfx_rect(px, py + 1, 6, 1);
        g_tone(col, 5); gfx_rect(px, py + 2, 6, 2); g_tone(col, 3); gfx_rect(px, py + 4, 6, 1); g_tone(col, 2); gfx_rect(px + 1, py + 5, 4, 1);
      ) : (
        g_tone(3, 7); gfx_rect(px + 1, py, 4, 1); g_tone(3, 4); gfx_rect(px, py + 1, 6, 4); g_tone(3, 2); gfx_rect(px + 1, py + 5, 4, 1);
      );
      i += 1;
    );
  );
  // pre-rendered knob (image made by a development script): face centre at (r + 4, r + 4) of the image
  (c ? g_tx_kb : g_tx_ks) >= 0 ? (gfx_x = cx - r - 4; gfx_y = floor(cy - g_hh(r) / 2) - r - 4; gfx_blit(c ? 5 : 6, 1, 0))
                               : g_cyl(cx, cy, r);
  a = a0 + f * 1.5 * $pi;
  i = 0.20;
  while (i <= 0.70) (   // pointer: a groove on the flat top face (raised by the wall height)
    px = floor(cx + sin(a) * r * i); py = floor(cy - g_hh(r) / 2 - cos(a) * r * i);
    g_tone(0, 0); gfx_rect(px - 1, py - 1, 3, 3);   // solid groove (the per-step light lip striped it like peeled paint)
    i += 1 / r;
  );
  gfx_setfont(1); g_grey(0.92);
  // label place: c=1 grain (big, right, on the base centre line); helpers (g_lside): 0 below, 2 left, 3 right, 4 above, 6 upper left, 7 below right-aligned
  // mirrored front (g_mr): the name goes to the mirrored side (grain: left; upper left -> upper right; ...)
  c ? (gfx_setfont(6); gfx_measurestr(lab, tw, th); g_text(lab, g_mr ? cx - g_glo - tw : cx + g_glo, fy + g_hh(r) - floor(th / 2)); gfx_setfont(1)) : (
    gfx_measurestr(lab, tw, th);
    g_lside == (g_mr ? 3 : 2) ? g_text(lab, cx - r - 6 - tw, fy + g_hh(r) - floor(th / 2)) :
    g_lside == (g_mr ? 2 : 3) ? g_text(lab, cx + r + 6, fy + g_hh(r) - floor(th / 2)) :
    g_lside == 4 ? g_ctext(lab, cx, fy - r - 3 - th) :
    g_lside == 6 ? g_text(lab, g_mr ? cx + r + 4 : cx - r - 4 - tw, fy + g_hh(r) - th - 1) :   // upper left: on the wire coming in from the left
    g_lside == 7 ? g_text(lab, g_mr ? cx - r : cx + r - tw, fy + g_hh(r) + r + 2) :   // below, right edge on the knob's right edge
    g_ctext(lab, cx, fy + g_hh(r) + r + 2);
  );
  (g_hover == s || g_drag == s) ? g_hover_val = g_valstr(s, v);
);
// slide switch, cy = centre line; the side labels name both states, the full name is the hover help
// recessed dark well: smooth inner shadow from the top lip (deep), softer from the sides, and a faint lit
// lip at the bottom - reads as a screen sunk into the panel, light from above
function g_well(x, y, w, h) local(i, d, a) (
  g_grey(0.03); gfx_rect(x, y, w, h);
  d = min(12, floor(h * 0.45)); i = 0;
  loop(d, a = (1 - i / d) ^ 2 * 0.75; g_grey(0); gfx_a = a; gfx_rect(x, y + i, w, 1); i += 1);
  d = min(6, floor(w * 0.1)); i = 0;
  loop(d, a = (1 - i / d) ^ 2 * 0.45; g_grey(0); gfx_a = a; gfx_rect(x + i, y, 1, h); gfx_rect(x + w - 1 - i, y, 1, h); i += 1);
  i = 0;
  loop(3, a = (1 - i / 3) * 0.10; g_hex(0x8fb4cc); gfx_a = a; gfx_rect(x, y + h - 1 - i, w, 1); i += 1);
  gfx_a = 1;
  g_bevel(x - 1, y - 1, w + 2, h + 2, 1, 0.55, 0.0);
);
function g_switch(s, x, cy, lab0, lab1) local(v, on, tw, th, y) (
  y = cy - 7;
  g_rowdef(s); v = g_get(s); on = s == 19 ? v == 4 : v != 0;
  gfx_setfont(1);
  // names 1 px lower than the box top line: the box is 16 rows (centre between two rows), the lower-case
  // letters 5 rows, so they cannot be exactly centred; the user chose half a pixel low over half a pixel high
  gfx_measurestr(lab0, tw, th); g_grey(on ? 0.50 : 0.95); g_text(lab0, x - tw - 6, y + 1);
  g_sw_frame ? (on ? g_hex(0x2a3040) : g_grey(0.46)) : g_grey(on ? 0.95 : 0.50); g_text(lab1, x + 48, y + 1);   // on the metal frame: dark ink
  // the slot: the same sunk well as the readout windows (inner shadow from the top lip, lit bottom lip); it was a flat
  // dark box and looked stuck on, not sunk in (user's remark, 2026-10-03). The lever fills the slot to either end
  // (x + 1 / x + 24 .. + 41: with a gap it did not look thrown all the way; user's remark); no lip shadow on it (that
  // made it look sunk too deep)
  g_well(x + 1, y + 1, 41, 14);
  g_tx_lever >= 0 ? (gfx_x = x + (on ? 24 : 1); gfx_y = y + 1; gfx_blit(10, 1, 0)) :
    (g_block(x + (on ? 24 : 1), y + 2, 18, 12, 0, 0.30, 0.95, 0); g_tone(2, 0); gfx_rect(x + (on ? 24 : 1), y + 14, 18, 2));
  g_grey(0.55); gfx_line(x + (on ? 29 : 6), y + 4, x + (on ? 29 : 6), y + 11); gfx_line(x + (on ? 33 : 10), y + 4, x + (on ? 33 : 10), y + 11); gfx_line(x + (on ? 37 : 14), y + 4, x + (on ? 37 : 14), y + 11);
  g_input(s, x - tw - 8, y - 2, tw + 8 + 42 + 50, 19, 2, 0);
  (g_hover == s) ? g_hover_val = g_valstr(s, v);
);
// role-coloured lamp images (made by a development script): img = 8 touch, 9 midi, 11 play, 12 loop; 7 = off
function g_lamp(cx, cy, on, lab, img) local(xx, yy) (
  // the dome's middle row is row 14 of the picture (opaque rows 9..19), so blitting at cy - 14 puts it on row cy =
  // the middle row of the readout windows in the same line (window: bevel cy - 8, inside cy - 7 .. cy + 7, lip cy + 8).
  // (For one commit it was at cy - 15: the window's middle had been measured half a row too high.)
  g_tx_lamp >= 0 ? (gfx_x = cx - 14; gfx_y = cy - 14; gfx_blit(on ? img : 7, 1, 0)) : (
  on ? (
    g_tone(slider32 ? 5 : 4, 3); yy = cy - 9;
    while (yy <= cy + 9) ( xx = cx - 9; while (xx <= cx + 9) (
      ((xx + yy) & 1) && sqrt((xx - cx) * (xx - cx) + (yy - cy) * (yy - cy)) <= 9 ? gfx_rect(xx, yy, 1, 1);
      xx += 1); yy += 1);
  );
  g_ball(cx, cy, 6, 3, 1);
  on ? g_ball(cx, cy, 4, slider32 ? 5 : 4, 0);
  );
  gfx_setfont(1); g_grey(on ? 0.95 : 0.60); g_text(lab, cx + 11, cy - 7);   // baseline on the same row as the digits in the readout windows (at cy - 8 it was 1 px higher); the bowls of a / p / o are rows cy - 2 .. cy + 2
);
// dotted wire, horizontal or vertical: a pixel wherever (x + y) is even, so corners of joined runs line up
function g_dline(x1, y1, x2, y2) local(x, y) (
  x = min(x1, x2); y = min(y1, y2);
  y1 == y2 ? (x += (x + y) & 1; while (x <= max(x1, x2)) ( gfx_rect(x, y, 1, 1); x += 2; )) :
             (y += (x + y) & 1; while (y <= max(y1, y2)) ( gfx_rect(x, y, 1, 1); y += 2; ));
);
function g_dl(x1, y1, x2, y2) ( g_mr ? g_dline(g_W - 1 - x1, y1, g_W - 1 - x2, y2) : g_dline(x1, y1, x2, y2); );
// silver push button for the bottom bar
// small inset readout window (dark glass), lit text for live values
// small inset readout window: label left-aligned (dim), value right-aligned (lit for live values).
// Consolas is monospaced, so changing digits never shift the layout.
// ((⚪153) the sample's BPM puts a whole number of beats (1 .. 64, within 0.01) into it, a sample of 20 s or less (a loop)
function bpm_fits() local(nb, k) (
  len > 0 && fsr > 0 && len / fsr <= 20 ? (nb = slider63 * len / fsr / 60; k = floor(nb + 0.5); k >= 1 && k <= 64 && abs(nb - k) <= 0.01) : 0;
);
function g_readout_h(x, y, w, h, lab, val, lit, help) local(ty) (   // h: 15 in the panel; 16 on the frame (inside the buttons' bezel height)
  g_well(x, y, w, h); ty = y + floor((h - 13) / 2);
  gfx_setfont(5); g_grey(0.55); g_text(lab, x + 5, ty);
  lit ? g_led_col() : g_grey(0.75); g_rtext(val, x + w - 5, ty); gfx_setfont(1);
  g_inside(x, y, w, h) ? g_hover_help = help;
);
function g_readout(x, y, w, lab, val, lit, help) ( g_readout_h(x, y, w, 15, lab, val, lit, help); );
// bottom-bar text: too long for the bar = it waits 1 s, then moves left one character every 0.08 s until its end
// shows, waits 1.5 s and starts again (it never runs under the buttons on the right; was cut with "...", ⚪32)
// (⚪130) a text cut to maxw px with "..." (a menu row's long item ran under its arrow)
function g_cliptext(s, x, y, maxw) local(tw, th, n) (
  gfx_measurestr(s, tw, th);
  tw > maxw ? (
    n = strlen(s);
    while (n > 0 && (strcpy_substr(#g_clp, s, 0, n); strcat(#g_clp, "..."); gfx_measurestr(#g_clp, tw, th); tw > maxw)) ( n -= 1; );
    g_text(#g_clp, x, y);
  ) : g_text(s, x, y);
);
function g_fittext(s, x, y, maxw) local(tw, th, n, k, t) (
  gfx_measurestr(s, tw, th);
  tw > maxw ? (
    n = strlen(s);
    strcmp(s, #g_mq_s) ? (   // a new text: from its start; g_mq_k = the first start from which the rest fits
      strcpy(#g_mq_s, s); g_mq_t0 = time_precise(); g_mq_k = 0;
      while (g_mq_k < n && (strcpy_substr(#g_fit, s, g_mq_k, n); gfx_measurestr(#g_fit, tw, th); tw > maxw)) ( g_mq_k += 1; );
    );
    t = time_precise() - g_mq_t0;
    t > 1 + g_mq_k * 0.08 + 1.5 ? (g_mq_t0 = time_precise(); t = 0);
    k = t < 1 ? 0 : min(g_mq_k, floor((t - 1) / 0.08));
    // from character k, as many as fit
    n -= k;
    while (n > 0 && (strcpy_substr(#g_fit, s, k, n); gfx_measurestr(#g_fit, tw, th); tw > maxw)) ( n -= 1; );
    g_text(#g_fit, x, y);
  ) : g_text(s, x, y);
);
function g_button(x, y, w, h, lab) (
  g_flat = 1; g_block(x, y, w, h, 1, g_press == -1 && g_inside(x, y, w, h) ? 0.15 : 0.45, g_press == -1 && g_inside(x, y, w, h) ? 0.5 : 1.0, g_press == -1 && g_inside(x, y, w, h)); g_flat = 0;
  gfx_setfont(1); g_grey(0.10); g_ctext(lab, x + w / 2, y + 2);
  g_click && g_inside(x, y, w, h) ? g_press = -1;
  g_release && g_press == -1 && g_inside(x, y, w, h);
);

// file name without the folder ("ReaScratch_samples/x.wav" -> "x.wav"), in place
function sm_basename(str) local(i, c) (
  i = strlen(str) - 1;
  while (i >= 0 && (c = str_getchar(str, i)) != '/' && c != 92) ( i -= 1; );   // 92 = backslash
  i >= 0 ? (strcpy_substr(#sm_tmp, str, i + 1); strcpy(str, #sm_tmp));
  str;
);
// a slot button's right-click menu (⚪78): empty it (not the slot playing), empty the others / all (all: only stopped),
// move it to another slot (they change places; the slot in use keeps playing); see so_run
function g_sm_menu(k, x, y) local(r, j, n) (
  sprintf(#g_smm, "%sEmpty slot %d|Empty all the other slots|%sEmpty all slots|>Move slot %d to (swap)",
          k == sm_cur && slider3 ? "#" : "", k + 1, slider3 ? "#" : "", k + 1);
  j = 0; n = 0;
  loop(SM_N, j != k ? (n += 1; sprintf(#g_smi, "|%s%d%s", n == SM_N - 1 ? "<" : "", j + 1, SM[j * 16 + 1] > 0 ? "" : " (empty)"); strcat(#g_smm, #g_smi)); j += 1);
  gfx_dest = -1; gfx_x = g_ox + x * g_k; gfx_y = g_oy + y * g_k; r = gfx_showmenu(#g_smm); gfx_dest = 20;
  r >= 1 && r <= 3 ? (so_a = k; so_cmd = r) :
  r >= 4 ? (so_a = k; so_b = r - 4 + (r - 4 >= k ? 1 : 0); so_cmd = 4);
);
// sample slot buttons 1-8 (bottom bar, left of 'keys'): the slot in use is pressed in with its number lit, an empty
// slot's number is faint. Click = switch (an empty slot is ignored, as for F1-F8 and the pads)
function g_sm_btns(x, y) local(i, bx, on, has, dn) (
  i = 0;
  loop(SM_N,
    bx = x + i * 22; on = i == sm_cur; has = SM[i * 16 + 1] > 0;
    dn = on || (g_press == -10 - i && g_inside(bx, y, 20, 20));
    g_flat = 1; g_block(bx, y, 20, 20, 1, dn ? 0.15 : 0.45, dn ? 0.5 : 1.0, dn); g_flat = 0;
    gfx_setfont(4); on ? g_led_col() : g_grey(has ? 0.10 : 0.55); g_ctext(sprintf(#g_smd, "%d", i + 1), bx + 10, y + 3);
    g_inside(bx, y, 20, 20) ? (
      has ? (sm_name(i, #g_smn); sprintf(#g_smh, "sample %d (F%d): %s%s", i + 1, i + 1, sm_basename(#g_smn), on ? "  - in use" : "  - click = switch"))
          : sprintf(#g_smh, "sample %d: empty - the import script, LOAD or a file dropped here puts a video here", i + 1);
      has ? strcat(#g_smh, "  (right-click: empty / move)");
      g_hover_help = #g_smh;
      g_click ? g_press = -10 - i;
      g_release && g_press == -10 - i ? gq_push(1, i);
      g_rclick ? g_sm_menu(i, bx, y + 20);
    );
    i += 1;
  );
);

// waveform overview, 1 peak per pixel column, computed here (UI thread) when the sample changes
function g_peaks(n) local(i, j, a, m, step, stride, p) (
  step = len / n; stride = max(1, floor(step / 400));
  i = 0;
  loop(n,
    m = 0; j = 0; p = floor(i * step);
    while (j < step) ( a = abs(buf[(p + floor(j)) * nch]); a > m ? m = a; j += stride; );
    G_PKBUF[i] = m; i += 1;
  );
  g_peaks_len = len; g_peaks_n = n; g_peaks_buf = buf;
);
// one strip of the waveform well: mirrored hills from the middle line (user's choice over one-sided, 2026-10-03),
// flat 30 % fill + a bright outline above and below + a glow fading outward; pb = peak per column, hx = read head
// column (columns left of it are 'played' = mustard, the rest grey). The outline's inner edge always sits on a whole
// pixel row (an edge straddling rows showed as an uneven line along a flat stretch); steps of more than one row are
// joined with anti-aliased lines. Peaks are not smoothed (the user wants the dips to show).
function g_wave(x0, y, h, n, pb, hx) local(i, pk, mid, half, a, r, rb, rp, rbp, cx) (
  mid = y + floor(h / 2); half = floor((h - 2) / 2);
  i = 0;
  loop(n,
    pk = min(1, pb[i]); a = floor(pk * half); cx = x0 + i;
    cx < hx ? g_hex(0xE6B731) : g_hex(0x808690);
    gfx_a = 0.30; gfx_rect(cx, mid - a, 1, 2 * a + 1);
    i += 1;
  );
  rp = -1; rbp = -1; i = 0;
  loop(n,
    pk = min(1, pb[i]); a = floor(pk * half); r = mid - a; rb = mid + a; cx = x0 + i;
    cx < hx ? g_hex(0xE6B731) : g_hex(0xAAB2BA);
    gfx_a = 1; gfx_rect(cx, r, 1, 1); gfx_rect(cx, rb, 1, 1);           // the lines: inner edges on whole rows
    gfx_a = 0.5; gfx_rect(cx, r - 1, 1, 1); gfx_rect(cx, rb + 1, 1, 1); // softer outer edges
    gfx_a = 0.25; gfx_rect(cx, r - 2, 1, 1); gfx_rect(cx, rb + 2, 1, 1); // glow, outward only
    gfx_a = 0.12; gfx_rect(cx, r - 3, 1, 1); gfx_rect(cx, rb + 3, 1, 1);
    rp >= 0 && abs(r - rp) > 1 ? (
      gfx_a = 1; gfx_line(cx - 0.5, rp + 0.5, cx + 0.5, r + 0.5, 1); gfx_line(cx - 0.5, rbp + 0.5, cx + 0.5, rb + 0.5, 1);
      gfx_a = 0.5; gfx_line(cx - 0.5, rp - 0.5, cx + 0.5, r - 0.5, 1); gfx_line(cx - 0.5, rbp + 1.5, cx + 0.5, rb + 1.5, 1);
      gfx_a = 0.25; gfx_line(cx - 0.5, rp - 1.5, cx + 0.5, r - 1.5, 1); gfx_line(cx - 0.5, rbp + 2.5, cx + 0.5, rb + 2.5, 1);
    );
    rp = r; rbp = rb; i += 1;
  );
  gfx_a = 1;
);

// static front background (frame, title, dark panel), rendered once into image 1
function g_front_bg() (
  gfx_setimgdim(1, g_W, g_H); gfx_dest = 1;
  g_ramps();
  g_block(0, 0, g_W, g_H, 1, 0.50, 0.92, 0);
  // side grips: inset grooves
  // (no side grips)
  g_logo = gfx_loadimg(3, "reascratch_logo.png");   // made by a development script, ships next to this file
  g_logo >= 0 ? (gfx_x = 18; gfx_y = 4; gfx_blit(3, 1, 0)) :
    (gfx_setfont(2); g_tone(1, 7); g_text("ReaScratch", 22, 6); g_hex(0x1b2230); g_text("ReaScratch", 22, 5));
  // dark panel, recessed: the frame's lip shadows its top edge, its bottom lip catches the light
  g_block(16, 44, g_W - 32, g_H - 44 - 36, 2, 0.05, 0.75, 1);
  g_tone(2, 0); gfx_rect(16, 46, g_W - 32, 4);
  g_tone(1, 1); gfx_rect(16, g_H - 32, g_W - 32, 2);
  gfx_dest = 20;   // back to the picture (image 20)
  g_bg_w = g_W; g_bg_h = g_H;
);

// ---------------------------------------------------------------- setup form parts (Audacity-like)
// (⚪130) the places come from g_srcx (colour bar), g_srx (the control), g_svw (number box), g_stw (bar), g_smw (menu box):
// the More tab's list sets them for its rows, then puts the usual ones back (24, 182, 56, 240, 240)
function g_srow(s, y, col) local(v, bx, tx, tw, mw, f) (
  g_rowdef(s); v = g_get(s);
  g_hex(col); gfx_rect(g_srcx, y + 1, 4, 18);   // colour bar: left edge on the tabs / section header (x 24)
  gfx_setfont(4); g_grey(0.05); g_rtext(g_slab(s), g_srx - 6, y + 3);
  bx = g_srx; mw = g_smw;
  g_kind == 1 ? (
    g_grey(1); gfx_rect(bx, y + 1, mw, 18); g_bevel(bx, y + 1, mw, 18, 1, 1, 0.50);
    g_grey(0.05); g_cliptext(g_valstr(s, v), bx + 5, y + 3, mw - 28);
    g_grey(0.83); gfx_rect(bx + mw - 18, y + 2, 16, 16); g_bevel(bx + mw - 18, y + 2, 16, 16, 0, 1, 0.45);
    g_grey(0.05); gfx_triangle(bx + mw - 14, y + 8, bx + mw - 6, y + 8, bx + mw - 10, y + 13);
    g_input(s, bx, y, mw, 20, 3, 0);
  ) : (
    g_grey(1); gfx_rect(bx, y + 1, g_svw, 18); g_bevel(bx, y + 1, g_svw, 18, 1, 1, 0.50);
    g_grey(0.05); g_text(g_valstr(s, v), bx + 5, y + 3);
    g_grey(0.30); g_rtext(sprintf(#g_m, "%d", g_min), bx + g_svw + 32, y + 3);
    tx = bx + g_svw + 38; tw = g_stw;   // the bar (410 until 2026-10-06: too long, user)
    g_grey(1); gfx_line(tx, y + 13, tx + tw, y + 13); g_grey(0.50); gfx_line(tx, y + 10, tx + tw, y + 10);
    g_grey(0.25); gfx_line(tx + 1, y + 11, tx + tw - 1, y + 11); g_grey(0.83); gfx_line(tx + 1, y + 12, tx + tw - 1, y + 12);
    f = g_max > g_min ? (v - g_min) / (g_max - g_min) : 0;
    g_hex(col); gfx_a = 0.85; gfx_rect(tx + 1, y + 11, max(1, floor((tw - 2) * f)), 2); gfx_a = 1;
    g_grey(0.83); gfx_rect(tx + floor(tw * f) - 5, y + 2, 11, 17); g_bevel(tx + floor(tw * f) - 5, y + 2, 11, 17, 0, 1, 0.30);
    g_grey(0.30); g_text(sprintf(#g_m, "%d", g_max), tx + tw + 8, y + 3);
    g_input(s, bx, y, g_svw, 20, 1, tw);
    g_input(s, tx - 6, y, tw + 12, 20, 1, tw);
  );
);
// ---------------------------------------------------------------- (⚪130) the setup page's More tab: the controller settings
// that had no row (the manual's chapter 13), in 8 groups (LSG, filled in @init). The groups on the left, the group's rows
// on the right, as many as fit (g_lvis); the wheel over the list (not over a value: that changes the value, as on the
// other tabs) or the bar on the right scrolls it. g_lgrp / g_lscr = the group shown and its first row
function g_more(y, col, pal) local(g, n, i, s, vis, top, hh, th, ty, bx) (
  g = 0;
  loop(9,   // ((⚪191) + Metronome: 9 groups, 17 px apart (19 until then: the 9th ran onto the frame's bottom line)
    g_hex(g == g_lgrp ? col : pal); gfx_rect(24, y + g * 17, 112, 16);
    gfx_setfont(4); g_grey(g == g_lgrp ? 1 : 0.10); g_text(LSGT[g], 30, y + g * 17 + 1);
    g_grey(g == g_lgrp ? 0.85 : 0.35); g_rtext(sprintf(#g_m, "%d", LSGN[g]), 130, y + g * 17 + 1);
    g_click && g_inside(24, y + g * 17, 112, 16) ? (g_lgrp != g ? g_lscr = 0; g_lgrp = g; g_click = 0);
    g_inside(24, y + g * 17, 112, 16) ? g_hover_help = g == 8 ? "the metronome: a click on the beats (N), what it follows, where it sounds" : "a group of the controller settings a preset fills in (the manual's 'pad modes, loops, filter and effects')";
    g += 1;
  );
  n = LSGN[g_lgrp]; vis = max(1, floor((g_H - 42 - y) / 18));
  hh = vis * 18;
  // the scroll bar: drag its thumb, or click above / below it for a page
  n > vis ? (
    th = max(16, floor(hh * vis / n));
    g_click && g_inside(708, y, 10, hh) ? (g_lbar = 1; g_lbar_y = g_my; g_lbar_t = g_lscr; g_click = 0;
      ty = y + floor((hh - th) * g_lscr / (n - vis));
      g_my < ty ? (g_lscr -= vis; g_lbar = 0) : g_my >= ty + th ? (g_lscr += vis; g_lbar = 0));
    g_lbar && (mouse_cap & 1) ? g_lscr = g_lbar_t + floor((g_my - g_lbar_y) / max(1, hh - th) * (n - vis) + 0.5);
  );
  !(mouse_cap & 1) ? g_lbar = 0;
  g_lscr = max(0, min(max(0, n - vis), g_lscr)); top = g_lscr;
  // the rows (their places: g_srow reads these, the frame puts the usual ones back)
  g_srcx = 144; g_srx = 342; g_svw = 64; g_stw = 180; g_smw = 356;
  g_hover = 0; i = 0;
  loop(min(vis, n - top),
    s = LSG[g_lgrp * 24 + top + i];
    g_srow(s, y + i * 18, col);
    i += 1;
  );
  // the wheel scrolls when it is not over a value (g_input took it then)
  g_wheel != 0 && !g_hover && g_inside(144, y, 576, hh) ? (g_lscr = max(0, min(max(0, n - vis), g_lscr - (g_wheel > 0 ? 1 : -1))); g_wheel = 0);
  g_srcx = 24; g_srx = 182; g_svw = 56; g_stw = 240; g_smw = 240;
  n > vis ? (
    th = max(16, floor(hh * vis / n)); ty = y + floor((hh - th) * g_lscr / (n - vis));
    g_grey(0.70); gfx_rect(710, y + 1, 6, hh - 2);
    g_hex(col); gfx_rect(709, ty + 1, 8, th - 2);
    g_inside(708, y, 10, hh) ? g_hover_help = "scroll: drag, or click above / below for a page (the wheel over the list scrolls too)";
  );
  !g_hover && !strlen(g_hover_help) && g_inside(144, y, 576, hh) ? g_hover_help = n > vis ? "wheel = scroll; a value: drag or wheel, Shift = fine, double / right-click = default" : "a value: drag or wheel, Shift = fine, double / right-click = default";
);
function g_shead(title, y, col) (
  g_hex(col); gfx_rect(24, y + 1, g_W - 48, 18);
  gfx_setfont(4); g_grey(1); g_text(title, 32, y + 3);
);

// ---------------------------------------------------------------- preset search (user's request 2026-10-07: 64 presets).
// A box right of the Preset menu on the setup page: click it and type part of a name or maker; the matches (in the menu's
// order) list under it; Up / Down + Enter or a click picks one, Esc or a click elsewhere closes it. Letters and digits only
// count, any case ("flx4", "DDJ 400", "3000", "s4", "reloop"). While typing, the keys do not reach the deck (Space, 1-8 ...)
function pmn_maker(k) (   // the maker words of menu position k (the submenu titles of pmn_menu)
  k <= 1 ? "" : k <= 5 ? "Akai " : k <= 7 ? "Behringer " : k <= 11 ? "Denon DJ " : k <= 13 ? "Gemini " : k <= 37 ? "Hercules " : k <= 41 ? "ION " : k <= 43 ? "Korg " : k <= 45 ? "Native Instruments Traktor Kontrol HID " : k <= 65 ? "Numark " : k <= 95 ? "Pioneer DJ AlphaTheta DDJ " : k <= 101 ? "Pioneer DJ AlphaTheta CDJ XDJ " : k <= 123 ? "Reloop " : k <= 133 ? "Turntables DVS timecode vinyl CD Serato rekordbox Traktor Technics " : "Test ";
);
function g_ps_norm(src, dst) local(i, n, c) (   // lower-case letters and digits only
  strcpy(dst, ""); i = 0; n = strlen(src);
  while (i < n) (
    c = str_getchar(src, i); c >= 'A' && c <= 'Z' ? c += 32;
    (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ? (sprintf(#g_psc, "%c", c); strcat(dst, #g_psc));
    i += 1;
  );
  dst;
);
// every word of the search (split at spaces) is in the name + maker words, in any order ("terminal 8", "pioneer 1000")
function g_ps_hit(key) local(i, n, c, ok) (
  ok = 1; i = 0; n = strlen(#g_ps); strcpy(#g_pst, "");
  while (i <= n && ok) (
    c = i < n ? str_getchar(#g_ps, i) : ' ';
    c == ' ' ? (
      g_ps_norm(#g_pst, #g_psq);
      strlen(#g_psq) ? (sprintf(#g_psp, "*%s*", #g_psq); !match(#g_psp, key) ? ok = 0);
      strcpy(#g_pst, "");
    ) : (sprintf(#g_psc, "%c", c); strcat(#g_pst, #g_psc));
    i += 1;
  );
  ok;
);
function g_ps_find() local(k, v) (   // #g_psm = the matching presets, three digits each; g_ps_n of them
  strcpy(#g_psm, ""); g_ps_n = 0;
  strlen(g_ps_norm(#g_ps, #g_psq)) ? (
    k = 1;
    while (k <= 134) (
      v = pmn_val(k);
      strcpy(#g_psk, pmn_maker(k)); strcat(#g_psk, g_valstr(1, v)); g_ps_norm(#g_psk, #g_psn);
      g_ps_hit(#g_psn) ? (sprintf(#g_psc, "%03d", v); strcat(#g_psm, #g_psc); g_ps_n += 1);
      k += 1;
    );
  );
  g_ps_sel = max(0, min(g_ps_sel, g_ps_n - 1)); g_ps_dirty = 0;
);
function g_ps_val(i) ( (str_getchar(#g_psm, 3 * i) - 48) * 100 + (str_getchar(#g_psm, 3 * i + 1) - 48) * 10 + str_getchar(#g_psm, 3 * i + 2) - 48; );
function g_ps_pick(i) ( i >= 0 && i < g_ps_n ? (g_set(1, g_ps_val(i)); g_ps_on = 0); );
// (⚪111, user's request 2026-10-09) the front page's bpm box: a click = type the sample's BPM (digits, "." or ","), Enter = set
// it (0 .. 300; 0 = unknown), Esc or a click elsewhere = leave it as it was
function g_bpe_key(c) (
  c == 27 ? g_bpe = 0 :
  c == 13 ? (
    match("%f", #g_bps, g_bpv) && g_bpv >= 0 && g_bpv <= 300 ? (
      g_set(63, g_bpv); gui_dirty = 1;
      sprintf(#tt_msg, g_bpv > 0 ? "BPM %.2f (the sample's)" : "BPM unknown", g_bpv); tt_msg_t = time_precise();
    ) : (strcpy(#tt_msg, "BPM: type 0 .. 300 (e.g. 128.5), Enter = set, Esc = cancel"); tt_msg_t = time_precise());
    g_bpe = 0;
  ) :
  c == 8 ? (strlen(#g_bps) ? str_setlen(#g_bps, strlen(#g_bps) - 1)) :
  ((c >= '0' && c <= '9') || c == '.' || c == ',') && strlen(#g_bps) < 6 ? (sprintf(#g_bpc, "%c", c == ',' ? '.' : c); strcat(#g_bps, #g_bpc));
);
function g_ps_key(c) (   // a typed key while the box is open
  c == 27 ? g_ps_on = 0 :
  c == 13 ? g_ps_pick(g_ps_sel) :
  c == 8 ? (strlen(#g_ps) ? str_setlen(#g_ps, strlen(#g_ps) - 1); g_ps_dirty = 1; g_ps_sel = 0) :
  c == 'down' ? g_ps_sel = min(g_ps_n - 1, g_ps_sel + 1) :
  c == 'up' ? g_ps_sel = max(0, g_ps_sel - 1) :
  c >= 32 && c < 127 && strlen(#g_ps) < 24 ? (sprintf(#g_psc, "%c", c); strcat(#g_ps, #g_psc); g_ps_dirty = 1; g_ps_sel = 0);
);
G_PS_ROWS = 12;
// the box (right of the Preset menu, row y); also takes the clicks that land on the open list, so the rows under it do not
function g_ps_box(y) local(x, w, tw, th) (
  x = 430; w = 200;
  g_ps_dirty ? g_ps_find();
  g_grey(1); gfx_rect(x, y + 1, w, 18); g_bevel(x, y + 1, w, 18, 1, 1, 0.50);
  gfx_setfont(4);
  g_ps_on ? (
    g_grey(0.05); g_text(#g_ps, x + 5, y + 3);
    gfx_measurestr(#g_ps, tw, th);
    (floor(time_precise() * 2) & 1) == 0 ? gfx_line(x + 6 + tw, y + 4, x + 6 + tw, y + 16);   // blinking caret
  ) : (g_grey(0.55); g_text("search (flx4, 400, s4 ...)", x + 5, y + 3));
  g_inside(x, y, w, 20) ? g_hover_help = "search a preset: type part of the name or the maker; Up / Down + Enter or click = pick, Esc = close";
  g_ps_lx = x; g_ps_ly = y + 20; g_ps_lw = g_W - 24 - x;
  g_ps_lh = g_ps_on && strlen(#g_ps) ? (max(1, min(g_ps_n, G_PS_ROWS)) + (g_ps_n > G_PS_ROWS)) * 16 + 4 : 0;
  g_click && g_inside(x, y, w, 20) ? (
    !g_ps_on ? (g_ps_on = 1; strcpy(#g_ps, ""); g_ps_dirty = 1; g_ps_sel = 0);
    g_click = 0;
  ) : g_click && g_ps_on && !(g_ps_lh > 0 && g_inside(g_ps_lx, g_ps_ly, g_ps_lw, g_ps_lh)) ? g_ps_on = 0;
  g_ps_click = g_ps_on && g_ps_lh > 0 && g_click && g_inside(g_ps_lx, g_ps_ly, g_ps_lw, g_ps_lh);
  g_ps_click ? g_click = 0;
);
// the list of matches, drawn last (over the rows); the mouse lights a row when it moves, a click picks it
function g_ps_list() local(i, n, ry, v) (
  g_ps_lh > 0 ? (
    gfx_set(0, 0, 0, 0.35); gfx_rect(g_ps_lx + 3, g_ps_ly + 3, g_ps_lw, g_ps_lh); gfx_a = 1;   // shadow
    g_grey(0.97); gfx_rect(g_ps_lx, g_ps_ly, g_ps_lw, g_ps_lh); g_bevel(g_ps_lx, g_ps_ly, g_ps_lw, g_ps_lh, 1, 1, 0.50);
    gfx_setfont(4);
    g_ps_n == 0 ? (g_grey(0.45); g_text("no preset matches", g_ps_lx + 8, g_ps_ly + 3)) : (
      n = min(g_ps_n, G_PS_ROWS); i = 0;
      (g_mx != g_ps_mx || g_my != g_ps_my) && g_inside(g_ps_lx, g_ps_ly + 2, g_ps_lw, n * 16) ? g_ps_sel = floor((g_my - g_ps_ly - 2) / 16);
      g_ps_mx = g_mx; g_ps_my = g_my;
      loop(n,
        ry = g_ps_ly + 2 + i * 16; v = g_ps_val(i);
        i == g_ps_sel ? (g_hex(0x2f6fb0); gfx_rect(g_ps_lx + 2, ry, g_ps_lw - 4, 16); g_grey(1)) : g_grey(0.05);
        g_text(g_valstr(1, v), g_ps_lx + 8, ry + 1);
        v == slider1 ? g_rtext("(now)", g_ps_lx + g_ps_lw - 8, ry + 1);
        g_ps_click && g_inside(g_ps_lx, ry, g_ps_lw, 16) ? g_ps_pick(i);
        i += 1;
      );
      g_ps_n > G_PS_ROWS ? (g_grey(0.45); g_text(sprintf(#g_psc, "%d more: type more letters", g_ps_n - G_PS_ROWS), g_ps_lx + 8, g_ps_ly + 2 + n * 16 + 1));
    );
  );
);

function wz_chg(s) (   // sliderchange of one slider by its number (the mask reaches slider 64 only); the Learn tab's sliders
  CVM[s] ? (mc_dirty = 1; ap_req = 1) :   // ((⚪129) a setting in CV: undo point; @block applies it)
  s <= 64 ? sliderchange(2 ^ (s - 1)) :
  s == 84 ? sliderchange(slider84) :
  s == 85 ? sliderchange(slider85) :
  s == 230 ? sliderchange(slider230) :
  s == 231 ? sliderchange(slider231) :
  0;
);
// ---------------------------------------------------------------- Learn tab (⚪68, user's request 2026-10-07): the owner of a
// controller touches its controls one at a time; the MIDI it sends (caught in @block while wz_cap) is read here, compared
// with the preset in use (✓ same / ✗ differs), put into this deck (Apply) and written to a file (Save; the video sync
// script writes it, reascratch_ctl_presets.lua, Data/ReaScratch_controllers/<name>.reascratch-preset). The saved presets
// come back through the shared memory for the 'user presets' menu right of the preset search.
// How a jog is read comes from probing the units' MIDI: a touch = a note on held while touched; the turn's values give the
// relative type (64-centre / two's complement / sign bit, both directions while rocking); one full turn = the ticks.
// Steps: 0 PLAY, 1 CUE, 2 SHIFT, 3 touch (rock), 4 one turn, 5 side, 6 tempo, 7 volume, 8 crossfader, 9 headphone CUE,
// 10 hot cue pads, 11 SHIFT + pad 1, 12 sampler pads, (⚪149) 13 FX ON, 14 FX knob, 15 FX <, 16 FX >. Results: WZ_RES + 24 k: [0] 0 not yet / 1 measured / 2 skipped /
// 3 measured but not usable, [1] channel, [2] status, [3] number, [4]-[6] the step's own, [7] remark (1 absolute jog,
// 2 type guessed from one direction, 3 a CC button, 4 another channel than the deck's, 5 cannot count, 6 pads not in a
// row, 7 the preset reads the jog as speed / platter position: the turn is not counted, 8 the FX knob on another channel than
// FX ON's: not used), [8] pairs (slider, value) from [9]
function wz_def(k) (
  wz_kind = k <= 2 || k == 9 || k == 13 || k >= 15 ? 1 : k == 3 ? 2 : k == 4 ? 3 : k == 5 ? 4 : k == 6 ? 5 : k <= 8 || k == 14 ? 6 : k == 11 ? 9 : 8;
  wz_lab = k == 0 ? "PLAY" : k == 1 ? "CUE" : k == 2 ? "SHIFT" : k == 3 ? "Touch" : k == 4 ? "One turn" : k == 5 ? "Side of the jog" :
           k == 6 ? "Tempo fader" : k == 7 ? "Volume fader" : k == 8 ? "Crossfader" : k == 9 ? "Headphone CUE" :
           k == 10 ? "Pads: HOT CUE" : k == 11 ? "SHIFT + pad 1" : k == 12 ? "Pads: SAMPLER" :
           k == 13 ? "FX ON" : k == 14 ? "FX knob" : k == 15 ? "FX <" : "FX >";
  wz_ins = k == 0 ? "Press this deck's PLAY (play / pause) once." :
           k == 1 ? "Press this deck's CUE once." :
           k == 2 ? "Press SHIFT once." :
           k == 3 ? "Put a hand on the top of the jog, rock it back and forth a little, then let go." :
           k == 4 ? "Hold the top and turn it exactly one full turn clockwise (start at a mark), then let go." :
           k == 5 ? "Turn the side (outer edge) of the jog without touching the top, then stop." :
           k == 6 ? "Move the tempo fader end to end; finish at the + end (the side marked +) and leave it there." :
           k == 7 ? "Move this deck's channel (volume) fader up and down, then stop." :
           k == 8 ? "Move the crossfader from end to end, then stop." :
           k == 9 ? "Press this deck's headphone CUE button once." :
           k == 10 ? "Put the pads in HOT CUE mode, then press pads 1 to 8 in order (top row first). Fewer pads: Done." :
           k == 11 ? "In HOT CUE mode: hold SHIFT and press pad 1." :
           k == 12 ? "Put the pads in SAMPLER mode, then press pads 1 to 8 in order (top row first). Fewer pads: Done." :
           k == 13 ? "Switch this deck's FX ON (the button or paddle) on once." :
           k == 14 ? "Turn this deck's FX knob (the FX amount, wet / dry) from end to end, then stop." :
           k == 15 ? "Press the button that steps this deck's FX back (FX PARAM <, BEAT <, or a spare FX button) once." :
                     "Press the button that steps this deck's FX forward (FX PARAM >, BEAT >, or a spare FX button) once.";
);
function wz_sname(s) (
  s == 6 ? "MIDI channel" : s == 7 ? "jog CC" : s == 8 ? "jog type" : s == 9 ? "jog ticks/s" : s == 12 ? "touch note" :
  s == 14 ? "side CC" : s == 15 ? "PLAY note" : s == 16 ? "CUE note" : s == 33 ? "crossfader side" : s == 34 ? "crossfader ch" :
  s == 35 ? "crossfader CC" : s == 46 ? "pad channel" : s == 47 ? "pad 1 note" : s == 48 ? "SHIFT pad channel" :
  s == 73 ? "sampler channel" : s == 74 ? "sampler pad 1" : s == 92 ? "tempo CC" : s == 100 ? "tempo bits" :
  s == 105 ? "SHIFT pad offset" : s == 106 ? "volume CC" : s == 117 ? "cue note" : s == 118 ? "pad order" :
  s == 119 ? "tempo direction" : s == 120 ? "hot cue pads" : s == 121 ? "sampler pads" : s == 122 ? "mixer channel" : s == 180 ? "hot cues 5-8 row" : s == 181 ? "SHIFT note" :
  s == 84 ? "FX channel" : s == 107 ? "FX ON note" : s == 225 ? "SHIFT + FX ON" : s == 85 ? "FX knob CC" :
  s == 163 ? "FX knob CC (master type)" : s == 159 ? "FX < button" : s == 160 ? "FX > button" : "setting";
);
function wz_vs(s, v, dst) (
  s == 8 ? strcpy(dst, v == 0 ? "64-centre" : v == 1 ? "two's compl." : v == 2 ? "sign bit" : v == 3 ? "absolute 7-bit" : v == 4 ? "absolute 14-bit" : v == 5 ? "CDJ speed" : v == 6 ? "platter position" : v == 7 ? "knob turned" : "platter counter") :
  s == 92 && v == 128 ? strcpy(dst, "pitch bend") :
  (s == 92 || s == 106 || s == 117 || s == 85 || s == 107 || s == 163 || s == 159 || s == 160 || s == 225) && v < 0 ? strcpy(dst, "none") :
  s == 84 && v == 0 ? strcpy(dst, "none") :
  s == 159 || s == 160 || s == 225 ? sprintf(dst, "ch %d note %d", floor(v / 128) + 1, v % 128) :
  (s == 12 || s == 14) && v == 0 ? strcpy(dst, "none") :
  s == 100 ? strcpy(dst, v ? "10-bit" : "14-bit") :
  s == 119 ? strcpy(dst, v ? "Reversed (+ = high)" : "Normal (+ = low)") :
  s == 118 ? strcpy(dst, v ? "CDJ" : "straight") :
  s == 33 ? strcpy(dst, v == 1 ? "left" : v == 2 ? "right" : "off") :
  s == 122 && v == 0 ? strcpy(dst, "the deck's") :
  sprintf(dst, "%d", v);
);
function wz_r(k) ( WZ_RES + 24 * k; );
function wz_pair(s, v) local(r, j) ( r = wz_r(wz_k); j = r[8]; j < 7 ? (r[9 + 2 * j] = s; r[10 + 2 * j] = v; r[8] = j + 1); );
// the deck's channel: PLAY's when measured, else the preset's
function wz_dch() local(r) ( r = wz_r(0); r[0] == 1 ? r[1] : WZ_SNAP[6]; );
// the value a step measured for slider s (-1000 = none), the last step wins
function wz_meas(s) local(k, r, j, v) (
  v = -1000; k = 0;
  loop(WZ_STEPS, r = wz_r(k); r[0] == 1 ? (j = 0; loop(r[8], r[9 + 2 * j] == s ? v = r[10 + 2 * j]; j += 1)); k += 1);
  v;
);
function wz_same(s, a, b) ( s == 9 ? abs(a - b) <= 0.15 * max(a, 1) : abs(a - b) < 0.001; );
// a step's check: 1 = the same as the preset, 0 = differs or not usable, -1 = nothing to compare (not done / skipped)
function wz_ok(k) local(r, j, ok) (
  r = wz_r(k);
  r[0] == 1 && (r[8] == 0 || r[7] == 7) ? -1 :
  r[0] == 1 ? (ok = r[7] != 4; j = 0; loop(r[8], !wz_same(r[9 + 2 * j], WZ_SNAP[r[9 + 2 * j]], r[10 + 2 * j]) ? ok = 0; j += 1); ok) :
  r[0] == 3 ? 0 : -1;
);
// the remark of a step, or its first difference ("" when all are the same); #wz_t2 / #wz_t3 are scratch
function wz_why(k, dst) local(r, j, n) (
  r = wz_r(k); strcpy(dst, "");
  r[0] == 0 ? strcpy(dst, "not done") : r[0] == 2 ? strcpy(dst, "skipped") :
  r[7] == 3 ? sprintf(dst, "sends CC %d, not a note: not usable here", r[3]) :
  r[7] == 4 ? sprintf(dst, "on MIDI ch %d; the deck (PLAY) is on ch %d: not usable", r[1], wz_dch()) :
  r[7] == 5 ? strcpy(dst, "not a relative jog: the ticks cannot be counted") :
  r[7] == 6 ? strcpy(dst, "the pads' notes are not in a row: not usable") :
  r[7] == 1 && k == 3 ? strcpy(dst, "the jog sends absolute values: type unknown") :
  r[7] == 7 ? sprintf(dst, "%d jog messages; the preset reads this jog as speed / position: not counted", r[4]) :
  r[7] == 8 ? sprintf(dst, "on MIDI ch %d; FX ON is on ch %d: not usable", r[1], r[4]) :
  k == 2 && r[0] == 1 ? sprintf(dst, "heard: ch %d note %d (no setting of its own)", r[1], r[3]) :
  r[0] == 3 ? strcpy(dst, "nothing usable heard") : (
    n = 0; j = 0;
    loop(r[8],
      !wz_same(r[9 + 2 * j], WZ_SNAP[r[9 + 2 * j]], r[10 + 2 * j]) ? (
        n == 0 ? (wz_vs(r[9 + 2 * j], WZ_SNAP[r[9 + 2 * j]], #wz_t2); wz_vs(r[9 + 2 * j], r[10 + 2 * j], #wz_t3);
                  sprintf(dst, "%s: preset %s, here %s", wz_sname(r[9 + 2 * j]), #wz_t2, #wz_t3));
        n += 1;
      );
      j += 1;
    );
    n > 1 ? (sprintf(#wz_t2, " (+%d more)", n - 1); strcat(dst, #wz_t2));
    n == 0 && r[7] == 2 ? strcpy(dst, "same as the preset (jog type guessed from one direction)");
  );
  dst;
);

// ---- reading the caught MIDI
function wz_reset() (
  wz_n = 0; wz_pn = 0; wz_mk = 0; wz_nn = 0; wz_best = -1; wz_best_n = 0; wz_tch = -1; wz_tch_off = 0; wz_cc_t = 0; wz_fin_t = 0;
  memset(WZ_H, 0, 2064); memset(WZ_T, 0, 2064); memset(WZ_V, 0, 2064); memset(WZ_L, 0, 2064);
  memset(WZ_RAW + 72 * wz_k, -1, 72);
);
function wz_skipnote(h) local(r) ( r = wz_r(2); wz_k >= 10 && r[0] == 1 && h == (r[1] - 1) * 128 + r[3]; );   // SHIFT's own note
function wz_feed() local(i, j, m1, m2, m3, t, st, h) (
  i = wz_pn;
  while (i < wz_n) (
    m1 = WZ_BUF[4 * i]; m2 = WZ_BUF[4 * i + 1]; m3 = WZ_BUF[4 * i + 2]; t = WZ_BUF[4 * i + 3];
    st = m1 & 0xF0;
    wz_l1 = m1; wz_l2 = m2; wz_l3 = m3;
    wz_mk < 24 ? (WZ_RAW[72 * wz_k + 3 * wz_mk] = m1; WZ_RAW[72 * wz_k + 3 * wz_mk + 1] = m2; WZ_RAW[72 * wz_k + 3 * wz_mk + 2] = m3; wz_mk += 1);
    st == 0xB0 || st == 0xE0 ? (
      h = st == 0xE0 ? 2048 + (m1 & 15) : (m1 & 15) * 128 + m2;
      WZ_H[h] += 1; WZ_T[h] = t; WZ_V[h] = st == 0xE0 ? (m3 << 7) | m2 : m3;
      st == 0xB0 && m3 > 0 ? WZ_L[h] = 1;   // a CC that went above 0 (a CC button)
      WZ_H[h] > wz_best_n ? (wz_best_n = WZ_H[h]; wz_best = h);
      wz_cc_t == 0 ? wz_cc_t = t;
    ) : st == 0x90 && m3 > 0 ? (
      h = (m1 & 15) * 128 + m2;
      wz_kind == 2 && wz_tch < 0 ? wz_tch = h;
      !wz_skipnote(h) ? (
        j = 0; while (j < wz_nn && WZ_NL[j] != h) ( j += 1; );
        j == wz_nn && wz_nn < 16 ? (WZ_NL[wz_nn] = h; wz_nn += 1);
      );
    ) : st == 0x80 || st == 0x90 ? (
      wz_kind == 2 && (m1 & 15) * 128 + m2 == wz_tch ? wz_tch_off = t;
    );
    i += 1;
  );
  wz_pn = i;
);
// the values one CC (h) sent, as a relative jog: the type (-1 = not relative, 1 absolute); wz_g_one = only one direction
function wz_guess(h) local(i, v, n, a64, a2c, asb, lo, hi, nd) (
  n = a64 = a2c = asb = lo = hi = 0; memset(WZ_D, 0, 128);
  i = 0;
  loop(wz_n,
    WZ_BUF[4 * i] == 0xB0 + floor(h / 128) && WZ_BUF[4 * i + 1] == h % 128 ? (
      v = WZ_BUF[4 * i + 2]; n += 1; WZ_D[v] = 1;
      v >= 40 && v <= 88 && v != 64 ? a64 += 1;
      (v >= 1 && v <= 24) || v >= 104 ? a2c += 1;
      (v >= 1 && v <= 24) || (v >= 65 && v <= 88) ? asb += 1;
      v >= 1 && v <= 24 ? lo += 1;
    );
    i += 1;
  );
  nd = 0; i = 0; loop(128, nd += WZ_D[i]; i += 1);
  wz_g_one = 0; wz_g_abs = nd > 40;
  wz_g_abs ? -1 :
  a64 == n && WZ_D[63] + WZ_D[62] + WZ_D[61] + WZ_D[60] > 0 && WZ_D[65] + WZ_D[66] + WZ_D[67] + WZ_D[68] > 0 ? 0 :
  a2c == n && lo > 0 && lo < n ? 1 :
  asb == n && lo > 0 && lo < n ? 2 :
  lo == n || a2c == n ? (wz_g_one = 1; 1) :
  a64 == n ? (wz_g_one = 1; 0) : -1;
);
function wz_sgn(v, mode) ( mode == 0 ? v - 64 : mode == 2 ? (v < 64 ? v : 64 - v) : (v < 64 ? v : v - 128); );
// a fader: the CC that moved most, its LSB CC folded in (14-bit: n + 32, 10-bit Reloop: n + 54); wz_fv = where it ended 0..1
function wz_fader() local(h, c, n, r10) (
  h = wz_best;
  h >= 2048 ? (wz_fc = 128; wz_fch = h - 2048 + 1; wz_fres = 0; wz_fv = WZ_V[h] / 16383) : (
    c = floor(h / 128); n = h % 128;
    n >= 32 && WZ_H[c * 128 + n - 32] > 0 ? n -= 32 : n >= 54 && WZ_H[c * 128 + n - 54] > 0 ? n -= 54;
    r10 = n < 74 && WZ_H[c * 128 + n + 54] > 0 && !(n < 96 && WZ_H[c * 128 + n + 32] > 0);
    wz_fc = n; wz_fch = c + 1; wz_fres = r10;
    wz_fv = r10 ? ((WZ_V[c * 128 + n] << 7) | WZ_V[c * 128 + n + 54]) / 1023 :
            n < 96 && WZ_H[c * 128 + n + 32] > 0 ? ((WZ_V[c * 128 + n] << 7) | WZ_V[c * 128 + n + 32]) / 16383 : WZ_V[c * 128 + n] / 127;
  );
);
// pads: from the d-th note, how many follow in a row (straight) or in the CDJ order (pad 1 = base + 4 .. pad 5 = base)
function wz_run(d) local(i, b, s, c) (
  b = WZ_NL[d]; s = 1; while (d + s < wz_nn && WZ_NL[d + s] == b + s && s < 8) ( s += 1; );
  c = 0;
  wz_k == 10 && b % 128 >= 4 ? (
    c = 1; while (d + c < wz_nn && c < 8 && WZ_NL[d + c] == (c < 4 ? b + c : b - 4 + c - 4)) ( c += 1; );
    c < 5 ? c = 0;
  );
  wz_rord = c > s; max(s, c);
);
function wz_pads_best() local(d, n) (   // the start (a mode button pressed first is left out) with the longest run
  wz_pd = 0; wz_pl = 0; d = 0;
  loop(wz_nn, n = wz_run(d); n > wz_pl ? (wz_pl = n; wz_pd = d; wz_po = wz_rord); d += 1);
);

// ---- a step ends: its result
function wz_finish(st) local(r, h, c, n, k3, mode, i, t, v) (
  r = wz_r(wz_k); memset(r, 0, 24); r[0] = st;
  st == 1 ? (
    wz_kind == 1 || wz_kind == 9 ? (
      wz_nn > 0 ? (
        h = WZ_NL[0]; r[1] = floor(h / 128) + 1; r[2] = 0x90; r[3] = h % 128;
        wz_k == 0 ? (wz_pair(6, r[1]); wz_pair(15, r[3])) :
        wz_k == 1 ? (r[1] != wz_dch() ? r[7] = 4; wz_pair(16, r[3])) :
        wz_k == 9 ? (wz_pair(117, r[3]); wz_pair(122, r[1] == wz_dch() ? 0 : r[1])) :
        wz_k == 11 ? (
          k3 = wz_r(10); n = k3[0] == 1 ? k3[4] : WZ_SNAP[47] + (WZ_SNAP[118] ? 4 : 0);   // the note pad 1 sends
          wz_pair(48, r[1]); wz_pair(105, max(-64, min(64, r[3] - n)));
        ) :
        // ((⚪149) FX ON: the video FX channel and note; SHIFT + FX ON keeps its note on the new channel
        wz_k == 13 ? (wz_pair(84, r[1]); wz_pair(107, r[3]); WZ_SNAP[225] >= 0 ? wz_pair(225, (r[1] - 1) * 128 + WZ_SNAP[225] % 128)) :
        wz_k == 15 ? wz_pair(159, (r[1] - 1) * 128 + r[3]) :
        wz_k == 16 ? wz_pair(160, (r[1] - 1) * 128 + r[3]);
      ) : (r[0] = 3; r[7] = 3; r[2] = 0xB0; r[3] = wz_best % 128; r[1] = floor(wz_best / 128) + 1);
    ) :
    wz_kind == 2 ? (
      wz_tch >= 0 ? (r[1] = floor(wz_tch / 128) + 1; r[3] = wz_tch % 128; r[1] != wz_dch() ? r[7] = 4) : r[3] = 0;
      wz_pair(12, r[3]);
      wz_best_n >= 4 && wz_best < 2048 ? (
        r[4] = wz_best % 128; r[6] = floor(wz_best / 128) + 1;
        r[6] != wz_dch() ? r[7] = 4;
        mode = wz_guess(wz_best); r[5] = mode;
        wz_pair(7, r[4]);
        WZ_SNAP[8] >= 5 ? 0 :   // (a CDJ / Denon preset: its jog is not a relative encoder, the type is not compared)
        mode >= 0 ? (wz_pair(8, mode); wz_g_one && r[7] == 0 ? r[7] = 2) : (wz_g_abs && r[7] == 0 ? r[7] = 1);
      ) : r[5] = -2;
    ) :
    wz_kind == 3 ? (
      k3 = wz_r(3); h = k3[0] == 1 && k3[5] >= -1 && WZ_H[(k3[6] - 1) * 128 + k3[4]] > 0 ? (k3[6] - 1) * 128 + k3[4] : wz_best;
      mode = k3[0] == 1 && k3[5] >= 0 ? k3[5] : wz_guess(h);
      r[1] = floor(h / 128) + 1; r[2] = 0xB0; r[3] = h % 128; r[1] != wz_dch() ? r[7] = 4;
      WZ_SNAP[8] >= 5 ? (r[4] = WZ_H[h]; r[7] = 7) :
      mode < 0 ? (r[0] = 3; r[7] = 5) : (
        t = 0; i = 0;
        loop(wz_n, WZ_BUF[4 * i] == 0xB0 + floor(h / 128) && WZ_BUF[4 * i + 1] == h % 128 ? t += wz_sgn(WZ_BUF[4 * i + 2], mode); i += 1);
        r[4] = abs(t); r[5] = floor(abs(t) * 100 / 3 / 60 + 0.5);   // ticks per turn x 33 1/3 rpm / 60
        !(k3[0] == 1 && k3[5] >= 0) ? (wz_pair(7, r[3]); wz_pair(8, mode); wz_g_one && r[7] == 0 ? r[7] = 2);
        wz_pair(9, max(10, min(8000, r[5])));
      );
    ) :
    wz_kind == 4 ? (
      r[1] = floor(wz_best / 128) + 1; r[2] = 0xB0; r[3] = wz_best % 128; r[1] != wz_dch() ? r[7] = 4;
      k3 = wz_r(3); n = k3[0] == 1 && k3[5] >= -1 ? k3[4] : WZ_SNAP[7];
      wz_pair(14, r[3] == n ? 0 : r[3]);
    ) :
    wz_kind == 5 || wz_kind == 6 ? (
      wz_fader(); r[1] = wz_fch; r[2] = wz_fc == 128 ? 0xE0 : 0xB0; r[3] = wz_fc; r[4] = wz_fres; r[6] = wz_fv;
      wz_k == 6 ? (r[1] != wz_dch() ? r[7] = 4; wz_pair(92, wz_fc); wz_pair(100, wz_fres); wz_pair(119, wz_fv > 0.5)) :
      wz_k == 7 ? (wz_pair(106, wz_fc); wz_pair(122, wz_fch == wz_dch() ? 0 : wz_fch)) :
      // ((⚪149) the FX knob, on the video FX channel (FX ON's when measured, else the preset's; none = the knob's): the
      // deck's FX amount CC (85), or on a preset whose FX knob picks the master's type (the Buddy: 85 none, 163 set) that
      wz_k == 14 ? (
        k3 = wz_r(13); c = k3[0] == 1 ? k3[1] : WZ_SNAP[84];
        wz_fc == 128 ? (r[0] = 3) :
        c > 0 && c != wz_fch ? (r[0] = 3; r[7] = 8; r[4] = c) : (
          c <= 0 ? wz_pair(84, wz_fch);
          wz_pair(WZ_SNAP[85] < 0 && WZ_SNAP[163] >= 0 ? 163 : 85, wz_fc);
        );
      ) :
                  (wz_pair(34, wz_fch); wz_pair(35, wz_fc); wz_pair(33, wz_cdeck == 2 ? 2 : 1));
    ) :
    wz_kind == 8 ? (
      wz_pads_best();
      wz_pl == 0 ? (r[0] = 3) : (
        h = WZ_NL[wz_pd]; r[1] = floor(h / 128) + 1; r[2] = 0x90; r[4] = h % 128; r[5] = wz_pl;
        r[3] = wz_po ? r[4] - 4 : r[4];   // the base note (CDJ order: pad 1 = base + 4)
        wz_pl < 2 && wz_nn > 1 ? (r[0] = 3; r[7] = 6) :
        wz_k == 10 ? (wz_pair(46, r[1]); wz_pair(47, r[3]); wz_pair(120, wz_pl); wz_pair(118, wz_po))
                   : (wz_pair(73, r[1]); wz_pair(74, r[3]); wz_pair(121, wz_pl));
      );
    );
  );
  wz_fin_t = time_precise();
);
function wz_go(k) ( wz_k = k; wz_def(k); wz_reset(); );
function wz_start() local(i, s) (
  i = 0; loop(136, s = (str_getchar(WZ_CTL, 3 * i) - 48) * 100 + (str_getchar(WZ_CTL, 3 * i + 1) - 48) * 10 + str_getchar(WZ_CTL, 3 * i + 2) - 48;
    WZ_SNAP[s] = sv(s); i += 1);
  WZ_SNAP[6] = CV[6]; WZ_SNAP[7] = CV[7]; WZ_SNAP[47] = CV[47]; WZ_SNAP[118] = CV[118];
  wz_base = slider1; memset(WZ_RES, 0, 24 * WZ_STEPS); memset(WZ_RAW, -1, 72 * WZ_STEPS);
  wz_on = 1; wz_sum = 0; strcpy(#wz_msg, ""); wz_go(0);
);
// every frame while a step is open: read what came, end the step when its control has been left alone
function wz_tick() local(now, idle, r) (
  wz_feed(); now = time_precise();
  idle = wz_best_n > 0 ? now - WZ_T[wz_best] : 0;
  wz_fin_t > 0 ? (
    now - wz_fin_t > 1.2 ? (wz_k + 1 < WZ_STEPS ? wz_go(wz_k + 1) : (wz_on = 0; wz_sum = 1));
  ) : (
    wz_kind == 1 || wz_kind == 9 ? (
      wz_nn > 0 ? wz_finish(1) : wz_best >= 0 && WZ_L[wz_best] && idle > 0.6 && wz_best < 2048 ? wz_finish(1);
    ) :
    wz_kind == 2 ? (
      (wz_tch >= 0 && wz_tch_off > 0 && now - wz_tch_off > 1.0 && (wz_best_n == 0 || idle > 1.0)) ||
      (wz_tch < 0 && wz_best_n >= 8 && idle > 1.5) ? wz_finish(1);
    ) :
    wz_kind == 3 ? (wz_best_n >= 8 && idle > 1.5 ? wz_finish(1)) :
    wz_kind == 4 || wz_kind == 6 ? (wz_best_n >= 4 && idle > 1.0 ? wz_finish(1)) :
    wz_kind == 5 ? (wz_best_n >= 4 && idle > 1.2 ? wz_finish(1)) :
    wz_kind == 8 ? (wz_pads_best(); wz_pl >= 8 ? wz_finish(1));
  );
);

// ---- Apply / Save / the user presets
function wz_set(s, v) ( sv_set(s, v); wz_chg(s); );
// Custom: the preset no longer overwrites them. ((⚪149) last_preset too: else preset_run ran for Custom and its "not the
// Buddy" branch put -1 back into the FX < > buttons (159 / 160) and the others there, after Apply / a user preset set them)
function wz_custom() ( slider1 = 0; last_preset = 0; sliderchange(slider1); gui_dirty = 1; );
function wz_apply() local(k, r, j) (
  wz_custom();
  k = 0; loop(WZ_STEPS, r = wz_r(k); r[0] == 1 && r[7] != 4 ? (j = 0; loop(r[8], wz_set(r[9 + 2 * j], r[10 + 2 * j]); j += 1)); k += 1);
  strcpy(#tt_msg, "learn: the measured settings are in this deck (Preset = Custom)"); tt_msg_t = time_precise();
);
function wz_out(str) local(i, n) (
  n = strlen(str); i = 0;
  while (i < n && wz_o < 90000) ( gmem[WZG + 100 + wz_o] = str_getchar(str, i, 'cu'); wz_o += 1; i += 1; );
);
function wz_save() local(i, n, s, v, k, r, j) (
  wz_o = 0;
  sprintf(#wz_t1, "[deck %d]\n", wz_cdeck); wz_out(#wz_t1);
  sprintf(#wz_t1, "compared_with = %s\n", g_pname_w(wz_base)); wz_out(#wz_t1);
  wz_out("# controller settings: measured on the Learn tab, the rest from the preset compared with\n");
  i = 0;
  loop(136,
    s = (str_getchar(WZ_CTL, 3 * i) - 48) * 100 + (str_getchar(WZ_CTL, 3 * i + 1) - 48) * 10 + str_getchar(WZ_CTL, 3 * i + 2) - 48;
    v = wz_meas(s);
    v = v > -1000 ? v : WZ_SNAP[s];
    sprintf(#wz_t1, v == floor(v) ? "slider%d = %d" : "slider%d = %.4f", s, v); wz_out(#wz_t1);
    wz_meas(s) > -1000 ? (sprintf(#wz_t1, "    # %s (measured)", wz_sname(s)); wz_out(#wz_t1));
    wz_out("\n");
    i += 1;
  );
  wz_out("# checks against the preset\n");
  k = 0;
  loop(WZ_STEPS,
    wz_def(k); r = wz_r(k); n = wz_ok(k);
    wz_why(k, #wz_t4);
    sprintf(#wz_t1, "check %s = %s%s", wz_lab, n == 1 ? "same" : n == 0 ? "differs: " : "", n == 1 ? (r[7] == 2 ? " (jog type guessed)" : "") : #wz_t4); wz_out(#wz_t1);
    k == 4 && r[0] == 1 && r[7] != 7 ? (sprintf(#wz_t1, " (%d ticks in the turn)", r[4]); wz_out(#wz_t1));
    wz_out("\n");
    k += 1;
  );
  wz_out("# MIDI heard (the first messages of each step, hex)\n");
  k = 0;
  loop(WZ_STEPS,
    wz_def(k); sprintf(#wz_t1, "midi %s =", wz_lab); wz_out(#wz_t1);
    j = 0;
    while (j < 24 && WZ_RAW[72 * k + 3 * j] >= 0) (
      sprintf(#wz_t1, j ? ", %02X %02X %02X" : " %02X %02X %02X", WZ_RAW[72 * k + 3 * j], WZ_RAW[72 * k + 3 * j + 1], WZ_RAW[72 * k + 3 * j + 2]); wz_out(#wz_t1);
      j += 1;
    );
    wz_out("\n");
    k += 1;
  );
  wz_def(wz_k);
  gmem[WZG + 99] = wz_o;
  n = strlen(#wz_name); i = 0; while (i < n) ( gmem[WZG + 10 + i] = str_getchar(#wz_name, i, 'cu'); i += 1; );
  gmem[WZG + 2] = n; gmem[WZG + 1] = wz_cdeck;
  wz_req = gmem[WZG] + 1; gmem[WZG] = wz_req; wz_req_t = time_precise(); strcpy(#wz_msg, "saving ...");
);
function wz_alive() ( gmem[WZG + 9] != wz_av ? (wz_av = gmem[WZG + 9]; wz_avt = time_precise()); time_precise() - wz_avt < 2; );
function wz_umenu() local(n, k, b, i, r) (
  n = min(32, gmem[WZL + 1]);
  !wz_alive() ? strcpy(#wz_menu, "#user presets need the video sync script running (Actions: ReaScratch video sync)") :
  n <= 0 ? strcpy(#wz_menu, "#no user presets yet: make one on the Learn tab") : (
    strcpy(#wz_menu, ""); k = 0;
    loop(n,
      b = WZL + 16 + 512 * k; strcpy(#wz_t1, ""); i = 0;
      loop(min(48, gmem[b + 1]), sprintf(#wz_t2, "%c", gmem[b + 2 + i]); strcat(#wz_t1, #wz_t2); i += 1);
      sprintf(#wz_t2, "%s%s (deck %d)", k ? "|" : "", #wz_t1, gmem[b]); strcat(#wz_menu, #wz_t2);
      k += 1;
    );
  );
  gfx_dest = -1; gfx_x = g_ox + g_ub_x * g_k; gfx_y = g_oy + (g_ub_y + 20) * g_k; r = gfx_showmenu(#wz_menu); gfx_dest = 20;
  r > 0 && n > 0 && wz_alive() ? (
    b = WZL + 16 + 512 * (r - 1);
    wz_custom(); i = 0; loop(min(230, gmem[b + 50]), wz_set(gmem[b + 51 + 2 * i], gmem[b + 52 + 2 * i]); i += 1);   // ((⚪129) 230 = PAIRS_MAX of reascratch_ctl_presets.lua; 100 dropped the last 31 of the 131 settings)
    strcpy(#wz_t1, ""); i = 0; loop(min(48, gmem[b + 1]), sprintf(#wz_t2, "%c", gmem[b + 2 + i]); strcat(#wz_t1, #wz_t2); i += 1);
    sprintf(#tt_msg, "user preset: %s (deck %d) - Preset = Custom", #wz_t1, gmem[b]); tt_msg_t = time_precise();
  );
);
function wz_key(c) (   // typing the name
  c == 27 || c == 13 ? wz_typing = 0 :
  c == 8 ? (strlen(#wz_name) ? str_setlen(#wz_name, strlen(#wz_name) - 1)) :
  c >= 32 && c < 127 && c != '|' && c != '#' && c != '!' && c != '<' && c != '>' && c != '&' && strlen(#wz_name) < 40 ? (sprintf(#wz_t2, "%c", c); strcat(#wz_name, #wz_t2));
);

// ---- drawing (the Learn tab's area from y, down to about y + 160)
function wz_mark(x, y, m) (   // 1 = check (green), 0 = cross (red), else a dash (grey)
  m == 1 ? (g_hex(0x2e8b3e); gfx_line(x, y + 6, x + 3, y + 9); gfx_line(x + 3, y + 9, x + 9, y + 2); gfx_line(x, y + 7, x + 3, y + 10); gfx_line(x + 3, y + 10, x + 9, y + 3)) :
  m == 0 ? (g_hex(0xc0392b); gfx_line(x + 1, y + 2, x + 8, y + 9); gfx_line(x + 8, y + 2, x + 1, y + 9); gfx_line(x + 2, y + 2, x + 9, y + 9); gfx_line(x + 9, y + 2, x + 2, y + 9)) :
  (g_grey(0.55); gfx_rect(x + 1, y + 5, 7, 2));
);
function wz_draw(y) local(x, r, i, j, k, n, col, bw, m) (
  col = 0x37474f;
  gfx_setfont(1);
  !wz_on && !wz_sum ? (
    // start
    gfx_setfont(4); g_grey(0.05); g_text("Learn a controller: touch its controls one at a time; ReaScratch reads the MIDI", 32, y);
    g_text("and checks it against the preset (a check = the same, a cross = differs).", 32, y + 16);
    gfx_setfont(1); g_grey(0.15);
    sprintf(#wz_t1, "Compared with: %s   (this deck: %s)", g_pname_w(slider1), slider76 == 2 ? "B" : "A"); g_text(#wz_t1, 32, y + 38);
    g_text("Steps: PLAY, CUE, SHIFT, touch, one turn, side, tempo, volume, crossfader, headphone CUE, pads (HOT CUE,", 32, y + 54);
    g_text("SHIFT, SAMPLER), FX (ON, knob, < >). Skip what the controller does not have. Leave the rest alone while a step waits.", 32, y + 68);
    g_text("The controller's deck:", 32, y + 92);
    g_button(160, y + 89, 56, 20, wz_cdeck == 2 ? "deck 2" : "deck 1") ? wz_cdeck = wz_cdeck == 2 ? 1 : 2;
    g_inside(160, y + 89, 56, 20) ? g_hover_help = "which deck of the controller this is (its deck 1 = left)";
    g_button(32, y + 118, 90, 22, "Start") ? wz_start();
    WZ_RES[0] || WZ_RES[24 * 12] ? (g_button(130, y + 118, 120, 22, "last result") ? wz_sum = 1);
    g_grey(0.30); g_text(wz_alive() ? "Saved presets: REAPER resource folder / Data / ReaScratch_controllers ('user presets' above)"
                                    : "The video sync script is not running: Save and the user presets need it (Actions: ReaScratch video sync)", 32, y + 146);
  ) : wz_on ? (
    // a step
    wz_tick();
    gfx_setfont(6); g_hex(col); sprintf(#wz_t1, "%d / %d   %s", wz_k + 1, WZ_STEPS, wz_lab); g_text(#wz_t1, 32, y);
    gfx_setfont(8); g_grey(0.05); g_fittext(wz_ins, 32, y + 22, g_W - 64);
    gfx_setfont(5); g_grey(0.25);
    wz_n > 0 ? (
      (wz_l1 & 0xF0) == 0xB0 ? sprintf(#wz_t1, "heard: ch %d CC %d = %d", (wz_l1 & 15) + 1, wz_l2, wz_l3) :
      (wz_l1 & 0xF0) == 0xE0 ? sprintf(#wz_t1, "heard: ch %d pitch bend %d", (wz_l1 & 15) + 1, (wz_l3 << 7) | wz_l2) :
      (wz_l1 & 0xF0) == 0x90 && wz_l3 > 0 ? sprintf(#wz_t1, "heard: ch %d note %d on", (wz_l1 & 15) + 1, wz_l2) :
      (wz_l1 & 0xF0) == 0x90 || (wz_l1 & 0xF0) == 0x80 ? sprintf(#wz_t1, "heard: ch %d note %d off", (wz_l1 & 15) + 1, wz_l2) :
      sprintf(#wz_t1, "heard: %02X %02X %02X", wz_l1, wz_l2, wz_l3);
      sprintf(#wz_t2, "   (%d messages)", wz_n); strcat(#wz_t1, #wz_t2);
      wz_kind == 8 ? (wz_pads_best(); sprintf(#wz_t2, "  pads in a row: %d", wz_pl); strcat(#wz_t1, #wz_t2));
      wz_kind == 3 && wz_best_n > 0 ? (sprintf(#wz_t2, "  jog messages: %d", wz_best_n); strcat(#wz_t1, #wz_t2));
    ) : strcpy(#wz_t1, "waiting for MIDI ...");
    g_text(#wz_t1, 32, y + 46);
    wz_fin_t > 0 ? (
      r = wz_r(wz_k); m = wz_ok(wz_k);
      wz_mark(32, y + 68, m);
      gfx_setfont(4); g_grey(0.05);
      m == 1 ? strcpy(#wz_t4, r[7] == 2 ? "same as the preset (jog type guessed from one direction)" : "same as the preset") : wz_why(wz_k, #wz_t4);
      g_fittext(#wz_t4, 48, y + 66, g_W - 96);
      gfx_setfont(1); g_grey(0.25); j = 0;
      loop(min(4, r[8]),
        wz_vs(r[9 + 2 * j], r[10 + 2 * j], #wz_t3); sprintf(#wz_t1, "%s = %s", wz_sname(r[9 + 2 * j]), #wz_t3);
        g_text(#wz_t1, 48 + (j % 2) * 300, y + 84 + floor(j / 2) * 14); j += 1;
      );
      wz_k == 4 && r[0] == 1 ? (sprintf(#wz_t1, "%d ticks in the turn", r[4]); g_text(#wz_t1, 48, y + 112));
    );
    bw = 70; x = 32;
    g_button(x, y + 132, bw, 22, "Back") ? wz_go(max(0, wz_k - 1)); x += bw + 6;
    g_button(x, y + 132, bw, 22, "Again") ? wz_go(wz_k); x += bw + 6;
    g_button(x, y + 132, bw, 22, "Skip") ? (wz_finish(2); wz_fin_t = time_precise() - 1.2); x += bw + 6;
    wz_kind == 8 ? (g_button(x, y + 132, bw, 22, "Done") ? (wz_pads_best(); wz_finish(wz_pl ? 1 : 3)); x += bw + 6);
    g_button(g_W - 32 - bw, y + 132, bw, 22, "Stop") ? (wz_on = 0; wz_sum = 1);
    g_inside(32, y + 132, bw, 22) ? g_hover_help = "the step before, again";
    g_inside(32 + bw + 6, y + 132, bw, 22) ? g_hover_help = "this step again (forget what it heard)";
    g_inside(32 + 2 * bw + 12, y + 132, bw, 22) ? g_hover_help = "the controller has no such control: keep the preset's value";
  ) : (
    // the summary: a line per step, two columns ((⚪149) 9 rows of 12 px; 7 of 15 until the FX steps)
    k = 0;
    loop(WZ_STEPS,
      wz_def(k); x = k < 9 ? 32 : 32 + floor((g_W - 64) / 2); j = y + (k % 9) * 12;
      wz_mark(x, j + 1, wz_ok(k));
      gfx_setfont(4); g_grey(0.05); g_text(wz_lab, x + 14, j);
      gfx_setfont(1); g_grey(0.25);
      wz_ok(k) == 1 ? strcpy(#wz_t4, "same") : wz_why(k, #wz_t4);
      g_fittext(#wz_t4, x + 116, j, (g_W - 64) / 2 - 122);
      k += 1;
    );
    wz_def(wz_k);
    x = 32;
    g_button(x, y + 114, 64, 22, "Apply") ? wz_apply(); x += 70;
    g_inside(32, y + 114, 64, 22) ? g_hover_help = "put the measured settings into this deck (Preset = Custom; skipped ones keep their values)";
    // the name box
    g_grey(1); gfx_rect(x, y + 115, 170, 20); g_bevel(x, y + 115, 170, 20, 1, 1, 0.50); gfx_setfont(4);
    strlen(#wz_name) || wz_typing ? (g_grey(0.05); g_text(#wz_name, x + 5, y + 118)) : (g_grey(0.55); g_text("controller name", x + 5, y + 118));
    wz_typing && (floor(time_precise() * 2) & 1) == 0 ? (gfx_measurestr(#wz_name, n, m); g_grey(0.05); gfx_line(x + 6 + n, y + 119, x + 6 + n, y + 131));
    g_click && g_inside(x, y + 115, 170, 20) ? (wz_typing = 1; g_click = 0) : g_click ? wz_typing = 0;
    g_inside(x, y + 115, 170, 20) ? g_hover_help = "the controller's name (the file's name); click and type";
    x += 176;
    g_button(x, y + 114, 56, 22, wz_cdeck == 2 ? "deck 2" : "deck 1") ? wz_cdeck = wz_cdeck == 2 ? 1 : 2;
    g_inside(x, y + 114, 56, 22) ? g_hover_help = "which deck of the controller this is (the file keeps deck 1 and deck 2)"; x += 62;
    g_button(x, y + 114, 56, 22, "Save") ? (
      !strlen(#wz_name) ? (strcpy(#wz_msg, "type the controller's name first"); wz_typing = 1) :
      !wz_alive() ? strcpy(#wz_msg, "not saved: the video sync script is not running (Actions: ReaScratch video sync)") : wz_save();
    ); x += 62;
    g_inside(x - 62, y + 114, 56, 22) ? g_hover_help = "write Data/ReaScratch_controllers/<name>.reascratch-preset (send it to have it built in)";
    g_button(x, y + 114, 56, 22, "Again") ? wz_start(); x += 62;
    g_button(x, y + 114, 56, 22, "Close") ? (wz_sum = 0; wz_typing = 0);
    wz_req > 0 && wz_req_t > 0 ? (
      gmem[WZG + 3] >= wz_req ? (
        strcpy(#wz_msg, ""); i = 0; loop(min(200, gmem[WZG + 5]), sprintf(#wz_t2, "%c", gmem[WZG + 95000 + i]); strcat(#wz_msg, #wz_t2); i += 1);   // ((⚪129) the message at +95000: at +6 it ran over alive (+9), the name (+10) and the text (+99, +100))
        wz_req_t = 0;
      ) : time_precise() - wz_req_t > 3 ? (strcpy(#wz_msg, "no answer: is the video sync script running? (Actions: ReaScratch video sync)"); wz_req_t = 0);
    );
    gfx_setfont(1); g_grey(0.15); g_fittext(#wz_msg, 32, y + 142, g_W - 64);
  );
);

// ---------------------------------------------------------------- key list (the 'keys' button / ? key; user's request
// 2026-10-04: the list of keys in the bottom bar had grown too long). A dark sheet over the panel, two columns of
// groups; while it is open the mouse does nothing else and any click (or Esc / ?) closes it
function g_kh(title) ( gfx_setfont(4); g_hex(0x9fb0c2); g_text(title, g_kx, g_ky); g_ky += 16; );
function g_kr(k, desc) (
  gfx_setfont(5); g_led_col(); g_rtext(k, g_kx + 92, g_ky + 1);
  gfx_setfont(1); g_grey(0.88); g_text(desc, g_kx + 102, g_ky); g_ky += 14;   // (17 / 15 until 2026-10-06: the sheet looked cramped)
);
function g_keys_sheet() local(x, y, w, h) (
  x = 22; y = 8; w = g_W - 44; h = g_H - 48;   // (y = 48 until ⚪62: the new keys did not fit under the title)
  gfx_set(0.04, 0.05, 0.07, 0.94); gfx_rect(x, y, w, h); gfx_a = 1;
  // the title as grey ANSI block art, faint, behind the list (image 26 = keys_watermark.png; user's choice 0.15)
  g_tx_wm >= 0 ? (gfx_getimgdim(26, g_wmw, g_wmh); gfx_x = x + floor((w - g_wmw) / 2); gfx_y = y + floor((h - g_wmh) / 2); gfx_a = 0.15; gfx_blit(26, 1, 0); gfx_a = 1);
