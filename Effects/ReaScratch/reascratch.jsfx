    dq_l += (hg_sl * hg_n - dq_l) * hg_m; dq_r += (hg_sr * hg_n - dq_r) * hg_m;
  );
  ax_crs > 0.0005 ? (
    (ax_hn -= 1) <= 0 ? (ax_hn = ax_hold; ax_hl = floor(dq_l * ax_q + 0.5) / ax_q; ax_hr = floor(dq_r * ax_q + 0.5) / ax_q);
    dq_l += (ax_hl - dq_l) * min(1, ax_crs * 3); dq_r += (ax_hr - dq_r) * min(1, ax_crs * 3);
  );
  // ((2026-10-14, user's request) Mirror: it swapped left / right. Now the sound plus its mirror images, a few cents off
  // (see MRN): two parts = one copy, left / right swapped, up; four parts = also one as it is, down, and one swapped,
  // down (another place on the drift). The rings are written always (as ⚪98)
  MRL[ax_ew % MRN] = dq_l; MRR[ax_ew % MRN] = dq_r;
  mrc_g4 += (mrc_4 - mrc_g4) * ax_sk;
  ax_ms > 0.0005 ? (
    mrc_p1 -= mrc_r / mrc_w; mrc_p1 < 0 ? mrc_p1 += 1;
    mrc_lv = min(1, ax_ms * 8);
    mrc_l = mrc_sh(MRR, mrc_p1); mrc_r1 = mrc_sh(MRL, mrc_p1);
    mrc_g4 > 0.0005 ? (
      mrc_p2 += mrc_r / mrc_w; mrc_p2 >= 1 ? mrc_p2 -= 1;
      mrc_p3 += mrc_r / mrc_w; mrc_p3 >= 1 ? mrc_p3 -= 1;
      mrc_l += (mrc_sh(MRL, mrc_p2) + mrc_sh(MRR, mrc_p3)) * mrc_g4; mrc_r1 += (mrc_sh(MRR, mrc_p2) + mrc_sh(MRL, mrc_p3)) * mrc_g4;
    );
    mrc_n = 1 / sqrt(1 + mrc_lv * mrc_lv * (1 + 2 * mrc_g4));
    dq_l = (dq_l + mrc_l * mrc_lv) * mrc_n; dq_r = (dq_r + mrc_r1 * mrc_lv) * mrc_n;
  );
  // (⚪98) the delay lines are written always: written only while their effect was on, a start read the old sound (a click)
  HSB[ax_ew % HSN] = dq_r; CHL[ax_ew % CHN] = dq_l; CHR[ax_ew % CHN] = dq_r;
  nx_zbs > 0.0005 ? (   // ((2026-10-13) Zoom blur: 4 short reflections, crossed left / right
    nx_zl = 0.5 * CHL[(ax_ew - nx_d1 + CHN) % CHN] + 0.38 * CHR[(ax_ew - nx_d2 + CHN) % CHN] + 0.28 * CHL[(ax_ew - nx_d3 + CHN) % CHN] + 0.2 * CHR[(ax_ew - nx_d4 + CHN) % CHN];
    nx_zr = 0.5 * CHR[(ax_ew - nx_d1 + CHN) % CHN] + 0.38 * CHL[(ax_ew - nx_d2 + CHN) % CHN] + 0.28 * CHR[(ax_ew - nx_d3 + CHN) % CHN] + 0.2 * CHL[(ax_ew - nx_d4 + CHN) % CHN];
    dq_l += nx_zl * nx_zbs; dq_r += nx_zr * nx_zbs;
