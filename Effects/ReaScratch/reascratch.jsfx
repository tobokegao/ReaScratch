);
ui_touch = 0; ui_goal = 0; kb_touch = 0; ui_blk = 0; tch = 0;   // mouse scratch / X key (set by @gfx), any touch
JQ = 60000; jq_n = 0; jq_i = 0; jq_s = 0;   // relative jog moves of this block: (sample offset, frames) pairs
// a jog turned without the touch (rim, or the platter coasting on after the hand let go; the Buddy sends the same CC):
// with a touch note, while playing = a pitch bend (CDJ / rekordbox) of NB_AMT of the ticks' travel, let out over ~0.1 s;
// stopped = moves the head as before. Ticks up to NB_COAST s after the touch ended are dropped (a flicked platter
// coasting on). Before (2026-10-06) each untouched tick moved the head 1/165 s and slip did not bring it back: the
// deck went off the other deck's beat after a scratch (user's report with the Buddy)
NB_AMT = 0.1; NB_COAST = 0.15; nb_rem = 0; nb_free = 1000000000;
// jog CC mode 5 (CDJ-2000NXS2 in USB-MIDI mode, its manual's MIDI list): the top (jog CC, while touched) sends the
// platter's speed, 64 = still, 65..127 = 0.06x..4x forward, 63..0 the same backward; the ring (fine ring CC) sends
// 64 below 0.49x, 65..127 = 0.5x..4x. Not tried on hardware: whether it repeats a steady speed is unknown, so the
// top's speed holds until the next value or the touch ends, the ring's for JRG_HOLD s at most
JRG_HOLD = 0.3; jsp_v = 0; jrg_v = 0; jrg_t = 1000000000;
function cdj_speed(v, lo) ( v > 64 ? lo + (v - 65) * (4 - lo) / 62 : v < 64 ? -(lo + (63 - v) * (4 - lo) / 62) : 0; );
head_mid = head_mid2 = 0;                   // first two of the three head smoothing stages
sp_avg = 0; sp_t = 0;
hd_v = 0; hd_prev = 0; hd_tch = 0; spin_on = 0; spin_v = 0; spin_r = 0;   // head speed (frames / sample), spin on release (slider 53),
                                                                          // brake / start / spinback (57-62): speed change per sample
ui_pos = 0; ui_rate = 0; ui_cnt = 0; ui_avg = 1600; ui_gen = 0; ui_seen = 0; ui_was = 0;   // mouse drag: steady rate between GUI frames
tp_vs = 0; tp_g = 0; tp_a1 = 1; tp_a2 = 0; tp_a3 = 0; tp_c1l = tp_c2l = tp_c1r = tp_c2r = 0; tp_n = 0; tp_yl = tp_yr = 0;   // low cut (state variable filter)
pf_a = 0; pf_prev = 0; pf_v = 0; pf_r = 1; prev_v = 0;   // pitch follows speed (slider 52): smoothed amount, head motion, grain read rate
