function sv(s) ( CVM[s] ? CV[s] : slider(s); );
function sv_set(s, v) ( CVM[s] ? (CV[s] = v) : (slider(s) = v); );
cm_blur = 0.6; cm_over = 1; cm_shake = 0.7;   // (⚪128, @serialize version 5) the camera moves as a version 5 state holds them
// (⚪135, @serialize version 8) the video FX LFO (setup rows 304-306; not sliders: a new slider moves REAPER's parameter
// numbers, and the recorded lanes' envelopes would sit on other parameters): shape 0 sine, 1 triangle, 2 square, 3 saw
// down, 4 saw up; rate 0..5 = 1/4, 1/2, 1, 2, 4, 8 beats a cycle; depth 0..1 (0 = off)
lf_shape = 2; lf_rate = 2; lf_depth = 0;
// ((user's choice 2026-10-13, @serialize version 14) the DEVICE knobs 1-8's video FX types (setup More > Video FX, rows
// 307-314; type numbers 1-15 as slider 82): Tint, Hue rotate, Invert, Threshold, Mirror, Kaleidoscope, Shift RGB, VHS at first
fkt0 = 1; fkt1 = 2; fkt2 = 3; fkt3 = 4; fkt4 = 5; fkt5 = 6; fkt6 = 8; fkt7 = 11;
// ((⚪158, user's choices 2026-10-13) the VHS colour (setup More > Video FX, row 315; kept in @serialize after the knob
// types): 0 = pinkish fringes (as it was first), 1 = blue-white, the default. Sent to the deck mix as gmem [273] deck A /
// [274] B. A state saved without it keeps the default
vhs_col = 1;
// ((⚪160, user's choice 2026-10-13) the VHS on-screen text ("PLAY ▶", "SP"; setup row 316, after the colour in
// @serialize): 0 = off (the default), 1 = on. gmem [275] deck A / [276] B
vhs_osd = 0;
// ((⚪162, user's choices 2026-10-14) Disc's sound: the phono EQ's tone at the top of the amount (setup row 317, after the
// VHS text in @serialize): 0 = dark (the default; the playback's constants longer), 1 = bright (shorter: the lows leaner,
// the presence up). Low amounts are always bright (the amount goes from bright to this)
dk_tone = 0;
boot_stop = 1;       // a project just opened / the FX just loaded: start stopped whatever was saved (see @slider)
NSLOT = 8;           // grain slots (2 or 4 active depending on overlap; up to 8 while a jump cross-fades)
VOICE = 0;           // grain slot state below the sample area: pos +0, phase +8, dir +16, active +24, length +32,
                     // follows the speed +40 (slider 52 > 0), fade gain +48, fade step +56 (0 = steady), sample slot +64
// ((⚪151) the slot for a new grain: nextv if it is free, else a free one, else the quietest (the lowest fade gain). Taken
// in turn, two jumps within 5 ms (a loop's wrap and a hot cue) overwrote grains still fading out of the first: a click)
function pick_v() local(k, b, g) (
  VOICE[nextv + 24] ? (
    b = -1; g = 2; k = 0;
    loop(NSLOT, b < 0 || g > 0 ? (!VOICE[k + 24] ? (b = k; g = -1) : VOICE[k + 48] < g ? (b = k; g = VOICE[k + 48])); k += 1);
    nextv = b;
  );
  nextv;
);
// memory map: 0..65535 = small tables (grain slots, GUI peaks / colours / keys), 65536.. = the sample.
// maxmem asks for 128M values (the most REAPER 7.80 gives, measured 2026-10-03); __memtop() is what we really got,
// so an older REAPER with a lower cap just holds a shorter sample. Stereo 48 kHz: about 23 min at 128M.
buf = 65536;
// (⚪92) the sound effects' delay lines at the very top: AFX_N values (echo L / R, chorus L / R, the right channel's shift)
AFX_N = 840000;   // ((⚪124) + the vocoder's buffers)
// ((⚪163) 840000: + Halftone's grain rings (2 x 16384; with the 65536 alignment of VWB the end could pass 800000)
 // ((⚪176) above them each slot's beat map, GBM: 4096 values a slot, see gb_b)
 GBM_N = 8 * 4096; MEMEND = __memtop() - AFX_N - GBM_N; GBM = MEMEND + AFX_N; memset(GBM, 0, GBM_N); AFX = MEMEND; ED_N = 262144; EDL = AFX; EDR = AFX + ED_N;
CHN = 8192; CHL = AFX + 2 * ED_N; CHR = CHL + CHN; HSN = 8192; HSB = CHR + CHN; VBL = HSB + HSN; VBR = VBL + CHN;
PSL = VBR + CHN; PSR = PSL + CHN; VTN = 1024; VTD = PSR + CHN; VTY = VTD + VTN;
// ((⚪124) the vocoder: three FFT work buffers in one 65536 block (fft must not cross one), the input (mono), the pulse
// response, the pulses' and the noise's output rings, the log magnitude
VWB = ceil((VTY + 512) / 65536) * 65536; VZA = VWB; VZB = VWB + 8192; VZC = VWB + 16384; VXN = 16384; XIN = VWB + 24576;
VHP = XIN + VXN; VHQ = VHP + 4096; VPN = 16384; VPO = VHQ + 4096; VNO = VPO + VPN; VLM = VNO + VPN; VXB = VLM + 4100;
FLN = 2048; FLL = VXB + 32; FLR = FLL + FLN; memset(FLL, 0, 2 * FLN);   // ((2026-10-13) Zoom blur's flanger   // (VHQ: the response before; VXB: the bands' aperiodicity (5) and their sums (10))
// ((2026-10-14, user's request) Mirror's sound: a chorus of as many copies as the picture has parts (amount < 0.5:
// two, left / right; from 0.5: four). The copies are the sound a few cents off (more with the amount: 2 .. 30 cents),
// each read from its own ring (MRL / MRR, the sound before Mirror) by two taps on a delay that drifts (the classic
// rotating-tape shifter, 30 ms long, each tap faded in and out by sin^2 so the two sum to one).
// mrc_tap: ring b at phase p (0..1) of the 30 ms; mrc_sh: the two taps half a turn apart
MRN = 8192; MRL = FLR + FLN; MRR = MRL + MRN; mrc_p1 = 0; mrc_p2 = 0; mrc_p3 = 0.25; mrc_g4 = 0; mrc_w = 1440; mrc_r = 0; mrc_4 = 0;
function mrc_tap(b, p) local(d, i, f, q) ( d = 4 + p * mrc_w; i = floor(d); f = d - i; q = (ax_ew - i + 2 * MRN) % MRN; b[q] * (1 - f) + b[(q - 1 + MRN) % MRN] * f; );
function mrc_sh(b, p) local(q) ( q = p + 0.5; q >= 1 ? q -= 1; mrc_tap(b, p) * sin($pi * p) ^ 2 + mrc_tap(b, q) * sin($pi * q) ^ 2; );
// ((⚪163, 2026-10-14, user's remark at ⚪148: granular may suit it better) Halftone's sound: grains, like the dots.
// Two voices half a grain apart (8 grains a beat, no BPM 16 a second), each grain read from its own ring (HGL / HGR,
// the sound before Halftone) at a delay picked at random when it starts (more with the amount: up to 5 .. 125 ms).
// ((⚪163, user's choice the same day) as many voices as the dots are fine (the picture's cells by the amount: coarse at
// first, fine at 1): 2 at 0 .. 8 at 1, the new ones faded in by the amount. The 8 voices an eighth of a grain apart,
// HGV[i] their grain's count, HGV[8 + i] its delay (in AFX: cleared with it); the order they come in = i's 3 bits
// reversed (0 4 2 6 1 5 3 7 come 0 1 2 .. : spread out); the window sin^2 over the whole grain (the gaps of the first
// version gone); the level by sqrt(2 / the voices' sum of squares)
HGN = 16384; HGL = MRR + MRN; HGR = HGL + HGN; HGV = HGR + HGN; hg_j = 0;
memset(AFX, 0, AFX_N);   // ((⚪123) after the fixed notes; the pitch finder's sound and table (512))
// ((⚪151) a NaN that got into the effects' state (the delay lines, the low cut, the level follower) stayed there: the
// output's NaN -> 0 made it silent for good. Before the gain a NaN clears them all (once: 800 k words, about a ms)
// ((⚪162, user's choice 2026-10-14) Disc's phono EQ, built from the RIAA standard (time constants 3180 / 318 / 75 us, and
// the cutting lathe's 3.18 us): the record cut (pre-emphasis), the groove's saturation, the playback (de-emphasis) a
// little off (as Minta Foundry's Patina "RIAA mismatch": dark .. bright by dk_tone, setup row 317). dk_cf: one first-order section (1 + s tz) / (1 + s tp)
// by the bilinear transform (K = 2 srate) into dk_c0 .. dk_c2; dk_f: run it (one instance a channel and section);
// dk_g: the analog section's gain at f Hz (to hold 1 kHz); dk_sat: a tanh-like soft clip
function dk_cf(tz, tp) ( dk_c0 = (1 + 2 * srate * tz) / (1 + 2 * srate * tp); dk_c1 = (1 - 2 * srate * tz) / (1 + 2 * srate * tp); dk_c2 = (1 - 2 * srate * tp) / (1 + 2 * srate * tp); );
function dk_f(sx, c0, c1, c2) instance(x1, y1) local(y) ( y = c0 * sx + c1 * x1 - c2 * y1; x1 = sx; y1 = y; y; );
function dk_g(tz, tp, hz) ( sqrt((1 + (2 * $pi * hz * tz) ^ 2) / (1 + (2 * $pi * hz * tp) ^ 2)); );
function dk_sat(sx) local(t) ( t = max(-3, min(3, sx)); t * (27 + t * t) / (27 + 9 * t * t); );
function dk_reset() (
  dkl1.x1 = dkl1.y1 = dkl2.x1 = dkl2.y1 = dkl3.x1 = dkl3.y1 = dkl4.x1 = dkl4.y1 = 0;
  dkr1.x1 = dkr1.y1 = dkr2.x1 = dkr2.y1 = dkr3.x1 = dkr3.y1 = dkr4.x1 = dkr4.y1 = 0;
);
function nan_reset() (
  memset(AFX, 0, AFX_N); tp_c1l = tp_c2l = tp_c1r = tp_c2r = 0; tp_yl = tp_yr = 0; ax_tl = ax_tr = 0; nx_t2l = nx_t2r = 0;
  dk_reset(); dk_ck = 0;
  ax_hl = ax_hr = 0; lm_g = lm_gt = 1; dq_l = dq_r = 0;
);
// (⚪123) the voice's pitch (Hz; 0 = none found): YIN over the last 25 ms of VTD (the sound at vt_sr, about 11 kHz),
// 65 .. 700 Hz
// ((⚪124) lighter, the same numbers: the difference d(t) = e0 + e(t) - 2 c(t), the cross term c by FFT (1024) and the
// energies by a running sum (VZC), instead of W x t1 products (it took most of the vibrato's CPU))
function vt_yin() local(W, t0, t1, t, j, d, x, cum, bt, o, a, b, c, mn, M, NF, e0, ar, ai, br, bi) (
  W = floor(0.025 * vt_sr); t0 = floor(vt_sr / 700); t1 = floor(vt_sr / 65);
  o = vt_pw - W - t1 - 1 + VTN * 4; M = W + t1 + 1; NF = 1024;
  memset(VZA, 0, 2 * NF); memset(VZB, 0, 2 * NF);
  VZC[0] = 0; j = 0;
  loop(M, x = VTD[(o + j) % VTN]; VZB[2 * j] = x; j < W ? VZA[2 * j] = x; VZC[j + 1] = VZC[j] + x * x; j += 1);
  fft(VZA, NF); fft(VZB, NF);   // (both in fft's own order: the product and ifft need no permute)
  j = 0; loop(NF,
    ar = VZA[2 * j]; ai = VZA[2 * j + 1]; br = VZB[2 * j]; bi = VZB[2 * j + 1];
    VZA[2 * j] = ar * br + ai * bi; VZA[2 * j + 1] = ar * bi - ai * br; j += 1;
  );
  ifft(VZA, NF);
  e0 = VZC[W];
  cum = 0; VTY[0] = 1; t = 1;
  loop(t1 + 1,
    d = max(0, e0 + VZC[t + W] - VZC[t] - 2 * VZA[2 * t] / NF);
    cum += d; VTY[t] = cum > 0 ? d * t / cum : 1; t += 1;
  );
  bt = 0; t = t0; mn = t0;
  while (t < t1 && !bt) ( VTY[t] < VTY[mn] ? mn = t; VTY[t] < 0.15 && VTY[t] <= VTY[t + 1] ? bt = t; t += 1; );
  !bt && VTY[mn] < 0.3 ? bt = mn;
  bt > 0 ? (
    a = VTY[bt - 1]; b = VTY[bt]; c = VTY[bt + 1]; x = a - 2 * b + c;
    x > 0 ? bt += max(-0.5, min(0.5, 0.5 * (a - c) / x));
    vt_ad = b; vt_sr / bt;
  ) : (vt_ad = 1; 0);
);
// ((⚪124, user's choice 2026-10-10: like the reference, which a WORLD resynthesis matched) the vocoder's analysis, every
// VH samples: the last VN samples of XIN, a Hann window 3 periods long at the frame's centre (VN / 2 back), the power
// spectrum smoothed over one f0 (CheapTrick's idea: the harmonics go, the envelope stays), its cepstrum liftered
// (sinc at the period) and made minimum phase: the response of one pulse (VHP, VRL long) with the periodic part, and a
// frame of noise shaped by the aperiodic part added to VNO (Hann 2 VH, from now). The aperiodicity: from the YIN dip
// (vt_ad), more above 4 kHz; no pitch = all noise
function vx_analyse() local(i, k, t0, lw, x, w, hb, a, ph, f, apk, gp, lo, hi, c, sw, nn, v, sd, cd, sk, ck, t, q1) (
  t0 = vt_f0 > 0 && vt_uv < 0.04 ? srate / vt_f0 : srate / 200;
  lw = min(VN, floor(3 * t0));
  memset(VZA, 0, 2 * VN);
  // ((⚪124) the window by a rotation: one cos a sample)
  sd = sin(2 * $pi / lw); cd = cos(2 * $pi / lw); sk = sin($pi / lw); ck = cos($pi / lw);
  i = 0; loop(lw,
    VZA[2 * i] = XIN[(ax_ew - VN / 2 - floor(lw / 2) + i + 4 * VXN) % VXN] * (0.5 - 0.5 * ck);
    t = ck * cd - sk * sd; sk = sk * cd + ck * sd; ck = t; i += 1;
  );
  fft(VZA, VN); fft_permute(VZA, VN);
  // power (normalised by the window's energy) and its running sum (VZB, real) for the smoothing over one f0
  sw = 0.375 * lw; c = 0;
  k = 0; loop(VN / 2 + 1, v = (sqr(VZA[2 * k]) + sqr(VZA[2 * k + 1])) / sw; VZC[k] = v; c += v; VZB[k] = c; k += 1);
  // ((⚪124, user's choice 2026-10-10: the light way) the aperiodicity of 5 bands (centres 500, 1500, 3000, 5000, 8000 Hz)
  // from this spectrum (VZC, before the smoothing): the power between the harmonics against at them, per band; the
  // window's own leak between the harmonics (about 0.3 in amplitude) taken off. Smoothed over a few frames
  memset(VXB + 5, 0, 10);
  vt_f0 > 0 && vt_uv < 0.04 ? (
    k = 1; f = vt_f0;
    while (f < srate / 2 - vt_f0) (
      lo = floor(f * VN / srate + 0.5); a = max(VZC[lo - 1], max(VZC[lo], VZC[lo + 1]));
      hi = floor((f + vt_f0 / 2) * VN / srate + 0.5); ph = min(VZC[hi - 1], min(VZC[hi], VZC[hi + 1]));
      i = f < 1000 ? 0 : f < 2000 ? 1 : f < 4000 ? 2 : f < 6000 ? 3 : 4;
      VXB[5 + i] += a; VXB[10 + i] += ph;
      k += 1; f = k * vt_f0;
    );
    i = 0; loop(5,
      v = VXB[5 + i] > 0 ? max(0, min(1, (sqrt(VXB[10 + i] / VXB[5 + i]) - 0.3) / 0.6)) : 1;
      VXB[i] += (v - VXB[i]) * (v > VXB[i] ? 0.7 : 0.35); i += 1;
    );
  ) : (i = 0; loop(5, VXB[i] += (1 - VXB[i]) * 0.7; i += 1));
  hb = max(1, floor(VN / t0 / 2 + 0.5));
  k = 0; loop(VN / 2 + 1,
    lo = max(0, k - hb - 1); hi = min(VN / 2, k + hb);
    v = (VZB[hi] - (k - hb - 1 >= 0 ? VZB[lo] : 0)) / (hi - (k - hb - 1 >= 0 ? lo : -1));
    VLM[k] = 0.5 * log(v + 0.0000000001);   // log magnitude
    k += 1;
  );
  // cepstrum
  k = 0; loop(VN, VZB[2 * k] = VLM[k <= VN / 2 ? k : VN - k]; VZB[2 * k + 1] = 0; k += 1);
  fft_ipermute(VZB, VN); ifft(VZB, VN);
  // CheapTrick's lifter: sinc at the period times its compensation (q1 = -0.15), sin / cos of k pi / t0 by a rotation;
  // then minimum phase
  memset(VZC, 0, 2 * VN);
  VZC[0] = VZB[0] / VN; q1 = -0.15;
  sd = sin($pi / t0); cd = cos($pi / t0); sk = sd; ck = cd;
  k = 1; loop(VN / 2,
    x = $pi * k / t0;
    VZC[2 * k] = (k < VN / 2 ? 2 : 1) * VZB[2 * k] / VN * sk / x * ((1 - 2 * q1) + 2 * q1 * (1 - 2 * sk * sk));
    t = ck * cd - sk * sd; sk = sk * cd + ck * sd; ck = t; k += 1;
  );
  fft(VZC, VN); fft_permute(VZC, VN);
  // the periodic and the noise spectra, half of them (the rest mirrored: the outputs are real). The aperiodicity smoothed
  // over a few frames; the noise's phase random by two uniform parts (no trigonometry)
  vx_ap0 = vt_f0 > 0 && vt_uv < 0.04 ? max(0, min(1, (vt_ad - 0.05) / 0.35)) : 1;
  vx_ap += (vx_ap0 - vx_ap) * (vx_ap0 > vx_ap ? 0.7 : 0.35);
  k = 0; loop(VN / 2 + 1,
    f = k * srate / VN;
    apk = f < 500 ? VXB[0] : f < 1500 ? VXB[0] + (VXB[1] - VXB[0]) * (f - 500) / 1000 : f < 3000 ? VXB[1] + (VXB[2] - VXB[1]) * (f - 1500) / 1500 :
          f < 5000 ? VXB[2] + (VXB[3] - VXB[2]) * (f - 3000) / 2000 : f < 8000 ? VXB[3] + (VXB[4] - VXB[3]) * (f - 5000) / 3000 : VXB[4];
    apk = max(0.02, min(1, apk));   // ((⚪124) the bands', between their centres
    gp = sqrt(1 - apk * apk);
    a = exp(VZC[2 * k]); ph = VZC[2 * k + 1];
    VZA[2 * k] = a * gp * cos(ph); VZA[2 * k + 1] = a * gp * sin(ph);
    VZB[2 * k] = a * apk * (rand(2) - 1); VZB[2 * k + 1] = a * apk * (rand(2) - 1);
    k > 0 && k < VN / 2 ? (
      VZA[2 * (VN - k)] = VZA[2 * k]; VZA[2 * (VN - k) + 1] = -VZA[2 * k + 1];
      VZB[2 * (VN - k)] = VZB[2 * k]; VZB[2 * (VN - k) + 1] = -VZB[2 * k + 1];
    );
    k += 1;
  );
  VZA[1] = VZA[VN + 1] = VZB[1] = VZB[VN + 1] = 0;
  fft_ipermute(VZA, VN); ifft(VZA, VN);
  memcpy(VHQ, VHP, VRL);
  i = 0; loop(VRL, VHP[i] = VZA[2 * i] / VN * (i < VRL * 0.75 ? 1 : 0.5 + 0.5 * cos($pi * (i - VRL * 0.75) / (VRL * 0.25))); i += 1);
  fft_ipermute(VZB, VN); ifft(VZB, VN);
  nn = sqrt(1.5 * VN) / VN;   // (uniform parts: 1.5 for their variance)
  sd = sin(2 * $pi / (2 * VH)); cd = cos(2 * $pi / (2 * VH)); sk = sin($pi / (2 * VH)); ck = cos($pi / (2 * VH));
  i = 0; loop(2 * VH,
    VNO[(ax_ew + i) % VPN] += VZB[2 * i] * nn * (0.5 - 0.5 * ck);
    t = ck * cd - sk * sd; sk = sk * cd + ck * sd; ck = t; i += 1;
  );
);
MAXSAMPLES = MEMEND - buf;
slider50 = MAXSAMPLES;
len = 0; nch = 0; fsr = srate;
lastcue = -1;
target = head = head_mid = head_mid2 = head_grain = head_last = 0;
touched = 0; gain = 0; hopcnt = 0; nextv = 0; posc = 0; midicount = 0; blocks = 0; peak = 0;
// prev_start = start of the last grain (the WSOLA reference); PS_NONE = none. Not -1: after a loop wrap a grain can
// start before 0 (it reads the end of the file), and a "< 0 = none" test switched the alignment off there (2026-10-04)
PS_NONE = -1000000000;
prev_start = PS_NONE; prev_dir = 1;
jog_idle = 0; abs_msb = 0; last_preset = 0;
enc_rate = 0; tick_acc = 0; vps = 0;   // encoder smoothing: estimated ticks/s, ticks this block, file frames per output sample
// envelope scratch / fader (⚪38): the envelopes of sliders 114 / 115 on the engine track, laid on the timeline where this
// deck's sample sits (slot k at (k - 1) x 3600 s, as the video). REAPER's transport never plays them (the video sync stops
// it); the video sync script samples each lane (Envelope_Evaluate, so automation items, pools and shapes count) every
// EV_DT s over the stretches that hold something and writes them to gmem. Lane = [0] version, [1] stretches, [2] EV_DT,
// [8 + 3j] start (s), [9 + 3j] values, [10 + 3j] first value's index (up to 4000 stretches). Read at the deck's own time.
VG_HOLD = 0; vg_show = 1; vg_t = 0; vg_n = 0; ev_fval = 1;
EV_OFF = -0.25;   // the scratch lane's bottom = hand away
ev_t = 0; ev_at = 0; ev_clk = 0; ev_v = EV_OFF; ev_s0 = 0; ev_lo = -1; ev_hi = -1;   // held, head where the lane says 0, the lane's clock (frames), last value, its stretch start, no grab again in [lo, hi] (s)
// recording the hand into the lanes (⚪50): while REAPER records, the video sync script sets [1] of this deck's ring in gmem
// (deck A 40000, deck B 70000; [0] = records written) and each block adds a record of RC_W values from [8]: deck time (s on
// the timeline; while the hand holds, the lane's clock from where it went on, as the lanes are read back), hand on (0/1),
// head from where the hand went on (beats of the sample), crossfader gain (over its gain in the middle), head (s on the timeline).
// reascratch_lib.lua (rec_tick) turns them into automation items when the recording stops
MX_K = 32000; MX_W = 22; MX_N = floor((400000 - 8) / MX_W);   // the mix ring (⚪14): the shared memory it copies
mx_i = 0; loop(21, MX_K[mx_i] = mx_i < 9 ? mx_i : mx_i < 13 ? mx_i + 1 : mx_i == 13 ? 16 : mx_i < 18 ? mx_i + 6 : mx_i + 8; mx_i += 1);
TK_W = 4; TK_N = floor((400000 - 8) / TK_W);RC_W = 13; RC_N = floor((30000 - 8) / RC_W); rc_was = 0; rc_clk = 0; rc_at = 0; rc_xf = 1;
// (⚪178) the performance lanes (reascratch_perf.jsfx, put before this JSFX on its track): while REAPER records and the
// video sync script set [1] of this deck's ring in gmem (deck A 14100000, B 14600000; [0] = records written, [2] = REAPER's
// position of the last block recorded), each change adds a record of PRF_W values from [8]: REAPER's position (s), lane,
// value. The lanes = the perf JSFX's sliders 2.. (lane i = slider i + 1): 1 transport, 2 head (s of the sample), 3 driven
// (the head moved by a hand, a spin, reverse, a seek), 4 slot (1-8), 5 tempo (%), 6 key (semitones). reascratch_lib.lua
// (pf_tick) puts them on the perf JSFX's lanes when the recording stops
PRF_W = 3; PRF_N = floor((500000 - 8) / PRF_W); prf_on = 0; prf_nx = 0; prf_dw = 0; prf_pt = prf_ph = prf_ht = prf_hv = prf_hs = 0;
function prf_put(t, lane, v) local(o) (
  o = prf_b + 8 + PRF_W * (gmem[prf_b] % PRF_N);
  gmem[o] = t; gmem[o + 1] = lane; gmem[o + 2] = v; gmem[prf_b] += 1;
);
// the head's record; at the time of the head's last record: that one's value replaced (prf_lo = where it is)
prf_lt = -1; prf_lo = 0;
function prf_hput(t, v) (
  prf_lt == t && prf_lo > 0 ? gmem[prf_lo + 2] = v : (prf_lo = prf_b + 8 + PRF_W * (gmem[prf_b] % PRF_N); prf_put(t, 2, v));
  prf_lt = t;
);
// a lane but the head: all of them in the first block (the state as it stands), then when it changed by over 1e-4
function prf_lane(lane, v) instance(last) (
  !prf_on || abs(v - last) > 0.0001 ? (prf_put(play_position, lane, v); last = v);
);
// (⚪178 stage 3) more lanes: 7 loop on, 8 loop start, 9 loop end (s of the sample), 10 loop roll, 11 SYNC (recorded only,
// not played), 12 CUE position (s), 13-20 hot cues 1-8 (s, -1 = empty), 21 memory cue events, 22 PITCH PLAY's key
// (semitones). A memory cue event is t + 1 (added at t s of the sample) or -(t + 1) (deleted); mc_add_at / mc_del_at
// queue it here (PRF_Q, 16; they run in @gfx too), @block writes one a block (the lane: 0 between them, each one 30 ms
// long, see pf_put in reascratch_lib.lua). PRF_Q: 30064.., free between MC (30000-30031) and TT (30100)
PRF_Q = 30064; prf_qw = prf_qr = 0;
function prf_ev(v) ( PRF_Q[prf_qw % 16] = v; prf_qw += 1; prf_qw - prf_qr > 16 ? prf_qr = prf_qw - 16; );
// (⚪178 stage 2) the performance lanes played back: while the video sync's "play the performance" mode is on (gmem[400]),
// this deck's playback is on (gmem[401] deck A / [402] deck B) and REAPER plays, the perf JSFX before this one hands this
// block's lane values over (gmem 14000000 / 14000256, see reascratch_perf.jsfx) and the head of @block applies them:
// all lanes that hold a value when REAPER starts / seeks / wraps a loop (prp_chase), else only the lanes that changed (a
// value set by hand stays until its lane changes; user's choice). prp_on = that playback this block (the deck's own
// lanes on its time and SYNC's beat alignment rest meanwhile; user's choice). The head: while the driven lane is 1, the
// target follows the head lane (prp_drv, a touch for the rest of the engine); else the deck runs by itself and is put
// on the lane when it is off by more than PRP_TOL s. A hand on the deck (prp_hand) rules the head meanwhile; let go,
// the head goes back to the lane (user's choice)
prp_on = 0; prp_was = 0; prp_cnt = -1; prp_nx = -1; prp_used = 0; prp_drv = 0; prp_dw = 0; prp_s = prp_g = 0; prp_j = 0; prp_bn = 1;
prp_v1 = prp_v4 = prp_v5 = prp_v6 = prp_hp = -100; PRP_TOL = 0.03;
// (stage 3) PRP_V[i] = lane i's value in the last block (lanes 7-22; 30032.., free between MC and PRF_Q); prp_sw = this
// block's playback switched the slot. Counts for the tests, to gmem [4] - [7] of the perf area each block: prp_jn = the
// head put on its lane by a jump (prp_jump), jt_n = all jumps (jump_to), bl_wn = loop wraps, then mc_n
PRP_V = 30032; memset(PRP_V, -100, 32); prp_sw = 0; prp_jn = 0; jt_n = 0; bl_wn = 0;
// (⚪178 stage 4) the mixer and the effects, lanes 23-74 (the perf JSFX's sliders 24-75; their minimum -2 = nothing
// recorded): 23 crossfader position, 24 its cut (the Z key, or the lane's), 25 crossfader side (slider 33), 26 channel
// volume (bvol_p), 27 mute (196), 28 picture opacity (195), 29-31 blend, key threshold, key softness (78-80, deck A only),
// 32-35 filter type, cutoff, resonance, morph (153, 152, 154, 150), 36-39 video FX type / amount, master type / amount
// (82, 83, 86, 87; the master deck A only), 40-48 FX knobs 1-8 (200-206, 151) and Strobe (207), 49-51 echo, bitcrusher,
// vibrato (197-199), 52 sound of the video FX (209), 53 / 54 TOUCH FX rows 1 / 2 on (bits), 55-62 / 63-70 their amounts
// (TF[16 + k], TFB[16 + k]), 71 pitch mode (52), 72 vibrato step (220), 73 vibrato width (vb_iv; with 51, 71, 72 and the
// key they make the vocoder, ⚪124), 74 the fader lanes' gain (the ⚪38 / ⚪50 fader lane on the deck's time and a pattern
// pad's fader: off while the performance lanes play, so their gain is played from here).
// (stage 4, the additions) 75 CLIP STOP held (the helper APC40's 1-8: bits, played through prp_ah, back to none as the
// pads), 76-78 the video FX LFO's shape, rate, depth (lf_*), 79 the picture mute (pic_mute), 80-82 the helper APC40's FX
// boost, master level, blackout (gmem[241], 1 - gmem[242], gmem[243]; deck A only).
// As heard: the filter, video FX and pad FX with ⚪119's lanes when they rule (fl_c ..., vf_t / vf_a, lv_pb), each amount
// 0 while BANK holds every effect off (fx_kill) or the knob / fader is switched off (DEVICE off, a fader off: fe_off*).
// PRF_M[lane] = the value recorded last (30200..; free above TT, 30100-30115). Played back: PRP_U[lane] = the value
// applied last (30400..), prp_set applies one. The cut, the fader lanes' gain and the TOUCH FX pads are played through
