    // the search narrows to none at 1 (the grains then line up exactly); a tempo other than 0 % needs it at any pitch
    // mode (the grains read at the pitch while the head runs at the tempo; full search from 2 % off)
    pf_s = floor(srch * max(1 - pf_a, min(1, abs(slider89) * 0.5)));
    pf_s > 0 && prev_start > PS_NONE && abs(pf_sr) > 0.1 ? (
      natural = pf_f ? VOICE[prev_v] : prev_start + prev_dir * hop_f * kshift;   // where the previous grain's content continues
      start = align(nominal, pf_sr, natural, pf_f ? pf_sr : prev_dir, min(hop_f, glen * 0.5), pf_s);
    );
    vp = VOICE + pick_v(); vp[32] = glen;               // each grain keeps its own length (search grains are longer)
    );
    vp[0] = start;
    vp[8] = 0;
    vp[16] = dir;
    vp[24] = 1;
    vp[40] = pf_f; vp[48] = 1; vp[56] = 0; vp[64] = sm_cur;
    prev_start = ui_seek ? PS_NONE : start; prev_dir = dir; prev_v = nextv;   // search grains are not a WSOLA reference
    head_grain = head;
    nextv = (nextv + 1) % NSLOT;
  );
  hopcnt -= 1;

  gaintarget = ((tch || slider3 || ui_seek || spin_on) && !ended) ? 1 : 0;   // untouched and stopped, or ran off the end -> silent
  gain += (gaintarget - gain) * 0.002;
  // ((⚪169, user's request 2026-10-14: lighter) stopped and faded out (the output is dq x gain = 0): no grains, no
  // effects; the delay lines get silence (as when the sound stops), the position goes on to the video below
  sl_lite = gain < 0.00001 && gaintarget == 0 && !(ax_etail && ax_een > 0.000000001);   // ((⚪204) not while the echo's tail rings)
  sl_lite ? (
    gain = 0; dq_l = dq_r = 0; xf_gain += (xf_goal - xf_gain) * xf_k; xf_gain != xf_gain ? xf_gain = xf_goal == xf_goal ? xf_goal : 1;
    HGL[ax_ew % HGN] = HGR[ax_ew % HGN] = 0; MRL[ax_ew % MRN] = MRR[ax_ew % MRN] = 0; HSB[ax_ew % HSN] = 0; CHL[ax_ew % CHN] = CHR[ax_ew % CHN] = 0;
    FLL[ax_ew % FLN] = FLR[ax_ew % FLN] = 0; XIN[ax_ew % VXN] = 0; PSL[ax_ew % CHN] = PSR[ax_ew % CHN] = 0; EDL[ax_ew % ED_N] = EDR[ax_ew % ED_N] = 0;
  ) : (
  outl = outr = 0;
  i = 0;
  loop(NSLOT,
    vp = VOICE + i;
    vp[24] ? (
      // a grain of the slot just left (fading out after a switch) keeps reading that slot's sample: reading the new one
      // at its old place made a step in the sound (a click at each switch, 2026-10-04)
      sm_vo = vp[64] != sm_cur && sm_cur >= 0;
      // ((⚪151) at that slot's rate, and not wrapped by the new slot's loop: they read the old sample 5 ms at the new rate)
      sm_vo ? (sm_b = buf; sm_l = len; sm_h = nch; sm_fo = fsr; sm_lo = lp_l; sm_s = SM + vp[64] * 16; buf = sm_s[0]; len = sm_s[1]; nch = max(1, sm_s[2]);
               sm_s[3] > 0 ? fsr = sm_s[3]; lp_l = 0);
      w = (0.5 - 0.5 * cos(2 * $pi * vp[8] / vp[32])) * vp[48];
      vp[40] ? (
        outl += rd6(vp[0], 0) * w;                      // following grains: 6-point read (at 1 this is the tape's read)
        outr += rd6(vp[0], 1) * w;
