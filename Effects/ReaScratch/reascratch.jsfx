slider50:0<0,200000000,1>-Sample memory (values)
slider51:0<0,100000,0.001>-Sample cut (s of file, 0=whole)
slider52:0<0,1,0.01>-Pitch mode (0=pitch-locked, 1=tape)
slider53:0.25<0,2,0.01>-Spin on release (s to lose 1.8x, 0=off)
slider54:0<0,1,1{Off,On}>-Slip mode
slider57:0<0,5,0.01>-Brake on stop (s from 1x to still, 0=off)
slider58:0<0,5,0.01>-Start on play (s from still to 1x, 0=off)
slider59:3<0.5,10,0.1>-Spinback speed (x backward)
slider60:1<0.1,5,0.01>-Spinback time (s to stop)
slider63:0<0,300,0.01>-BPM (0=unknown)
slider64:0<0,3600,0.0001>-Beat grid (s, any beat)
slider65:/ReaScratch_samples:(empty).wav:-Sample file 2
slider66:/ReaScratch_samples:(empty).wav:-Sample file 3
slider67:/ReaScratch_samples:(empty).wav:-Sample file 4
slider68:/ReaScratch_samples:(empty).wav:-Sample file 5
slider69:/ReaScratch_samples:(empty).wav:-Sample file 6
slider70:/ReaScratch_samples:(empty).wav:-Sample file 7
slider71:/ReaScratch_samples:(empty).wav:-Sample file 8
slider72:1<1,8,1>-Sample slot (1-8)
slider75:0<0,8,1>-Clear sample cues (slot 1-8, set by the import script)
slider76:1<1,2,1{A,B}>-Deck (1 = A, 2 = B; set by the setup script)
slider77:1<0,1,1{Linear,Equal power}>-Fade curve
slider78:0<0,37,1{Mix,Add,Subtract,Multiply,Overlay,Soft light,Hard light,Luma key,Chroma key,Wipe right,Wipe down,Wipe diagonal,Split,Slide,Blinds,Iris box,Iris diamond,Iris circle,Clock,Blocks,Dip to black,Dip to white,Pixelate,Zoom,Punch zoom,Whip right,Whip up,Whip down,Shake cut,Spin zoom,Drop bounce,Tilt right,Tilt down,Brush wipe,Defocus,Picture in picture,Shatter,PiP to corner}>-Video blend (deck A's is used; 9-37 = transitions: the crossfader's place = how far)
slider79:0.3<0,1,0.01>-Key threshold
slider80:0.1<0,1,0.01>-Key softness
slider81:0<0,1,1{Right-handed,Left-handed}>-Layout (front page; left-handed = mirrored, record on the left)
slider82:0<0,15,1{Off,Tint,Hue rotate,Invert,Threshold,Mirror,Kaleidoscope,LoRez,Shift RGB,Strobe,Trails,VHS,Disc,Line art,Halftone,Zoom blur}>-Video FX (this deck's picture)
slider83:0<0,1,0.01>-Video FX amount
slider84:7<0,16,1>-Video FX MIDI channel (0=none)
slider85:23<-1,127,1>-Video FX CC (centre = off; FLX4 CFX knob; -1=none)
slider86:0<0,15,1{Off,Tint,Hue rotate,Invert,Threshold,Mirror,Kaleidoscope,LoRez,Shift RGB,Strobe,Trails,VHS,Disc,Line art,Halftone,Zoom blur}>-Master video FX (after the mix; deck A's is used)
slider87:0<0,1,0.01>-Master video FX amount
slider89:0<-50,50,0.01>-Tempo (%)
slider90:6<0,9,1{+-8%,+-16%,+-50%,+-5 BPM,+-10 BPM,+-15 BPM,+-20 BPM,+-30 BPM,+-40 BPM,+-60 BPM}>-Tempo range
slider91:0<0,1,1{Off,On}>-Sync (follow the other deck's BPM)
slider94:0<0,1000,0.1>-CPU worst block (% of its time, last second)
slider95:0<0,1000,0.1>-CPU average (% of real time, last second)
slider96:0<0,100000,0.1>-Sample load time (ms of CPU, last load; spread over the blocks)
slider97:0<0,1,1{Off,On}>-Load test (scratch by itself; the load test script)
slider98:0<0,1000,0.1>-Dropout threshold (ms behind real time; 0 = one block + 3 ms)
slider99:0<0,1000000,1>-Dropouts (count, since the FX loaded)
slider104:0.6<0,1,0.01>-Camera move blur (video blends 24-32: motion blur; a turning picture is also smeared along its arc. 0 = none)
slider105:1<0,2,0.01>-Camera move overshoot (how far a move goes past its end and comes back; 1 = the usual back ease, 0 = none)
slider106:0.7<0,1,0.01>-Camera move shake (Shake cut, and Drop bounce as it lands, with a colour split)
slider108:7<0,10,1>-Settings version (hidden)
slider109:50<50,75,1>-Swing (16th, %; 50 = straight, 67 = triplet)
slider110:-1<-1,3600,0.001>-Hot cue 5 (s, -1=empty)
slider111:-1<-1,3600,0.001>-Hot cue 6 (s, -1=empty)
slider112:-1<-1,3600,0.001>-Hot cue 7 (s, -1=empty)
slider113:-1<-1,3600,0.001>-Hot cue 8 (s, -1=empty)
slider114:-0.25<-0.25,2,0.001>-Envelope scratch (lane: beats from where it grabbed; bottom = hand away)
slider115:1<0,1,0.001>-Envelope fader (lane: 1 = open)
slider116:0<0,1,1{Off,On}>-Cue (headphones: this deck on channels 5/6)
slider150:0<-0.5,0.5,0.001>-Filter morph (0 = low pass left of centre / high pass right; turns through band pass, high pass, notch)
slider151:0<0,1,0.01>-FX knob 8 (this deck; its type in setup More > Video FX, VHS at first; picture and sound; APC40 DEVICE knob 8)
slider152:0<-1,1,0.001>-Filter (- = low pass, + = high pass, 0 = off)
slider153:0<0,7,1{Moog (4-pole),Ladder (2-pole),Steiner,Pillow,Rect,Shriek4p,MS-20,nlSVF}>-Filter type
slider154:0.4<0,1,0.01>-Filter resonance
slider172:0<0,8,1>-New file in slot (1-8; set by the video sync script after it wrote the slot's file)
slider173:0<0,300,0.001>-New file's BPM (set with slider 172; 0 = unknown)
slider174:0<0,3600,0.0001>-New file's beat grid (s; set with slider 172)
slider175:0<0,4,1{-,Empty slot A,Empty the others than A,Empty all,Swap A and B}>-Slot command (as the slot menu; for scripts)
slider176:1<1,8,1>-Slot command A
slider177:1<1,8,1>-Slot command B
slider179:0<0,1,1{Off,On}>-CUE LOOP (hot cue pads start a loop at the cue; L key, or the HOT CUE mode button again)
slider195:1<0,1,0.01>-Video opacity (this deck's picture; the sound stays)
slider196:0<0,1,1{Off,On}>-Mute (this deck's sound and picture)
slider197:0<0,1,0.01>-Echo (this deck; the picture: Trails)
slider198:0<0,1,0.01>-Bitcrusher (this deck; the picture: LoRez)
slider199:0<0,1,0.01>-Vibrato (this deck; the picture: a raster wave)
slider200:0<0,1,0.01>-FX knob 1 (this deck; its type in setup More > Video FX, Tint at first; picture and sound)
slider201:0<0,1,0.01>-FX knob 2 (this deck; its type in setup More > Video FX, Hue rotate at first; picture and sound)
slider202:0<0,1,0.01>-FX knob 3 (this deck; its type in setup More > Video FX, Invert at first; picture and sound)
slider203:0<0,1,0.01>-FX knob 4 (this deck; its type in setup More > Video FX, Threshold at first; picture and sound)
slider204:0<0,1,0.01>-FX knob 5 (this deck; its type in setup More > Video FX, Mirror at first; picture and sound)
slider205:0<0,1,0.01>-FX knob 6 (this deck; its type in setup More > Video FX, Kaleidoscope at first; picture and sound)
slider206:0<0,1,0.01>-FX knob 7 (this deck; its type in setup More > Video FX, Shift RGB at first; picture and sound)
slider207:0<0,1,0.01>-FX knob: Strobe (this deck; picture and sound)
slider209:1<0,1,0.01>-Sound of the video FX (how much the sounds of the video FX and of the echo / bitcrusher / vibrato faders play; 1 = all, 0 = picture only)
slider217:0<-12,12,1>-Key (semitones; the tempo stays. Knob page 3)
slider218:2<0,5,1{1/8,1/4,1/2,3/4,1,2}>-Echo length (beats; no BPM: x 0.5 s. Knob page 2)
slider219:-1<-1,0.95,0.01>-Echo feedback (how long the repeats go on; -1 = by the echo amount. Knob page 2)
slider220:3<0,5,1{1 beat,1/2 beat (8th),1/3 beat (8th triplet),1/4 beat (16th),1/6 beat (16th triplet),1/8 beat (32nd)}>-Vibrato step (the swing goes up in one step and down in the next, by the BPM; no BPM: 0.1 s. Knob page 2; with SHIFT the knob = the swing's width)
slider221:-1<-1,4,1>-Gate / Strobe step (-1 = by the amount; 0 .. 4 = 1, 2, 4, 8, 16 a beat. Knob page 2)
slider231:0<0,2,1{Off,SYNC follows REAPER,REAPER follows this deck}>-REAPER tempo (SYNC follows REAPER = the SYNC button follows REAPER's tempo and beat, not the other deck; REAPER follows this deck = while it plays, louder than the other, REAPER's tempo is its BPM: the video sync script writes it)
slider230:0<0,133,1>-2nd controller preset (the Preset list; its MIDI on bus 2 and its lights out on bus 2: setup makes the tracks "controller 2 in" / "lights 1" / "lights 2"; 0 = none)
slider232:0<0,4,0.25>-Brake on stop in beats (beats from the playing speed to still, at this deck's BPM; 0 = the seconds of 'Brake on stop')
slider233:0<0,3,1{Off,1 beat,1/2 beat (8th),1/4 beat (16th)}>-PAUSE quantize (Quantize on: PLAY to stop waits for this grid; the other deck's beat while it plays, else this deck's)
slider249:11<0,14,1{Black,White,Lamp colour,Red,Orange,Yellow,Lime,Green,Cyan,Sky,Blue,Navy,Purple,Magenta,Pink}>-Tint dark colour (the Tint effect: the darks in this colour, the lights in 'Tint light colour', a gradient between)
slider250:14<0,14,1{Black,White,Lamp colour,Red,Orange,Yellow,Lime,Green,Cyan,Sky,Blue,Navy,Purple,Magenta,Pink}>-Tint light colour (Lamp colour = the lamp's yellow / blue, as before)
slider251:0<0,15,1>-Envelope vfx type (lane: this deck's video FX as recorded, 0 = none; the larger of it and the live one plays)
slider252:0<0,1,0.001>-Envelope vfx amount (lane)
slider253:0<-1,1,0.001>-Envelope filter cutoff (lane: as Filter; plays while the live cutoff knob is at its centre)
slider254:0.4<0,1,0.01>-Envelope filter resonance (lane)
slider255:0<-0.5,0.5,0.001>-Envelope filter morph (lane)
slider256:0<0,255,1>-Envelope pad FX (lane: the TOUCH FX pads on, bit k = pad k + 1)
slider223:0<0,15,1>-Envelope master type (lane, deck A: the master video FX as recorded)
slider224:0<0,1,0.001>-Envelope master amount (lane, deck A)

in_pin:none
out_pin:left
out_pin:right
out_pin:left (before the crossfader)
out_pin:right (before the crossfader)
out_pin:cue left
out_pin:cue right
out_pin:metronome left
out_pin:metronome right

@init
BD_HC = 0; BD_SM = 11;   // Buddy mode notes (mode button + pad): top row HOT CUE 0, AUTO LOOP 17, TOUCH FX 2, SAMPLER 11; bottom SLICER 15, BOUNCE LOOP 9, NEURAL MIX 8, LOOPER 18
pq_wait = 0; pq_last = 0;   // quantized PLAY waiting (⚪36)
pz_wait = 0; pz_last = 0; pz_cnt = 0; pz_src = 0; pz_f = 0; pz_sps = 0;   // quantized PAUSE waiting (⚪83); pz_cnt = samples to its step in this block
pdm_mode = 1; pdm_hold = 0; pv_hold = 0; pv_used = 0; pm_shm = 0; pm_sl = 0; bvol_g = 1; bvol_p = 1; vfxk_amt = 0;   // pad mode (1 HOT CUE, 2 SAMPLER, 3 other), volume fader gain, FX ON memory
ext_midi_bus = 1;    // (⚪110) MIDI buses: midirecv sets midi_bus, midisend sends on it (bus 1 = 0 unless a second controller is set)
vfx_n = 15; bld_n = 37;   // ((⚪151) a 16th video FX type needs another place for gmem [222 + type] (the master amount by type, 223-237): [238] is the helper APC40's page
   // ((⚪136) the video blends (slider 78): 0 .. bld_n; 37 = Brush wipe, (⚪137) 38 = Defocus, (⚪139) 39 = Picture in picture, (⚪140) 40 = Shatter, 41 = PiP to corner; 2026-10-12: Whip left, Tilt left, Tilt down taken out: 33 = Brush wipe .. 37 = PiP to corner)
   // ((⚪132) the video FX types (sliders 82 / 86 / 223 / 251): 1 .. vfx_n; 12 = Disc, (⚪133) 13 = Line art, (⚪134) 14 = Halftone, (⚪138) 15 = Zoom blur)
ext_noinit = 1;      // REAPER's own play / seek must not run @init again (it sent the head back to CUE and the video lost sync; user's report)
sr_last = srate;   // ((⚪151) see the start of @block)
// (⚪150) the helper APC40's FX boost / master level / blackout live in gmem, which outlives the project: a project
// opened (or the helper unplugged) after a blackout kept the main output silent with no button to undo it
gmem[241] = 0; gmem[242] = 0; gmem[243] = 0;
gmem[142] = -1;   // ((⚪151) the crossfader's place for the transitions: none until deck A's @block writes it (gmem starts at 0, read as deck A's end)
// (⚪129, ⚪130) the controller settings (the MIDI channels, notes and CCs a preset sets; WZ_CTL less 33 / 84 / 85 that
// scripts set by name) are not sliders but CV[their old slider number], kept in @serialize: they need no automation, and
// the sliders ran out. The 32 on the setup page's tabs came first (⚪129, CVM = 1), the other 96 with the More tab
// (⚪130, CVM = 2). Their slider lines are gone (user's choice 2026-10-11: no spares kept; that moved REAPER's parameter
// numbers, so envelopes saved before then sit on other parameters). A new slider takes a free number; a setup row for
// a slider over 300 is the slider's number + 197 (rows 301-303 = sliders 104-106, ⚪128's camera moves).
// CVM[n] != 0: setting n is in CV. sv / sv_set read / write a setting by its number, wherever it is
CV = 62000; CVM = 62300; memset(CV, 0, 300); memset(CVM, 0, 300); ap_req = 0; pr_fresh = 0;
CVM[6] = 1; CV[6] = 2;   //ctl:slider6:2<1,16,1>-MIDI channel (deck)
CVM[7] = 1; CV[7] = 34;   //ctl:slider7:34<0,127,1>-Jog CC number
CVM[8] = 1; CV[8] = 0;   //ctl:slider8:0<0,8,1{Relative 64-centre (FLX4),Relative two's complement,Relative sign bit,Absolute 7-bit,Absolute 14-bit (CC n / n+32),Speed (CDJ MIDI: 64 = still),Platter position 14-bit (Denon: CC n / n+22),Absolute knob turned (APC40 TRACK KNOB: sent back to 64),Platter counter 7-bit (Rane Twelve: CC n counts round 0-127)}>-Jog CC mode
CVM[9] = 1; CV[9] = 400;   //ctl:slider9:400<10,8000,1>-Jog ticks per second at 1x
CVM[10] = 1; CV[10] = 0;   //ctl:slider10:0<0,1000,10>-Encoder smoothing (ms)
CVM[12] = 1; CV[12] = 54;   //ctl:slider12:54<0,127,1>-Touch note (0=none)
CVM[13] = 1; CV[13] = 150;   //ctl:slider13:150<0,2000,10>-Auto release (ms, 0=hold)
CVM[14] = 1; CV[14] = 33;   //ctl:slider14:33<0,127,1>-Fine ring CC (0=none)
CVM[15] = 1; CV[15] = 11;   //ctl:slider15:11<0,127,1>-PLAY note
CVM[16] = 1; CV[16] = 12;   //ctl:slider16:12<0,127,1>-CUE note
CVM[17] = 1; CV[17] = 0;   //ctl:slider17:0<0,127,1>-Release note (0=none)
CVM[34] = 1; CV[34] = 7;   //ctl:slider34:7<1,16,1>-Crossfader MIDI channel
CVM[35] = 1; CV[35] = 31;   //ctl:slider35:31<0,127,1>-Crossfader CC (LSB = CC+32 if sent)
CVM[46] = 1; CV[46] = 10;   //ctl:slider46:10<0,16,1>-Hot cue pad MIDI channel (0=none)
CVM[47] = 1; CV[47] = 0;   //ctl:slider47:0<0,120,1>-Hot cue pad 1 note (pads 2-8 = +1..+7)
CVM[48] = 1; CV[48] = 11;   //ctl:slider48:11<0,16,1>-Hot cue SHIFT+pad channel (clear, 0=none)
CVM[55] = 1; CV[55] = 0;   //ctl:slider55:0<0,16,1>-Memory cue MIDI channel (0=none)
CVM[56] = 1; CV[56] = 0;   //ctl:slider56:0<0,124,1>-Memory cue MEMORY note (CALL back / next / DELETE = +1..+3)
CVM[61] = 1; CV[61] = 0;   //ctl:slider61:0<0,16,1>-Spinback MIDI channel (0=none)
CVM[62] = 1; CV[62] = 0;   //ctl:slider62:0<0,127,1>-Spinback note
CVM[73] = 1; CV[73] = 0;   //ctl:slider73:0<0,16,1>-Sample select MIDI channel (0=none)
CVM[74] = 1; CV[74] = 48;   //ctl:slider74:48<0,120,1>-Sample select note of slot 1 (2-8 = +1..+7)
CVM[88] = 1; CV[88] = -1;   //ctl:slider88:-1<-1,127,1>-Master video FX CC (on the Video FX channel; -1=none)
CVM[92] = 1; CV[92] = 0;   //ctl:slider92:0<-1,128,1>-Tempo fader CC (deck channel; LSB = CC+32; 128 = pitch bend; -1=none)
CVM[93] = 1; CV[93] = 88;   //ctl:slider93:88<0,127,1>-SYNC note (note+8 = tempo range; 0=none)
CVM[102] = 1; CV[102] = -1;   //ctl:slider102:-1<-1,127,1>-Pad mode button note (deck channel; -1 = no pad modes)
CVM[103] = 1; CV[103] = 0;   //ctl:slider103:0<0,127,1>-HOT CUE mode note (pad channel, sent while the mode button is held)
CVM[104] = 1; CV[104] = 0;   //ctl:slider104:0<0,127,1>-SAMPLER mode note (pad channel, sent while the mode button is held)
CVM[105] = 1; CV[105] = 0;   //ctl:slider105:0<-64,64,1>-SHIFT+pad note offset (0 = the pad notes on the SHIFT channel)
CVM[106] = 1; CV[106] = -1;   //ctl:slider106:-1<-1,127,1>-Volume fader CC (mixer channel; -1 = none)
CVM[120] = 1; CV[120] = 8;   //ctl:slider120:8<1,8,1>-Number of hot cue pads (the pad 1 note and the next ones)
CVM[121] = 1; CV[121] = 8;   //ctl:slider121:8<1,8,1>-Number of sample select pads (the sample 1 note and the next ones)
// (⚪130) the other controller settings (the manual's chapter 13: pad modes, loop, filter, video FX, browser and
// CDJ buttons ...) were sliders set in REAPER's parameter list; since then they are in CV too (CVM = 2; @serialize
// version 7) with rows on the setup page's More tab, a list in 8 groups (user's choice 2026-10-11)
CVM[100] = 2; CV[100] = 0;   //ctl:slider100:0<0,1,1{14-bit (LSB = CC+32),10-bit (LSB = CC+54; Reloop Buddy)}>-Tempo fader resolution
CVM[101] = 2; CV[101] = -1;   //ctl:slider101:-1<-1,127,1>-Tempo range note (deck channel; -1 = SYNC note + 8, 0 = none)
CVM[107] = 2; CV[107] = -1;   //ctl:slider107:-1<-1,127,1>-Video FX on/off note (Video FX channel; -1 = none)
CVM[117] = 2; CV[117] = -1;   //ctl:slider117:-1<-1,127,1>-Cue button note (mixer channel; -1 = none)
CVM[118] = 2; CV[118] = 0;   //ctl:slider118:0<0,1,1{Straight,CDJ (pad 1 note +4..+7 = hot cues 1-4 / A-D; +0..+3 = 5-8 / E-H)}>-Hot cue pad order
CVM[119] = 2; CV[119] = 0;   //ctl:slider119:0<0,1,1{Normal,Reversed (CDJ: 127 = + side)}>-Tempo fader direction
CVM[122] = 2; CV[122] = 0;   //ctl:slider122:0<0,16,1>-Mixer MIDI channel (channel fader, cue button, deck select; 0 = the deck channel)
CVM[123] = 2; CV[123] = -1;   //ctl:slider123:-1<-1,127,1>-Deck select note (mixer channel; -1 = none. With it, the shared buttons act on the selected deck)
CVM[124] = 2; CV[124] = -1;   //ctl:slider124:-1<-1,127,1>-Tempo encoder CC (deck channel, relative; selected deck; -1 = none)
CVM[125] = 2; CV[125] = -1;   //ctl:slider125:-1<-1,127,1>-Nudge - note (deck channel; selected deck; -1 = none)
CVM[126] = 2; CV[126] = -1;   //ctl:slider126:-1<-1,127,1>-Nudge + note (deck channel; selected deck; -1 = none)
CVM[127] = 2; CV[127] = -1;   //ctl:slider127:-1<-1,127,1>-Tap tempo note (deck channel; selected deck; -1 = none)
CVM[128] = 2; CV[128] = -1;   //ctl:slider128:-1<-1,127,1>-Stop note (deck channel; selected deck; -1 = none)
CVM[129] = 2; CV[129] = -1;   //ctl:slider129:-1<-1,127,1>-Sample 5-8 notes (deck channel, note .. +3; selected deck; -1 = none)
CVM[130] = 2; CV[130] = -1;   //ctl:slider130:-1<-1,127,1>-Cue mix encoder CC (deck channel, relative; -1 = none)
CVM[131] = 2; CV[131] = 0;   //ctl:slider131:0<0,1,1{Centre = off,0 = off}>-Video FX knob type
CVM[132] = 2; CV[132] = 0;   //ctl:slider132:0<0,16,1>-Extra buttons MIDI channel (0 = none)
CVM[133] = 2; CV[133] = 0;   //ctl:slider133:0<0,124,1>-Extra buttons note (held: spinback, reverse, half speed, fast forward; with SHIFT: loop, SYNC, Q, SLIP = +0..+3)
CVM[134] = 2; CV[134] = 0;   //ctl:slider134:0<0,1,1{Notes in a row,Across channels (APC40 mkI)}>-Pad layout
CVM[135] = 2; CV[135] = 0;   //ctl:slider135:0<0,9,1{Off,APC40 mkII,APC40 mkI,One colour (on / off),Reloop RGB (Buddy / Ready),Reloop Mixon 4 RGB,Pioneer DJ colour (DDJ-1000 / FLX10 ...),Hercules Inpulse 500,Denon DJ Prime 4,Denon DJ SC5000 / SC6000}>-Pad and button lights (MIDI out)
CVM[136] = 2; CV[136] = 127;   //ctl:slider136:127<1,127,1>-Light on value (buttons; one-colour pads)
CVM[137] = 2; CV[137] = 0;   //ctl:slider137:0<0,10,0.1>-Tempo fader centre zone (% of half the travel read as 0 %)
CVM[138] = 2; CV[138] = -1;   //ctl:slider138:-1<-1,127,1>-AUTO LOOP mode note (pad channel, with the mode button; -1 = none)
CVM[139] = 2; CV[139] = -1;   //ctl:slider139:-1<-1,127,1>-TOUCH FX mode note (pad channel, with the mode button; -1 = none)
CVM[140] = 2; CV[140] = -1;   //ctl:slider140:-1<-1,127,1>-SLICER mode note (pad channel, with the mode button; -1 = none)
CVM[141] = 2; CV[141] = -1;   //ctl:slider141:-1<-1,127,1>-BOUNCE LOOP mode note (pad channel, with the mode button; -1 = none)
CVM[142] = 2; CV[142] = -1;   //ctl:slider142:-1<-1,127,1>-MEMORY mode note (pad channel, with the mode button; -1 = none)
CVM[143] = 2; CV[143] = -1;   //ctl:slider143:-1<-1,127,1>-VIDEO FX mode note (pad channel, with the mode button; pads 1-8 = video FX 1-8, the lit one again = off; -1 = none)
CVM[144] = 2; CV[144] = 0;   //ctl:slider144:0<0,16,1>-Loop knob MIDI channel (0 = none)
CVM[145] = 2; CV[145] = -1;   //ctl:slider145:-1<-1,127,1>-Loop knob CC (relative: loop length half / double)
CVM[146] = 2; CV[146] = -1;   //ctl:slider146:-1<-1,127,1>-Loop knob push note (loop on / off)
CVM[147] = 2; CV[147] = -1;   //ctl:slider147:-1<-1,255,1>-Loop move CC (deck channel, relative: move the loop / jump a beat; 128 + CC = on the loop knob's channel)
CVM[148] = 2; CV[148] = -1;   //ctl:slider148:-1<-1,255,1>-Reloop note (deck channel; 128 + note = on the loop knob's channel)
CVM[149] = 2; CV[149] = -1;   //ctl:slider149:-1<-1,127,1>-Back to CUE note (deck channel; the CUE / memory cue called, playing on)
