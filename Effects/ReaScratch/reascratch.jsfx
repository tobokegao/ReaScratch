    pid == 76 || pid == 77 ? (
      preset(1, dkv(25, 24), 1, 333, 0, dkv(78, 77), 150, dkv(59, 66), dkv(51, 60), 0, 0); preset_xf(dk, 1, 10);
      preset_pad(1, dkv(90, 94), 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(dkv(13, 14), dkv(64, 71));
      preset_mx(dkv(8, 9), dkv(101, 102)); preset_rd(0, 1, 0); preset_n(3, 8);
    );
    // Hercules DJControl Starlight / MIX (USB): the Inpulse 200's numbers (deck ch 2 / 3, JOG CC 0x0A, rim 0x09, TOUCH 8,
    // PLAY 7, CUE 6, SYNC 5, PFL 0x0C, fader CC 0; crossfader ch 1 CC 0), the filter knob CC 1 (centre = off); no tempo
    // fader (Mixxx has the Inpulse's tempo CC, the units have none); 4 pads ch 7 / 8: hot cues 0-3 (SHIFT +8), sampler
    // 0x30-0x33 (MIX: 0x10-0x13)
    pid >= 78 && pid <= 81 ? (
      preset(dk + 1, 10, 1, 138, 9, 8, 150, 7, 6, 0, 0); preset_xf(dk, 1, 0);
      preset_pad(dk + 6, 0, dk + 6); preset_sm(dk + 6, pid <= 79 ? 48 : 16); preset_vfx(0, -1); preset_te(-1, 5);   // ((⚪141) CC 1 = cutoff only)
      preset_mx(0, 12); preset_rd(0, 0, 8); preset_n(4, 4);
    );
    // Hercules DJControl Compact: both decks on ch 1: JOG CC 0x30 / 0x31 (two's complement, 256 / rev), no touch (held while
    // turning), PLAY 0x21 / 0x51, CUE 0x22 / 0x52, SYNC 0x23 / 0x53; crossfader CC 0x36; 4 pads: hot cues 1-4 / 0x31-0x34,
    // their delete buttons +4, samples 0x11-0x14 / 0x41-0x44; no tempo fader, channel fader or PFL
    pid == 82 || pid == 83 ? (
      preset(1, dkv(48, 49), 1, 142, 0, 0, 150, dkv(33, 81), dkv(34, 82), 0, 0); preset_xf(dk, 1, 54);
      preset_pad(1, dkv(1, 49), 1); preset_sm(1, dkv(17, 65)); preset_vfx(0, -1); preset_te(-1, dkv(35, 83));
      preset_mx(-1, -1); preset_rd(0, 0, 4); preset_n(4, 4);
    );
    // Hercules DJControl Jogvision: deck ch 1 / 2: JOG CC 0x41 (1 / 127), rim 0x40, TOUCH 0x55, PLAY 0x32, CUE 0x31, SYNC
    // 0x30 (⚪141; 0x35 = SHIFT + SYNC), FX dry / wet CC 0x46, tempo CC 2 + 0x22, fader CC 1, PFL 0x33, filter CC 0x0F; crossfader ch 1 CC 0; 8 hot cues 0x10-0x17 (delete +8),
    // samples 0x20-0x27
    pid == 84 || pid == 85 ? (
      preset(dk, 65, 1, 222, 64, 85, 150, 50, 49, 0, 0); preset_xf(dk, 1, 0);
      preset_pad(dk, 16, dk); preset_sm(dk, 32); preset_vfx(dk, 0x46); CV[131] = 1; preset_te(2, 0x30); preset_mx(1, 51); pk_f(-1, -1, -1, 0x0F, 0);   // (⚪141)
      preset_rd(0, 1, 8);
    );
    // Hercules DJ Control Instinct: both decks on ch 1: JOG CC 0x32 / 0x33 (two's complement, 128 / rev), TOUCH 0x1A / 0x34,
    // PLAY 0x16 / 0x30, CUE 0x15 / 0x2F, SYNC 0x17 / 0x31, fader CC 0x36 / 0x3B, PFL 0x18 / 0x32; crossfader CC 0x3A; 2 hot
    // cues 0x0D-0x0E / 0x27-0x28 (deck 2's clear +2; deck 1's not known); no tempo fader (+ / - buttons)
    pid == 86 || pid == 87 ? (
      preset(1, dkv(50, 51), 1, 71, 0, dkv(26, 52), 150, dkv(22, 48), dkv(21, 47), 0, 0); preset_xf(dk, 1, 58);
      preset_pad(1, dkv(13, 39), dkv(0, 1)); preset_sm(0, 48); preset_vfx(0, -1); preset_te(-1, dkv(23, 49));
      preset_mx(dkv(54, 59), dkv(24, 50)); preset_rd(0, 0, 2); preset_n(2, 8);
    );
    // DDJ-RB (Pioneer's list): the SB3's numbers, but no KEYLOCK (no tempo range button) and no centre = off knob
    pid == 92 || pid == 93 ? (
      preset_vfx(0, -1); preset_rd(0, 1, 8);
    );
    // Reloop Mixage (Interface Edition MK1 / MK2, Controller Edition; one Mixxx mapping): both decks on ch 1: JOG CC 0x24 /
    // 0x25 (64-centre, 620 / rev measured by its author), TOUCH 0x24 / 0x25, PLAY 0x0C / 0x1A, CUE 0x0B / 0x19, SYNC 0x09 /
    // 0x17, fader CC 0x38 / 0x3E, PFL 0x0E / 0x1C; crossfader CC 0x31; hot cues 1-4 = SHIFT + SYNC / CUP / CUE / PLAY (0x48-
    // 0x4B / 0x56-0x59); PITCH = pitch bend on ch 1 / ch 2 (deck 2's channel differs from its buttons': left out)
    pid == 94 || pid == 95 ? (
      preset(1, dkv(36, 37), 0, 344, 0, dkv(36, 37), 150, dkv(12, 26), dkv(11, 25), 0, 0); preset_xf(dk, 1, 49);
      preset_pad(1, dkv(72, 86), 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(dkv(128, -1), dkv(9, 23));
      preset_mx(dkv(56, 62), dkv(14, 28)); preset_rd(0, 0, 0); preset_n(4, 8);
    );
    // Reloop Beatpad: deck ch 1 / 2: in the jog's vinyl mode JOG CC 0x63 / 0x65 (Mixxx; 64-centre), TOUCH 0x63 / 0x65,
    // PLAY 0x60, CUE 0x5F (Reloop's v1.2 list: MainCue; Mixxx put it on 0x5E), SYNC 0x5D, fader CC 0x4F, PFL 0x61, PITCH =
    // pitch bend; crossfader ch 5 CC 0x45; 4 pads: hot cues 0x4C-0x4F (SHIFT -0x40: not readable here), sampler 0x58-0x5B.
    // Reloop's list: 1/600 of a turn per step (Mixxx 1600); its jog CCs (0x43-0x45) do not match Mixxx's: hard to read
    pid == 96 || pid == 97 ? (
      preset(dk, dkv(99, 101), 0, 333, 0, dkv(99, 101), 150, 96, 95, 0, 0); preset_xf(dk, 5, 69);
      preset_pad(dk, 76, 0); preset_sm(dk, 88); preset_vfx(0, -1); preset_te(128, 93); preset_mx(79, 97);
      preset_rd(0, 1, 0); preset_n(4, 4);
    );
    // Korg KAOSS DJ: deck ch 8 / 9: JOG CC 0x10 while touched (two's complement, 128 / rev), CC 0x0E untouched (= the rim),
    // TOUCH 0x1F, PLAY 0x1B, CUE 0x1E, SYNC 0x1D, tempo CC 0x19 (7-bit), fader CC 0x18, PFL 0x19; crossfader ch 7 CC 0x17;
    // 3 hot cues 0x12-0x14 (SHIFT +25). Korg's software sends F0 42 40 00 01 28 00 1F 70 01 F7 at start (not known if needed)
    pid == 98 || pid == 99 ? (
      preset(dk + 7, 16, 1, 71, 14, 31, 150, 27, 30, 0, 0); preset_xf(dk, 7, 23);
      preset_pad(dk + 7, 18, dk + 7); preset_sm(0, 48); preset_vfx(0, -1); preset_te(25, 29); preset_mx(24, 25);
      preset_rd(0, 1, 25); preset_n(3, 8);
    );
    // Gemini FirstMix / ION Discover DJ (the same layout): both decks on ch 1: JOG CC 0x19 / 0x18 (two's complement; FirstMix
    // 180 / rev, Discover DJ 128 / rev at 45 rpm), TOUCH 0x4D / 0x4E, PLAY 0x4A / 0x4C, CUE 0x3B / 0x42; crossfader CC 0x0A;
    // SYNC FirstMix 0x33 / 0x3C, Discover DJ 0x40 / 0x47; FirstMix PFL 0x43 / 0x45; no tempo fader, channel fader or pads
    pid >= 100 && pid <= 103 ? (
      preset(1, dkv(25, 24), 1, pid <= 101 ? 100 : 96, 0, dkv(77, 78), 150, dkv(74, 76), dkv(59, 66), 0, 0); preset_xf(dk, 1, 10);
      preset_pad(0, 0, 0); preset_sm(0, 48); preset_vfx(0, -1);
      preset_te(-1, pid <= 101 ? dkv(51, 60) : dkv(64, 71)); preset_mx(-1, pid <= 101 ? dkv(67, 69) : -1); preset_rd(0, 0, 0);
    );
    // ION Discover DJ Pro: both decks on ch 1: JOG CC 0x19 / 0x18 (two's complement, 128 / rev), its touch is a CC (none
    // here: held while turning), PLAY 0x3B / 0x42, CUE 0x33 / 0x3C, SYNC 0x40 / 0x47, tempo CC 0x0D / 0x0E (7-bit), fader
    // CC 8 / 9, PFL 0x65 / 0x66; crossfader CC 0x0A
    pid == 104 || pid == 105 ? (
      preset(1, dkv(25, 24), 1, 71, 0, 0, 150, dkv(59, 66), dkv(51, 60), 0, 0); preset_xf(dk, 1, 10);
      preset_pad(0, 0, 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(dkv(13, 14), dkv(64, 71));
      preset_mx(dkv(8, 9), dkv(101, 102)); preset_rd(0, 1, 0);
    );
    // (⚪209) DVS: the jog messages of the DVS JSFX (reascratch_dvs.jsfx on the track "DVS A in" / "DVS B in", which reads a
    // timecode vinyl / CD or the Pioneer DJ PLX-CRSS12's control tone): relative CC 34 (two's complement) on the deck's
    // channel, 8000 ticks a second at 1x (8 a cycle of the 1 kHz tone), no touch note (every message = touched; the JSFX
    // sends one at least every 20 ms while it reads). No buttons (PLAY / CUE on notes nothing sends): those of the turntables
    // below, or a 2nd controller. Not tried on hardware
    (pid >= 126 && pid <= 131) || pid == 134 || pid == 135 ? (
      preset(dk, 34, 1, 8000, 0, 0, 150, 126, 127, 0, 0); slider33 = dk; sliderchange(slider33);
      preset_pad(0, 0, 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(-1, 0);
      preset_mx(-1, -1); preset_rd(0, 1, 0);
    );
    // (⚪211) Pioneer DJ PLX-CRSS12 (AlphaTheta's MIDI list E1; the unit's DECK button = 1 / 2): the performance pads on
    // ch 8 / 9, PAD MODE k pad i = note 16 (k - 1) + i - 1 (the 5-8 button: pads 5-8 = + 4), SHIFT + pad = + 8: HOT CUE
    // (mode 1) = notes 0-7, SAMPLER (mode 2) = 16-23; SHIFT = note 48 on the deck channel. Its START/STOP and pitch fader
    // move the platter itself (the deck follows the record): not taken
    pid == 128 || pid == 129 ? (preset_pad(dk + 7, 0, dk + 7); preset_rd(0, 1, 8); preset_sm(dk + 7, 16); CV[181] = 48);
    // (⚪211 / ⚪216) Reloop RP-8000 MK2: no MIDI list from Reloop; a Traktor mapping for it (DJ TechTools 9866, djrainx96
    // 2019, its 2-deck .tsi read: tools/controller_research/sources/rp8000mk2/) has the pads of deck A on ch 6 and deck B on
    // ch 7 (CH-1 / CH-2 on the unit), HOT CUE notes 20-27, SHIFT + pad = 28-35 (delete); the lights on the same notes take
    // a 6-bit RGB as the Buddy's (its values 44, 58, 49, 12, 11). The Bome forum log (ch 6, notes 0x14-0x17) agrees
    pid == 130 || pid == 131 ? (preset_pad(dk + 5, 20, dk + 5); preset_rd(0, 1, 8));
    // (⚪213) Reloop RP-8000 (the first, MK1; Reloop's own mappings for Traktor and Scratch Live, 228337): one channel a
    // deck (CH-1 / CH-2); the pads' notes go with the mode: CUE 0-7, LOOP 8-15, SAMPLE 16-21 (22 / 23 = the bank), SLICER
    // 24-31; the mode button held + pad = + 32 (delete a cue, stop a sample). Lights: the same notes, 127 / 0 (the mode's
    // colour is the unit's own). Its platter sends nothing: DVS (a timecode vinyl)
    pid == 134 || pid == 135 ? (preset_pad(dk, 0, dk); preset_rd(0, 1, 32); preset_sm(dk, 16); preset_n(8, 6));
    // (⚪210) Rane Twelve MKII in USB mode (the Mixxx forum's mapping, MK1 logs the same): its DECK 1-4 = ch 1-4; the
    // platter CC 6 counting round 0-127 (jog mode 8), about 3600 ticks a turn (3584 also measured) = 2000 / s at 33 1/3;
    // no touch sensor and a motor: the deck follows the platter, held touched (Auto release 0); the cue pads ch 5 / 6
    // notes 20-27 (the touch strip's 8 parts in CUE MODE), CUE MODE held + a part = + 8 (delete; Mixxx maps 28-35 to
    // hotcue_N_clear). (⚪213) The first Twelve (MK1): the same messages (the MKII guide: Serato USB mode "identical to the
    // original Rane Twelve"; MK1 logs: CC 6, pitch bend, deck select the same). Its pitch fader moves the motor (not taken).
    // Not tried on hardware
    pid == 132 || pid == 133 ? (
      preset(dk, 6, 8, 2000, 0, 0, 0, 126, 127, 0, 0); slider33 = dk; sliderchange(slider33);
      preset_pad(dk + 4, 20, dk + 4); preset_sm(0, 48); preset_vfx(0, -1); preset_te(-1, 0);
      preset_mx(-1, -1); preset_rd(0, 1, 8);
    );
    // Behringer CMD Micro: both decks on ch 1: JOG CC 0x11 / 0x21 (64-centre, 128 / rev), TOUCH 1 / 2, PLAY 0x17 / 0x27,
    // CUE 0x18 / 0x28, SYNC 0x16 / 0x26, tempo CC 0x10 / 0x20 (7-bit), fader CC 0x12 / 0x22, PFL 0x19 / 0x29; crossfader
    // CC 0x40 (= deck 2's tempo CC + 32: an LSB counts only right after its MSB); no hot cue pads
    pid == 106 || pid == 107 ? (
      preset(1, dkv(17, 33), 0, 71, 0, dkv(1, 2), 150, dkv(23, 39), dkv(24, 40), 0, 0); preset_xf(dk, 1, 64);
      preset_pad(0, 0, 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(dkv(16, 32), dkv(22, 38));
      preset_mx(dkv(18, 34), dkv(25, 41)); preset_rd(0, 1, 0);
    );
    // Numark DJ2GO2 (no touch; Numark's own Traktor mapping via the Internet Archive): the DJ2GO2 Touch's numbers without
