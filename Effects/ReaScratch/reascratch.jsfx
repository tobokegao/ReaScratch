  nx_fds += (nx_fd - nx_fds) * ax_sk; nx_fd2s += (nx_fd2 - nx_fd2s) * ax_sk;
  nx_zbs > 0.0005 ? (   // ((2026-10-13) Zoom blur's flanger
    nx_i = floor(nx_fds); nx_f = nx_fds - nx_i; nx_fl = FLL[(ax_ew - nx_i + FLN) % FLN] * (1 - nx_f) + FLL[(ax_ew - nx_i - 1 + FLN) % FLN] * nx_f;
    nx_i = floor(nx_fd2s); nx_f = nx_fd2s - nx_i; nx_fr = FLR[(ax_ew - nx_i + FLN) % FLN] * (1 - nx_f) + FLR[(ax_ew - nx_i - 1 + FLN) % FLN] * nx_f;
    FLL[ax_ew % FLN] = dq_l + nx_fl * 0.6; FLR[ax_ew % FLN] = dq_r + nx_fr * 0.6;
    dq_l += nx_fl * 0.7 * nx_zbs; dq_r += nx_fr * 0.7 * nx_zbs;
  ) : (FLL[ax_ew % FLN] = dq_l; FLR[ax_ew % FLN] = dq_r);
  // (⚪100) the Shift RGB knob's delay follows it over about 30 ms, read between samples: it stepped by whole samples at
  // each block and switched on and off at once (noise when the knob moved, user's report 2026-10-09)
  ax_hds += (ax_hd - ax_hds) * ax_sk;
  ax_hds > 0.001 || ax_chs > 0.0005 ? (
    ax_hds > 0.001 ? (
      ax_i = floor(ax_hds); ax_f = ax_hds - ax_i;
      dq_r = HSB[(ax_ew - ax_i + HSN) % HSN] * (1 - ax_f) + HSB[(ax_ew - ax_i - 1 + HSN) % HSN] * ax_f;
    );
    ax_chs > 0.0005 ? (
      ax_lfo += 0.8 / srate; ax_lfo > 1 ? ax_lfo -= 1;
      ax_d = (0.012 + 0.004 * sin(2 * $pi * ax_lfo)) * srate; ax_i = floor(ax_d); ax_f = ax_d - ax_i;
      ax_cl = CHL[(ax_ew - ax_i + CHN) % CHN] * (1 - ax_f) + CHL[(ax_ew - ax_i - 1 + CHN) % CHN] * ax_f;
      ax_d = (0.017 + 0.004 * sin(2 * $pi * ax_lfo + 2)) * srate; ax_i = floor(ax_d); ax_f = ax_d - ax_i;
      ax_cr = CHR[(ax_ew - ax_i + CHN) % CHN] * (1 - ax_f) + CHR[(ax_ew - ax_i - 1 + CHN) % CHN] * ax_f;
      dq_l = dq_l * (1 - 0.4 * ax_chs) + ax_cl * 0.6 * ax_chs; dq_r = dq_r * (1 - 0.4 * ax_chs) + ax_cr * 0.6 * ax_chs;
    );
  );
  // (⚪93) the vibrato: only the moved copy (the pitch goes up and down). (⚪98) Its amount follows the fader over about 30 ms
  // and the delay line is written always: a fader move stepped the delay (noise, user's report 2026-10-09)
  // ((⚪169) VBL / VBR were written here, never read: gone)
  ax_vs += (ax_vib - ax_vs) * ax_sk;
  // (⚪123, user's request and choices 2026-10-10: as the reference clip, sm34436237) toward the pitch end of the Pitch mode
  // bar (slider 52) the voice is sung again on a new pitch. (⚪124, user's reports and choice 2026-10-10: the moved voice
  // (PSOLA) still sounded like the voice moved; a WORLD resynthesis on the reference's own pitch sounded like it) the voice
  // is analysed and made again (vx_analyse: its envelope and noise; pulses at the new period through the envelope). The
  // pitch, as measured in the reference (WORLD's harvest, the 5 Hz swing averaged out): about C4 whatever the voice sang
  // (it sang 900 .. 1700 cents lower): C4 (moved by the key knob, slider 217), plus a cosine swing of vb_iv * 48 cents each way (SHIFT +
  // the vibrato step knob, default 5 = +-240, kept with the project), one swing every two vibrato steps (slider 220) of
  // the deck's beats (the reference: exactly 5 a second). No pitch: noise through the envelope. About VN / 2 later (23 ms)
  XIN[ax_ew % VXN] = (dq_l + dq_r) * 0.5;
  vt_m = ax_vs > 0.0005 ? (1 - slider52) * min(1, ax_vs * 2) : 0;
  vt_ms += (vt_m - vt_ms) * ax_sk;
  vt_ms > 0.001 ? (
    vx_on = 1;
    vt_l1 += ((dq_l + dq_r) * 0.5 - vt_l1) * vt_lk; vt_l2 += (vt_l1 - vt_l2) * vt_lk;
    (vt_dc += 1) >= vt_dn ? (
      vt_dc = 0; VTD[vt_pw % VTN] = vt_l2; vt_pw += 1;
      vt_pw % 64 == 0 ? (vt_f = vt_yin(); vt_f > 0 ? (vt_f0 = vt_f; vt_uv = 0) : (vt_uv += 64 * vt_dn / srate));   // ((⚪124) every 256 samples)
    );
    ax_bpm > 0 && slider63 > 0 ? vt_bt = gb_b(head) / vt_st : (vt_fr += 10 / srate; vt_bt = vt_fr);
    vx_vo = vt_f0 > 0 && vt_uv < 0.04;
    vx_vo ? (
      vx_ci = 1200 * log(vt_f0 / 261.63) / log(2);
      vx_cs < -9999 ? vx_cs = vx_ci;
      vx_cs += (vx_ci - vx_cs) * vx_ck;
      vx_pv = 100 * slider217;
      vx_ct = vx_pv + vb_iv * 48 * cos($pi * vt_bt);
      vx_co = vx_cs + (vx_ct - vx_cs) * min(1, vt_ms * 2);
      vx_to = srate / (261.63 * 2 ^ (vx_co / 1200));
    );
    (vx_hc += 1) >= VH ? (vx_hc = 0; vx_analyse());
    // a pulse when its time comes (vx_pc counts down; split between two samples for the fraction)
    vx_pc -= 1;
    vx_pc <= 1 ? (
      vx_vo ? (
        vx_a = sqrt(vx_to); vx_f = max(0, vx_pc); vx_i = 0; vx_al = vx_hc / VH;   // (vx_al: between the response before and now)
        loop(VRL,
          vx_k = (ax_ew + vx_i) % VPN; vx_x = vx_a * (VHQ[vx_i] + (VHP[vx_i] - VHQ[vx_i]) * vx_al);
          VPO[vx_k] += vx_x * (1 - vx_f); VPO[(vx_k + 1) % VPN] += vx_x * vx_f; vx_i += 1;
        );
      );
      vx_pc += vx_vo ? vx_to : srate / 200;
    );
    vx_k = ax_ew % VPN; vx_y = VPO[vx_k] + VNO[vx_k]; VPO[vx_k] = VNO[vx_k] = 0;
    // the level: the output's power brought to the input's (VN / 2 back, as the analysis), over about 0.3 s
    vx_x = XIN[(ax_ew - VN / 2 + 4 * VXN) % VXN];
    vx_pi += (vx_x * vx_x - vx_pi) * vx_pk; vx_po += (vx_y * vx_y - vx_po) * vx_pk;
    vx_pi > 0.0000001 && vx_po > 0.000000001 ? vx_gt = max(0.1, min(10, sqrt(vx_pi / vx_po)));
    vx_g += (vx_gt - vx_g) * vx_gk;
    vx_y = max(-1, min(1, vx_y * vx_g));
    ax_m = min(1, vt_ms * 4);
    dq_l += (vx_y - dq_l) * ax_m; dq_r += (vx_y - dq_r) * ax_m;
  ) : (vt_f0 = 0; vt_uv = 1; vx_cs = -99999; vx_pc = 0;
         vx_on ? (memset(VPO, 0, 2 * VPN); vx_on = 0));   // ((⚪151) its output rings (VPO, VNO) emptied once: what was left in them played at the next start)
  // the tape end: the pitch swinging up and down (a moving delay), one swing every two steps (no BPM: 5 a second). ((⚪122)'s
  // tremolo went: the reference clip's loudness did not swing)
  PSL[ax_ew % CHN] = dq_l; PSR[ax_ew % CHN] = dq_r;
  ax_vs > 0.0005 && slider52 > 0.001 ? (
    ax_vp += (ax_bpm > 0 ? ax_bpm / 60 / (2 * vt_st) : 5) / srate; ax_vp > 1 ? ax_vp -= 1;
    ax_d = (0.006 + 0.005 * ax_vs * slider52 * sin(2 * $pi * ax_vp)) * srate; ax_i = floor(ax_d); ax_f = ax_d - ax_i;
    ax_cl = PSL[(ax_ew - ax_i + CHN) % CHN] * (1 - ax_f) + PSL[(ax_ew - ax_i - 1 + CHN) % CHN] * ax_f;
    ax_cr = PSR[(ax_ew - ax_i + CHN) % CHN] * (1 - ax_f) + PSR[(ax_ew - ax_i - 1 + CHN) % CHN] * ax_f;
    ax_m = min(1, ax_vs * 4) * min(1, slider52 * 4); dq_l += (ax_cl - dq_l) * ax_m; dq_r += (ax_cr - dq_r) * ax_m;
  );
  // DJ filter (sliders 150, 152-154; see mg_proc). (⚪126, user's report and choice 2026-10-10: the bitcrusher won over the
  // cutoff: it made its highs after the filter) after the bitcrusher and the other effects, before the echo (its tail keeps
  // the sound it had, as a mixer's color FX before a beat FX). Its power before / after (fl_pi / fl_po) leaves it out of
  // the level match below (it would have brought back what the cutoff took)
  fl_pi += (dq_l * dq_l + dq_r * dq_r - fl_pi) * lm_k;
  mg_w = max(0, min(1, mg_w + (mg_on ? mg_ws : -mg_ws)));
  mg_w > 0 ? (
    mg_yl = mgl.mg_proc(dq_l, mg_t, mg_m); mg_yr = mgr.mg_proc(dq_r, mg_t, mg_m);
    mg_yl != mg_yl || abs(mg_yl) > 100 ? (mgl.mg_reset(); mg_yl = 0);
    mg_yr != mg_yr || abs(mg_yr) > 100 ? (mgr.mg_reset(); mg_yr = 0);
    dq_l += (mg_yl - dq_l) * mg_w; dq_r += (mg_yr - dq_r) * mg_w;
  );
  fl_po += (dq_l * dq_l + dq_r * dq_r - fl_po) * lm_k;
  // (⚪114, user's report 2026-10-10: a click with the FX ON bar, Trails = echo) the line held silence while off, so the
  // first echo began at once half a beat after the switch, mid-wave: the sound going in now fades in over about 5 ms too
  ax_ewg += ((ax_echo > 0.001) - ax_ewg) * ax_fk;
  ax_es > 0.0005 || ax_ewg > 0.0005 ? (
    ax_el = EDL[(ax_ew - ax_ed + ED_N) % ED_N]; ax_er = EDR[(ax_ew - ax_ed + ED_N) % ED_N];
    EDL[ax_ew % ED_N] = dq_l * ax_ewg + ax_er * ax_fb; EDR[ax_ew % ED_N] = dq_r * ax_ewg + ax_el * ax_fb;   // crossed: it bounces left / right
    dq_l += ax_el * ax_es; dq_r += ax_er * ax_es;
    ax_een += (ax_el * ax_el + ax_er * ax_er - ax_een) * 0.0005;   // ((⚪204) the tail's energy)
  ) : (EDL[ax_ew % ED_N] = 0; EDR[ax_ew % ED_N] = 0; ax_een = 0);
  // (⚪114, user's request 2026-10-10: the echo, the bitcrusher and the stereo effects changed the loudness) the level
  // after them (about 0.2 s) brought back to the level before, -12 .. +6 dB (the echo at 1 was +8.8 dB), as much as the strongest of them is on (1 with
  // all off). In silence the gain is held (an echo's tail after the sound stops is not raised)
  lm_po += (dq_l * dq_l + dq_r * dq_r - lm_po) * lm_k;
  lm_on = min(1, 4 * max(max(max(ax_es, ax_crs), max(max(nx_lw * ax_lna, dk_w * ax_dsc), max(nx_hts, nx_zbs))), max(max(ax_ms, ax_chs), max(ax_vs * slider52, min(1, ax_hds / (0.02 * srate))))));   // ((2026-10-13) + Line art, Halftone, Zoom blur   // ((⚪124) not the fixed-note vibrato: PSOLA keeps the level, and its delay made this raise the starts of sounds)
  lm_on > 0.001 ? (
    lm_pi > 0.0000001 && lm_po > 0.0000001 ? lm_gt = max(0.25, min(2, sqrt(lm_pi * (fl_pi > 0.0000001 ? min(4, fl_po / fl_pi) : 1) / lm_po)));   // ((⚪126) less what the filter took (or gave: resonance)
    lm_g += (lm_gt - lm_g) * lm_gk;
    dq_l *= 1 + (lm_g - 1) * lm_on; dq_r *= 1 + (lm_g - 1) * lm_on;
  ) : (lm_g = lm_gt = 1);
  ax_vhs > 0.001 ? (ax_hs = (rand(2) - 1) * 0.004 * ax_vhs; dq_l += ax_hs; dq_r += ax_hs);   // ((⚪118) VHS's hiss
  // ((⚪162) Disc's crackle: short clicks, 3 .. 60 a second at 1x by the amount's square (user's choice: few at first) (more as the record turns faster, none
  // while it stands), mostly small with a rare loud pop; left / right a little apart
  ax_dsc > 0.001 ? (
    rand(1) < (3 + 57 * ax_dsc * ax_dsc) * min(2, tp_vs) / srate ? dk_ck = (rand(2) - 1) * (0.02 + 0.16 * rand(1) ^ 6) * ax_dsc;
    dq_l += dk_ck; dq_r += dk_ck * 0.75; dk_ck *= 0.7;
  ) : dk_ck = 0;
  ax_gts > 0.0005 ? (
    ax_bpm > 0 ? (ax_p = gb_b(head) * ax_gs) : (ax_tc += (2 + ax_gts * 14) / srate; ax_p = ax_tc);
    ax_gg += ((ax_p - floor(ax_p) >= 0.5 ? 1 - ax_gts : 1) - ax_gg) * 0.01;
    dq_l *= ax_gg; dq_r *= ax_gg;
  ) : ax_gg = 1;
  );   // (⚪169: the end of the full path)
  ax_ew += 1; ax_ew >= 1073741824 ? ax_ew = 0;
  (dq_l != dq_l || dq_r != dq_r) ? nan_reset();   // ((⚪151) see nan_reset)
  spl2 = dq_l;     // before the crossfader (channels 3/4, filmed by the "Rec" track); ((⚪204) the gain is on before the effects)
  spl3 = dq_r;
  spl0 = spl2 * xf_gain * ax_mlv;   // ((2026-10-13) ax_mlv: the helper's master fader)
  spl1 = spl3 * xf_gain * ax_mlv;
  peak = max(peak, max(abs(spl0), abs(spl1)));
  // safety: NaN -> 0, hard limit to 0 dBFS
  spl0 != spl0 ? spl0 = 0;
  spl1 != spl1 ? spl1 = 0;
  spl0 = max(-1, min(1, spl0));
  spl1 = max(-1, min(1, spl1));
  spl2 != spl2 ? spl2 = 0;
  spl3 != spl3 ? spl3 = 0;
  spl2 = max(-1, min(1, spl2));
  spl3 = max(-1, min(1, spl3));

  (posc += 1) >= 128 ? (
    posc = 0;
    // while searching, the position (read by the video sync script) moves only every SEEK_VID s; on release at once
    seek_vn += 128;
    !ui_seek || seek_flush || seek_vn >= SEEK_VID * srate ? (
      slider24 = sw_vpos(head) / fsr; seek_vn = 0; seek_flush = 0; sliderchange(slider24);
    );
    sl_v25 = ui_seek ? 1 : (head - head_last) / fsr / (128 / srate);
    head_last = head;
    sl_v25 != slider25 ? (slider25 = sl_v25; sliderchange(slider25));   // ((⚪169) only when it changed
  );
) : (
  spl0 = spl1 = spl2 = spl3 = 0;
);
// cue (headphones, slider 116): the sound before the crossfader and the volume fader on channels 5/6 while it is on;
// the setup sends them to the "Cue" track (its JSFX mixes in the main sound and goes to the headphones)
pfl_g += min(max(slider116 - pfl_g, -pfl_st), pfl_st);
spl4 = spl2 * pfl_g;
spl5 = spl3 * pfl_g;
// (⚪191) the metronome (see mt_on) on channels 7/8 (the setup sends them to the "Cue" track; its JSFX adds them to the
// headphones whatever its cue mix), and on the main too with mt_main. The clock follows the head while it plays untouched;
// stopped, held or searched it goes on at the deck's BPM (mt_hold 0) or follows the head silently (1). A click when the
// clock comes into a beat (in its first 5 %: a jump onto a beat clicks too, one into the middle of a beat does not);
// the bar's first beat 1500 Hz, the others 1000 Hz, falling away in about 15 ms
mt_act ? (
  mt_lk = slider3 && !tch && !ui_seek;
  mt_nb = mt_lk || mt_hd ? gb_b(head) : mt_b + mt_bps;
  (mt_lk || !mt_hd) && floor(mt_nb) != floor(mt_b) && mt_nb - floor(mt_nb) < 0.05 ? (
    mt_env = 1; mt_ph = 0; mt_f = (floor(mt_nb) - floor(floor(mt_nb) / 4) * 4 == 0 ? 1500 : 1000) / srate;
    mt_gt = time_precise();   // (the corner glows brighter, @gfx)
  );
  mt_b = mt_nb;
);
mt_env > 0.0003 ? (
  mt_c = sin(2 * $pi * mt_ph) * mt_env * mt_amp; mt_ph += mt_f; mt_ph >= 1 ? mt_ph -= 1; mt_env *= mt_dk;
  spl6 = spl7 = mt_c;
  mt_main ? (spl0 = max(-1, min(1, spl0 + mt_c)); spl1 = max(-1, min(1, spl1 + mt_c)));
) : (mt_env = 0; spl6 = spl7 = 0);
// CPU meter: worst block of the last second (% of the block's time) and the average (% of real time)
(pm_n -= 1) == 0 ? (
  pm_dt = time_precise() - pm_t0;
  pm_w = max(pm_w, pm_dt); pm_s += pm_dt; pm_c += samplesblock;
  pm_c >= srate ? (
    slider94 = pm_w / (samplesblock / srate) * 100; slider95 = pm_s / (pm_c / srate) * 100;
    sliderchange(slider94); sliderchange(slider95);
    pm_w = 0; pm_s = 0; pm_c = 0;
  );
);

@serialize
// The state, format version 14: memory cues (count, positions in s; a damaged count clamped), each sample slot's stored
// values (SM +6 .. +15) and memory cues (SMC), hot cues 5-8 of every slot (SMH), the vibrato's interval (⚪123), three
// values once the camera moves' (⚪128; sliders 104-106 since ⚪129: written, read and dropped, to keep the layout), the
// controller settings (CV, ⚪129 / ⚪130), the video FX LFO (⚪135), each video FX's own sound amount (gmem [151 .. 166];
// deck A's read back), the blend kept with a transition (bl_keep) and its on / off (bl_combo), the DEVICE knobs' types.
// ((⚪152, user's choice 2026-10-13: the kit not handed out widely yet) the conversions of versions 1-13 went: the
// projects then had been saved again at 14 first. An older state is not read (the defaults stay; a note says so).
// The loops count with sz_i, not i: @serialize can run beside @sample, whose i it shared (⚪151)
sm_rd = file_avail(0) >= 0;
!sm_rd ? sm_save(sm_cur);                          // writing: the slot in use is stored with its present values
mc_ver = 14; file_var(0, mc_ver);
sm_rd && mc_ver != 14 ? (strcpy(#tt_msg, "saved by an older ReaScratch: its state was not read"); tt_msg_t = time_precise());
!sm_rd || mc_ver == 14 ? (
  sm_rd ? mc_n = 0;
  file_var(0, mc_n);
  mc_n = max(0, min(MC_MAX, floor(mc_n)));
  file_mem(0, MC, mc_n);
  sz_i = 0;
  loop(SM_N,
    file_mem(0, SM + sz_i * 16 + 6, 10);
    SM[sz_i * 16 + 14] = max(0, min(MC_MAX, floor(SM[sz_i * 16 + 14])));
    file_mem(0, SMC + sz_i * 32, SM[sz_i * 16 + 14]);
    sz_i += 1;
  );
  file_mem(0, SMH, SM_N * 4);
  file_var(0, vb_iv); vb_iv = max(0, min(12, floor(vb_iv + 0.5)));
  !sm_rd ? (cm_blur = slider104; cm_over = slider105; cm_shake = slider106);
  file_var(0, cm_blur); file_var(0, cm_over); file_var(0, cm_shake);
  file_mem(0, CV, 257);
  // ((⚪151) a damaged or hand-edited state: each setting kept within its range (cvd), a NaN -> its default
  sm_rd ? (sz_i = 1; loop(256, CV[sz_i] != CV[sz_i] ? CV[sz_i] = CVDF[sz_i];
    CVM[sz_i] && CVHI[sz_i] > CVLO[sz_i] ? CV[sz_i] = max(CVLO[sz_i], min(CVHI[sz_i], CV[sz_i])); sz_i += 1));
  file_var(0, lf_shape); file_var(0, lf_rate); file_var(0, lf_depth);
  sz_i = 1; loop(16, fxs_v = fxs(sz_i); file_var(0, fxs_v); sm_rd && slider76 != 2 ? gmem[150 + sz_i] = 1 - max(0, min(1, fxs_v)); sz_i += 1);
  file_var(0, bl_keep); bl_keep = max(0, min(8, floor(bl_keep + 0.5)));
  file_var(0, bl_combo); bl_combo = bl_combo > 0.5;
  sz_i = 0; loop(8, fk_tyv = fk_ty(sz_i); file_var(0, fk_tyv); fk_tyset(sz_i, fk_tyv); sz_i += 1);
  // ((⚪158) the VHS colour: added at the end of version 14, read only when there (a state saved before has none: the default)
  !sm_rd || file_avail(0) > 0 ? (file_var(0, vhs_col); vhs_col = vhs_col > 0.5);
  !sm_rd || file_avail(0) > 0 ? (file_var(0, vhs_osd); vhs_osd = vhs_osd > 0.5);   // ((⚪160) the same way)
  !sm_rd || file_avail(0) > 0 ? (file_var(0, dk_tone); dk_tone = dk_tone == dk_tone ? max(0, min(1, dk_tone)) : 0);   // ((⚪162) the same way)
  // ((⚪175) each slot's musical key, the same way; a damaged value -> unknown
  !sm_rd || file_avail(0) > 0 ? (file_mem(0, SMY, SM_N); sz_i = 0; loop(SM_N, SMY[sz_i] = SMY[sz_i] == SMY[sz_i] ? max(0, min(48, floor(SMY[sz_i] + 0.5))) : 0; sz_i += 1));
  // ((⚪176) each slot's beat map, the same way: its count, then the pairs; a damaged count -> no map
  sz_i = 0; loop(SM_N, !sm_rd || file_avail(0) > 0 ? (gb_sn = GBM[sz_i * 4096]; file_var(0, gb_sn); gb_sn = gb_sn == gb_sn ? max(0, min(GB_MAX, floor(gb_sn + 0.5))) : 0;
    GBM[sz_i * 4096] = gb_sn; file_mem(0, GBM + sz_i * 4096 + 8, 2 * gb_sn)); sz_i += 1); gb_ci = gb_cj = -1; sm_rd ? gb_l63 = -1;
  // ((⚪185) auto gain on / its target, each slot's loudness and peak, the same way
  !sm_rd || file_avail(0) > 0 ? (file_var(0, ag_on); ag_on = ag_on > 0.5);
  !sm_rd || file_avail(0) > 0 ? (file_var(0, ag_tgt); ag_tgt = ag_tgt == ag_tgt ? max(-24, min(-6, floor(ag_tgt + 0.5))) : -12);
  !sm_rd || file_avail(0) > 0 ? (file_mem(0, SMG, 2 * SM_N); sz_i = 0; loop(2 * SM_N, SMG[sz_i] = SMG[sz_i] == SMG[sz_i] ? max(-80, min(0, SMG[sz_i])) : 0; sz_i += 1));
  // ((⚪189) the preview's two settings (CV [257] / [258], past the 257 kept above), the same way; a state saved before
  // has none: then they come from the preset
  !sm_rd || file_avail(0) > 0 ? (file_mem(0, CV + 257, 2); CV[257] = CV[257] == CV[257] ? max(-1, min(2047, floor(CV[257] + 0.5))) : -1; CV[258] = CV[258] > 0.5)
                             : (CV[257] = -1; CV[258] = 0; pid = p_old(slider1); dk = pid & 1 ? 2 : 1; pid > 0 ? pv_def());
  // ((⚪191) the METRONOME button (CV [259]) and the metronome's settings (see mt_on), the same way; a state saved before
  // has none: the preset's button (⚪192), the metronome off, the defaults
  !sm_rd || file_avail(0) > 0 ? (file_mem(0, CV + 259, 1); CV[259] = CV[259] == CV[259] ? max(-1, min(2047, floor(CV[259] + 0.5))) : -1)
                             : (pid = p_old(slider1); CV[259] = pid > 0 ? pd_v(0, 4) - 1 : -1);   // ((⚪192) the preset's)
  !sm_rd || file_avail(0) > 0 ? (file_var(0, mt_on); file_var(0, mt_mode); file_var(0, mt_out); file_var(0, mt_hold); file_var(0, mt_vol);
                                 mt_on = mt_on > 0.5; mt_mode = mt_mode == mt_mode ? max(0, min(2, floor(mt_mode + 0.5))) : 0;
                                 mt_out = mt_out > 0.5; mt_hold = mt_hold > 0.5; mt_vol = mt_vol == mt_vol ? max(-30, min(0, floor(mt_vol + 0.5))) : -12)
                             : (mt_on = 0; mt_mode = 0; mt_out = 0; mt_hold = 0; mt_vol = -12);
  // ((⚪193) LOAD / LOAD replace on any channel (CV [260] / [261]), the same way; a state saved before has none: the preset's
  !sm_rd || file_avail(0) > 0 ? (file_mem(0, CV + 260, 2); sz_i = 260; loop(2, CV[sz_i] = CV[sz_i] == CV[sz_i] ? max(-1, min(2047, floor(CV[sz_i] + 0.5))) : -1; sz_i += 1))
                             : (CV[260] = CV[261] = -1; pid = p_old(slider1); dk = pid & 1 ? 2 : 1; pid > 0 ? ld_def());
  // a project just opened with a preset: @slider ran the preset before this read (as when the settings were sliders:
  // the preset's values stand over the saved ones); then @block applies them
  sm_rd ? (pr_fresh ? preset_run(); pr_fresh = 0; ap_req = 1);
  // reading (project opened, FX state set, undo): REAPER runs @slider before this, so a change of slider 72 in the state
  // already switched slots using the old stores, and put stale values into the sliders (a re-added FX lost slot 2's hot
  // cue, 2026-10-04). The writer stored the slot in use just before writing, so its store is the truth: put it back in.
  // (⚪97) the head where it was saved (seconds): used once the sample is in. From the slot's store, not slider 24: with a
  // slot other than the first in use (a LOAD into slot 2) the slot switch @slider makes on reading put a stale 0 into
  // slider 24, so the user's REAPER started at the video's black first frame again (⚪100, 2026-10-09)
  sm_rd ? boot_head = sm_cur >= 0 ? SM[sm_cur * 16 + 6] : slider24 >= 0 ? slider24 : -1;
  sm_rd && sm_cur >= 0 ? (sm_restore(sm_cur); len > 0 ? (jump_to(min((boot_head >= 0 ? boot_head : slider4) * fsr, len - 1)); boot_head = -1) : jump_to(0));
);
@gfx 744 340
time_precise() - gq_blk > 0.25 ? gq_run();   // ((⚪151) no @block running: the queued requests here, see gq_push)
// ---------------------------------------------------------------- custom GUI (v5: chamfered knobs, 8-tone shading, light from straight above)
// Front = hardware-style panel (brushed metal frame, spaced caps title, dark panel, silver knobs with an
// LED dot ring, slide switches, dome indicator lamps, thin "schematic" lines between related controls).
// Back ("setup") = plain form like an old Audacity effect dialog (label: value box  min --slider-- max),
// with one colour per group so the function of each block is obvious.
// Every control writes the real slider and sets gui_dirty, so @block re-runs apply_sliders().
// Mouse: knobs drag vertically, form sliders horizontally, both relative; Shift = fine;
// double-click or right-click = default; wheel = step (Shift = 10 steps); switches and menus act on release.
// All GUI variables start with g_ (EEL2 names are case-insensitive and global).

function g_grey(v) ( gfx_r = gfx_g = gfx_b = v; gfx_a = 1; );
function g_hex(h) ( gfx_r = ((h >> 16) & 255) / 255; gfx_g = ((h >> 8) & 255) / 255; gfx_b = (h & 255) / 255; gfx_a = 1; );
function g_led_col() ( slider32 ? g_hex(0x4fb3e0) : g_hex(0xfbd743); );
function g_hc_col(i) ( g_hex(i == 1 ? 0xff6b6b : i == 2 ? 0xffb43d : i == 3 ? 0x3ddc97 : i == 4 ? 0xb18cff :
                              i == 5 ? 0x52b6ff : i == 6 ? 0xff6fc8 : i == 7 ? 0xcfe04a : 0xd9945a); );   // 5-8: sky, pink, lime, copper (⚪36)   // TRACKMENTO night: flare, amber, jade, violet (the pads' colours)
// memory cue mark: a 5-3-1 px triangle pointing down from (x, y), pale silver (the slip line's colour)
function g_mc_tri(x, y) ( g_hex(0xf2f0ec); gfx_rect(x - 2, y, 5, 1); gfx_rect(x - 1, y + 1, 3, 1); gfx_rect(x, y + 2, 1, 1); );   // chalk, as the memory cue buttons
function g_inside(x, y, w, h) ( g_mx >= x && g_mx < x + w && g_my >= y && g_my < y + h; );
// mirrored front (left-handed layout, g_mr): the layout is worked out as deck B's, then g_fl moves a box (x, w wide),
// g_fc a centre and g_dl (after g_dline) a dotted wire to the mirrored place
function g_fl(x, w) ( g_mr ? g_W - x - w : x; );
function g_fc(cx) ( g_mr ? g_W - cx : cx; );
function g_text(str, x, y) ( gfx_x = x; gfx_y = y; gfx_drawstr(str); );
function g_ctext(str, cx, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = floor(cx - tw / 2); gfx_y = y; gfx_drawstr(str); );
function g_rtext(str, xr, y) local(tw, th) ( gfx_measurestr(str, tw, th); gfx_x = xr - tw; gfx_y = y; gfx_drawstr(str); );
function g_bevel(x, y, w, h, inset, lite, dark) (
  g_grey(inset ? dark : lite); gfx_line(x, y, x + w - 1, y); gfx_line(x, y, x, y + h - 1);
  g_grey(inset ? lite : dark); gfx_line(x, y + h - 1, x + w - 1, y + h - 1); gfx_line(x + w - 1, y, x + w - 1, y + h - 1);
);

// ---------------------------------------------------------------- parameter table
function g_rowdef(s) (
  g_kind = 0; g_n = 0; g_min = 0; g_max = 127; g_step = 1; g_def = 0; g_help = "";
  // ((⚪130) the More tab's rows: from the table cvd fills in @init)
  s <= 300 && CVM[s] == 2 ? (g_min = CVLO[s]; g_max = CVHI[s]; g_step = CVST[s]; g_def = CVDF[s]; g_help = CVHL[s]; CVMN[s] ? (g_kind = 1; g_n = CVMN[s])) :
  s == 1  ? (g_kind = 1; g_n = 134; g_help = "Preset: fills the controller settings for a known controller (Custom keeps your values)") :
  s == 230 ? (g_kind = 1; g_n = 134; g_help = "2nd controller: a second controller at the same time (as the Reloop Buddy + APC40 mkII); the video sync sets up its MIDI tracks") :
  s == 3  ? (g_kind = 1; g_n = 2; g_help = "untouched: hand off the jog = stop or play at 1x (the PLAY button)") :
  s == 4  ? (g_max = len > 0 ? (len - 1) / fsr : 600; g_step = 0.001; g_help = "Cue position: where CUE (or the C key) jumps to. Right-click the waveform to set it") :
  s == 5  ? (g_kind = 1; g_n = 2; g_def = 1; g_help = "at end (end / loop): stop (silent when untouched) or loop to the start") :
  s == 6  ? (g_min = 1; g_max = 16; g_def = 2; g_help = "MIDI channel the controller sends on (DJ controllers: deck number)") :
  s == 7  ? (g_def = 34; g_help = "CC number of the jog / knob") :
  s == 8  ? (g_kind = 1; g_n = 9; g_help = "How the jog CC value is read: relative 64 / 2's complement / sign bit, absolute 7 / 14-bit, CDJ speed, Denon platter position, an absolute knob turned (APC40)") :
  s == 9  ? (g_min = 10; g_max = 8000; g_def = 400; g_help = "Jog ticks per second that mean 1x speed. Smaller = the same turn moves faster") :
  s == 10 ? (g_max = 1000; g_step = 10; g_help = "Encoder smoothing: estimate the turn speed of a coarse encoder and glide at it. 0 = direct jog") :
  s == 11 ? (g_min = 0.1; g_max = 100; g_step = 0.1; g_def = 15; g_help = "smooth: how softly the read head follows the jog") :
  s == 12 ? (g_def = 54; g_help = "Platter touch sensor note. 0 = no sensor (touched while turning)") :
  s == 13 ? (g_max = 2000; g_step = 10; g_def = 150; g_help = "No-sensor mode: time after the turn stops until 'hand off'. 0 = hold until the Release button") :
  s == 14 ? (g_def = 33; g_help = "A second CC that moves at 1/4 speed (FLX4 outer ring). 0 = none") :
  s == 15 ? (g_def = 11; g_help = "Note of the button that toggles play / stop when untouched") :
  s == 16 ? (g_def = 12; g_help = "Note of the button that jumps to the cue position") :
  s == 17 ? (g_help = "Note of the button that ends a hold (silence). 0 = none") :
  s == 18 ? (g_min = 10; g_max = 200; g_def = 50; g_help = "grain: length of each grain. Short = gritty / mechanical, long = smooth") :
  s == 19 ? (g_min = 2; g_max = 4; g_step = 2; g_def = 4; g_help = "overlap (x2 / x4): grains played at once. 4 = smooth, 2 = light") :
  s == 20 ? (g_kind = 1; g_n = 2; g_help = "direction: backward = grains forward (words readable) or reversed") :
  s == 21 ? (g_max = 20; g_step = 0.5; g_def = 10; g_help = "wsola: match each grain to the last one's wave (less phasing). 0 = off") :
  s == 22 ? (g_max = 40; g_step = 0.5; g_def = 8; g_help = "jitter: random grain offset while still. Breaks the buzz of a frozen grain") :
  s == 23 ? (g_min = 0.01; g_max = 1; g_step = 0.01; g_def = 0.15; g_help = "jitter off: no jitter while the head moves faster than this") :
  s == 32 ? (g_kind = 1; g_n = 2; g_help = "Colour of the grain ring dots and the read head (the four lamps have their own colours)") :
  s == 33 ? (g_kind = 1; g_n = 3; g_help = "Which side of the crossfader this deck is on (it is cut at the other end). Off = no crossfader") :
  s == 34 ? (g_min = 1; g_max = 16; g_def = 7; g_help = "MIDI channel of the crossfader (FLX4: 7, the mixer channel)") :
  s == 35 ? (g_def = 31; g_help = "CC number of the crossfader (FLX4: 31; a 14-bit fader also sends CC+32)") :
  s == 36 ? (g_max = 20; g_step = 0.1; g_def = 2; g_help = "Cut-in: how far from the closed end the sound starts (lag). Small = cuts in right at the end") :
  s == 40 ? (g_kind = 1; g_n = 2; g_def = 1; g_help = "quantize: while playing, cue / hot cue / memory cue jumps wait for the beat (Q)") :
  s == 63 ? (g_max = 300; g_step = 0.01; g_help = "BPM of the sample (0 = unknown, no quantize). Tap T on the beat while playing, or wheel: 0.1, Shift = 1") :
  s == 64 ? (g_max = len > 0 ? (len - 1) / fsr : 600; g_step = 0.001; g_help = "Beat grid: the time of any beat in the sample (s). Shift+T = here. Wheel: 1 ms, Shift = 10 ms") :
  s == 46 ? (g_max = 16; g_def = 10; g_help = "MIDI channel of the hot cue pads (FLX4 HOT CUE mode: deck 1 = 8, deck 2 = 10). 0 = none") :
  s == 47 ? (g_max = 120; g_help = "Note of pad 1; pads 2-8 are the next seven notes (FLX4: 0, Buddy: 20)") :
  s == 48 ? (g_max = 16; g_def = 11; g_help = "MIDI channel of SHIFT + pad = clear the hot cue (FLX4: deck 1 = 9, deck 2 = 11). 0 = none") :
  s == 53 ? (g_max = 2; g_step = 0.01; g_def = 0.25; g_help = "Spin on release: let go while turning fast = the record keeps spinning and the motor pulls it back (s to lose 1 turn/s). 0 = off") :
  s == 49 ? (g_min = 50; g_max = 2000; g_step = 10; g_def = 300; g_help = "Held longer than this = go back on release (PLAY while holding = keep playing). Shorter = jump and play") :
  s == 52 ? (g_max = 1; g_step = 0.01; g_help = "pitch follows speed: 0 = stays (grains), 1 = tape (held still = silent)") :
  s == 54 ? (g_kind = 1; g_n = 2; g_help = "slip: after a scratch or a held hot cue, go on where playback would be (S)") :
  s == 55 ? (g_max = 16; g_help = "MIDI channel of the memory cue buttons (MEMORY, CALL back, CALL next, DELETE). 0 = none") :
  s == 56 ? (g_max = 124; g_help = "Note of MEMORY (add); CALL back / CALL next / DELETE are the next three notes") :
  s == 57 ? (g_max = 5; g_step = 0.01; g_help = "Brake: PLAY to stop slows the record down to still (s from 1x). 0 = stops at once") :
  s == 58 ? (g_max = 5; g_step = 0.01; g_help = "Start: PLAY to play speeds the record up from still (s to 1x). 0 = plays at once") :
  s == 232 ? (g_max = 4; g_step = 0.25; g_help = "Brake in beats (at this deck's BPM and speed); 0 = the seconds above. 1 = still in one beat") :
  s == 233 ? (g_kind = 1; g_n = 4; g_help = "PAUSE quantize (Quantize on): PLAY to stop waits for the next beat / 8th / 16th, then brakes") :
  s == 59 ? (g_min = 0.5; g_max = 10; g_step = 0.1; g_def = 3; g_help = "Spinback (B key): how fast the record is thrown backward (x)") :
  s == 60 ? (g_min = 0.1; g_max = 5; g_step = 0.01; g_def = 1; g_help = "Spinback: time until it slows to still and stops (s)") :
  s == 61 ? (g_max = 16; g_help = "MIDI channel of the spinback button. 0 = none") :
  s == 62 ? (g_help = "Note of the spinback button") :
  s == 73 ? (g_max = 16; g_help = "MIDI channel of the sample select pads (FLX4 SAMPLER mode: deck 1 = 8, deck 2 = 10). 0 = none") :
  s == 77 ? (g_kind = 1; g_n = 2; g_def = 1; g_help = "Fade curve: linear, or equal power (the middle keeps the loudness; smooth mixes with a wide fade width)") :
  s == 78 ? (g_kind = 1; g_n = 38; g_help = "How deck B's video is laid over deck A's while the crossfader is between the ends; 9-37 = transitions (the crossfader's place = how far; edge = key softness)") :
  s == 301 ? (g_max = 1; g_step = 0.01; g_def = 0.6; g_help = "Camera moves (Punch zoom .. Tilt): motion blur; a turning picture is also smeared along its arc. 0 = none") :
  s == 302 ? (g_max = 2; g_step = 0.01; g_def = 1; g_help = "Camera moves: how far a move goes past its end and comes back (1 = the usual back ease, 0 = none)") :
  s == 316 ? (g_kind = 1; g_n = 2; g_def = 0; g_help = "VHS on-screen text: the deck's PLAY and SP in the picture's top corners while VHS is on (as a VCR shows them)") :
  // ((⚪185) auto gain
  s == 318 ? (g_kind = 1; g_n = 2; g_def = 1; g_help = "Auto gain: each sample is turned up or down to the target loudness (measured on import / LOAD; for samples imported with an older kit, run setup again). Up only as far as its peaks allow") :
  s == 319 ? (g_min = -24; g_max = -6; g_def = -12; g_help = "Auto gain target: the loudness each sample is brought to (LUFS; higher = louder; -12 by default)") :
  // ((⚪191) the metronome (deck A's settings; its on / off is each deck's own with 'Each deck')
  s == 320 ? (g_kind = 1; g_n = 2; g_help = "Metronome: a click on the beats in the headphones (N; the bar's first beat higher). It needs the sample's BPM") :
  s == 321 ? (g_kind = 1; g_n = 3; g_help = "Metronome follows: the playing deck (both playing: the one that started first), the SYNC base deck (the one the other deck's SYNC follows; else the playing deck), or each deck (its own on / off and beats)") :
  s == 322 ? (g_kind = 1; g_n = 2; g_help = "Metronome out: the headphones only (the Cue track), or the headphones and the main output") :
  s == 323 ? (g_kind = 1; g_n = 2; g_help = "Metronome while the deck is stopped or in your hand (scratch, search): keeps time at its BPM, or silent") :
  s == 324 ? (g_min = -30; g_max = 0; g_def = -12; g_help = "Metronome volume (dB; -12 by default)") :
  s == 317 ? (g_max = 1; g_step = 0.01; g_def = 0; g_help = "Disc tone: where the Disc sound's phono EQ ends at the top of the amount (it starts bright). 0 = dark (default; fuller lows, darker highs), 1 = bright (leaner lows, the presence up)") :
  s == 315 ? (g_kind = 1; g_n = 2; g_def = 1; g_help = "VHS colour: the VHS effect's tint. Pink fringes = red and blue fringes alike; Blue-white (default) = weaker reds and a cold blue-white cast over the picture") :
  s >= 307 && s <= 314 ? (g_kind = 1; g_n = 15; g_def = (s == 313 ? 8 : s == 314 ? 11 : s - 306) - 1; g_help = "DEVICE knob (APC40 DEVICE CONTROL 1-8): its video FX type, picture and sound. The DEVICE button and CLIP STOP under it follow (the helper APC40)") :
  s == 304 ? (g_kind = 1; g_n = 5; g_def = 2; g_help = "Video FX LFO: the amounts of this deck's video FX rise and fall with the beat in this shape (Strobe excepted)") :
  s == 305 ? (g_kind = 1; g_n = 6; g_def = 2; g_help = "Video FX LFO: beats a cycle (no BPM: as 120 BPM)") :
  s == 306 ? (g_max = 1; g_step = 0.01; g_def = 0; g_help = "Video FX LFO: how far the amounts fall (0 = off, 1 = down to none). The master's: deck A's") :
  s == 303 ? (g_max = 1; g_step = 0.01; g_def = 0.7; g_help = "Camera moves: the shake (Shake cut, and Drop bounce as it lands), with a colour split") :
  s == 79 ? (g_max = 1; g_step = 0.01; g_def = 0.3; g_help = "Key threshold: luma key = darker than this is see-through; chroma key = how green counts (0.3 = default)") :
  s == 80 ? (g_max = 1; g_step = 0.01; g_def = 0.1; g_help = "Key softness: luma key = width of the soft edge between see-through and solid; wipe / split / blinds / iris / clock transitions = blur of their edge") :
  // ((2026-10-13, user's choice: Navy and Pink were set as the defaults on 2026-10-13 in the user's project only; a new FX
  // and a right-click came back to Black / Lamp colour) the defaults Navy (11) / Pink (14)
  s == 249 || s == 250 ? (g_kind = 1; g_n = 15; g_def = s == 249 ? 11 : 14; g_help = s == 249 ? "Tint: the colour of the darks (the picture's darks .. lights become dark .. light colour)" : "Tint: the colour of the lights (Lamp colour = yellow / blue by the lamp, as before)") :
  s == 82 ? (g_kind = 1; g_n = 16; g_help = "Video FX on this deck's picture (Resolume-style). The amount knob / CC turns it in") :
  s == 83 ? (g_max = 1; g_step = 0.01; g_help = "Video FX amount: 0 = off. Tint / invert / threshold: how much; hue: the turn; others: size / speed") :
  s == 84 ? (g_max = 16; g_def = 7; g_help = "MIDI channel of the video FX knobs (FLX4: 7, the mixer channel). 0 = none") :
  s == 85 ? (g_min = -1; g_def = 23; g_help = "CC of this deck's video FX knob; centre = off, either way = more (FLX4 CFX: 23 / 24). -1 = none") :
  s == 86 ? (g_kind = 1; g_n = 16; g_help = "Video FX on the mixed picture (deck A's setting is used)") :
  s == 87 ? (g_max = 1; g_step = 0.01; g_help = "Master video FX amount: 0 = off") :
  s == 88 ? (g_min = -1; g_def = -1; g_help = "CC of the master video FX amount (0..127), on the video FX channel (Buddy FX knob: 0). -1 = none") :
  s == 102 ? (g_min = -1; g_def = -1; g_help = "Pad mode button note on the deck channel (Buddy: 32). Held + a pad = pick a mode. -1 = no modes") :
  s == 103 ? (g_help = "Note the pad channel sends for the HOT CUE mode while the mode button is held") :
  s == 104 ? (g_help = "Note the pad channel sends for the SAMPLER mode while the mode button is held") :
  s == 120 ? (g_min = 1; g_max = 8; g_def = 8; g_help = "How many pads are hot cues: pad 1 note and the next ones (fewer when the next notes are other buttons)") :
  s == 121 ? (g_min = 1; g_max = 8; g_def = 8; g_help = "How many pads pick a sample: sample 1 note and the next ones (fewer when the next notes are other buttons)") :
  s == 105 ? (g_min = -64; g_max = 64; g_help = "SHIFT+pad = pad note + this, on the SHIFT channel (Buddy: 8). 0 = the same notes (FLX4)") :
  s == 109 ? (g_min = 50; g_max = 75; g_def = 50; g_help = "Swing: the off-beat 16th lands late while playing (on the beat grid). 50 = straight, 67 = triplet") :
  s == 106 ? (g_min = -1; g_def = -1; g_help = "CC of the channel volume fader on the mixer channel (Mixer MIDI channel; 0 = the deck channel): sound and picture (Buddy: 28). -1 = none") :
  s == 89 ? (g_min = -te_rng(); g_max = te_rng(); g_step = 0.01; g_help = "tempo (pitch stays): drag / wheel, right-click = 0 %; keys: see keys") :
  s == 90 ? (g_kind = 1; g_n = 10; g_def = 6; g_help = "Tempo range: what the tempo fader's ends mean (Shift+Y, FLX4 SHIFT+BEAT SYNC). SYNC may go past it up to 50 %") :
  s == 91 ? (g_kind = 1; g_n = 2; g_help = "sync: follow the other deck's BPM and beat (Y). Tempo by hand = off") :
  s == 231 ? (g_kind = 1; g_n = 3; g_help = "REAPER's tempo: SYNC follows REAPER (the SYNC button), or REAPER follows this deck while it plays (louder than the other)") :
  s == 92 ? (g_min = -1; g_max = 128; g_help = "CC of the tempo fader on the deck channel (FLX4: 0; LSB = CC+32; 128 = pitch bend). -1 = none") :
  s == 93 ? (g_def = 88; g_help = "Note of SYNC on the deck channel (FLX4 BEAT SYNC: 88); note + 8 = next tempo range. 0 = none") :
  s == 81 ? (g_kind = 1; g_n = 2; g_help = "Front page: right-handed = record on the right; left-handed = mirrored, record on the left (two decks side by side: records outside)") :
  s == 74 ? (g_max = 120; g_def = 48; g_help = "Note of the pad for sample 1; samples 2-8 are the next seven notes (FLX4 SAMPLER mode: 48)") :
  s == 37 ? (g_max = 100; g_step = 0.5; g_def = 30;   // ((user's choice 2026-10-13) 30 % and Equal power at first (it was 2 % Linear: too sudden)
             g_help = "Fade width: how far the fader travels from silent to full. 0 = instant on / off (scratch cut)");
);
function g_slab(s) (   // long labels for the setup form
  s <= 300 && CVM[s] == 2 ? CVLB[s] : s >= 307 && s <= 314 ? sprintf(#fk_lb, "DEVICE knob %d type:", s - 306) : s == 315 ? "VHS colour:" : s == 320 ? "Metronome:" : s == 321 ? "Metronome follows:" : s == 322 ? "Metronome out:" : s == 323 ? "Stopped / in hand:" : s == 324 ? "Metronome volume:" : s == 316 ? "VHS on-screen text:" : s == 317 ? "Disc tone:" : s == 318 ? "Auto gain:" : s == 319 ? "Auto gain target:" : s == 304 ? "Video FX LFO shape:" : s == 305 ? "Video FX LFO rate:" : s == 306 ? "Video FX LFO depth:" : s == 1 ? "Preset:" : s == 230 ? "2nd controller:" : s == 231 ? "REAPER tempo:" : s == 32 ? "Lamp colour:" : s == 249 ? "Tint dark:" : s == 250 ? "Tint light:" : s == 6 ? "MIDI channel:" : s == 7 ? "Jog CC number:" : s == 8 ? "Jog CC mode:" :
  s == 9 ? "Ticks per second at 1x:" : s == 10 ? "Encoder smoothing (ms):" : s == 12 ? "Touch note:" : s == 13 ? "Auto release (ms):" :
  s == 14 ? "Fine ring CC:" : s == 15 ? "PLAY note:" : s == 16 ? "CUE note:" : s == 17 ? "Release note:" :
