WZ_CTL = "";   // the controller settings a saved preset holds (the sliders the presets set)

function preset(ch, jogcc, mode, tps, fine, touch, rel, play, cue, relnote, enc) (
  CV[6] = ch; CV[7] = jogcc; CV[8] = mode; CV[9] = tps; CV[14] = fine;
  CV[12] = touch; CV[13] = rel; CV[15] = play; CV[16] = cue; CV[17] = relnote; CV[10] = enc;
);
function preset_xf(side, ch, cc) (
  slider33 = side; CV[34] = ch; CV[35] = cc; CV[178] = 127;
  sliderchange(slider33);
);
// APC40 mkII: at the right end its crossfader springs back from 127 to 121-125 and takes seconds to get back (measured
// 2026-10-08, ROADMAP ⚪78); with the default cut-in deck 1 stayed about 97 % open there. 120 and above = the end
function preset_xf_end(v) ( CV[178] = v; );
function preset_pad(ch, note, sch) (
  CV[46] = ch; CV[47] = note; CV[48] = sch;
);
function preset_sm(ch, note) ( CV[73] = ch; CV[74] = note; );
function preset_vfx(ch, cc) ( slider84 = ch; slider85 = cc; sliderchange(slider84); sliderchange(slider85); );
function preset_te(cc, note) ( CV[92] = cc; CV[93] = note; );
// channel fader CC (slider 106) and headphone CUE note (117), both on the deck channel (-1 = none); after preset_bd
function preset_mx(vol, cue) ( CV[106] = vol; CV[117] = cue; );
// tempo range note (slider 101), tempo fader direction (119), SHIFT+pad note offset (105)
function preset_rd(range, dir, shoff) (
  CV[101] = range; CV[119] = dir; CV[105] = shoff;
);
// how many pads are hot cues (slider 120) / pick a sample (121); every preset starts from 8, 8
function preset_n(hc, smn) ( CV[120] = hc; CV[121] = smn; );   // ((⚪150) not "sm": that is SM, the slots table)
// hot cues 5-8 on a second row of pads (slider 180: its note offset, 0 = none) and a SHIFT button (181: held = a hot
// cue pad clears; -1 = none). APC40 (⚪89, user's choice 2026-10-08): the top row of the clip grid = 5-8, SHIFT + pad = clear
function preset_hc2(off, sh) ( CV[180] = off; CV[181] = sh; );
// the lights (⚪77): type (slider 135, 0 = none) and the on value of one-colour lights / buttons (136)
function preset_lt(t, on) ( CV[135] = t; CV[136] = on; );
function preset_tz(z) ( CV[137] = z; );   // the tempo fader's centre zone (%)
// (⚪112) the units not tried get the Buddy's / APC40's functions (user's choices 2026-10-09). pk_s: the pad modes' layout
// (slider 234), SHIFT (note, channel), SHIFT + jog CC, SHIFT + headphone CUE (the picture mute; mixer channel). pk_f: the
// knobs as the Buddy's: HI = morph, LOW = resonance (mixer channel), MID = the sound of the video FX ((channel - 1) * 128 +
// CC), the filter knob = cutoff (on channel cch; 0 = the mixer channel). pk_l: loop on / off (deck channel), reloop, half,
// double. pk_x: the FX unit on channel ch: on / off note, SHIFT + it (this deck's effects off while held), its level knob
// (this deck's amount, 0 = off), BEAT < > on channel bch (both decks' amount), SHIFT + BEAT < > (the master's), a knob on
// ch for the master's amount. pk_b: the browser section. -1 = none
function pk_s(lay, sh, shc, shjog, pic) (
  CV[234] = lay; CV[181] = shc == CV[6] ? sh : -1; CV[226] = sh >= 0 ? (shc - 1) * 128 + sh : -1; CV[228] = shjog; CV[229] = pic;
);
function pk_f(hi, low, mid, cut, cch) ( CV[155] = hi; CV[156] = low; CV[210] = mid; CV[157] = cut; CV[235] = cch; );
function pk_l(on, rel, half, dbl) ( CV[144] = on >= 0 ? CV[6] : 0; CV[145] = -1; CV[146] = on; CV[147] = -1; CV[148] = rel; CV[184] = half; CV[185] = dbl; );
function pk_x(ch, on, onsh, lvl, bch, dn, up, dnsh, upsh, mlvl) (
  slider84 = ch; CV[107] = on; CV[225] = onsh >= 0 ? (ch - 1) * 128 + onsh : -1; slider85 = lvl; CV[131] = lvl >= 0; CV[88] = mlvl;
  CV[159] = dn >= 0 ? (bch - 1) * 128 + dn : -1; CV[160] = up >= 0 ? (bch - 1) * 128 + up : -1;   // (bch: the BEAT buttons' channel)
  CV[161] = dnsh >= 0 ? (bch - 1) * 128 + dnsh : -1; CV[162] = upsh >= 0 ? (bch - 1) * 128 + upsh : -1;
);
function pk_b(ch, cc, push, ccsh, pushsh, ld, ldsh) (
  CV[165] = ch; CV[166] = cc; CV[167] = push; CV[168] = ccsh; CV[169] = pushsh; CV[170] = ld; CV[171] = ldsh;
);
// (⚪141, user's choice 2026-10-13: the Buddy's FX section on the units not tried) slider 247 on, after pk_x / pk_b: kn = the FX
// unit's level knob (on the video FX channel) = the Buddy's FX knob (nothing held = the transition's softness, the unit's
// SHIFT held = the master's amount, the FX ON button on = that deck's amount), BEAT < > = FX PARAM < >, BROWSE = the sound
function pk_bud(kn) ( CV[247] = 1; CV[163] = kn; CV[164] = -1; CV[248] = CV[166]; CV[166] = -1; slider85 = -1; CV[88] == kn ? CV[88] = -1; );
function dkv(a, b) ( dk == 1 ? a : b; );   // deck 1's or deck 2's value (both decks on one channel, other numbers)
// APC40 (⚪90 / ⚪91; sliders 182-194): the pad mode buttons, video FX on / off, loop half / double, the filter knobs'
// channel, the pitch mode / video opacity / grain length faders, crossfader assign, mute, slots, REAPER metronome /
// record. Every other preset: none
function preset_apc2(md, lp, lh, ld, fk) (
  CV[182] = md; CV[183] = lp; CV[184] = lh; CV[185] = ld; CV[186] = fk;
);
// (⚪101) sample pads scroll back / on, auto loop notes, knob page notes, master FX type note, effects-off note
function preset_apc4(sb, so, al, kp, mf, ko) (
  CV[222] = sb >= 0 ? dkv(2, 6) : 0;   // (⚪102) CLIP STOP 2-4 / 6-8
  CV[211] = sb; CV[212] = so; CV[213] = al; CV[214] = kp; CV[215] = mf; CV[216] = ko;
);
function preset_apc3(fp, fo, fg, xa, mu, sl, mt, rc) (
  CV[187] = fp; CV[188] = fo; CV[189] = fg; CV[190] = xa; CV[191] = mu; CV[192] = sl; CV[193] = mt; CV[194] = rc;
);
// APC40 mkII / mkI (⚪90 / ⚪91, user's choices 2026-10-08): DEVICE buttons 58-65 = the pad modes of the selected deck (on
// the two hot cue rows), CLIP STOP 1 / 2 = the video FX on / off (SHIFT: reloop), LEFT / RIGHT 97 / 96 = the loop half /
// double (SHIFT: move it), TRACK KNOBs 1-4 / 5-8 (CC 48-51 / 52-55) = deck A / B video FX amount, filter morph,
// resonance, cutoff. Deck A = columns 1-4, deck B = 5-8 (user's request 2026-10-08): the track buttons of column 1 / 5,
// REC ARM = LOAD (SHIFT: replace), SHIFT + PLAY = back to the CUE, TRACK FADERs 1-4 / 5-8 = volume, pitch mode, video
// opacity, grain length, CROSSFADER A/B = the side (mkII), ACTIVATOR = mute, UP / DOWN = the
// slot before / after, METRONOME / SESSION = REAPER's metronome / record (mkII)
function preset_apc_buddy(mk2) (
  // (⚪101, user's choices 2026-10-09) ▲ / ▼ = the loop double / half (SHIFT: on / back; they were LEFT / RIGHT), LEFT /
  // RIGHT = the sample pads one slot back / on, SCENE LAUNCH 1-4 = auto loop 1 / 2 / 4 / 8 beats (they were the samples 5-8),
  // PAN / SENDS / USER = the TRACK KNOBs' pages, MASTER = the master video FX type (the master fader its amount), BANK
  // held = every effect off (mkI: no BANK; its PAN / SEND A / SEND B are the pages)
  preset_apc2(58, 52, 95, 94, 1);
  // (⚪105, user's choices 2026-10-09) METRONOME = the video blend in turn (not REAPER's metronome), STOP ALL CLIPS (mkI STOP) =
  // the tempo range (not a stop: PLAY stops), SHIFT + PLAY = both decks play / stop together
  preset_apc3(dkv(1, 5) * 128 + 7, dkv(2, 6) * 128 + 7, dkv(3, 7) * 128 + 7, mk2 ? 66 : -1, 50, -1, -1, mk2 ? 102 : -1);
  CV[227] = mk2 ? 90 : -1;
  CV[128] = -1; CV[101] = mk2 ? 81 : 92;
  preset_apc4(97, 96, 82, 87, 80, mk2 ? 103 : -1);
  CV[155] = dkv(49, 53); CV[156] = dkv(50, 54); CV[157] = dkv(51, 55); CV[165] = dkv(1, 5); CV[170] = 48; CV[208] = 16; CV[210] = dkv(0, 4) * 128 + 7;
);
// APC40 (⚪76; sliders 122-135): mixer channel, deck select, tempo encoder, nudge - / +, tap, stop, samples 5-8, cue mix
// encoder, video FX knob type, extra buttons channel / note, pad layout, lights. Every other preset: none
function preset_apc(mch, sel, tenc, nm, np, tap, stp, s58, cmx, vt, xch, xn, lay, led) (
  CV[122] = mch; CV[123] = sel; CV[124] = tenc; CV[125] = nm; CV[126] = np; CV[127] = tap; CV[128] = stp;
  CV[129] = s58; CV[130] = cmx; CV[131] = vt; CV[132] = xch; CV[133] = xn; CV[134] = lay; CV[135] = led;
);
// the Buddy settings (100-107); every other preset puts them back to their defaults
function preset_bd(on, deck) (
  CV[100] = on; CV[101] = on ? 3 : -1; CV[102] = on ? 32 : -1; CV[103] = on ? BD_HC : 0; CV[104] = on ? BD_SM : 0;
  CV[105] = on ? 8 : 0; CV[106] = on ? 28 : -1; CV[107] = on ? 0 : -1; CV[117] = on ? 27 : -1;
  on ? (CV[88] = -1);   // (the FX knob, CC 0, picks the master FX's type: slider 163, since 2026-10-08)
);

// DJ filter (sliders 150, 152-154) on this deck's sound, before the fader, the crossfader and the cue (⚪78; knob CCs
// 155-157 on the mixer channel). On the Buddy, as FM Filter 2's knobs (user's choice 2026-10-08, after a DJ EQ on HIGH / LOW
// sounded weak): FILTER = cutoff, HIGH = morph, LOW = resonance.
// Cutoff: centre = off (a 10 ms fade in / out); left of centre the cutoff goes from 12 kHz down to 100 Hz, right of centre
// from 25 Hz up to 6 kHz. Morph (FM Filter 2's: 0 low pass, 0.25 band pass, 0.5 high pass, 0.75 notch / band reject, 1 =
// low pass again): left of centre it starts at 0, right of centre at 0.5, plus the morph knob (-0.5 .. 0.5); so with
// the morph knob at its centre: low pass left, high pass right. The filter models are ported from Saike FM Filter 2 (MIT License, Copyright (c) 2022 Joep
// Vanlier; the full text: LICENSE_Saike_filters.txt next to this file; the models chosen by the user, 2026-10-07 / 08), from
// its Saike_Yutani_filters.jsfx-inc:
//   Moog (4-pole) / Ladder (2-pole) = init_moog / eval_moog / mix_moog, init_moog2 / eval_moog2 / mix_moog2 (the Moog model
//     after S. D'Angelo and V. Valimaki, "Generalized Moog Ladder Filter: Part II - Explicit Non linear Model through a
//     Novel Delay-Free Loop Implementation Method", IEEE TASLP 22(12), 2014),
//   Steiner = init_steiner / eval_steiner, Pillow = "Pill2p" (eval_steiner_rav, resonance halved),
//   Rect = init_rectpeak / eval_rectpeak (on init_linearSVF_all / eval_linearSVF_All; in place of Shriek2p, user's choice
//     2026-10-08), Shriek4p = init_svf2 / eval_svf2 (no resonance) into eval_svf2b,
//   MS-20 = init_MS20 / eval_MS20_nonlin_tanh, ..BP_tanh, ..HP_tanh, ..BR_tanh / processSample_ms20 (the morph blends two),
//   nlSVF = "nlSVF2p" (init_SVF_nonlin / eval_SVF_nonlin) (MS-20 and nlSVF added at the user's request 2026-10-08).
// Not FM Filter 2's 303 model (Dominique Wurtz's copyright). As in FM Filter 2 they run at 2x (the input interpolated;
// on the way down the elliptic_2x of Saike's protosynth, also MIT), with the drive at 0 dB. Changes: cutoff in Hz from
// the one knob and the morph's side, Moog / Ladder's output sign flipped (theirs comes out inverted), the
// Steiner state curve s|s|/(|s|(1+|s|)) written as s/(1+|s|) (the same, without 0/0), a DC blocker after the filter
// (Shriek's curve is asymmetric), NaN -> reset.
function mg_th(x) ( 2 / (1 + exp(-2 * x)) - 1; );
function mg_gh(s) ( s / (1 + abs(0.25 * s)); );
function mg_dgh(s) ( 1 / (1 + 0.5 * abs(s) + 0.0625 * s * s); );
function mg_c(x) ( 1.25 * x + 3.75 * x * x / (1 + abs(5 * x)); );
function mg_dc(x) local(ax) ( ax = 1 / (5 * abs(x) + 1); 7.5 * x * ax - 18.75 * x * x * sign(x) * ax * ax + 1.25; );
function mg_f(s) ( 2.4 * s / (1 + abs(6 * s)) + 0.6 * s; );
// Moog (four = 1) / Ladder (four = 0)
function mg_lad_init(fc, res, four) local(g, p0s, nmp, gn, kgn, p0g, tmp, acc)
  instance(rg1, rg2, rg3, rg4, qg1, qg2, qg3, qg4, k0g, k0s, q0s, r1s, k) (
  four ? (k = res * 3.9999999999999987; g = tan($pi * fc / (2 * srate)) / sqrt(1 + sqrt(k) - 2 * pow(k, 0.25) * 0.7071067811865476))
       : (k = res * 120; g = tan($pi * fc / (2 * srate)) / sqrt(1 + k));
  p0s = 1 / (1 + g); q0s = 1 - g; r1s = -g; k0s = 0.052 * g * p0s;
  nmp = 1 - p0s; gn = four ? sqr(sqr(nmp)) : sqr(nmp);
  kgn = k * gn; p0g = 1 / (1 + kgn); k0g = -19.23076923076923 * p0g;
  acc = tmp = p0s * (g - 1);
  four ? (
    rg1 = rg3 = -4 * kgn; rg2 = -6 * kgn; rg4 = -kgn;
    qg1 = -4 * (kgn + acc); acc *= tmp; qg2 = -6 * (kgn + acc); acc *= tmp; qg3 = -4 * (kgn + acc); acc *= tmp; qg4 = -(kgn + acc);
  ) : (
    rg1 = -2 * kgn; rg2 = -kgn; qg1 = -2 * (kgn + acc); acc *= tmp; qg2 = -(kgn + acc);
  );
);
// ch = the morph's quarter (0 low -> band pass, 1 band -> high pass, 2 high pass -> notch, 3 notch -> low pass), fr = how far
function mg_lad(x, four, ch, fr) local(yi, yd, y, yo, a, b, c, d, lp, bp, hp, br, f1, f2)
  instance(rg1, rg2, rg3, rg4, qg1, qg2, qg3, qg4, k0g, k0s, q0s, r1s, k, si1, si2, si3, si4, sf1, sf2, sf3, sf4, sg1, sg2, sg3, sg4) (
  x *= 0.052;
  yo = mg_th(k0g * (x + sg1)); a = yo;
  yi = yo; yd = k0s * (yi + sf1); y = yd + si1; yo = mg_th(19.23076923076923 * y); b = yo; si1 = yd + y; sf1 = r1s * yi - q0s * yo;
  yi = yo; yd = k0s * (yi + sf2); y = yd + si2; yo = mg_th(19.23076923076923 * y); c = yo; si2 = yd + y; sf2 = r1s * yi - q0s * yo;
  four ? (
    yi = yo; yd = k0s * (yi + sf3); y = yd + si3; yo = mg_th(19.23076923076923 * y); d = yo; si3 = yd + y; sf3 = r1s * yi - q0s * yo;
    yi = yo; yd = k0s * (yi + sf4); y = yd + si4; yo = mg_th(19.23076923076923 * y); si4 = yd + y; sf4 = r1s * yi - q0s * yo;
    sg1 = rg1 * x + qg1 * k * y + sg2; sg2 = rg2 * x + qg2 * k * y + sg3; sg3 = rg3 * x + qg3 * k * y + sg4; sg4 = rg4 * x + qg4 * k * y;
    lp = y * (1 + k) * 19.23076923076923; bp = 2 * c - 2 * b; hp = a - 4 * b + 6 * c - 4 * d + yo; br = a - 4 * b + 6 * c - 4 * d;
  ) : (
    sg1 = rg1 * x + qg1 * k * y + sg2; sg2 = rg2 * x + qg2 * k * y;
    lp = y * (1 + k) * 19.23076923076923; bp = (2 * b - 2 * yo) * 8; hp = a - b; br = -(2 * b - yo * (2 + k) - a);
  );
  ch == 0 ? (f1 = lp; f2 = bp) : ch == 1 ? (f1 = bp; f2 = hp) : ch == 2 ? (fr = sqr(sqr(fr)); f1 = hp; f2 = br) : (f1 = br; f2 = lp);
  -(f2 * fr + f1 * (1 - fr));
);
// Steiner (rav = 0) / Pillow (rav = 1)
function mg_st_init(fc, res, m) instance(h, kk, nc, lp, bp, hpm) (
  h = tan($pi * fc / (2 * srate)); kk = 3.98 * res; nc = 1 / (-kk * h + h * h + 2 * h + 1);
  m < 0.25 ? (lp = 1 - m * 4; bp = m * 4; hpm = 0) :
  m < 0.5 ? (hpm = (m - 0.25) * 4; bp = 1 - (m - 0.25) * 4; lp = 0) :
  m < 0.75 ? (hpm = 1; bp = -2 * (m - 0.5) * 4; lp = (m - 0.5) * 4) :
  (hpm = 1 - (m - 0.75) * 4; bp = -2 * (1 - (m - 0.75) * 4); lp = 1);
);
function mg_st(xn, rav) local(xx, v1n, v2n, kp1, fb, s1f, s2f, it, fs1, fc, s1, s2, f1, f2, a, b, c, d, nm, ds1, ds2)
  instance(x, v1, v2, h, kk, nc, lp, bp, hpm) (
  kp1 = kk + 1;
  rav ? (
    v1n = v1; v2n = v2;
    fb = mg_gh(kp1 * (hpm * x + v1));
    s1f = 2 * bp * x - hpm * x - v1 + v2 + fb - hpm * xn;
    s2f = -4 * bp * x + hpm * x - 2 * (v2 + fb) + v1 + lp * x + hpm * xn + lp * xn;
  ) : (
    xx = x + xn;
    v1n = (-kk * h * v1 + (bp - hpm) * h * xx + h * h * ((lp - hpm) * xx - v1) + 2 * h * v2 + v1) * nc;
    v2n = (kk * h * ((bp - hpm) * xx + v2 - 2 * v1) + (lp - bp) * h * h * xx + (lp - bp) * h * xx - h * h * v2 + v2) * nc;
    fb = max(-1, min(1, kp1 * (hpm * x + v1)));
    s1f = 2 * bp * x - hpm * x - v1 + v2 + fb;
    s2f = -4 * bp * x + hpm * x - 2 * (v2 + fb) + v1 + lp * x;
  );
  it = 0;
  while (
    it += 1;
    fs1 = kp1 * (hpm * xn + v1n);
    rav ? (
      fc = mg_gh(fs1);
      s1 = s1f - v1n + v2n + fc; s2 = s2f + v1n - 2 * (v2n + fc);
      ds1 = 1 / sqr(1 + abs(s1)); ds2 = 1 / sqr(1 + abs(s2));
      s1 = s1 / (1 + abs(s1)); s2 = s2 / (1 + abs(s2));
      d = mg_dgh(fs1);
      a = h * (kp1 * d - 1) * ds1 - 1; b = h * ds1; c = h * (1 - 2 * kp1 * d) * ds2; d = -2 * h * ds2 - 1;
    ) : (
      fc = max(-1, min(1, fs1));
      s1 = s1f - hpm * xn - v1n + v2n + fc; s2 = s2f + hpm * xn + lp * xn + v1n - 2 * (v2n + fc);
      d = abs(fs1) > 1 ? 0 : 1;
      a = h * (kp1 * d - 1) - 1; b = h; c = h * (1 - 2 * kp1 * d); d = -2 * h - 1;
    );
    f1 = v1 - v1n + h * s1; f2 = v2 - v2n + h * s2;
    nm = 1 / (a * d - b * c);
    v1n -= (d * f1 - b * f2) * nm; v2n -= (a * f2 - c * f1) * nm;
    abs(f1) + abs(f2) > 0.00000001 && it < 26;
  );
  x = xn; v1 = v1n; v2 = v2n;
  v1n + hpm * xn;
);
// Shriek: one 2-pole stage (b = 0: eval_svf2; b = 1: eval_svf2b, Shriek4p's second stage). kd = k - k_factor with the
// drive at 0 dB (FM Filter 2's preamp = 1)
function mg_sh_init(fc, res, m) local(r) instance(wc, kk, kd, mo0, mo1, mo2) (
  wc = tan($pi * fc / (2 * srate)); kk = 0.999 - res + 0.01; kd = kk - (1 + (1 - kk) * 0.2);
  m < 0.25 ? (mo0 = 0; mo1 = 8 * m; mo2 = 1 - 4 * m) :
  m < 0.5 ? (r = m - 0.25; mo0 = r * 4; mo1 = 2 - r * 8; mo2 = -r * 4) :
  m < 0.75 ? (r = m - 0.5; mo0 = 1; mo1 = -r * 8; mo2 = -1 + r * 4) :
  (r = m - 0.75; mo0 = 1 - r * 4; mo1 = r * 8 - 2; mo2 = r * 4);
);
function mg_sh(v0, b) local(f1c, f2c, it, dg, ct, f1, f2, a, c, t, nm, r, s3, dn)
  instance(wc, kk, kd, mo0, mo1, mo2, v0n, v1, v2, g1) (
  v0 *= 3;
  f1c = wc * mg_c(v0n - v2 - 2 * (v1 + (b ? g1 * kd : mg_f(g1 * kd)))) + v1;
  f2c = wc * g1 + v2;
  v0n = v0;
  it = 0;
  while (
    it += 1;
    b ? (
      s3 = v1 * v1 * v1; g1 = (s3 + v1) / (1 + abs(s3 + 5 * v1));
      dn = abs(s3 + 5 * v1) + 1;
      dg = (3 * v1 * v1 + 1) / dn - (3 * v1 * v1 + 5) * (s3 + v1) * sign(s3 + 5 * v1) / sqr(dn + 1);
      ct = v0 - v2 - 2 * (v1 + g1 * kd);
      a = -2 * wc * ((kk - 1) * dg * kd * g1 + 1) * mg_dc(ct) - 1;
    ) : (
      g1 = v1 / (1 + abs(v1)); dg = 1 / sqr(1 + abs(v1));
      ct = v0 - v2 - 2 * (v1 + mg_f(g1 * kd));
      t = 3 * kd * g1;
      a = -2 * wc * ((kk - 1) * dg * (0.8 / (4 * t * t + 4 * abs(t) + 1) + 0.2) + 1) * mg_dc(ct) - 1;
    );
    f1 = wc * mg_c(ct) - v1 + f1c; f2 = wc * g1 - v2 + f2c;
    c = wc * dg;
    r = abs(f1) + abs(f2);
    nm = 1 / (-a + wc * c);   // a d - b c with b = -wc, d = -1
    v1 -= (-f1 + wc * f2) * nm; v2 -= (a * f2 - c * f1) * nm;
    r > 0.00000001 && it < 26;
  );
  0.33333 * (mo0 * v0 + mo1 * v1 + mo2 * v2);
);
function mg_sh_reset() instance(v0n, v1, v2, g1) ( v0n = v1 = v2 = g1 = 0; );
// Rect: a linear state variable filter (morph as FM Filter 2's) ...
function mg_lsv_init(fc, res, m) local(g, fr) instance(k, a1, a2, a3, m0, m1, m2) (
  g = tan($pi * fc / (2 * srate)); k = 2 - 2 * res; a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  m *= 4; fr = m - floor(m);
  m < 1 ? (m0 = 0; m1 = fr; m2 = 1 - fr) :
  m < 2 ? (m0 = fr; m1 = (1 - fr) - k * fr; m2 = -fr) :
  m < 3 ? (m0 = 1; m1 = -k * (1 - fr) - fr; m2 = -(1 - fr)) :
  (m0 = 1 - fr; m1 = -(1 - fr); m2 = fr);
);
function mg_lsv(v0) local(v1, v2, v3) instance(ic1eq, ic2eq, a1, a2, a3, m0, m1, m2) (
  v3 = v0 - ic2eq; v1 = a1 * ic1eq + a2 * v3; v2 = ic2eq + a2 * ic1eq + a3 * v3;
  ic1eq = 2 * v1 - ic1eq; ic2eq = 2 * v2 - ic2eq;
  m0 * v0 + m1 * v1 + m2 * v2;
);
function mg_lsv_reset() instance(ic1eq, ic2eq) ( ic1eq = ic2eq = 0; );
// ... and Rect itself: two resonant ones an octave down against one, the difference rectified, through one at the cutoff
// (the original copies the resonant one's coefficients into its "none" too: so here)
function mg_rect_init(fc, res, m) local(fl) (
  fl = max(20, fc / 2); res = max(0, min(0.92, res));
  this.ra.mg_lsv_init(fl, res, m); this.rb.mg_lsv_init(fl, res, m); this.rn.mg_lsv_init(fl, res, m); this.ro.mg_lsv_init(fc, 0, m);
);
function mg_rect(x) local(base, peak) (
  base = this.rn.mg_lsv(x); peak = this.rb.mg_lsv(this.ra.mg_lsv(x));
  this.ro.mg_lsv(base + mg_th(abs(peak - base)));
);
// MS-20: one of its four filters (mode 0 low pass, 1 band pass, 2 high pass, 3 band reject), each with its own state
function mg_ms_init(fc, res) local(sf) instance(hh, k) (
  sf = 2 * srate / 44100; hh = 0.5 * tan(2 * $pi * fc / (2 * srate) / (2.1 * sf)) * 2.1 * sf; k = 2 * res;
);
function mg_ms(x, mode) local(kc, gd, t1, t2, it, kx, g, dg, s1, s2, a1, a2, m1, m2, f1, f2, r, a, b, c, d, nm)
  instance(y1, y2, d1, d2, hh, k) (
  kc = mode == 1 ? 0.95 * k : mode == 2 ? 0.85 * k : k;
  mode == 2 ? (gd = max(-1, min(1, kc * (d2 + x))); t1 = mg_th(-d1 - gd); t2 = mg_th(d1 - d2 - x + gd)) : (
    gd = max(-1, min(1, d2 * kc));
    mode == 0 ? (t1 = mg_th(-d1 + x - gd); t2 = mg_th(d1 - d2 + gd)) : (t1 = mg_th(-d1 - x - gd); t2 = mg_th(d1 - d2 + x + gd));
  );
  it = 0;
  while (
    it += 1;
    kx = mode == 2 ? kc * (x + y2) : kc * y2; g = max(-1, min(1, kx)); dg = abs(kx) > 1 ? 0 : 1;
    mode == 0 ? (s1 = x - y1 - g; s2 = y1 - y2 + g) : mode == 2 ? (s1 = -y1 - g; s2 = -x + y1 - y2 + g) : (s1 = -x - y1 - g; s2 = x + y1 - y2 + g);
    a1 = mg_th(s1); a2 = mg_th(s2);
    m1 = (a1 * a1 - 1) * (mode == 2 ? 1 : hh); m2 = (a2 * a2 - 1) * (mode == 2 ? 1 : hh);   // (the high pass's as in the original)
    f1 = y1 - d1 - hh * (t1 + a1); f2 = y2 - d2 - hh * (t2 + a2); r = abs(f1) + abs(f2);
    a = 1 - m1; b = -kc * m1 * dg; c = m2; d = (kc * dg - 1) * m2 + 1;
    nm = 1 / (a * d - b * c); y1 -= (d * f1 - b * f2) * nm; y2 -= (a * f2 - c * f1) * nm;
    r > 0.00000001 && it < 6;
  );
  d1 = y1; d2 = y2;
  mode == 3 ? x - y2 : mode == 2 ? y2 + x : y2;
);
function mg_ms_reset() instance(y1, y2, d1, d2) ( y1 = y2 = d1 = d2 = 0; );
function mg_ms4(x, mode) (
  mode == 0 ? this.ml.mg_ms(x, 0) : mode == 1 ? this.mb.mg_ms(x, 1) : mode == 2 ? this.mh.mg_ms(x, 2) : this.mr.mg_ms(x, 3);
);
// nlSVF (2-pole)
function mg_nl_init(fc, res, m) instance(h, k, hh, h2, k2h, den, mo0, mo1, mo2) (
  h = tan($pi * fc / (2 * srate)); k = 0.999 - res + 0.01; hh = h * h; h2 = 2 * h; k2h = h2 * k; den = 1 / (hh + k2h + 1);
  m < 0.25 ? (mo0 = 0; mo1 = 16 * m; mo2 = 4 - 16 * m) :
  m < 0.5 ? (mo0 = 16 * m - 4; mo1 = 4 * (2 * k - 1) * (4 * m - 1) + 4; mo2 = 4 - 16 * m) :
  m < 0.75 ? (mo0 = 4; mo1 = 8 * k - 4 * (2 * k + 1) * (4 * m - 2); mo2 = 16 * m - 12) :
  (mo0 = 16 - 16 * m; mo1 = 16 * m - 16; mo2 = 16 * m - 12);
);
function mg_nl(x) local(it, y1, y2, yd, fb, c1, mul, a1, a2, f1, f2, r, da1, a, b, c, nm)
  instance(d0, d1, d2, h, k, hh, h2, k2h, den, mo0, mo1, mo2) (
  x *= 0.05;
  y1 = (d0 * h - d1 * hh - d1 * k2h + d1 - d2 * h2 + h * x) * den;
  y2 = (d0 * hh + d1 * h2 - d2 * hh + d2 * k2h + d2 + hh * x) * den;
  it = 0;
  while (
    it += 1;
    yd = y1 + d1; fb = 2 * k * yd;
    c1 = x + d0 - (y2 + d2) - (fb > 0 ? min(1, fb) : max(-1, fb * 0.25));
    mul = c1 < 0 ? 1.01 : 0.96;
    a1 = mg_th(mul * c1); a2 = mg_th(yd);
    f1 = y1 - d1 - h * a1; f2 = y2 - d2 - h * a2; r = abs(f1) + abs(f2);
    da1 = mul * (1 - a1 * a1);
    a = 1 + k2h * da1 * (fb > 0 ? (fb > 1 ? 0 : 1) : (fb < -4 ? 0 : 0.25));
    b = h * da1; c = -h * (1 - a2 * a2);
    nm = 1 / (a - b * c); y1 -= (f1 - b * f2) * nm; y2 -= (a * f2 - c * f1) * nm;
    r > 0.00000001 && it < 26;
  );
  d0 = x; d1 = y1; d2 = y2;
  (mo0 * x + mo1 * y1 + mo2 * y2) * 5;
);
function mg_nl_reset() instance(d0, d1, d2) ( d0 = d1 = d2 = 0; );
function mg_ell(x) instance(e1, e2, e3, e4, e5, e6, ey) (
  ey = 0.03851260969347568 * x + e1;
  e1 = 0.07917433005447011 * x + 1.8465480149702582 * ey + e2;
  e2 = 0.1448318280102846 * x - 3.085415375328384 * ey + e3;
  e3 = 0.15947402363472882 * x + 2.9173159325651126 * ey + e4;
  e4 = 0.14483182801028455 * x - 2.1600701985167765 * ey + e5;
  e5 = 0.07917433005447012 * x + 0.9894349416880517 * ey + e6;
  e6 = 0.038512609693475676 * x - 0.27584791692890615 * ey;
  ey;
);
// type t: 0 Moog, 1 Ladder, 2 Steiner, 3 Pillow, 4 Rect, 5 Shriek4p, 6 MS-20, 7 nlSVF. FILTER TYPE pad k (0-7) -> its type: pads
// 1 and 8 = nlSVF and Moog (swapped, user's choice 2026-10-08), the others in order
function mg_pad(k) ( k == 0 ? 7 : k == 7 ? 0 : k; );
// m = morph (0..1)
function mg_set(fc, res, t, m) (
  t <= 1 ? this.mg_lad_init(fc, res, t == 0) : t <= 3 ? this.mg_st_init(fc, t == 3 ? res / 2 : res, m) : t == 4 ? this.mg_rect_init(fc, res, m) : t == 5 ? (
    this.sa.mg_sh_init(fc, 0, m); this.sb.mg_sh_init(fc, res, m);
  ) : t == 6 ? (
    this.ml.mg_ms_init(fc, res); this.mb.mg_ms_init(fc, res); this.mh.mg_ms_init(fc, res); this.mr.mg_ms_init(fc, res);
  ) : this.nl.mg_nl_init(fc, res, m);
);
function mg_run(x, t, m) local(ch, fr, y) (
  ch = min(3, floor(m * 4)); fr = m * 4 - ch;
  t == 0 ? this.mg_lad(x, 1, ch, fr) : t == 1 ? this.mg_lad(x, 0, ch, fr) : t == 2 ? this.mg_st(x, 0) :
  t == 3 ? this.mg_st(x, 1) : t == 4 ? this.mg_rect(x) : t == 5 ? this.sb.mg_sh(this.sa.mg_sh(x, 0), 1) :
  t == 6 ? (y = this.mg_ms4(x, ch) * (1 - fr); fr > 0.00000001 ? y += this.mg_ms4(x, (ch + 1) % 4) * fr; y) : this.nl.mg_nl(x);
);
// one output sample: two steps at 2x, DC blocker (10 Hz)
function mg_proc(x, t, m) local(y) instance(xp, dx, dy) (
  this.mg_ell(this.mg_run((xp + x) * 0.5, t, m));
  y = this.mg_ell(this.mg_run(x, t, m));
  xp = x;
  dy = y - dx + (1 - 2 * $pi * 10 / srate) * dy; dx = y;
  dy;
);
function mg_reset() instance(xp, dx, dy, si1, si2, si3, si4, sf1, sf2, sf3, sf4, sg1, sg2, sg3, sg4, x, v1, v2,
  e1, e2, e3, e4, e5, e6, ey) (
  xp = dx = dy = si1 = si2 = si3 = si4 = sf1 = sf2 = sf3 = sf4 = sg1 = sg2 = sg3 = sg4 = x = v1 = v2 = 0;
  e1 = e2 = e3 = e4 = e5 = e6 = ey = 0;
  this.sa.mg_sh_reset(); this.sb.mg_sh_reset();
  this.ml.mg_ms_reset(); this.mb.mg_ms_reset(); this.mh.mg_ms_reset(); this.mr.mg_ms_reset(); this.nl.mg_nl_reset();
  this.ra.mg_lsv_reset(); this.rb.mg_lsv_reset(); this.rn.mg_lsv_reset(); this.ro.mg_lsv_reset();
);
mg_fv = 0; mg_mv = 0; mg_w = 0; mg_on = 0; mg_t = -1; mg_m = 0;

// hot cues: hc_held = pad being held (1-4, 0 = none), hc_ret / hc_ret_play = where and how to go back,
// hc_kbd = pad held by a number key (let go if the FX window stops drawing)
hc_held = 0; hc_ret = 0; hc_ret_play = 0; hc_t0 = 0; hc_keep = 0; hc_kbd = 0;
// slip (slider 54): slip_on = background playback is running, slip_pos = where it is (file frames), slip_tch = touched last sample
slip_on = 0; slip_pos = 0; slip_tch = 0;
// beat loops (⚪78): bl_on = looping between bl_a and bl_b (file frames), bl_beats its length, bl_has = a loop to go
// back to (reloop), bl_roll = a held BOUNCE LOOP pad's (the background playback runs with or without slip), bl_pad = that pad
bs_g40 = gmem[40]; so_cmd = 0; so_a = so_b = 0; so_hold = 0; so_req = 0;   // (so_: the slot menu's request, see so_run)   // browse knob: the slot it picked (0 = none), the deck it works seen last
sl_held = -1; sl_d = 0; sl_idle = 0; sl_fix = 0; sl_s0 = 0;   // the SLICER pad held (slip: it holds the background playback), see bl_slice, samples since the pads rested
rv_on = 0; rv_f = 1; bl_on = 0; bl_a = bl_b = 0; bl_has = 0; bl_beats = 4; bl_roll = 0; bl_pad = -1; bl_sm = -1;
// jump: move the head and its smoothing stages together, so the head lands exactly on p and keeps its speed (setting
// all stages to p stopped it, and in tape the sound then spun up from zero over ~60 ms, like a rewind; user's report)
// (⚪150) a loop's wrap moves every stage of the head, and what is measured from the head (the envelope / pattern pad
// / recording anchors), by d together; not a jump for the grains (pf_prev too: they read on across the wrap, lp_wrap).
// The three wraps each listed the stages by hand, and the pattern pad's anchor pt_at was left out: a pattern past the
// loop's end set the target from the old anchor every sample, and the head ran away by a loop each sample
function head_shift(d) (
  target += d; head += d; head_mid += d; head_mid2 += d; hd_prev += d; head_grain += d; ui_pos += d; ui_goal += d;
  ev_at += d; pt_at += d; rc_at += d; pf_prev += d;
);
function jump_to(p) local(off) (
  p = max(0, min(max(len - 1, 0), p));   // ((⚪150) a CUE (up to 3600 s) past the sample's end sent the head beyond it)
  off = p - head; target += off; head_mid += off; head_mid2 += off; head = p; hd_prev += off;
  head_grain = head_last = head; ui_goal = ui_pos = target; ui_rate = 0; spin_on = 0; prev_start = PS_NONE; lp_neg = 0;
  sl_d = 0; sl_fix = 0;   // (SLICER: see bl_slice)
  jt_n += 1;   // ((⚪178 stage 3) counted for the tests)
);
// (⚪178) the head put on the performance head lane (counted for the tests: no jump more than the recording had)
function prp_jump(p) ( prp_jn += 1; jump_to(p); );
// (stage 3) how far the head (x) is off the head lane (y), s: inside a loop by its length round (the deck wraps at its own
// sample, the lane at the recording's blocks: played from another place, on another block grid, they differ by a wrap)
function prp_off(x, y) local(w, d) (
  w = fsr > 0 ? (bl_b - bl_a) / fsr : 0;
  d = x - y;
  bl_on && w > 0 && x >= bl_a / fsr - 0.0005 && x <= bl_b / fsr + 0.0005 ? d -= floor(d / w + 0.5) * w;
  abs(d);
);
// run_at(v): set the smoothing stages as if the head had been moving at v (frames / sample) for a while, so it runs
// at v from the next sample. Used when the transport starts or stops by a button (PLAY, a hot cue, CUE): from rest the
// head otherwise sped up through the three stages over ~30 ms, a tape 'wind-up' at the start (user's report). Not
// while a hand holds the platter. Steady state of one stage y += (x - y) k at speed v: x - y = v / k.
function run_at(v) local(d) (
  !tch ? (
    d = v / smooth_k;
    head_mid2 = head + d; head_mid = head + 2 * d; target = head + 3 * d;
    hd_prev = head - v; ui_goal = ui_pos = target; ui_rate = 0;
  );
);
// tempo (slider 89) and SYNC (91), see the header. te_1x() = the transport's speed (file frames / output sample)
// te_ob = the other deck's place in the shared memory; te_obpm = its BPM at its tempo (0 = none / not running);
// te_k = 1, 2 or 0.5 (half / double time); te_tk = the tempo fader must reach the tempo before it rules (soft takeover),
// te_mval = the tempo the fader set last, te_mlast = the fader's last value (-1000 = none yet), te_msb = its MSB
