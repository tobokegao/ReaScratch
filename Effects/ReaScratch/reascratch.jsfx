    // the 4-Mx's numbers. Needs Hercules' driver; set its deck mode to 2-deck basic. JOG CC 0x24 /
    // 0x25 while touched, CC 0x01 / 0x09 untouched (= the rim here), two's complement, 256 / rev (the guide) = 142 ticks/s
    // at 33 1/3 rpm; touch 0x1A / 0x3A; tempo 7-bit by default (its 14-bit LSB is 1 bit: read the MSB); K1-K3 = hot cues 1-3
    // (notes 1-3 / 33-35; SHIFT + K = 7-9 / 39-41, other buttons in between)
    pid == 124 || pid == 125 ? (
      preset(1, dkv(36, 37), 1, 142, dkv(1, 9), dkv(26, 58), 150, dkv(14, 46), dkv(13, 45), 0, 0); preset_xf(dk, 1, 34);
      preset_pad(1, dkv(1, 33), 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(dkv(5, 13), dkv(17, 49));
      preset_mx(dkv(3, 11), dkv(15, 47)); preset_rd(0, 0, 0); preset_n(3, 8);
