    ) : CV[247] ? (   // ((2026-10-13) the Buddy, nothing held: the transition's softness (its edges; the key's softness too); SHIFT = the master's amount)
      kpick(5, slider80, v / 127) ? (slider80 = v / 127; sliderchange(slider80); sprintf(#tt_msg, "transition softness %d %%", floor(slider80 * 100 + 0.5)); tt_msg_t = time_precise(); gui_dirty = 1);
    ) : (
      vfx_ty = v == 0 ? 0 : vfx_ord(1 + min(vfx_n - 1, floor((v - 1) * vfx_n / 127)));   // ((⚪118) the 11 with VHS, (⚪121) in the order, (⚪132) vfx_n)
      vfx_ty != slider86 ? (slider86 = vfx_ty; sliderchange(slider86); sprintf(#tt_msg, "master video FX: %s", vfx_nm(vfx_ty)); tt_msg_t = time_precise(); gui_dirty = 1);
    );
  );
  sh && CV[247] && (pdm_hold || gmem[130]) ? (   // ((2026-10-13) the mode button: the key softness)
    gmem[254] = 1;
    kpick(5, slider80, v / 127) ? (slider80 = v / 127; sliderchange(slider80));
    sprintf(#tt_msg, "key softness %d %%%s", floor(slider80 * 100 + 0.5), slider78 == 7 || (slider78 >= 9 && slider78 <= 18 && slider78 != 13) || (slider78 >= 9 && bl_combo && bl_keep == 7) ? "" : " (Luma key / wipe transitions only)"); tt_msg_t = time_precise(); gui_dirty = 1;
  ) : sh && CV[247] && (gmem[117] || gmem[118]) && !kpick(2, gmem[117] ? slider83 : gmem[186], v / 127) ? (
    0;
  ) : sh && CV[247] && (gmem[117] || gmem[118]) ? (   // ((2026-10-13) the bar: the deck's amount, as without SHIFT; its sound by BROWSE)
    fxa_v = v / 127; gmem[117] ? (slider83 = fxa_v; vfx_mv |= 1); gmem[118] ? (gmem[144] = fxa_v; gmem[148] += 1);
    sprintf(#tt_msg, "%s video FX %d %%", gmem[117] && gmem[118] ? "decks A and B:" : gmem[117] ? "deck A:" : "deck B:", floor(fxa_v * 100 + 0.5)); tt_msg_t = time_precise(); gui_dirty = 1;
  ) : sh && CV[247] ? (   // ((2026-10-13) the Buddy: SHIFT + the knob = the master's amount too)
    kpick(1, slider87, v / 127) ? (slider87 = v / 127; vfx_mv |= 2; sprintf(#tt_msg, "master video FX %d %%", floor(slider87 * 100 + 0.5)); tt_msg_t = time_precise(); gui_dirty = 1);
  ) : sh ? (
    vfx_ty = v == 0 ? 0 : 1 + min(7, floor((v - 1) * 8 / 127));   // ((⚪121) the blends only again (Add .. Chroma key after Mix); the transitions: the mode button + the knob)
    vfx_ty != slider78 ? (slider78 = vfx_ty; sliderchange(slider78); sprintf(#tt_msg, "video blend: %s", bld_nm(vfx_ty)); tt_msg_t = time_precise(); gui_dirty = 1);
  );
);

// ((⚪151) the values that follow only the sample rate, worked out here and when the rate changes (start of @block)
// instead of in every block
function sr_calc() (
  mg_ws = 1 / (0.01 * srate);
  pfl_st = 1 / (0.005 * srate);   // cue on / off: a 5 ms fade, no click (as the AB Router of the Playtime project)
  nx_d1 = floor(min(CHN - 2, 0.019 * srate)); nx_d2 = floor(min(CHN - 2, 0.029 * srate)); nx_d3 = floor(min(CHN - 2, 0.041 * srate)); nx_d4 = floor(min(CHN - 2, 0.059 * srate));
  vt_dn = max(1, floor(srate / 11025 + 0.5)); vt_sr = srate / vt_dn; vt_lk = 1 - exp(-2 * $pi * 1000 / srate);
  VN = srate > 60000 ? 4096 : 2048; VH = VN / 8; VRL = VN / 4;   // ((⚪124) a frame every 5.8 ms (the responses cross-faded), a pulse 11.6 ms long
  // ((⚪124) the vocoder: FFT size, hop, pulse length; smoothing of the pitch, the power, the gain
  vx_ck = 1 - exp(-1 / (0.03 * srate)); vx_pk = 1 - exp(-1 / (0.3 * srate)); vx_gk = 1 - exp(-1 / (0.1 * srate));
  xf_k = 1 - exp(-1 / (0.001 * srate));             // 1 ms ramp: no click, still sharp enough for transforms
);
sr_calc();

@slider
// always start stopped: a project saved while playing started playing the moment it was opened (user's report,
// 2026-10-03: a surprise, and a risk on stage). The first @slider / @block after loading puts the switch on stop.
// (⚪97) the crossfader where it was when the project was saved (slider 39): a controller sends it only when it moves, so
// it stood in the middle at start and deck B showed with the fader at deck A's end (user's report 2026-10-08)
xf_boot ? (xf_boot = 0; CV[34] > 0 && slider39 >= 0 && slider39 <= 1 ? (xf_pos = slider39; xf_msb = floor(slider39 * 127 + 0.5)));
boot_stop ? (boot_stop = 0; slider3 = 0; sliderchange(slider3); slider97 = 0; sliderchange(slider97));   // (and never a load test left on)
slider50 = MAXSAMPLES;   // read-only: a saved project value must not stand
(slider199 < 0 || slider199 > 1) ? (slider199 = max(0, min(1, slider199)); sliderchange(slider199));   // (⚪97: a project from the key fader's time held -12)
apply_sliders();

@block
// ((⚪151) the audio device's rate changed: with ext_noinit REAPER does not run @init again (measured: the rate went
// 44.1 -> 48 kHz, @init ran once), so the time constants worked out from srate stayed at the old rate: worked out again)
srate != sr_last ? (sr_last = srate; ax_sk = 1 - exp(-1 / (0.03 * srate)); ac_k = ax_sk; ax_fk = 1 - exp(-1 / (0.005 * srate)); len <= 0 ? fsr = srate; sr_calc(); ap_req = 1);
pr_fresh = 0; ap_req ? (ap_req = 0; apply_sliders());   // ((⚪129) a setting in CV changed by the setup page / Learn tab)
pm_t0 = time_precise(); pm_n = samplesblock;
so_run();   // the slot menu's request (empty / move)
gq_run(); gq_blk = time_precise();   // ((⚪151) the window's requests, see gq_push)
// (⚪178 stage 2) the performance lanes played back (see prp_on in @init). The perf JSFX ran this block (its count moved and
// its play_position is this block's) and says REAPER plays. Lanes: [9] transport, [10] head, [11] driven, [12] slot,
// [13] tempo, [14] key; (stage 3) [15] - [18] loop on / start / end / roll, [19] SYNC (not played), [20] CUE position,
// [21] - [28] hot cues 1-8, [29] memory cue events, [30] PITCH PLAY's key; a lane's minimum = nothing recorded there (not
// applied)
prp_b = 14000000 + (slider76 == 2 ? 256 : 0);
prp_on = gmem[400] > 0 && gmem[slider76 == 2 ? 402 : 401] > 0 && (play_state & 1) && gmem[prp_b + 3] > 0 &&
         gmem[prp_b] != prp_cnt && abs(gmem[prp_b + 1] - play_position) < 0.000001;
prp_cnt = gmem[prp_b];
prp_drv = 0;
prp_on ? (
  // REAPER started, sought or wrapped a loop: this block is not where the last one ended (samplesblock is not constant)
  prp_chase = !prp_was || abs(play_position - prp_nx) > 0.0001;
  prp_hand = touched || ui_touch || kb_touch || ui_seek;
  prp_x = gmem[prp_b + 12];   // slot (before the head: a switch moves it)
  prp_sw = 0;
  prp_x > 0.5 && (prp_chase || abs(prp_x - prp_v4) > 0.0001) ? (floor(prp_x + 0.5) - 1 != sm_cur ? (sm_switch(floor(prp_x + 0.5) - 1, 0); prp_sw = 1); prp_used = 1);
  prp_v4 = prp_x;
  prp_x = gmem[prp_b + 9];    // transport (at once: no quantize wait, no brake / start ramp - the driven head plays those)
  prp_x > -0.5 && (prp_chase || abs(prp_x - prp_v1) > 0.0001) ? ((prp_x > 0.5) != (slider3 > 0) ? play_on(prp_x > 0.5); prp_used = 1);
  prp_v1 = prp_x;
  // tempo (the fader then takes over when it reaches it, as after SYNC). Changed = off the value applied last by more
  // than the lane's thinning (0.001 %): the thinned lane runs a slow slope between its points (0 -> 0.001 % over 4.5 s
  // in the stage 2 test), which took a tempo set by hand back at once
  prp_x = gmem[prp_b + 13];
  prp_x > -50.5 && (prp_chase || abs(prp_x - prp_v5) > 0.001) ? (abs(prp_x - slider89) > 0.00001 ? (slider89 = prp_x; sliderchange(slider89); te_tk = 1; te_mlast = -1000); prp_used = 1; prp_v5 = prp_x);
  prp_x = gmem[prp_b + 14];   // key
  prp_x > -12.5 && (prp_chase || abs(prp_x - prp_v6) > 0.0001) ? (floor(prp_x + 0.5) != slider217 ? (slider217 = floor(prp_x + 0.5); sliderchange(slider217)); prp_used = 1);
  prp_v6 = prp_x;
  // (stage 3) the loop: its four lanes as one (any of them changed, a chase or a slot switched here = all four), the
  // variables set at once (no quantize, no slip: the head lane has where the loop and its end took the head). A slot
  // switched here: the loop goes as a switch ends it (bl_sm below in @block would end the one set here)
  prp_sw ? (bl_sm = sm_cur; bl_on = 0; bl_has = 0; bl_roll = 0; bl_pad = -1);
  prp_lc = prp_chase || prp_sw; prp_i = 7;
  loop(4, prp_x = gmem[prp_b + 8 + prp_i]; abs(prp_x - PRP_V[prp_i]) > 0.0000001 ? prp_lc = 1; PRP_V[prp_i] = prp_x; prp_i += 1);
  prp_x = gmem[prp_b + 15];
  prp_lc && prp_x > -0.5 && len > 0 && fsr > 0 ? (
    prp_used = 1;
    gmem[prp_b + 16] > -0.5 && gmem[prp_b + 17] > -0.5 ? (bl_a = gmem[prp_b + 16] * fsr; bl_b = gmem[prp_b + 17] * fsr);
    bl_on = prp_x > 0.5; bl_roll = bl_on && gmem[prp_b + 18] > 0.5; bl_pad = -1;
    // (its length in beats for the pads' lights and CUE LOOP: a power of two when it is one)
    bl_on && bl_b > bl_a ? (bl_has = bl_has || !bl_roll; prp_w = (bl_b - bl_a) / bl_beat(); prp_p = 2 ^ floor(log(prp_w) / log(2) + 0.5);
                            bl_beats = abs(prp_w / prp_p - 1) < 0.001 ? prp_p : prp_w);
  );
  // the CUE position (lastcue too: else @slider takes the new slider4 for a CUE moved by hand and jumps there)
  prp_x = gmem[prp_b + 20];
  prp_x > -0.5 && (prp_chase || prp_sw || abs(prp_x - PRP_V[12]) > 0.0000001) ? (slider4 != prp_x ? (slider4 = prp_x; lastcue = slider4; sliderchange(slider4)); prp_used = 1);
  PRP_V[12] = prp_x;
  // hot cues 1-8 set and cleared as recorded (the deck's own hot cues: user's choice)
  prp_i = 1;
  loop(8,
    prp_x = gmem[prp_b + 20 + prp_i];
    prp_x > -1.5 && (prp_chase || prp_sw || abs(prp_x - PRP_V[12 + prp_i]) > 0.0000001) ? (abs((prp_x < 0 ? -1 : prp_x) - hc_pos(prp_i)) > 0.0000001 ? hc_put(prp_i, prp_x < 0 ? -1 : prp_x); prp_used = 1);
    PRP_V[12 + prp_i] = prp_x; prp_i += 1;
  );
  // a memory cue added / deleted: only where the lane goes to an event (not on a chase: the cues are the deck's state)
  prp_x = gmem[prp_b + 29];
  !prp_chase && prp_x > -3601.5 && abs(prp_x) > 0.5 && abs(prp_x - PRP_V[21]) > 0.0000001 ? (
    prp_used = 1;
    prp_x > 0 ? mc_add_at(floor((prp_x - 1) * 1000 + 0.5) / 1000) : mc_del_at(mc_find(-prp_x - 1, 0.002));
  );
  PRP_V[21] = prp_x;
  // PITCH PLAY's key (until its lane changes, or the pad mode leaves PITCH PLAY)
  prp_x = gmem[prp_b + 30];
  prp_x > -24.5 && (prp_chase || abs(prp_x - PRP_V[22]) > 0.00001) ? (pp_k = 2 ^ (prp_x / 12); prp_used = 1);
  PRP_V[22] = prp_x;
  // (stage 4) the mixer and the effects, lanes 23-74 (see prp_set). Nothing recorded there: the lanes' own variables
  // (cut, fader lanes' gain, TOUCH FX) back to none; deck A's lanes not on deck B
  prp_i = 23;
  loop(PRP_N - 22,
    prp_x = gmem[prp_b + 8 + prp_i];
    prp_x > -1.5 ? (
      (prp_chase || abs(prp_x - PRP_U[prp_i]) > prp_tl(prp_i)) && !(slider76 == 2 && prp_ao(prp_i)) ? (prp_set(prp_i, prp_x); PRP_U[prp_i] = prp_x; prp_used = 1);
    ) : (
      PRP_U[prp_i] = prp_x;
      prp_i == 24 ? (prp_cut = 0) : prp_i == 74 ? (prp_pf = 1) : prp_i == 53 ? (prp_tb = 0) : prp_i == 54 ? (prp_tbb = 0) : prp_i == 75 ? (prp_ah = 0);
    );
    prp_i += 1;
  );
  // the head (s of the sample) and the driven lane
  prp_h = gmem[prp_b + 10]; prp_x = gmem[prp_b + 11];
  prp_h > -0.5 && len > 0 && fsr > 0 && !prp_hand ? (
    prp_used = 1;
    prp_x > 0.5 ? (
      // driven: the head moves in a straight line from where it is to the lane over this block, on the target (no
      // smoothing: the lane is the smoothed head already). The lane holds one value per block, where the head is at the
      // block's end (the records are one block early, see prf_hput). Chosen by a timing test during development:
      // the head lane played back and recorded again was off by 0.36 ms on average in a scratch (max 2.3 ms); a straight
      // line one block late with the smoothing 7.8 ms (max 29 ms), steps 6.6 ms (max 19 ms)
      prp_drv = 1; prp_j = 0; prp_bn = max(1, samplesblock);
      prp_g = prp_h * fsr;
      // (off the line: compared with the last block's lane value, where the head is due now - the lane holds where it
      // is due at the block's end, more than PRP_TOL ahead in a fast scratch)
      prp_chase || prp_hp < -0.5 ? prp_jump(prp_h * fsr) : abs(head / fsr - prp_hp) > PRP_TOL ? prp_jump(prp_hp * fsr);
      prp_s = target;
    ) : prp_dw && !prp_chase ? (
      // the first block after the driven head: on the lane, and at the transport's speed at once (the head's smoothing
      // started again from the hand's last speed and stayed 20 ms behind: under PRP_TOL, never put right)
      tch = 0; abs(head / fsr - prp_h) > 0.0005 ? prp_jump(prp_h * fsr); run_at(slider3 ? te_1x() : 0);
    ) : (prp_chase || prp_off(head / fsr, prp_h) > PRP_TOL) ? prp_jump(prp_h * fsr);
  );
  prp_hp = prp_h;
  prp_nx = play_position + samplesblock / srate;
) : (
  // REAPER stopped after it played the lanes: the deck stops with it (not when the mode or the deck's playback went off)
  prp_was && prp_used && !(play_state & 1) && slider3 ? play_on(0);
  prp_used = 0;
  prp_cut = 0; prp_pf = 1; prp_tb = prp_tbb = 0; prp_ah = 0;   // ((stage 4) the lanes' cut, fader gain, TOUCH FX and CLIP STOP end with them)
);
prp_dw = prp_drv; prp_was = prp_on;
gmem[prp_b + 4] = prp_jn; gmem[prp_b + 5] = jt_n; gmem[prp_b + 6] = bl_wn; gmem[prp_b + 7] = mc_n;   // ((stage 3) for the tests)
// ((⚪151) another clip in this deck (a slot switch or a new file in the slot: the sample's place or length changed): a
// count for the deck mix, which then drops this deck's still-frame history and trails (deck A [270], deck B [271])
buf != vc_buf || len != vc_len ? (vc_buf = buf; vc_len = len; gmem[slider76 == 2 ? 271 : 270] += 1);
so_hold && (gmem[slider76 == 2 ? 71 : 65] >= so_req || time_precise() > so_hold) ? (so_hold = 0; sm_changed() ? sm_load_all(SM_N));
// ((⚪173) the video sync script wrote the sound the project had in a slot again (a LOAD saved in no project had overwritten
// the slot's file): that slot is read again, its head / cues / BPM kept. gmem[292] / [293] counter, [290] / [291] slot 1-8
// (deck A / B; not a slider: a parameter set from the script made an undo point, and the LOAD could not be redone)
!hl_ok ? (hl_ok = 1; hl_seen = gmem[slider76 == 2 ? 293 : 292]);
gmem[slider76 == 2 ? 293 : 292] != hl_seen ? (
  hl_seen = gmem[slider76 == 2 ? 293 : 292];
  hl_k = floor(gmem[slider76 == 2 ? 291 : 290] + 0.5);
  hl_k >= 1 && hl_k <= SM_N ? sm_load_all(hl_k - 1);
);
// the deck the browse knob works changed (SHIFT + push, or the APC40's deck select): this deck says so if it is it
gmem[40] != bs_g40 ? (
  bs_g40 = gmem[40];
  CV[165] > 0 && (gmem[40] == 2 ? 2 : 1) == (slider76 == 2 ? 2 : 1) ? (strcpy(#tt_msg, "browse knob: this deck"); tt_msg_t = time_precise(); gui_dirty = 1);
);
// (⚪119, user's request and choices 2026-10-10) the recorded lanes besides scratch / fader, read where the scratch lanes
// are (the deck's time; a held lane's own clock): gmem from 10000000 (deck A) / 12000000 (B), 200000 a lane: video FX
// type / amount, filter cutoff / resonance / morph, pad FX (bits), master type / amount (deck A). The video FX and the
// pads: the larger of the lane and the live one; the filter: the lane while the live cutoff knob is at its centre (off)
lv_b = slider76 == 2 ? 12000000 : 10000000;
lv_T = sm_cur * 3600 + (ev_t ? ev_clk : target) / fsr;
lv_on = slider3 && len > 0 && fsr > 0 && !prp_on;   // ((⚪178) not while the performance lanes play)
lv_vt = lv_on ? floor(ev_v2(lv_b, lv_T, 0) + 0.5) : 0; lv_va = lv_on ? ev_v2(lv_b + 200000, lv_T, 0) : 0;
lv_c = lv_on ? ev_v2(lv_b + 400000, lv_T, -9) : -9;
lv_r = lv_on ? ev_v2(lv_b + 600000, lv_T, slider154) : slider154; lv_m = lv_on ? ev_v2(lv_b + 800000, lv_T, slider150) : slider150;
lv_pb = lv_on ? floor(ev_v2(lv_b + 1000000, lv_T, 0) + 0.5) : 0;
lv_mt = lv_on && slider76 != 2 ? floor(ev_v2(lv_b + 1200000, lv_T, 0) + 0.5) : 0; lv_ma = lv_on && slider76 != 2 ? ev_v2(lv_b + 1400000, lv_T, 0) : 0;
lv_fl = lv_c > -5 && abs(slider152) <= 0.05;
fl_c = lv_fl ? lv_c : slider152; fl_r = lv_fl ? lv_r : slider154; fl_m = max(-0.5, min(0.5, lv_fl ? lv_m : slider150));
vf_t = slider82; vf_a = slider83; lv_vt > 0 && lv_va > vf_a + 0.0001 ? (vf_t = lv_vt; vf_a = lv_va);
mf_t = slider86; mf_a = slider87; lv_mt > 0 && lv_ma > mf_a + 0.0001 ? (mf_t = lv_mt; mf_a = lv_ma);
// DJ filter (sliders 150, 152-154): the cutoff and morph knobs smoothed (30 ms); coefficients once a block
mg_k = 1 - exp(-samplesblock / (0.03 * srate));
mg_fv += (fl_c - mg_fv) * mg_k; abs(fl_c - mg_fv) < 0.0005 ? mg_fv = fl_c;   // ((⚪119) fl_c: the knob or its lane)
mg_mg = fl_m;   // (a project saved with the earlier EQ slider here held -40 .. 6: kept to -0.5 .. 0.5)
mg_mv += (mg_mg - mg_mv) * mg_k; abs(mg_mg - mg_mv) < 0.0005 ? mg_mv = mg_mg;
// ((user's choice 2026-10-12) the filter's play 0.02 -> 0.05: the user's project had the knobs at -0.03 / -0.08 (2 and 5
// steps of the APC40's knob), the filter and the picture's night look running unnoticed)
mg_on = abs(mg_fv) > 0.05;
mg_on ? (
  mg_a = (abs(mg_fv) - 0.05) / 0.95; mg_top = min(12000, 0.24 * srate);
  mg_fc = mg_fv > 0 ? 25 * (6000 / 25) ^ mg_a : mg_top * (100 / mg_top) ^ mg_a;
  mg_m = (mg_fv > 0 ? 0.5 : 0) + mg_mv; mg_m = mg_m - floor(mg_m);
  mg_t != slider153 || mg_w <= 0 ? (mg_t = slider153; mgl.mg_reset(); mgr.mg_reset());
  mgl.mg_set(mg_fc, fl_r, mg_t, mg_m); mgr.mg_set(mg_fc, fl_r, mg_t, mg_m);
);   // CPU meter: this block's time, measured at its last sample
// dropout counter (sliders 98-99): lag = wall time minus audio time since the previous block; its floor follows the
// lowest lag (rising slowly, ~10 s, for clock drift); lag above the floor by the threshold = one dropout
xr_gap = pm_t0 - xr_t;
xr_t > 0 && xr_gap < 2 ? (   // (a pause of 2 s or more = processing stopped, not a dropout)
  xr_lag += xr_gap - xr_dur;
  xr_lag < xr_base ? xr_base = xr_lag : xr_base += (xr_lag - xr_base) * min(1, xr_dur / 10);
  xr_lag - xr_base > (slider98 > 0 ? slider98 / 1000 : samplesblock / srate + 0.003) ? (
    slider99 += 1; sliderchange(slider99); xr_base = xr_lag;
  );
) : (
  xr_lag = xr_base = 0;
);
xr_t = pm_t0; xr_dur = samplesblock / srate;
// load test (slider 97, the load test script): the deck scratches by itself. Every 6 s: a jump to a random place, 3 s of
// scratching (+-3x at 2 Hz), 3 s of play at 1x; 20 s in, all samples are loaded again once (as an import does)
slider97 ? (
  !lt_on ? (lt_on = 1; lt_t = 0; lt_ld = 0);
  touched = 1; jog_idle = 0;
  lt_c = lt_t - 6 * floor(lt_t / 6);
  lt_c < samplesblock / srate && len > 0 ? jump_to(rand(len - 1));
  lt_v = (lt_c < 3 ? 3 * sin(2 * $pi * 2 * lt_c) : 1) * fsr / srate;
  lt_t += samplesblock / srate;
  lt_t >= 20 && !lt_ld ? (lt_ld = 1; sm_load_all(0));
) : lt_on ? (lt_on = 0; lt_v = 0; touched = 0);
boot_stop ? (boot_stop = 0; slider3 = 0; sliderchange(slider3); slider97 = 0; sliderchange(slider97));   // (and never a load test left on)
gui_dirty ? (gui_dirty = 0; apply_sliders());   // a slider was changed from the custom GUI
jog_idle += samplesblock;
ax_prevpg = ax_pg();   // ((2026-10-13) the helper's page as this block starts (deck A decides)
