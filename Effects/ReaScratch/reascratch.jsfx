  dq_l *= gain; dq_r *= gain;
  ag_g += (ag_t - ag_g) * ax_fk; dq_l *= ag_g; dq_r *= ag_g;   // ((⚪185) auto gain)
  // (⚪92) the sound effects (see the block); each one only while its amount is above 0
  // (⚪113, user's report 2026-10-10: a click when the FX ON bar turned Tint on) the amounts follow over about 5 ms (they
  // switched at once), and Tint's filter follows the sound while off (it started from the sound of its last time on)
  ax_tw += ((ax_tint > 0.001) - ax_tw) * ax_fk; ax_rs += (ax_ring - ax_rs) * ax_fk; ax_cs += (ax_clip - ax_cs) * ax_fk;
  ax_crs += (ax_crush - ax_crs) * ax_fk; ax_ms += (ax_mir - ax_ms) * ax_fk; ax_chs += (ax_cho - ax_chs) * ax_fk;
  ax_es += (ax_elv - ax_es) * ax_fk; ax_gts += (ax_gate - ax_gts) * ax_fk;
  ax_tw > 0.0005 ? (ax_tl += (dq_l - ax_tl) * ax_tk; ax_tr += (dq_r - ax_tr) * ax_tk; nx_t2l += (ax_tl - nx_t2l) * ax_tk; nx_t2r += (ax_tr - nx_t2r) * ax_tk;
                   // (the level brought back: see ax_tpi in @init)
                   ax_tpi += (dq_l * dq_l + dq_r * dq_r - ax_tpi) * ax_tks; ax_tpo += (nx_t2l * nx_t2l + nx_t2r * nx_t2r - ax_tpo) * ax_tks;
                   ax_tki = max(max(abs(dq_l), abs(dq_r)), ax_tki * ax_tkd); ax_tko = max(max(abs(nx_t2l), abs(nx_t2r)), ax_tko * ax_tkd);
                   ax_tg += (max(1, min(4, min(sqrt((ax_tpi + 0.000000000001) / (ax_tpo + 0.000000000001)), (ax_tki + 0.000000001) / (ax_tko + 0.000000001)))) - ax_tg) * ax_tgk;
                   dq_l += (nx_t2l * ax_tg - dq_l) * ax_tw; dq_r += (nx_t2r * ax_tg - dq_r) * ax_tw)
                 : (ax_tl = nx_t2l = dq_l; ax_tr = nx_t2r = dq_r; ax_tpi = ax_tpo = ax_tki = ax_tko = 0; ax_tg = 1);
  ax_rs > 0.0005 ? (ax_rp += 2 * $pi * 220 / srate; ax_rp > 2 * $pi ? ax_rp -= 2 * $pi; ax_m = 1 - ax_rs + sin(ax_rp) * ax_rs; dq_l *= ax_m; dq_r *= ax_m);
  // (⚪95: clips at 0.22, it was too loud) (2026-10-09, user's report: at the knob's top still too loud: the clipped wave is
  // near a square, its power far above the sound's) the power before / after (about 30 ms) and the clipped sound taken
  // down to the power it came in with, never up (measured with the knob at the top: +7.1 dB over the knob at 0 before)
  ax_cs > 0.0005 ? (
    ac_pi += (dq_l * dq_l + dq_r * dq_r - ac_pi) * ac_k;
    ax_g = 1 + 24 * ax_cs; dq_l += (max(-0.22, min(0.22, dq_l * ax_g)) - dq_l) * ax_cs; dq_r += (max(-0.22, min(0.22, dq_r * ax_g)) - dq_r) * ax_cs;
    ac_po += (dq_l * dq_l + dq_r * dq_r - ac_po) * ac_k;
    ac_m = ac_po > 0.000000001 ? min(1, sqrt(ac_pi * (1 - 0.3 * ax_cs) / ac_po)) : 1; dq_l *= ac_m; dq_r *= ac_m;   // (and up to 1.5 dB under: distortion sounds louder)
  ) : (ac_pi = ac_po = 0);
  // (⚪114, user's request 2026-10-10) the level before the echo / bitcrusher / stereo effects (see after the echo)
  lm_pi += (dq_l * dq_l + dq_r * dq_r - lm_pi) * lm_k;
  // ((2026-10-13) Line art: the lows cut (its filter follows the sound while off); Halftone: coarse steps
  // ((⚪162) Disc: the phono EQ (its filters run while off too: no click when it comes in)
  dk_w += ((ax_dsc > 0.001) - dk_w) * ax_fk;
  dk_w > 0.0005 || ax_dsc > 0.001 ? (   // ((⚪169) only while on (it settles within about 15 ms: the 5 ms fade-in covers it); off: state cleared once
  dk_live = 1;
  dk_yl = dkl4.dk_f(dkl3.dk_f(dk_sat(dkl2.dk_f(dkl1.dk_f(dq_l, dk_a0, dk_a1, dk_a2), dk_b0, dk_b1, dk_b2) * dk_np * dk_dr) / dk_dr, dk_d0, dk_d1, dk_d2), dk_e0, dk_e1, dk_e2) * dk_nd;
  dk_yr = dkr4.dk_f(dkr3.dk_f(dk_sat(dkr2.dk_f(dkr1.dk_f(dq_r, dk_a0, dk_a1, dk_a2), dk_b0, dk_b1, dk_b2) * dk_np * dk_dr) / dk_dr, dk_d0, dk_d1, dk_d2), dk_e0, dk_e1, dk_e2) * dk_nd;
  dq_l += (dk_yl - dq_l) * dk_w; dq_r += (dk_yr - dq_r) * dk_w;
  ) : dk_live ? (dk_reset(); dk_live = 0);
  nx_lw += ((ax_lna > 0.001) - nx_lw) * ax_fk; nx_hts += (ax_htn - nx_hts) * ax_fk; nx_zbs += (ax_zbl - nx_zbs) * ax_fk;
  nx_lw > 0.0005 ? (nx_l1 += (dq_l - nx_l1) * nx_hk; nx_r1 += (dq_r - nx_r1) * nx_hk; nx_hl = dq_l - nx_l1; nx_hr = dq_r - nx_r1;
                    nx_l2 += (nx_hl - nx_l2) * nx_hk; nx_r2 += (nx_hr - nx_r2) * nx_hk;
                    dq_l += (nx_hl - nx_l2 - dq_l) * nx_lw; dq_r += (nx_hr - nx_r2 - dq_r) * nx_lw)
                 : (nx_l1 = dq_l; nx_r1 = dq_r; nx_l2 = nx_r2 = 0);
  // ((⚪163) Halftone: grains (see HGN; it was a tremolo of 8 a beat). The rings are written always (as ⚪98);
  // a new grain = its count changed (a scratch back too); the dry sound fades out by amount 0.5
  HGL[ax_ew % HGN] = dq_l; HGR[ax_ew % HGN] = dq_r;
  nx_hts > 0.0005 ? (
    ax_bpm > 0 && slider63 > 0 ? nx_tp = gb_b(head) * 8 : (nx_tc += 16 / srate; nx_tc >= 1024 ? nx_tc -= 1024; nx_tp = nx_tc);
    // ((⚪163) 2 .. 8 voices by the amount (see HGV); each voice's grain count and delay kept up while it is silent too
    hg_mv = 2 + 6 * nx_hts; hg_sl = hg_sr = hg_s2 = 0; hg_i = 0;
    loop(8,
      hg_p = nx_tp + hg_i / 8; hg_q = floor(hg_p); hg_p -= hg_q;
      hg_q != HGV[hg_i] ? (HGV[hg_i] = hg_q; HGV[8 + hg_i] = floor(rand(1) * hg_j));
      hg_g = max(0, min(1, hg_mv - (((hg_i & 1) << 2) | (hg_i & 2) | ((hg_i & 4) >> 2))));
      hg_g > 0 ? (hg_w = sin($pi * hg_p) ^ 2 * hg_g; hg_a = (ax_ew - HGV[8 + hg_i] + HGN) % HGN; hg_sl += HGL[hg_a] * hg_w; hg_sr += HGR[hg_a] * hg_w; hg_s2 += hg_g * hg_g);
      hg_i += 1;
    );
