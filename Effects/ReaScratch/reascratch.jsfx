        g_pl_px = floor(g_pl_x + (g_pl_q + g_pl_j + 0.25) * g_pl_ux - (g_pl_o + 0.25) * g_pl_uy) - g_pl_mx;
        g_pl_py = floor(g_pl_y + (g_pl_q + g_pl_j + 0.25) * g_pl_uy + (g_pl_o + 0.25) * g_pl_ux) - g_pl_my;
        g_pl_px >= 0 && g_pl_px < 17 && g_pl_py >= 0 && g_pl_py < 17 ? G_TRIM[g_pl_py * 17 + g_pl_px] = 1;
