  pf_d = head - pf_prev; pf_prev = head;
  pf_jmp = abs(pf_d) > tp_jump;
  !pf_jmp ? pf_v = pf_d;
  pf_n = pf_v * srate / fsr / (1 + slider89 / 100);   // head speed (x) relative to the tempo: the tempo never moves the pitch
  pf_r = (pf_n < 0 ? -1 : 1) * (pf_a == 0 ? 1 : abs(pf_n) ^ pf_a) * fsr / srate;   // ((⚪169) no pow at 0: |x|^0 = 1
  pf_rk = pf_r * kshift;   // PITCH PLAY's key: every grain reads kshift x faster, centred on the head as before
  ((pf_a > 0 && pf_jmp) || sm_jump) && !ui_seek ? (
    // a jump (CUE, hot cue, loop): the grains fade out over 5 ms where they are (at their old speed), and a full set of
    // grains fades in at the new place, each as far into its life as if it had been playing there all along
    i = 0; loop(NSLOT, vp = VOICE + i; vp[24] ? vp[56] = -tp_xs; i += 1);
    pf_g = overlap - 1;
    loop(overlap,
      pf_t = pf_g * hop;                                // age (output samples)
      vp = VOICE + pick_v();
      vp[0] = head - glen * 0.5 * (pf_rk - pf_a * pf_v) * srate / fsr + (pf_rk - pf_v) * pf_t;
      vp[8] = pf_t * fsr / srate; vp[16] = pf_r < 0 ? -1 : 1; vp[24] = 1; vp[32] = glen; vp[40] = 1; vp[48] = 0; vp[56] = tp_xs; vp[64] = sm_cur;
      pf_g == 0 ? (prev_start = vp[0]; prev_dir = vp[16]; prev_v = nextv);
      nextv = (nextv + 1) % NSLOT; pf_g -= 1;
    );
    hopcnt = hop; head_grain = head; sm_jump = 0;
  );
  // (2026-10-21) PLAY from silence, pitch-locked (pf_a 0): the grains left from the stop sat at jittered / searched
  // places, so the first ~20 ms sounded ahead of where the playing sound is (a quantized PLAY came in before the other
  // deck's bar, user's report). A full set of grains instead, each as far into its life as if the deck had been playing
  ss_go = gain < 0.00001 && pf_a == 0 && (slider3 || spin_on) && !tch && !ui_seek && !ended && len > 0;
  ss_go ? (
    i = 0; loop(NSLOT, vp = VOICE + i; vp[24] = 0; i += 1);
    ss_g = overlap - 1;
    loop(overlap,
      ss_t = ss_g * hop;                                // age (output samples)
      vp = VOICE + pick_v();
      vp[0] = head - ss_t * te_1x() - glen * 0.5 * kshift + ss_t * fsr / srate * kshift;
      vp[8] = ss_t * fsr / srate; vp[16] = 1; vp[24] = 1; vp[32] = glen; vp[40] = 0; vp[48] = 1; vp[56] = 0; vp[64] = sm_cur;
      ss_g == 0 ? (prev_start = vp[0]; prev_dir = 1; prev_v = nextv);
      nextv = (nextv + 1) % NSLOT; ss_g -= 1;
    );
