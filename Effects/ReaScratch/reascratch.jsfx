      pk_s(24, -1, dk, -1, -1); preset_sm(dk + 4, 20); pk_f(23, 25, (dk - 1) * 128 + 24, 0x1A, 0);
      CV[144] = dk + 4; CV[146] = 0x40; CV[246] = 1; pk_b(15, 0x00, 0x06, 0x78, 0x7B, dkv(0x02, 0x03), -1); pk_x(dk + 8, -1, -1, 0x00, dk + 8, -1, -1, -1, -1, -1); CV[131] = 1;
    );
    pid >= 78 && pid <= 81 ? (   // DJControl Starlight / MIX: pad modes; FILTER CC 1 (centre off), LOW CC 2 = resonance
      CV[234] = pid <= 79 ? 20 : 21; pk_f(-1, 0x02, -1, 0x01, 0);
    );
    pid == 82 || pid == 83 ? (   // DJControl Compact (ch 1, deck 2 = + 0x30): reloop 0x19, loop 8 0x1A, half 0x1B, double 0x1C; FX pad 9
      CV[144] = 1; CV[146] = dkv(0x1A, 0x4A); CV[245] = dkv(0x19, 0x49); CV[184] = dkv(0x1B, 0x4B); CV[185] = dkv(0x1C, 0x4C);
      pk_x(1, dkv(0x09, 0x39), -1, -1, 1, dkv(0x0A, 0x3A), dkv(0x0B, 0x3B), -1, -1, -1);
    );
    pid == 84 || pid == 85 ? (   // DJControl Jogvision (ch 1 / 2): pad modes; SHIFT 0x56; loop 1 / half 0 / double 2, loop knob CC 0x44
      CV[234] = 22; CV[181] = 0x56; CV[144] = dk; CV[146] = 0x01; CV[184] = 0x00; CV[185] = 0x02; CV[145] = 0x44; CV[147] = 0x4A;
      CV[237] = 0x39; pk_x(dk, 0x04, -1, 0x46, dk, 0x05, 0x06, -1, -1, -1); pk_b(1, 0x4E, 0x4F, -1, -1, dkv(0x51, -1), -1); pk_bud(0x46);
    );
    pid == 86 || pid == 87 ? (   // DJ Control Instinct (ch 1): clear = + 2; loop in, reloop, half; FX 1
      CV[48] = 1; CV[105] = 2; CV[144] = 1; CV[146] = dkv(0x09, 0x23); CV[245] = dkv(0x0B, 0x25); CV[184] = dkv(0x0C, 0x26);
      pk_x(1, dkv(0x01, 0x1B), -1, -1, 1, dkv(0x02, 0x1C), dkv(0x03, 0x1D), -1, -1, -1); pk_b(1, -1, -1, -1, -1, dkv(0x19, 0x33), -1);
    );
    pid == 110 || pid == 111 ? (   // DJ Control MP3 e2 (ch 1): K5-K8 = hot cues 1-4; K1 = loop in, K3 = reloop; AUTOMIX held = SHIFT
      preset_pad(1, dkv(0x05, 0x19), 0); CV[120] = 4; CV[181] = 0x2E; CV[144] = 1; CV[146] = dkv(0x01, 0x15); CV[245] = dkv(0x03, 0x17);
    );
    pid == 112 || pid == 113 ? (   // DJ Control AIR (ch 1): loop in, double, reloop; Magic = SHIFT; flanger = FX on, its knob = master
      CV[181] = 0x2E; CV[144] = 1; CV[146] = dkv(0x09, 0x1F); CV[185] = dkv(0x0B, 0x21); CV[245] = dkv(0x0C, 0x22);
      pk_x(1, dkv(0x01, 0x17), -1, 0x3F, 1, -1, -1, -1, -1, -1); pk_b(1, -1, -1, -1, -1, dkv(0x15, 0x2B), -1); pk_bud(0x3F);
    );
    pid == 120 || pid == 121 ? (CV[181] = dkv(0x1C, 0x42); CV[245] = dkv(0x02, 0x22); pk_b(1, -1, -1, -1, -1, dkv(0x4A, 0x4B), -1));   // DJ Console 4-Mx: SHIFT, reloop (FX button 2)
    pid == 122 || pid == 123 ? (CV[181] = 0x2D; CV[144] = 1; CV[146] = dkv(0x01, 0x15); CV[245] = dkv(0x03, 0x17);
      pk_x(1, dkv(0x13, 0x27), -1, -1, 1, -1, -1, -1, -1, -1); pk_b(1, -1, -1, -1, -1, dkv(0x11, 0x25), -1));   // (⚪141) Mk4: SCRATCH held = SHIFT
    pid == 124 || pid == 125 ? (CV[181] = dkv(0x1C, 0x42); CV[48] = 1; CV[105] = 6; pk_b(1, -1, -1, -1, -1, dkv(0x4A, 0x4B), -1));   // (⚪141) 4Set
    pid == 72 || pid == 73 ? (pk_x(1, dkv(0x63, 0x64), -1, 0x1C, 1, -1, -1, -1, -1, -1); CV[131] = 1; pk_b(1, 0x1A, -1, -1, -1, dkv(0x4B, 0x34), -1); pk_bud(0x1C));
    pid == 76 || pid == 77 ? (pk_x(1, dkv(0x63, 0x64), -1, dkv(0x1B, 0x1E), 1, -1, -1, -1, -1, -1); CV[131] = 1; pk_b(1, 0x1A, -1, -1, -1, dkv(0x4B, 0x34), -1); pk_bud(dkv(0x1B, 0x1E)));
    pid == 110 || pid == 111 ? pk_b(1, -1, -1, -1, -1, dkv(0x11, 0x25), -1);
    pid == 46 || pid == 47 ? pk_bud(dkv(0x04, -1));
    pid == 68 || pid == 69 || pid == 74 || pid == 75 || pid == 82 || pid == 83 || pid == 86 || pid == 87 || pid == 122 || pid == 123 ? pk_bud(-1);
    pid == 98 || pid == 99 ? (   // Korg KAOSS DJ (ch 8 / 9): SHIFT 0x1A; loop 0x10, half 0x0F, double 0x11, SHIFT 0x29 = reloop; FX 0x18
      CV[181] = 0x1A; CV[144] = dk + 7; CV[146] = 0x10; CV[184] = 0x0F; CV[185] = 0x11; CV[245] = 0x29; CV[228] = 0x0F;
      slider84 = dk + 7; CV[107] = 0x18; pk_b(7, 0x1E, -1, -1, -1, -1, -1);
    );
    pid == 100 || pid == 101 ? (CV[240] = dkv(0x40, 0x47); pk_b(1, 0x1A, -1, -1, -1, dkv(0x4B, 0x34), -1));   // Gemini FirstMix: REV = backward while held
    pid == 102 || pid == 103 ? (CV[240] = dkv(0x33, 0x3C); pk_b(1, 0x1A, -1, -1, -1, dkv(0x4B, 0x34), -1));   // ION Discover DJ: REVERSE
    pid == 104 || pid == 105 ? (CV[144] = 1; CV[146] = dkv(0x53, 0x56); CV[245] = dkv(0x55, 0x58); CV[239] = dkv(0x63, 0x64); pk_b(1, 0x1A, -1, -1, -1, dkv(0x4B, 0x34), -1));   // Discover DJ Pro
    pid == 106 || pid == 107 ? (CV[144] = 1; CV[146] = dkv(0x12, 0x22); pk_b(1, 0x32, -1, -1, -1, dkv(0x14, 0x25), -1); CV[246] = 1);   // Behringer CMD Micro: beat loop 4
    // XDJ-RX3 / XZ: the mixer on ch 5
    pid == 30 || pid == 31 ? (
      pk_s(5, 0x3F, dk, 0x29, -1);
      CV[122] = 5; CV[131] = 0;
      pk_f(dkv(0x02, 0x07), dkv(0x04, 0x09), 4 * 128 + dkv(0x03, 0x08), dkv(0x05, 0x0A), 0);
      pk_l(0x43, 0x08, 0x0C, 0x0B);
      pk_b(1, 0x4F, 0x33, 0x60, 0x61, -1, -1);
    );
    sliderchange(slider84); sliderchange(slider85); 
    // --- lights (⚪77; from the makers' MIDI lists and Mixxx's mappings; none tried on the
    // units yet but the APC40 mkII). The lights go to the same channels and notes the buttons send. One colour (on value):
    // the DDJ with single-colour pads (the FLX2 too: its list read as pictures), Numark, Hercules but the Inpulse 500, Korg, Gemini, ION, Behringer, older Reloop;
    // colour: Reloop Buddy / Ready / Mixon 8 Pro (bit 6 = bright, RR GG BB), Mixon 4, the DDJ-800 / 1000 / FLX10 / REV5 /
    // SX3 / XDJ-RX3 / XZ (Pioneer DJ's palette), Inpulse 500, Prime 4, SC5000 / SC6000, the HID bridge (Reloop's RGB to its
    // own loopMIDI port "ReaScratch LED"; the HID bridge turns it into the units' HID output). None: CDJ (no MIDI out
    // in their lists), APC40 one-deck presets (4, 5)
    pr == 2 || pr == 3 || pr == 8 || pr == 9 || (pid >= 14 && pid <= 19) || pid == 26 || pid == 27 || pid == 34 || pid == 35 ||
      (pid >= 88 && pid <= 93) ? (
      preset_lt(3, 127);
    );
    (pid >= 20 && pid <= 25) || pid == 28 || pid == 29 || pid == 30 || pid == 31 || pid == 44 || pid == 45 ? (
      preset_lt(6, 127);
    );
    pid == 6 || pid == 7 || pid == 32 || pid == 33 || pid == 40 || pid == 41 || pid == 62 || pid == 63 ? (
      preset_lt(4, 127);
    );
    pid == 36 || pid == 37 ? (
      preset_lt(5, 127);
    );
    (pid >= 46 && pid <= 49) || (pid >= 64 && pid <= 71) || pid == 108 || pid == 109 ||
      pid == 94 || pid == 95 || pid == 96 || pid == 97 || pid == 114 || pid == 115 ||
      pid == 38 || pid == 39 || pid == 42 || pid == 43 || pid == 54 || pid == 55 || pid == 56 || pid == 57 ? (
      preset_lt(3, 127);
    );
    (pid >= 72 && pid <= 77) || pid == 100 || pid == 101 || pid == 104 || pid == 105 ? (
      preset_lt(3, 100);   // Mixtrack (the first, Pro, 2), FirstMix, Discover DJ Pro: 0x64
    );
    pid == 50 || pid == 51 || (pid >= 82 && pid <= 87) || (pid >= 110 && pid <= 113) || (pid >= 120 && pid <= 125) || pid == 98 ||
      pid == 99 || pid == 102 || pid == 103 ? (
      preset_lt(3, 127);
    );
    pid >= 78 && pid <= 81 ? (
      preset_lt(3, 126);   // Starlight / MIX: the pads 0x7E (Mixxx)
    );
    pid == 106 || pid == 107 ? (
      preset_lt(3, 1);   // CMD Micro: 0x01 (Mixxx, read the other way round; a guess)
    );
    pid == 52 || pid == 53 ? (
      preset_lt(7, 127);
    );
    pid == 58 || pid == 59 ? (
      preset_lt(8, 127);
    );
    pid == 60 || pid == 61 ? (
      preset_lt(9, 127);
    );
    pid >= 116 && pid <= 119 ? (
      preset_lt(pid <= 117 ? 1 : 2, 1);   // APC40 mkII / mkI (as the presets above set)
    );
    // (⚪212) the turntables: PLX-CRSS12 = Pioneer DJ's palette (its MIDI list: the pads lit in the colour number 0x01-0x7F
    // sent to the note they send), RP-8000 MK2 = Reloop's RGB as the Buddy's (⚪216: the Traktor mapping's values), Rane Twelve MKII
    // = one colour (the Mixxx forum's mapping: the cue pads take a colour 1-127 on their notes; its palette not known).
    // The DVS preset alone has no unit to light. The CDJs take no lights (no MIDI in for them in their lists)
    pid == 128 || pid == 129 ? preset_lt(6, 127);
    pid == 130 || pid == 131 ? preset_lt(4, 127);
    // (⚪213) the Rane Twelve's strip LEDs take a colour as 0b0RRGGBB (Mixxx forum mapping: white 127, red 112, green 28,
    // teal 15, yellow 60, purple 18; the same as Numark NS6II's pads, inMusic): Reloop's RGB type. The RP-8000 (MK1): one
    // colour 127 / 0 (its mappings)
    pid == 132 || pid == 133 ? preset_lt(4, 127);
    pid == 134 || pid == 135 ? preset_lt(3, 127);
    pid > 0 ? pv_def();   // (⚪189; Custom keeps its own)
    pid > 0 ? ld_def();   // (⚪193)
    // Reloop Ready: the Buddy's numbers (Mixxx PR 4513: jog CC 6 two's complement 300 / rev, touch 6, PLAY 0, CUE 1,
    // pads ch 5 / 6 notes 20-27 + SHIFT 28-35, tempo CC 9 + 0x3F, fader 0x1C, PFL 0x1B, crossfader ch 15 CC 8)
);

// (⚪110, user's request 2026-10-09) two controllers at once (the Reloop Buddy and the APC40 mkII): slider 230 = the second
// controller's preset (the Preset list; 0 = none). Its MIDI comes on bus 2 (setup: the "controller 2 in" track, input =
// that controller, sends it to both engines on bus 2; the engines' own input = the first controller) and its lights go
// out on bus 2 ("lights 2" takes bus 2 to it, "lights 1" bus 1 to the first). Every controller setting (WZ_CTL, but the
// crossfader side: a deck has one side, the APC40 toggles it) is kept twice: the sliders = the first controller's (as
// before), CXB = the second's (what its preset sets, made again whenever slider 230 changes). While a bus 2 message is
// handled, and while the second controller's lights are sent, the sliders hold CXB (cx_swap), so the same code reads
// either controller; outside @block's MIDI loop they always hold the first's. Its own MIDI state goes with them (cx_vs)
CXL = 44000; CXA = 44300; CXB = 44600; CXVA = 44900; CXVB = 44950; APL_B = 45000; APR_B = 47100;
CXN = 0; cx_i = 0;
loop(strlen(WZ_CTL) / 3,
  cx_v = (str_getchar(WZ_CTL, 3 * cx_i) - 48) * 100 + (str_getchar(WZ_CTL, 3 * cx_i + 1) - 48) * 10 + str_getchar(WZ_CTL, 3 * cx_i + 2) - 48;
  cx_v != 33 ? (CXL[CXN] = cx_v; CXN += 1);
  cx_i += 1;
);
cx_on = 0; cx_cur = 0; cx_last = -1; jt_at = 0; jt_ar = 0; jt_on = 0;
function cx_vs(o) (   // the controller's own state -> o
  o[0] = APL; o[1] = APR; o[2] = apc_type; o[3] = apc_sx; o[4] = apc_g112; o[5] = apc_clr; o[6] = apc_selw; o[7] = apc_full;
  o[8] = jk_last; o[9] = kp_page; o[10] = kp_eff; o[11] = te_msb; o[12] = te_lw; o[13] = xf_msb; o[14] = xf_lw;
  o[15] = abs_msb; o[16] = abs_lsb; o[17] = dn_msb; o[18] = dn_have; o[19] = dn_prev; o[20] = rn_prev; o[21] = rn_have;
);
function cx_vl(o) (
  APL = o[0]; APR = o[1]; apc_type = o[2]; apc_sx = o[3]; apc_g112 = o[4]; apc_clr = o[5]; apc_selw = o[6]; apc_full = o[7];
  jk_last = o[8]; kp_page = o[9]; kp_eff = o[10]; te_msb = o[11]; te_lw = o[12]; xf_msb = o[13]; xf_lw = o[14];
  abs_msb = o[15]; abs_lsb = o[16]; dn_msb = o[17]; dn_have = o[18]; dn_prev = o[19]; rn_prev = o[20]; rn_have = o[21];
);
// the sliders (and that state) to controller c: 0 = the first, 1 = the second; MIDI sent from here goes out on its bus
function cx_swap(c) local(i, f, t) (
  c != cx_cur ? (
    f = cx_cur ? CXB : CXA; t = c ? CXB : CXA;
    i = 0; loop(CXN, f[i] = sv(CXL[i]); sv_set(CXL[i], t[i]); i += 1);
    cx_vs(cx_cur ? CXVB : CXVA); cx_vl(c ? CXVB : CXVA);
    cx_cur = c;
    spt = fsr / max(CV[9], 1); auto_touch = CV[12] == 0; autorel = CV[13] * srate / 1000;
  );
  midi_bus = c;
);
// the second controller's settings from its preset (the sliders keep the first's); its state as at the start
function cx_build() local(i, s1, s33) (
  cx_cur ? cx_swap(0);
  cx_on = 0;
  slider230 > 0 ? (
    i = 0; loop(CXN, CXA[i] = sv(CXL[i]); i += 1);
    s1 = slider1; s33 = slider33;
    slider1 = slider230; preset_run();
    i = 0; loop(CXN, CXB[i] = sv(CXL[i]); sv_set(CXL[i], CXA[i]); i += 1);
    slider1 = s1; slider33 = s33; pid = p_old(slider1); dk = pid & 1 ? 2 : 1;
    CXVB[0] = APL_B; CXVB[1] = APR_B; CXVB[2] = -1; CXVB[3] = 0; CXVB[4] = gmem[112]; CXVB[5] = gmem[47]; CXVB[6] = -1; CXVB[7] = 0;
    CXVB[8] = -1; CXVB[9] = 0; CXVB[10] = 0; CXVB[11] = 0; CXVB[12] = -1; CXVB[13] = 64; CXVB[14] = -1;
    CXVB[15] = 0; CXVB[16] = 0; CXVB[17] = 0; CXVB[18] = 0; CXVB[19] = 0; CXVB[20] = 0; CXVB[21] = 0;
    memset(APL_B, -1, 2048); memset(APR_B, -1, 24);
    cx_on = 1;
  );
  midi_bus = 0;
);
// ((user's choices 2026-10-13) the APC40 mkII as the Buddy's helper: when it is the second controller (its MIDI on bus 2,
// cx_cur = 1 while its messages and lights are handled), its crossfader is left out (the Buddy's rules), TRACK KNOB 1 / 5
// (the jog knob alone) = the sound of deck A's / B's video FX, the master fader and track fader 1 / 5 pick up, and SCENE
// LAUNCH 1-5 pick the clip grid's page (gmem [238], both decks): 1 = as before, 2 = the blends and transitions, 3 / 4 =
// deck A's / B's video FX type, 5 = the master's
function ax_on() ( cx_on && cx_cur == 1 && CV[135] == 1; );
function ax_pg() ( max(1, min(5, gmem[238] | 0)); );
// @block's per-controller lines before the MIDI loop (the knob pages, the jog's scale and touch, the jog knob back to 64)
function cx_pre() (
  // (⚪107, user's choice 2026-10-09) APC40: SHIFT held = the knobs' page 2 (SENDS) for the moment
  kp_new = CV[214] >= 0 && CV[181] >= 0 && hc_sh ? 1 : kp_page;
  kp_new != kp_eff ? (kp_eff = kp_new; memset(APR + 8, -1, 4); !kp_eff && CV[8] == 7 && CV[214] >= 0 && !ax_on() ? (midisend(0, 0xB0 | (CV[6] - 1), CV[7], 64); jk_last = 64));
  spt = fsr / max(CV[9], 1);     // file frames per jog tick
  auto_touch = CV[12] == 0;
  CV[8] == 7 && jk_last >= 0 && jk_last != 64 && jog_idle > 0.5 * srate && !ax_on() ? (midisend(0, 0xB0 | (CV[6] - 1), CV[7], 64); jk_last = 64);   // (⚪92)
);
// after a message (two controllers): which one's jog touched last decides the auto release (a jog without a touch sensor,
// as the APC40's knob, is let go after its Auto release; the Buddy's touch note lets go itself)
function cx_after() (
  jog_idle == 0 ? (jt_at = 1; jt_ar = autorel; jt_on = CV[13] > 0) : jog_idle = cx_ji;
  !auto_touch && CV[12] > 0 && (m1 & 0x0F) == CV[6] - 1 && ((m1 & 0xF0) == 0x90 || (m1 & 0xF0) == 0x80) && m2 == CV[12] ? jt_at = 0;
);

// all slider-dependent state; called from @slider, and from @block when the GUI changed a slider
function apply_sliders() (
  // ((⚪152, user's choice 2026-10-13: the kit not handed out widely yet) the settings versions 1-6's conversions went (the
  // master video FX CC's -1, the Preset slider's numbering, the VHS knob, the vibrato step): the projects then had been
  // saved again at 7 first. An older project is not converted: its preset can be another and its settings off
  slider108 < 7 ? (strcpy(#tt_msg, "saved by an older ReaScratch: preset and settings not converted (check them)"); tt_msg_t = time_precise();
                   slider108 = 7; sliderchange(slider108));
  // preset: copies its values into the controller settings (CV) (Custom = leave them alone;
  // to keep a hand-tweaked value after a reload, switch the preset back to Custom)
  slider1 != last_preset ? (last_preset = slider1; preset_run(); pdm_mode = 1; pr_fresh = 1);   // ((⚪112) a new preset starts in HOT CUE)
  slider230 != cx_last ? (cx_last = slider230; cx_build());   // (⚪110) the second controller's settings
  !so_hold && sm_changed() ? sm_load_all(SM_N);   // (not while the slot menu's file sliders are being set: so_run)
  // the slot in use: the first time (project opened / FX loaded) the sliders already hold its values; later a change of
  // slider 72 (import script, automation) switches like a pad, also to an empty slot
  sm_cur < 0 ? (sm_cur = max(0, min(SM_N - 1, slider72 - 1)); sm_use(sm_cur); SM[sm_cur * 16 + 15] = 0; sm_save(sm_cur))
             : slider72 - 1 != sm_cur ? sm_switch(slider72 - 1, 1);
  slider75 > 0 ? (sm_clear(min(SM_N, slider75) - 1); slider75 = 0; sliderchange(slider75));
  slider172 > 0 ? (sm_newfile(min(SM_N, slider172) - 1); slider172 = 0; sliderchange(slider172));
  slider175 > 0 ? (so_cmd = slider175; so_a = slider176 - 1; so_b = slider177 - 1; slider175 = 0; sliderchange(slider175));   // done in @block
  grain_calc();
  nb_k = 1 - exp(-1 / (0.03 * srate));                     // jog bend let out with a 30 ms time constant (~0.1 s)
  smooth_k = 1 - exp(-1 / (max(slider11, 0.1) * 0.0005 * srate));   // three stages of half the time each (about 1.5 x the time in all)
  autorel = CV[13] * srate / 1000;                       // auto release in output samples
  tp_k = 1 - exp(-1 / (0.01 * srate));                     // slider 52 glide (10 ms)
  tp_vk = 1 - exp(-1 / (0.005 * srate));                   // speed estimates (5 ms)
  // (2026-10-22, user's report: the brake after a fast backward jog spin came too soon) the hand's speed before it lets go,
  // averaged over 80 ms: the spin on release starts from it (a jog slows in the last ms before the touch note-off)
  sp_k = 1 - exp(-1 / (0.08 * srate));
  tp_xs = 1 / (0.005 * srate);                             // jump cross-fade (5 ms)
  slider4 != lastcue ? (
    jump_to(slider4 * fsr);
    lastcue = slider4;
    prev_start = PS_NONE;
  );
);

// ---------------------------------------------------------------- APC40 (⚪76, user's requests 2026-10-07: two decks on
// one APC40, the jog by the mouse, the knobs and buttons as printed; the pads lit in the hot cues' colours)
// the selected deck: the deck select buttons (APC40: TRACK SELECT 1 / 2) write gmem[40] = 1 / 2; the shared buttons
// (PLAY, CUE, SYNC, the tempo encoder, nudge, tap, stop, samples 5-8) act on the selected deck only. None picked yet = A
function apc_sel() ( CV[123] < 0 || (gmem[40] ? gmem[40] == (slider76 == 2 ? 2 : 1) : slider76 != 2); );
// (user's choices 2026-10-13) the APC40's MASTER held (gmem[262], lit): PLAY, CUE and SYNC act on both decks (PLAY: both
// play / stop together); with the APC40 as the Buddy's helper the Buddy's too (CUE / SYNC passed to the other deck through
// gmem[263]-[268]). Only with an APC40 there (its preset, or a second controller). Buttons only: the knobs on both decks
// read as broken (user's report: it was a switch left on, and the knobs then moved both decks)
function apc_both() ( gmem[262] && (cx_on || CV[215] >= 0); );
function apc_rel(v) ( v < 64 ? v : v - 128; );   // a relative encoder's step (two's complement)
function knob_rel(v) ( CV[246] ? v - 64 : apc_rel(v); );   // (⚪112) the loop / browse knobs: slider 246 = 64-centre (Reloop, Hercules ...)
// pad k of a row of n starting at channel c (1-16) and note: in a row = consecutive notes on one channel; across
// channels (APC40 mkI, slider 134: a row of the clip grid is one note on channels 1-8) = channel c + k, the same note.
// apc_pad: the pad index of a message (-1 = none); apc_at: where pad k is (apc_c = channel 1-16, apc_n = note)
function apc_pad(c, note, n, ch, nt) (
  c <= 0 ? -1 : CV[134] ? (nt == note && ch >= c - 1 && ch < c - 1 + n ? ch - (c - 1) : -1)
                          : (ch == c - 1 && nt >= note && nt < note + n ? nt - note : -1);
);
function apc_at(c, note, k) ( CV[134] ? (apc_c = c + k; apc_n = note) : (apc_c = c; apc_n = note + k); );
// a hot cue pad's index 0-7 (-1 = none): the row from the pad 1 note, then the hot cues 5-8 row (slider 180) after it
function hc_pk(ch, nt) local(k) (
  k = apc_pad(CV[46], CV[47], CV[120], ch, nt);
  k < 0 && CV[180] && CV[120] <= 4 ? (k = apc_pad(CV[46], CV[47] + CV[180], CV[120], ch, nt); k >= 0 ? k += CV[120]);
  k;
);
// the hot cue pads' count with the hot cues 5-8 row, and where pad k is (as hc_pk counts them)
function hc_np() ( CV[180] && CV[120] <= 4 ? 2 * CV[120] : CV[120]; );
function hc_at(k) ( k < CV[120] ? apc_at(CV[46], CV[47], k) : apc_at(CV[46], CV[47] + CV[180], k - CV[120]); );
// pad modes (Buddy: the mode button held + a pad; APC40: the DEVICE buttons, slider 182)
function pdm_on() ( CV[102] >= 0 || CV[182] >= 0 || CV[234] > 0; );
// (⚪112) pad modes the unit switches itself (slider 234; DDJ: each mode's pads send their own notes, its mode buttons send
// notes on the deck channel). pb_get(k): printed mode k (0-3 the mode buttons, 4-7 their SHIFT layer) -> pb_bn = its
// button's note (deck channel), pb_base = its pads' first note (pad channel; SHIFT + pad = the SHIFT pad channel, the same
// notes), pb_md = the ReaScratch mode (pdm_mode; 2 = the samples, read through sliders 73 / 74 as before).
// Every layout has its 8 modes' pads at 0x00, 0x10 .. 0x70 (pb_base = k * 16; a second page / bank / SHIFT at +8). The
// printed modes, in the order of their pads, and the ReaScratch modes they are (user's choice 2026-10-09: each printed mode
// to the nearest ReaScratch mode, the rest to the modes left; the makers' MIDI lists):
//  1 DDJ rekordbox (FLX4 / 400 / FLX6 / 800 / 1000 / FLX10; FLX2 = the first 4 blocks, no mode buttons): HOT CUE, PAD FX1,
//    BEAT JUMP, SAMPLER, KEYBOARD, PAD FX2 (FLX6: KEY SHIFT), BEAT LOOP, KEY SHIFT (FLX6: SP.SCRATCH) = HOT CUE, TOUCH FX,
//    SLICER, samples, PITCH PLAY, BOUNCE LOOP, AUTO LOOP, NEURAL MIX; buttons 0x1B 0x1E 0x20 0x22, SHIFT 0x69 0x6B 0x6D 0x6F
//    (the DDJ-400's BEAT LOOP button sends 0x6D and SHIFT + it 0x1E: the notes name the modes, not the buttons)
//  2 DDJ-REV1: HOT CUE, AUTO LOOP, TRACKING SCRATCH, SAMPLER, BEAT JUMP, ROLL, TRANS, SCRATCH BANK = HOT CUE, AUTO LOOP,
//    PITCH PLAY, samples, SLICER, BOUNCE LOOP, TOUCH FX, NEURAL MIX; the same buttons as 1
//  3 DDJ-SB3: HOT CUE, FADE MIX, PAD SCRATCH, SAMPLER, BEAT JUMP, ROLL, SLICER, TRANS = HOT CUE, FILTER TYPE, NEURAL MIX,
//    samples, AUTO LOOP, BOUNCE LOOP, SLICER, TOUCH FX; buttons as 1 but SHIFT + SAMPLER 0x6E
//  4 DDJ-SX / SX3: HOT CUE, ROLL, SLICER, SAMPLER, CUE LOOP, SAVED LOOP, SLICER LOOP, PITCH PLAY = HOT CUE, BOUNCE LOOP,
//    SLICER, samples, AUTO LOOP, NEURAL MIX, TOUCH FX, PITCH PLAY; buttons as 3 (the SX's SHIFT + SAMPLER 0x6F too)
//  5 XDJ-RX3 / XZ: HOT CUE, BEAT LOOP, SLIP LOOP, BEAT JUMP, EXTENSION 1-4 = HOT CUE, AUTO LOOP, BOUNCE LOOP, SLICER,
//    TOUCH FX, PITCH PLAY, NEURAL MIX, FILTER TYPE; buttons 0x22-0x25, SHIFT 0x26-0x29
//  6 DDJ-REV5: HOT CUE, ROLL, SAVED LOOP, SAMPLER, PITCH PLAY, PIANO PLAY, STEMS, SCRATCH BANK = HOT CUE, BOUNCE LOOP,
//    AUTO LOOP, samples, PITCH PLAY, SLICER, TOUCH FX, NEURAL MIX; buttons 0x40-0x43, SHIFT 0x50-0x53
//  7 Hercules Inpulse 200 / 300 (one preset: the 300's 8 modes, Mixxx's names; the 200's 3rd block, FX, reads as SLICER):
//    HotCue, Roll, Slicer, Sampler, Toneplay, FX, Slicer loop, Beatjump = HOT CUE, BOUNCE LOOP, SLICER, samples, PITCH PLAY,
//    TOUCH FX, AUTO LOOP, NEURAL MIX; buttons (deck channel) MODE 1-8 = 0x0F-0x16 (Hercules' lists)
//  8 Hercules Inpulse 500: HotCue, Loop, Slicer, Sampler, Pitch, Roll, Effect, BeatJump = HOT CUE, AUTO LOOP, SLICER, samples,
//    PITCH PLAY, BOUNCE LOOP, TOUCH FX, NEURAL MIX; buttons 0x0F-0x16
//  9 Reloop Mixon 4 (8 notes a mode, SHIFT + 0x40): HOT CUE, LOOP ROLL, SAMPLER, SLICER, CUE LOOP, SAVED LOOPS, PITCH PLAY,
//    SLICER LOOP = HOT CUE, BOUNCE LOOP, samples, SLICER, AUTO LOOP, NEURAL MIX, PITCH PLAY, TOUCH FX; buttons 0x16-0x1D
// 10 Reloop Terminal Mix 8 (8 a mode, SHIFT + 0x40): HOT CUE, LOOP, SAMPLER, SLICE, MODE 1-4 = HOT CUE, AUTO LOOP, samples,
//    SLICER, BOUNCE LOOP, TOUCH FX, PITCH PLAY, NEURAL MIX; buttons 0x11-0x14, SHIFT 0x51-0x54
// 11 Reloop Beatpad 2 (8 a mode, SHIFT + 0x40): HOT CUE, AUTO LOOP, TOUCH FX, SLICER, SAMPLER, BOUNCE LOOP, JOG FX, SLICER
//    LOOP = HOT CUE, AUTO LOOP, TOUCH FX, SLICER, samples, BOUNCE LOOP, NEURAL MIX, PITCH PLAY; buttons 0x48-0x4F
// 12 Numark DJ2GO2 (Touch) (4 pads from note 1 a mode; Numark's Traktor map): Cue, Auto Loop, Manual Loop, Sampler = HOT CUE,
//    AUTO LOOP, BOUNCE LOOP, samples; no button notes
// 13 Numark Mixtrack (Pro) 3: Hot Cue 0x1B, Auto Loop 0x17, Sampler 0x20 (4 pads each; one mode button that turns round)
// 14 Numark Mixtrack Platinum: hot cues 0x18, auto loop 0x14; buttons on the pad channel 0x0B / 0x06
// 15-18: the pads send the same notes in every mode, only the mode buttons tell it (pb_tb): 15 Numark Mixtrack Pro /
//    Platinum FX (buttons on the pad channel: HOTCUE 0x00, AUTO LOOP 0x0D, SAMPLE1 0x0B = samples, SHIFT: BEATJUMP 0x02 =
//    SLICER, SAMPLE2 0x0F = TOUCH FX; FADER CUTS 0x07 sends the crossfader: not a mode here), 16 Numark Party Mix II / Live
//    (the mode it turned to, on the pad channel: Cue 0x00, Loop 0x0E = AUTO LOOP, Sampler 0x0B, Effects 0x0F = TOUCH FX),
//    17 Denon DJ Prime 4 (deck channel: HOT CUE 0x0B, LOOP 0x0C = AUTO LOOP, ROLL 0x0D = BOUNCE LOOP, SLICER 0x0E), 18 Denon
//    DJ SC5000 / SC6000 (HOT CUE 0x1B, ROLL 0x1C = BOUNCE LOOP, SLICER 0x1D, LOOP 0x1E = AUTO LOOP)
// 19-22 (Mixxx's mappings, 2026-10-10): 19 Reloop Beatpad (4 pads a mode, SHIFT - 0x40): CUE 0x4C, LOOP 0x50 = AUTO LOOP,
//    INSTANT FX 0x54 = TOUCH FX, SAMPLER 0x58; buttons 0x48-0x4B. 20 Hercules DJControl Starlight (4 pads, SHIFT + 8): HOT CUE
//    0x00, LOOP 0x10 = AUTO LOOP, FX 0x20 = TOUCH FX, SAMPLER 0x30; 21 DJControl MIX: SAMPLER 0x10, FX 0x20, LOOP 0x30 (no button
//    notes). 22 DJControl Jogvision: HOT CUE 0x10, SAMPLER 0x20
// 23-24 (⚪112, 6th pass 2026-10-11; the pads the same in every mode, the mode notes on the pad channel, as 15-18): 23 Numark
//    Party Mix, the first one (rylito's and Mixxx's mappings agree; not the II's numbers): its PAD MODE turns round Cue 0x00,
//    Loop 0x0B = AUTO LOOP, Sampler 0x0E, Effects 0x18 = TOUCH FX. 24 Reloop Mixon 8 Pro (a user's djay mapping; which
//    printed button sends which note not known): hot cue 0x00, roll 0x08 = BOUNCE LOOP, slicer 0x09, sampler 0x0B, saved loop
//    0x0D = AUTO LOOP, pitch play 0x0F, stems 0x24 = NEURAL MIX, instant FX 0x02 = TOUCH FX
// pb_bc = the buttons are on the pad channel; pb_pg = a second page at + 8 (DDJ); pb_tb = the pads are the same in every mode
function pb_8(k, a, b, c, d, e, f, g, h) ( k == 0 ? a : k == 1 ? b : k == 2 ? c : k == 3 ? d : k == 4 ? e : k == 5 ? f : k == 6 ? g : h; );
function pb_t(bn, base, md) ( pb_bn = bn; pb_base = base; pb_md = md; );
function pb_get(k) local(l) (
  l = CV[234]; pb_b2 = -1; pb_bc = l == 14 || l == 15 || l == 16 || l >= 23; pb_pg = l == 1 || l == 6; pb_tb = (l >= 15 && l <= 18) || l >= 23;
  l >= 1 && l <= 6 ? (
    pb_base = k * 16;
    pb_bn = l == 5 ? 0x22 + k : l == 6 ? (k < 4 ? 0x40 + k : 0x4C + k) :
            k == 0 ? 0x1B : k == 1 ? 0x1E : k == 2 ? 0x20 : k == 3 ? 0x22 : k == 4 ? 0x69 : k == 5 ? 0x6B : k == 6 ? 0x6D :
            l == 3 || l == 4 ? 0x6E : 0x6F;
    l == 4 && k == 7 ? pb_b2 = 0x6F;
    pb_md = l == 1 ? (k == 0 ? 1 : k == 1 ? 5 : k == 2 ? 6 : k == 3 ? 2 : k == 4 ? 12 : k == 5 ? 7 : k == 6 ? 4 : 8) :
            l == 2 ? (k == 0 ? 1 : k == 1 ? 4 : k == 2 ? 12 : k == 3 ? 2 : k == 4 ? 6 : k == 5 ? 7 : k == 6 ? 5 : 8) :
            l == 3 ? (k == 0 ? 1 : k == 1 ? 10 : k == 2 ? 8 : k == 3 ? 2 : k == 4 ? 4 : k == 5 ? 7 : k == 6 ? 6 : 5) :
            l == 4 ? (k == 0 ? 1 : k == 1 ? 7 : k == 2 ? 6 : k == 3 ? 2 : k == 4 ? 4 : k == 5 ? 8 : k == 6 ? 5 : 12) :
            l == 5 ? (k == 0 ? 1 : k == 1 ? 4 : k == 2 ? 7 : k == 3 ? 6 : k == 4 ? 5 : k == 5 ? 12 : k == 6 ? 8 : 10) :
                     (k == 0 ? 1 : k == 1 ? 7 : k == 2 ? 4 : k == 3 ? 2 : k == 4 ? 12 : k == 5 ? 6 : k == 6 ? 5 : 8);
  ) :
  l == 7 ? pb_t(0x0F + k, 16 * k, pb_8(k, 1, 7, 6, 2, 12, 5, 4, 8)) :
  l == 8 ? pb_t(0x0F + k, 16 * k, pb_8(k, 1, 4, 6, 2, 12, 7, 5, 8)) :
  l == 9 ? pb_t(0x16 + k, 8 * k, pb_8(k, 1, 7, 2, 6, 4, 8, 12, 5)) :
  l == 10 ? pb_t(k < 4 ? 0x11 + k : 0x4D + k, 8 * k, pb_8(k, 1, 4, 2, 6, 7, 5, 12, 8)) :
  l == 11 ? pb_t(0x48 + k, 8 * k, pb_8(k, 1, 4, 5, 6, 2, 7, 8, 12)) :
  l == 12 ? (k < 4 ? pb_t(-1, 16 * k + 1, pb_8(k, 1, 4, 7, 2, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 13 ? (k < 3 ? pb_t(-1, pb_8(k, 0x1B, 0x17, 0x20, 0, 0, 0, 0, 0), pb_8(k, 1, 4, 2, 0, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 14 ? (k < 2 ? pb_t(k ? 0x06 : 0x0B, k ? 0x14 : 0x18, k ? 4 : 1) : pb_t(-1, -1, 0)) :
  l == 15 ? (k < 5 ? pb_t(pb_8(k, 0x00, 0x0D, 0x0B, 0x02, 0x0F, 0, 0, 0), -1, pb_8(k, 1, 4, 2, 6, 5, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 16 ? (k < 4 ? pb_t(pb_8(k, 0x00, 0x0E, 0x0B, 0x0F, 0, 0, 0, 0), -1, pb_8(k, 1, 4, 2, 5, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 17 ? (k < 4 ? pb_t(0x0B + k, -1, pb_8(k, 1, 4, 7, 6, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 18 ? (k < 4 ? pb_t(0x1B + k, -1, pb_8(k, 1, 7, 6, 4, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 19 ? (k < 4 ? pb_t(0x48 + k, 0x4C + 4 * k, pb_8(k, 1, 4, 5, 2, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 20 ? (k < 4 ? pb_t(-1, 16 * k, pb_8(k, 1, 4, 5, 2, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 21 ? (k < 4 ? pb_t(-1, 16 * k, pb_8(k, 1, 2, 5, 4, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 22 ? (k < 2 ? pb_t(-1, k ? 0x20 : 0x10, k ? 2 : 1) : pb_t(-1, -1, 0)) :
  l == 23 ? (k < 4 ? pb_t(pb_8(k, 0x00, 0x0B, 0x0E, 0x18, 0, 0, 0, 0), -1, pb_8(k, 1, 4, 2, 5, 0, 0, 0, 0)) : pb_t(-1, -1, 0)) :
  l == 24 ? pb_t(pb_8(k, 0x00, 0x08, 0x09, 0x0B, 0x0D, 0x0F, 0x24, 0x02), -1, pb_8(k, 1, 7, 6, 2, 4, 12, 8, 5)) :
  pb_t(-1, -1, 0);
);
function pb_shared() ( pb_get(0); pb_tb; );
// a pad's note -> its mode (0 = not a pad of a mode); pb_k = the pad 0-7, pb_sh = it came on the SHIFT pad channel
function pb_find(ch, nt) local(k, r, o, c2, p) (
  r = 0; c2 = CV[48] > 0 && CV[48] != CV[46] && ch == CV[48] - 1;
  CV[234] > 0 && ((CV[46] > 0 && ch == CV[46] - 1) || c2) ? (
    p = 0;
    loop(3,   // p 0 = a plain note, 1 = SHIFT at + slider 105 on the same channel, 2 = a second page at + 8
      k = 0;
      loop(8,
        pb_get(k); o = nt - pb_base - (p == 1 ? CV[105] : p == 2 ? 8 : 0);
        !r && pb_base >= 0 && (p == 0 || (p == 1 && CV[105] != 0 && !c2) || (p == 2 && pb_pg)) && o >= 0 && o < CV[120] ?
          (r = pb_md; pb_k = o; pb_sh = p == 1 || c2);
        k += 1;
      );
      p += 1;
    );
  );
  r;
);
function pb_base_of(m) local(k, b) ( b = -1; k = 0; loop(8, pb_get(k); b < 0 && pb_md == m ? b = pb_base; k += 1); b; );
// the FX knobs' sliders 200-207 (⚪94): k = 0 .. 7
// ((⚪120, user's choice 2026-10-10) knob 8 = VHS (slider 151, saved since ⚪121; it was a variable); Strobe =
// SHIFT + knob 8 (slider 207). The ring shows VHS, with SHIFT held Strobe)
// (user's choice 2026-10-12: a knob left a step or two up kept a whole effect running - the user's project had the
// Kaleidoscope knob at 0.087 and the Tint knob at 0.197, and a frame took 33 ms instead of 13) the FX knobs' play: under
// 0.05 = off, above it rescaled so the knob still reaches 1 (no jump at the edge). Picture and sound alike
function fxk_dz(v) ( v < 0.05 ? 0 : (v - 0.05) / 0.95; );
function fxk_get(k) ( k == 0 ? slider200 : k == 1 ? slider201 : k == 2 ? slider202 : k == 3 ? slider203 : k == 4 ? slider204 :
                      k == 5 ? slider205 : k == 6 ? slider206 : hc_sh ? slider207 : slider151; );
function fxk_set(k, v) (
  k == 0 ? (slider200 = v; sliderchange(slider200)) : k == 1 ? (slider201 = v; sliderchange(slider201)) :
  k == 2 ? (slider202 = v; sliderchange(slider202)) : k == 3 ? (slider203 = v; sliderchange(slider203)) :
  k == 4 ? (slider204 = v; sliderchange(slider204)) : k == 5 ? (slider205 = v; sliderchange(slider205)) :
  k == 6 ? (slider206 = v; sliderchange(slider206)) : hc_sh ? (slider207 = v; sliderchange(slider207)) : (slider151 = v; sliderchange(slider151));
);
// the mode of the k-th button (0-7): HOT CUE, AUTO LOOP, TOUCH FX, SLICER, BOUNCE LOOP, VIDEO FX, FILTER TYPE, PITCH PLAY
// (2026-10-09, user's choice: with the Buddy and the APC40 together the modes did not match) the modes of both in one order,
// the Buddy's buttons as printed: HOT CUE, AUTO LOOP, TOUCH FX, FILTER TYPE (the SAMPLER button) / SLICER, BOUNCE LOOP,
// PITCH PLAY (the NEURAL MIX button), NEURAL MIX = the memory cues and held moves (the LOOPER button). The APC40's DEVICE
// buttons 1-8 the same (it had VIDEO FX on the 6th: the DEVICE knobs do the video FX). No SAMPLER mode now: the APC40 has its
// own sample row; the Buddy switches samples by the keys, the mouse or the APC40
function pdm_btn(k) ( k == 0 ? 1 : k == 1 ? 4 : k == 2 ? 5 : k == 3 ? 10 : k == 4 ? 6 : k == 5 ? 7 : k == 6 ? 12 : 8; );
function pdm_name(m) (
  m == 1 ? (slider179 ? "pads: CUE LOOP" : "pads: HOT CUE") : m == 4 ? "pads: AUTO LOOP" : m == 5 ? "pads: TOUCH FX" : m == 10 ? "pads: FILTER TYPE" :
  m == 6 ? "pads: SLICER" : m == 7 ? "pads: BOUNCE LOOP" : m == 12 ? "pads: PITCH PLAY" : m == 8 ? (CV[182] >= 0 ? "pads: VIDEO BLEND (Add .. Chroma key; again = Mix)" : "pads: NEURAL MIX (memory cues, held moves)") :
  m == 9 ? "pads: VIDEO FX" : m == 2 ? "pads: SAMPLER" : m == 13 ? "pads: PATTERN (FILTER TYPE again = back)" : "pads: off";
);
// PITCH PLAY (⚪91, user's choice 2026-10-08; Serato's Pitch Play): pad k's key in semitones. Top row (pads 1-4) +1 .. +4,
// the second row (5-8) -3 .. 0 (lower row lower)
function pp_semi(k) ( k < 4 ? k + 1 : k - 7; );
// the slot before / after that has a file (APC40 UP / DOWN, ⚪91)
function sm_step(d) local(k) (
  k = sm_cur + d;
  while (k >= 0 && k < SM_N && SM[k * 16 + 1] <= 0) ( k += d; );
  k >= 0 && k < SM_N ? sm_switch(k, 0);
);
// back to the CUE (the memory cue called last) and on as it was (Buddy: SHIFT + PLAY, its own note; APC40: SHIFT + PLAY)
function cue_back() ( len > 0 ? (bl_off(); jump_to(min(slider4 * fsr, len - 1)); slider3 ? run_at(te_1x())); );
// the filter knobs (sliders 155-157; Buddy HIGH CC 23 = morph, LOW CC 25 = resonance, FILTER CC 26 = cutoff): centre
// (63-65) = morph 0 / filter off
function flt_cc(cc, v) (
  CV[155] >= 0 && cc == CV[155] ? (slider150 = abs(v - 64) <= 1 ? 0 : max(-0.5, min(0.5, (v - 64) / 126)); sliderchange(slider150));
  CV[156] >= 0 && cc == CV[156] ? (slider154 = v / 127; sliderchange(slider154));
  CV[157] >= 0 && cc == CV[157] ? (slider152 = abs(v - 64) <= 1 ? 0 : max(-1, min(1, (v - 64) / 63)); sliderchange(slider152));
);
// (⚪101, user's choices 2026-10-09) the deck knobs' pages (APC40 PAN / SENDS / USER; TRACK KNOB 1-4 / 5-8 = this deck's
// jog CC and the next 3): page 1 (kp_page 0) = jog, morph, resonance, cutoff (as before); page 2 = echo length, echo
// feedback, vibrato speed, gate / Strobe step; page 3 = volume, picture opacity, grain length, key (what the faders had
// before ⚪92). kp_set = a knob of page 2 / 3 turned (v 0..127), kp_ring = the value knob k shows on the page in use
function kp_set(k, v) (
  kp_eff == 1 ? (
    k == 0 ? (slider218 = min(5, floor(v * 6 / 128)); sliderchange(slider218)) :
    k == 1 ? (slider219 = v / 127 * 0.95; sliderchange(slider219)) :
    k == 2 ? (hc_sh ? vb_iv = min(12, floor(v * 13 / 128)) : (slider220 = min(5, floor(v * 6 / 128)); sliderchange(slider220))) :   // ((⚪123) SHIFT: the interval)
             (slider221 = min(4, floor(v * 5 / 128)); sliderchange(slider221));
  ) : (
    k == 0 ? (bvol_p = v / 127; bvol_g = sqr(bvol_p)) :
    k == 1 ? (slider195 = v / 127; sliderchange(slider195)) :
    k == 2 ? (slider18 = floor(10 + v / 127 * 190 + 0.5); sliderchange(slider18); grain_calc()) :
             (slider217 = abs(v - 64) <= 2 ? 0 : max(-12, min(12, floor((v - 64) / 63 * 12 + (v > 64 ? 0.5 : -0.5)))); sliderchange(slider217));
  );
  APR[8 + k] = v;   // (the knob shows it already)
);
// (⚪103, user's choice 2026-10-09) the filter knobs with SHIFT held (Buddy: HIGH / LOW / FILTER): echo length, echo
// feedback, key (as the APC40's knob pages). The knobs are absolute: after a SHIFT turn the filter waits for its knob to
// come back to where the filter is (pick-up, fpk0..2) before it follows again, so it does not jump
// ((user's request 2026-10-13) the SHIFT side picks up too: once the knob has been turned without SHIFT (fsk0 .. 2), echo length /
// feedback / key move only when the knob reaches the value (the same step, within 4 of 127, or crossed since the last
// SHIFT turn: fsl0 .. 2, -1 = none yet)
function flt_sh(cc, v) local(k, q) (
  CV[155] >= 0 && cc == CV[155] ? (k = min(5, floor(v * 6 / 128)); q = (slider218 + 0.5) * 128 / 6;
    !fsk0 || k == slider218 || (fsl0 >= 0 && (fsl0 - q) * (v - q) <= 0) ? (fsk0 = 0; slider218 = k; sliderchange(slider218); fpk0 = 1)
      : (strcpy(#tt_msg, "echo length: turn the knob to its place to pick up"); tt_msg_t = time_precise(); gui_dirty = 1); fsl0 = v; fpk0 = 1) :
  CV[156] >= 0 && cc == CV[156] ? (q = slider219 / 0.95 * 127;
    !fsk1 || abs(v - q) <= 4 || (fsl1 >= 0 && (fsl1 - q) * (v - q) <= 0) ? (fsk1 = 0; slider219 = v / 127 * 0.95; sliderchange(slider219); fpk1 = 1)
      : (strcpy(#tt_msg, "echo feedback: turn the knob to its place to pick up"); tt_msg_t = time_precise(); gui_dirty = 1); fsl1 = v; fpk1 = 1) :
  CV[157] >= 0 && cc == CV[157] ? (k = abs(v - 64) <= 2 ? 0 : max(-12, min(12, floor((v - 64) / 63 * 12 + (v > 64 ? 0.5 : -0.5)))); q = 64 + slider217 / 12 * 63;
    !fsk2 || k == slider217 || (fsl2 >= 0 && (fsl2 - q) * (v - q) <= 0) ? (fsk2 = 0; slider217 = k; sliderchange(slider217); fpk2 = 1)
      : (strcpy(#tt_msg, "key: turn the knob to its place to pick up"); tt_msg_t = time_precise(); gui_dirty = 1); fsl2 = v; fpk2 = 1);
);
function flt_pk(cc, v) (   // the filter knob, through its pick-up
