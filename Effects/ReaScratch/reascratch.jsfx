    abs(atan(g_pl_m / g_pl_e) - g_pl_sl) < g_pl_be ? (g_pl_be = abs(atan(g_pl_m / g_pl_e) - g_pl_sl); g_pl_n = g_pl_m; g_pl_dn = g_pl_e);
