  g_stab == 6 ? (g_sy -= 4; g_srow(73, g_sy, 0x6a5a2a); g_sy += 18; g_srow(74, g_sy, 0x6a5a2a); g_sy += 18; g_srow(121, g_sy, 0x6a5a2a); g_sy += 18; g_s = 102; loop(4, g_srow(g_s, g_sy, 0x6a5a2a); g_sy += 18; g_s += 1);
                 g_srow(318, g_sy, 0x6a5a2a); g_sy += 18; g_srow(319, g_sy, 0x6a5a2a); g_sy += 18) :
  // (⚪83 brake in beats, PAUSE quantize: 9 rows, 18 apart, else the last one ran into the bottom bar's 'front' button)
  g_stab == 4 ? (g_sy -= 4; g_srow(53, g_sy, 0x2e7d7a); g_sy += 18; g_srow(57, g_sy, 0x2e7d7a); g_sy += 18; g_srow(232, g_sy, 0x2e7d7a); g_sy += 18; g_srow(233, g_sy, 0x2e7d7a); g_sy += 18;
                 g_s = 58; loop(5, g_srow(g_s, g_sy, 0x2e7d7a); g_sy += 18; g_s += 1)) :
                (g_s = 46; loop(4, g_srow(g_s, g_sy, 0x8a3f7a); g_sy += 20; g_s += 1); g_srow(120, g_sy, 0x8a3f7a); g_sy += 20; g_srow(54, g_sy, 0x8a3f7a); g_sy += 20; g_srow(55, g_sy, 0x8a3f7a); g_sy += 20; g_srow(56, g_sy, 0x8a3f7a); g_sy += 20);
  g_ps_list();
  g_button(g_fl(g_W - 24 - 56, 56), g_H - 27, 56, 20, "front") ? g_page = 0;   // where 'setup' is on the front
  gfx_setfont(1); g_grey(0.15);
  g_fittext(strlen(g_hover_help) ? g_hover_help : "Shift = fine, double / right-click = default", g_mr ? 24 + 56 + 8 : 24, g_H - 24, g_W - 24 - 56 - 8 - 24);
);

// show the picture: dark surround, then the picture scaled by g_k with point sampling (gfx_mode 4) and no alpha (2)
gfx_dest = -1;
gfx_set(0.05, 0.07, 0.09, 1); gfx_rect(0, 0, gfx_w, gfx_h);
gfx_x = g_ox; gfx_y = g_oy; gfx_a = 1; gfx_mode = 6; gfx_blit(20, g_k, 0); gfx_mode = 0;
!(mouse_cap & 1) ? (g_press = 0; g_wdrag = 0; g_pl_drag = 0; ui_touch = 0; g_sdrag ? (g_sdrag = 0; seek_end()));
g_prev_mx = g_mx; g_prev_my = g_my;
g_prevcap = mouse_cap;
