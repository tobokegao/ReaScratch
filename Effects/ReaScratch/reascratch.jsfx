  g_ch == '%' ? gq_push(2, 5); (g_ch == '^' || g_ch == '&') ? gq_push(2, 6); g_ch == 39 ? gq_push(2, 7); (g_ch == '*' || g_ch == '(') ? gq_push(2, 8);
