      k += 1;
    );
  );
);
// a submenu header (ticked when the current preset is in menu positions a..b); last = it is the last item of the
// submenu it sits in (a group's last series): the "<" goes on its header, as on a model's
function pmn_head(title, a, b, last) local(k, cur) (
  cur = 0; k = a; while (k <= b) ( pmn_val(k) == pmn_cur ? cur = 1; k += 1; );
  last ? strcat(#pmn_m, "<");
  cur ? strcat(#pmn_m, "!");   // the maker of the current preset is ticked too
