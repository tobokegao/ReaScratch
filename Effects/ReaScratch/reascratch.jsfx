    g_click && g_inside(g_lx, g_ly, g_lw, 24) ? (g_sdrag = 1; seek_at = -1; seek_n = SEEK_SNIP * srate);
    g_sdrag ? (seek_goal = max(0, min(len - 2, ((mouse_x - g_ox) / g_k - g_lx - 4) / g_wn * (len - 1))); ui_seek = 1);   // also on the release frame: let go = exactly there
    // a hot cue line within 3 px of the pointer (in the strip under it): right-click clears it instead of setting the cue
    g_hc_hit = 0; g_i = 1;
