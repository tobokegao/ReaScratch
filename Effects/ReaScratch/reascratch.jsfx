  g_fb_x0 = g_pl_x - g_pl_r + g_fb_w1 + 8; g_fb_x1 = g_pl_x + g_pl_r - g_fb_w2 - 8;   // the slot between the words
  g_fb_v = slider52;
  g_grey(0.92); g_text("pitch", g_pl_x - g_pl_r - 1, g_fb_y - floor(g_th / 2)); g_text("tape", g_pl_x + g_pl_r - g_fb_w2 + 1, g_fb_y - floor(g_th / 2));   // Tahoma 12: 1 px of air left of "p" and right of "e"
  g_grey(0.05); gfx_rect(g_fb_x0, g_fb_y - 2, g_fb_x1 - g_fb_x0 + 1, 5); g_grey(0.45); gfx_line(g_fb_x0, g_fb_y + 3, g_fb_x1, g_fb_y + 3);
  g_grey(0.36); g_i = 0;
  loop(11, g_cx = floor(g_fb_x0 + (g_fb_x1 - g_fb_x0) * g_i / 10 + 0.5); gfx_line(g_cx, g_fb_y - 13, g_cx, g_fb_y - 10); g_i += 1);
  g_cx = floor(g_fb_x0 + (g_fb_x1 - g_fb_x0) * g_fb_v + 0.5);
  // indicator (Mac OS 8 slider style, as in its image): 11 px wide, its tip in its middle column, which is
  // put on g_cx - the same whole-pixel formula as the tick marks - so the tip meets a tick exactly at every tenth
  // and at both ends (user's requirement)
  g_tx_fc >= 0 ? (gfx_x = g_cx - 5; gfx_y = g_fb_y - 9; gfx_blit(16, 1, 0)) : (g_block(g_cx - 5, g_fb_y - 4, 11, 9, 0, 0.30, 0.95, 0); g_tone(2, 0); gfx_rect(g_cx - 5, g_fb_y + 5, 11, 2); g_tone(0, 6); gfx_rect(g_cx, g_fb_y - 9, 1, 5));
  g_input(52, g_fb_x0 - 8, g_fb_y - 13, g_fb_x1 - g_fb_x0 + 16, 21, 1, g_fb_x1 - g_fb_x0);   // drag sideways (Shift = fine), double / right-click = 0
  (g_hover == 52 || g_drag == 52) ? g_hover_val = g_valstr(52, slider52);
  g_tx_plat >= 0 ? (gfx_x = g_pl_x - g_pl_r - 6; gfx_y = g_pl_y - g_pl_r - 6; gfx_blit(14, 1, 0)) : (
    g_grey(0.75); gfx_circle(g_pl_x, g_pl_y, g_pl_r, 1, 0); g_grey(0.06); gfx_circle(g_pl_x, g_pl_y, g_pl_r - 5, 1, 0);
    g_grey(0.80); gfx_circle(g_pl_x, g_pl_y, g_pl_r * 0.34, 1, 0);
  );
  // (⚪174, user's choice 2026-10-14: the deck's picture in the record's label, as rekordbox's deck previews: seen here even
  // while the deck is hidden in the mix, with its own video effects) the deck mix (reascratch_deck_mix.eel) writes a 64 x 64
  // grid of the square in the middle of the deck's picture, r * 65536 + g * 256 + b, deck A gmem [9000000 ..], deck B
  // [9010000 ..], + 4096 = grids written so far (0 = none yet: the record as it is). ((user 2026-10-14: larger, sharper)
  // the label grown from r 34 to PV_R, drawn as small squares inside its circle; the white marks on the vinyl inside it
  // are left out below)
  // (⚪179, 2026-10-15: moved from 3000000 / 3010000, inside deck B's scratch lane 2100000 .. 3099999)
  PV_R = 62;
  // ((⚪188) while this deck previews a file of the Media Explorer (P key; gmem [372] = the deck, [373] = it has a picture)
  // the preview's picture instead, from [9020000 ..] (the deck mix reads it from the "preview view" track)
  pv_pr = gmem[372] == (slider76 == 2 ? 2 : 1);
  pv_o = pv_pr && gmem[373] ? 9020000 : slider76 == 2 ? 9010000 : 9000000;
  pv_on = gmem[pv_o + 4096] > 0;
  pv_on ? (
    pv_d = 2 * PV_R / 64; pv_j = 0;
    loop(64,
      pv_i = 0;
      loop(64,
        // ((user 2026-10-14: the edge was jagged) a square wholly inside: one rect; one across the edge: pixel by pixel, each
        // as much as it lies inside the circle (its centre's distance, 1 px of soft edge); wholly outside: nothing
        pv_x0 = floor(g_pl_x - PV_R + pv_i * pv_d); pv_y0 = floor(g_pl_y - PV_R + pv_j * pv_d);
        pv_x1 = floor(g_pl_x - PV_R + (pv_i + 1) * pv_d); pv_y1 = floor(g_pl_y - PV_R + (pv_j + 1) * pv_d);
        pv_dx = max(abs(pv_x0 - g_pl_x), abs(pv_x1 - g_pl_x)); pv_dy = max(abs(pv_y0 - g_pl_y), abs(pv_y1 - g_pl_y));
        pv_in = pv_dx * pv_dx + pv_dy * pv_dy <= (PV_R - 1) ^ 2;
        pv_dx = max(0, max(pv_x0 - g_pl_x, g_pl_x - pv_x1)); pv_dy = max(0, max(pv_y0 - g_pl_y, g_pl_y - pv_y1));
        pv_out = pv_dx * pv_dx + pv_dy * pv_dy >= (PV_R + 1) ^ 2;
        !pv_out ? (
          pv_v = gmem[pv_o + pv_j * 64 + pv_i];
          pv_cr = floor(pv_v / 65536) / 255; pv_cg = (floor(pv_v / 256) % 256) / 255; pv_cb = (pv_v % 256) / 255;
          pv_in ? (gfx_set(pv_cr, pv_cg, pv_cb, 1); gfx_rect(pv_x0, pv_y0, pv_x1 - pv_x0, pv_y1 - pv_y0)) : (
            pv_y = pv_y0;
            loop(pv_y1 - pv_y0,
              pv_x = pv_x0;
              loop(pv_x1 - pv_x0,
                pv_a = max(0, min(1, PV_R - sqrt((pv_x + 0.5 - g_pl_x) ^ 2 + (pv_y + 0.5 - g_pl_y) ^ 2) + 0.5));
                pv_a > 0 ? (gfx_set(pv_cr, pv_cg, pv_cb, pv_a); gfx_rect(pv_x, pv_y, 1, 1));
                pv_x += 1;
              );
              pv_y += 1;
            );
          );
        );
        pv_i += 1;
      );
      pv_j += 1;
    );
    gfx_a = 1;
  );
  // ((⚪188) previewing: "PREVIEW m:ss" in the label's lower part (gmem [374] = the preview's position, s)
  pv_pr ? (
    gfx_setfont(7); sprintf(#pv_t, "PREVIEW %d:%02d", floor(gmem[374] / 60), floor(gmem[374]) % 60);
    gfx_measurestr(#pv_t, pv_tw, pv_th); pv_tx = floor(g_pl_x - pv_tw / 2);
    gfx_set(0, 0, 0, 0.65); gfx_rect(pv_tx - 3, floor(g_pl_y + 30), pv_tw + 6, pv_th + 2);
    gfx_set(1, 0.85, 0.3, 1); gfx_x = pv_tx; gfx_y = floor(g_pl_y + 31); gfx_drawstr(#pv_t); gfx_a = 1;
  );
  // sticker: up at the start of the file, turns clockwise as the head moves forward (33 1/3 rpm while playing)
  // drawn as a pixel-art 'perfect line': the direction snaps to the nearest slope whose steps repeat evenly
  // (0, 1:5, 1:4, 1:3, 1:2, 2:3, 1:1 and their mirrors = 48 directions, at most ~5.6 deg off), one pixel per
  // column / row (no doubled corners), starting and ending on whole steps. Measured from the centre (which lies
  // between two pixels), so mirrored directions draw mirrored lines. Thin, half-transparent, pale silver (not the
  // lamp colour) so it marks the angle without shouting (user's requests, 2026-10-03).
  // angle from the read head: straight up at 0 s, clockwise, 1 turn = 1.8 s (also follows the hand while turning,
  // since the hand moves the head)
  g_pl_a = -0.5 * $pi + 2 * $pi * (len > 0 ? head / fsr : 0) / 1.8;
  g_pl_c = cos(g_pl_a); g_pl_s = sin(g_pl_a);
  g_pl_xm = abs(g_pl_c) >= abs(g_pl_s);                       // major axis: x
