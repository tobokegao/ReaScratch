    // the Touch's (not known); no SHIFT notes known
    pid == 108 || pid == 109 ? (
      preset(dk, 6, 1, 131, 0, 0, 150, 0, 1, 0, 0); preset_xf(dk, 16, 8);
      preset_pad(dk + 4, 1, 0); preset_sm(dk + 4, 49); preset_vfx(0, -1); preset_te(9, 2); preset_mx(-1, 27);
      preset_rd(0, 1, 0); preset_n(4, 4);
    );
    // Hercules DJ Control MP3 e2 / MP3 LE / Glow (Hercules' VirtualDJ mapping MP3E2.xml, Mixxx): both decks on ch 1 (the
    // driver's panel can change it): JOG CC 0x30 / 0x31 (1 / 127, 128 / rev), no touch (held while turning), PLAY 0x0F /
    // 0x23, CUE 0x0E / 0x22, SYNC 0x12 / 0x26, fader CC 0x34 / 0x39, PFL 0x10 / 0x24; crossfader CC 0x38; the tempo is an
    // encoder (not read); its 8 keys change meaning with the mode (not hot cues)
    pid == 110 || pid == 111 ? (
      preset(1, dkv(48, 49), 1, 71, 0, 0, 150, dkv(15, 35), dkv(14, 34), 0, 0); preset_xf(dk, 1, 56);
      preset_pad(0, 0, 0); preset_sm(0, 48); preset_vfx(0, -1); preset_te(-1, dkv(18, 38));
      preset_mx(dkv(52, 57), dkv(16, 36)); preset_rd(0, 0, 0);
    );
    // Hercules DJ Control AIR (Mixxx; the AIR+'s list has the same two jog CCs): both decks on ch 1: in SCRATCH mode the jog
    // sends CC 0x32 / 0x33 (1 / 127, 128 / rev), otherwise CC 0x30 / 0x31 (= the rim here); no touch sensor (held while
    // turning); PLAY 0x12 / 0x28, CUE 0x11 / 0x27, SYNC 0x13 / 0x29, tempo CC 0x34 / 0x35 (7-bit), fader CC 0x36 / 0x3B,
    // PFL 0x14 / 0x2A; crossfader CC 0x3A; samples 5-8 / 0x1B-0x1E; no hot cue pads
    pid == 112 || pid == 113 ? (
      preset(1, dkv(50, 51), 1, 71, dkv(48, 49), 0, 150, dkv(18, 40), dkv(17, 39), 0, 0); preset_xf(dk, 1, 58);
      preset_pad(0, 0, 0); preset_sm(1, dkv(5, 27)); preset_vfx(0, -1); preset_te(dkv(52, 53), dkv(19, 41));
      preset_mx(dkv(54, 59), dkv(20, 42)); preset_rd(0, 1, 0); preset_n(8, 4);
    );
    // Hercules DJ Console 4-Mx (Mixxx's mapping by its author): needs
    // Hercules' driver (not class compliant); decks A / B on ch 1 (C / D: the buttons on ch 2, set the driver's deck mode
    // to 2 decks): JOG CC 0x24 / 0x25 while pressed (two's complement; Mixxx 256 / rev at 45 rpm = 192 ticks/s), CC 0x01 /
    // 0x09 without pressure (= the rim here), touch 0x1A / 0x3A (Mixxx reads it only with the unit's SCRATCH button on),
    // PLAY 0x0E / 0x2E, CUE 0x0D / 0x2D, SYNC 0x11 / 0x31, tempo CC 0x05 / 0x0D (its LSB 0x28 / 0x29 is not CC+32: read as
    // 7-bit; direction not known), fader CC 0x03 / 0x0B, PFL 0x0F / 0x2F, crossfader CC 0x22; no pads: of the 12 FX buttons
    // (notes 0x01-0x0C / 0x21-0x2C) Mixxx 2.1 makes 5, 6 samples and 7-10 hot cues 1-4 (its SHIFT layer is in software)
    pid == 120 || pid == 121 ? (
      preset(1, dkv(36, 37), 1, 192, dkv(1, 9), dkv(26, 58), 150, dkv(14, 46), dkv(13, 45), 0, 0); preset_xf(dk, 1, 34);
