        outr += rd(vp[0], 1) * w;
        vp[0] += vp[16] * fsr / srate * kshift;
      );
      vp[8] += fsr / srate;
      vp[56] ? (vp[48] += vp[56]; vp[48] >= 1 ? (vp[48] = 1; vp[56] = 0) : vp[48] <= 0 ? vp[24] = 0);
      vp[8] >= vp[32] ? vp[24] = 0;
      sm_vo ? (buf = sm_b; len = sm_l; nch = sm_h; fsr = sm_fo; lp_l = sm_lo);
    );
    i += 1;
  );
  outl *= outscale; outr *= outscale;
  // low cut, 12 dB/oct (TPT state variable filter, Q 0.707); the cutoff follows the read rate: 50 Hz still, 5 Hz from 1x.
  // Always running; blended in over the first 5 % of the bar, so 0 stays the plain grains and slow reads do not rumble
  tp_vs += (abs(pf_r) * srate / fsr - tp_vs) * tp_vk;
  (tp_n -= 1) <= 0 ? (
    tp_n = 16;
    tp_g = tan($pi * min(0.45 * srate, 5 + 45 * max(0, 1 - tp_vs)) / srate);
    tp_a1 = 1 / (1 + tp_g * (tp_g + 1.41421356)); tp_a2 = tp_g * tp_a1; tp_a3 = tp_g * tp_a2;
  );
  tp_v3 = outl - tp_c2l; tp_v1 = tp_a1 * tp_c1l + tp_a2 * tp_v3; tp_v2 = tp_c2l + tp_a2 * tp_c1l + tp_a3 * tp_v3;
  tp_c1l = 2 * tp_v1 - tp_c1l; tp_c2l = 2 * tp_v2 - tp_c2l; tp_yl = outl - 1.41421356 * tp_v1 - tp_v2;
  tp_v3 = outr - tp_c2r; tp_v1 = tp_a1 * tp_c1r + tp_a2 * tp_v3; tp_v2 = tp_c2r + tp_a2 * tp_c1r + tp_a3 * tp_v3;
  tp_c1r = 2 * tp_v1 - tp_c1r; tp_c2r = 2 * tp_v2 - tp_c2r; tp_yr = outr - 1.41421356 * tp_v1 - tp_v2;
  pf_b = min(1, pf_a * 20);
