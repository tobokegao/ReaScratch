    ) : sprintf(#tt_msg, "tap %d: keep tapping on the beat (BPM from the 4th tap)", tt_n);
  ) : strcpy(#tt_msg, "tap T or the bpm box on the beat while it plays");
  tt_msg_t = time_precise();
);

