function prf_mv(lane, v) ( !prf_on || abs(v - PRF_M[lane]) > 0.0001 ? (prf_put(play_position, lane, v); PRF_M[lane] = v); );
function prp_tl(l) ( l == 23 || l == 26 || l == 28 || l == 30 || l == 31 || (l >= 33 && l <= 35) || l == 37 || (l >= 39 && l <= 52) || l == 71 || l == 74 || l == 78 || l == 80 || l == 81 ? 0.001 : 0.000001; );
function prp_ao(l) ( l >= 29 && l <= 31 || l == 38 || l == 39 || l >= 80; );   // (deck A only)
function prp_set(l, x) (
  l == 23 ? (xf_pos = max(0, min(1, x)); xf_known = 1) : l == 24 ? (prp_cut = x > 0.5) :
  l == 25 ? (slider33 = floor(x + 0.5); sliderchange(slider33)) : l == 26 ? (bvol_p = max(0, min(1, x)); bvol_g = sqr(bvol_p)) :
  l == 27 ? (slider196 = x > 0.5; sliderchange(slider196)) : l == 28 ? (slider195 = x; sliderchange(slider195)) :
  l == 29 ? (slider78 = floor(x + 0.5); sliderchange(slider78); gui_dirty = 1) : l == 30 ? (slider79 = x; sliderchange(slider79)) :
  l == 31 ? (slider80 = x; sliderchange(slider80)) : l == 32 ? (slider153 = floor(x + 0.5); sliderchange(slider153)) :
  l == 33 ? (slider152 = x; sliderchange(slider152)) : l == 34 ? (slider154 = x; sliderchange(slider154)) :
  l == 35 ? (slider150 = x; sliderchange(slider150)) :
  // (a type set here keeps its amount from the lane: am_t / am_mt = the new type, so the amounts kept per type (below in
  // @block) do not swap it)
  l == 36 ? (slider82 = floor(x + 0.5); am_t = slider82; sliderchange(slider82); gui_dirty = 1) : l == 37 ? (slider83 = x; sliderchange(slider83)) :
  l == 38 ? (slider86 = floor(x + 0.5); am_mt = slider86; sliderchange(slider86); gui_dirty = 1) : l == 39 ? (slider87 = x; sliderchange(slider87)) :
  l == 40 ? (slider200 = x; sliderchange(slider200)) : l == 41 ? (slider201 = x; sliderchange(slider201)) :
  l == 42 ? (slider202 = x; sliderchange(slider202)) : l == 43 ? (slider203 = x; sliderchange(slider203)) :
  l == 44 ? (slider204 = x; sliderchange(slider204)) : l == 45 ? (slider205 = x; sliderchange(slider205)) :
  l == 46 ? (slider206 = x; sliderchange(slider206)) : l == 47 ? (slider151 = x; sliderchange(slider151)) :
  l == 48 ? (slider207 = x; sliderchange(slider207)) : l == 49 ? (slider197 = x; sliderchange(slider197)) :
  l == 50 ? (slider198 = x; sliderchange(slider198)) : l == 51 ? (slider199 = x; sliderchange(slider199)) :
  l == 52 ? (slider209 = x; sliderchange(slider209)) : l == 53 ? (prp_tb = floor(x + 0.5)) : l == 54 ? (prp_tbb = floor(x + 0.5)) :
  l >= 55 && l <= 62 ? (TF[16 + l - 55] = x) : l >= 63 && l <= 70 ? (TFB[16 + l - 63] = x) :
  l == 71 ? (slider52 = x; sliderchange(slider52)) : l == 72 ? (slider220 = floor(x + 0.5); sliderchange(slider220)) :
  l == 73 ? (vb_iv = max(0, min(12, floor(x + 0.5)))) : l == 74 ? (prp_pf = max(0, min(1, x))) :
  l == 75 ? (prp_ah = floor(x + 0.5)) : l == 76 ? (lf_shape = max(0, min(4, floor(x + 0.5)))) :
  l == 77 ? (lf_rate = max(0, min(5, floor(x + 0.5)))) : l == 78 ? (lf_depth = max(0, min(1, x))) :
