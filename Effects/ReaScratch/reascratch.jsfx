      g_uid = ui_goal - (mouse_x - g_wpx) * 0.002 * fsr * ((mouse_cap & 8) ? 0.25 : 1);
      ui_goal = slider5 && lp_l > 1 ? g_uid : max(0, min(len - 2, g_uid));
      g_wpx = mouse_x; ui_gen += 1;
    );
    // grab the whole file = search (CDJ / rekordbox style): the point under the cursor, from window pixels
    // (finer than picture pixels when the window is scaled up); the drag may leave the strip
