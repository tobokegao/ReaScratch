// tap tempo (T key, while playing): the BPM comes from where the head was at each tap (the sample's own time, so the
// taps need it running at 1x); a pause over 2 s, or a head that did not move on, starts again. From the 4th tap the
// BPM is the straight line through the last TT_MAX taps and the grid is that line at the last tap.
function tt_tap() local(i, mi, mh, sxy, sxx, slope, er) (
  len > 0 && slider3 && !tch ? (
    time_precise() - tt_t > 2 || (tt_n > 0 && head <= TT[tt_n - 1] + 0.1 * fsr) ? tt_n = 0;
