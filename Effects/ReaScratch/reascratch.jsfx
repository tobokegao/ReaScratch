      hc_pos(g_i) >= 0 ? (
        g_cx = g_inside(g_lx, g_ly, g_lw, 24) ? g_lx + 4 + floor(min(hc_pos(g_i) * fsr, len - 1) / len * g_wn)
                                             : g_zc + floor((hc_pos(g_i) * fsr - head) / g_spp);
        g_inside(g_lx, g_ly, g_lw, g_lh) && abs(g_mx - g_cx) <= 3 ? g_hc_hit = g_i;
      );
      g_i += 1;
    );
    g_hc_hit ? g_hover_help = sprintf(#g_hch, "hot cue %d: right-click = clear (keys: %d = jump, Shift+%d = clear)", g_hc_hit, g_hc_hit, g_hc_hit);
    g_rclick && g_hc_hit ? (gq_push(2, g_hc_hit); g_rclick = 0);
    // the same for a memory cue mark (a hot cue line wins when both are near)
    g_mc_hit = -1; g_i = 0;
    loop(mc_n,
      g_cx = g_inside(g_lx, g_ly, g_lw, 24) ? g_lx + 4 + floor(min(MC[g_i] * fsr, len - 1) / len * g_wn)
                                           : g_zc + floor((MC[g_i] * fsr - head) / g_spp);
      g_inside(g_lx, g_ly, g_lw, g_lh) && abs(g_mx - g_cx) <= 3 ? g_mc_hit = g_i;
      g_i += 1;
    );
    !g_hc_hit && g_mc_hit >= 0 ? (
      g_hover_val = sprintf(#g_mcv, "%.3f s", MC[g_mc_hit]);
      g_hover_help = "memory cue: right-click = delete (M = add, Left / Right = call)";
      g_rclick ? (mc_del_at(g_mc_hit); g_rclick = 0);
    );
    g_rclick && g_inside(g_lx, g_ly, g_lw, 24) ? g_set(4, (g_mx - g_lx - 4) / g_wn * (len - 1) / fsr);
    g_rclick && g_inside(g_lx, g_ly + 24, g_lw, g_lh - 24) ? g_set(4, max(0, min(len - 1, head + (g_mx - g_zc) * g_spp)) / fsr);
  ) : (
    gfx_setfont(5); g_grey(0.55); g_text("no sample: run reascratch_import_video", g_lx + 10, g_ly + 28);
  );

  // controls area: from g_m below the waveform to the content bottom
  g_ct = g_ly + g_lh + g_gw0;
  // switch column on the left edge: first slot top = g_ct, last slot bottom = g_b
  gfx_setfont(1); g_lw0 = 0;
  gfx_measurestr("stop", g_tw, g_th); g_lw0 = max(g_lw0, g_tw); gfx_measurestr("end", g_tw, g_th); g_lw0 = max(g_lw0, g_tw);
  gfx_measurestr("fwd", g_tw, g_th); g_lw0 = max(g_lw0, g_tw); gfx_measurestr("x2", g_tw, g_th); g_lw0 = max(g_lw0, g_tw);
  g_sx = g_l + g_lw0 + 6;                         // widest left label starts on the left edge
  g_gr = 34;
  g_rreach = g_gr + 11 + 3;                                   // ring reach from the base centre: dot ring radius + half a dot
  g_gB = floor((g_ct + g_b) / 2);                         // base centre y: same gap above and below the ring
  // the column sits g_si inside the content box (top and bottom), so it reads as one group with a little air around it
  g_si = 4;
  g_s0 = g_ct + 7 + g_si;
  g_pitch = (g_b - 8 - g_si - g_s0) / 3;
  // right edge of the switch column: its widest right label (needed here for the mirrored place)
  gfx_setfont(1); g_swr = 0;
  gfx_measurestr("play", g_tw, g_th); g_swr = max(g_swr, g_tw); gfx_measurestr("loop", g_tw, g_th); g_swr = max(g_swr, g_tw);
  gfx_measurestr("x4", g_tw, g_th); g_swr = max(g_swr, g_tw); gfx_measurestr("rev", g_tw, g_th); g_swr = g_sx + 48 + max(g_swr, g_tw);
  g_mdl = g_fl(g_l, g_swr - g_l) - g_l;          // mirrored: the column moves to the right edge (switches throw the same way)
  g_switch(3, g_sx + g_mdl, g_s0, "stop", "play");
  // rows on whole pixels: the pitch is not a whole number (97 / 3), and at a fractional y the box, the lever picture
  // and the names were each rounded their own way (the lever sat 1 px off in its box in rows 2 and 3)
  g_switch(5, g_sx + g_mdl, g_s0 + floor(g_pitch + 0.5), "end", "loop");
  g_switch(19, g_sx + g_mdl, g_s0 + floor(2 * g_pitch + 0.5), "x2", "x4");
  g_switch(20, g_sx + g_mdl, g_s0 + floor(3 * g_pitch + 0.5), "fwd", "rev");
  // helper knobs: 2 x 2 with the top row shifted left (a parallelogram, sharp tip at the lower right = smooth);
  // names sit above the knobs. Right column's knob edge on the right edge; top names' top on the area's top edge
  g_kr = 16; g_hhs = g_hh(g_kr);
  gfx_setfont(1); gfx_measurestr("jitter off", g_tw, g_th);
  // Ambience-style: two pairs, each rising to the upper right, stacked; the four knobs sit on a parallelogram
  g_x2 = g_r - g_kr; g_x1 = g_x2 - 74; g_rz = 30;     // columns; each pair's right knob sits g_rz higher
  g_ya = g_ct + g_kr + g_hhs;                          // top pair, right knob base centre (knob top on the area top)
  g_yb = g_b - g_kr - g_rz;                            // bottom pair: the left knob's (wsola) body bottom on the content bottom edge
  g_bus = g_x1 - g_kr - 4 - 28 - 6;                    // vertical wire, left of the left column's names
  // grain: centred between the switch column and the helper knobs, on the area's middle line
  // grain group = knob + C ring + "grain" + 200 / 10, placed by the knob's base centre (g_gx, g_gB):
  //   the C ring is centred on the base centre; equal space above / below and left / right of the group
  g_cy = g_gB - g_hh(g_gr) / 2;                           // knob centre y that puts its base centre on g_gB
  gfx_setfont(5); gfx_measurestr("200", g_tw3, g_th2);
  gfx_setfont(6); gfx_measurestr("grain", g_tw, g_th); gfx_setfont(1);
  // the name 'grain' keeps clear of the lit dots of the C ring (user's requests, 2026-10-04: mirrored, it lay on them;
  // then the same room on both layouts): r + 22 from the centre, 7 px past the dots on the left (r + 15, glow included).
  // The ring is not turned when mirrored, so left-handed the name faces those dots; right-handed it sits in the ring's
  // opening with the same room. The knob stays where it was with the name at r + 8; the wire to the bus is 14 px shorter
  g_gx = g_bus - 30 - (g_gr + 8 + g_tw + 6);   // grain: its wire ran 30 px to the bus;
  g_glo = g_gr + 22;
  g_gap = g_gx - g_rreach - g_swr;                            // space between the switch column and the ring's left edge
  // mirrored (g_mr): the grain network is worked out in deck B's places, then every knob centre, name and wire is
  // mirrored one by one (user's request: not moved as a block). The knobs themselves are not turned around: the grain
  // ring still opens to the right, so its 200 / 10 marks stay on the knob's right
  g_knob(18, g_fc(g_gx), g_cy, g_gr, 1, "grain");
  // TBKgao mark engraved in the iron: centred in the gap between the switch column and the grain ring, on the base line
  // (mirrored: the ring's 200 / 10 marks stay on its right, so they face the mark there: centred between their right
  // edge and the switch column instead)
  g_tx_tbk >= 0 ? (gfx_getimgdim(13, g_tbw, g_tbh);
    gfx_x = g_mr ? floor((g_fc(g_gx) + g_gr + 8 + g_tw3 + g_W - g_swr - g_tbw) / 2) : g_swr + floor((g_gap - g_tbw) / 2);
    gfx_y = g_gB - floor(g_tbh / 2); gfx_blit(13, 1, 0));
  gfx_setfont(5); g_grey(0.55);
  // (the 200 / 10 range marks are not drawn: user's choice 2026-10-16; g_tw3 above still places the mark)
  // helper knobs (Ambience-style parallelogram): wires grain -> bus -> jitter and wsola; jitter -> jitter off along the slant
  g_gfy = g_gB;
  g_grey(0.50); gfx_a = 0.9;
  // every wire of the grain network is dotted (every other pixel)
  g_dl(g_gx + g_glo + g_tw + 6, g_gfy, g_bus, g_gfy); g_dl(g_bus, g_ya + g_rz, g_bus, g_yb + g_rz);
  g_dl(g_bus, g_ya + g_rz, g_x1 - g_kr - 2, g_ya + g_rz); g_dl(g_bus, g_yb + g_rz, g_x1 - g_kr - 2, g_yb + g_rz);
  // jitter -> jitter off: up from the top of jitter's face, then right at jitter off's base-centre height into the knob
  g_i = g_ya + g_rz - g_hhs - g_kr - 2;                // just above jitter's face (face centre = base - wall)
  g_dl(g_x1, g_i, g_x1, g_ya); g_dl(g_x1, g_ya, g_x2 - g_kr - 2, g_ya);
  gfx_a = 1;
  g_lside = 6; g_knob(22, g_fc(g_x1), g_ya + g_rz - g_hhs / 2, g_kr, 0, "jitter");
  g_lside = 6; g_knob(23, g_fc(g_x2), g_ya - g_hhs / 2, g_kr, 0, "jitter off");
  g_lside = 6; g_knob(21, g_fc(g_x1), g_yb + g_rz - g_hhs / 2, g_kr, 0, "wsola");
  g_lside = 7; g_knob(11, g_fc(g_x2), g_yb - g_hhs / 2, g_kr, 0, "smooth");   // not on the grain network: its name sits apart, under the knob
  g_lside = 0;
  // (⚪191, user's choices 2026-10-16: the record's corner is the metronome's now) the musical key as it sounds (⚪175), in
  // a black well as the corner's, shaped as the user's sketch (image 29 = key_well.png:
  // right-handed / mirrored cells, 126 x 48; user's requests: filling the space, its gap under the waveform as the
  // others' g_gw0, rounded boxes with their own corner radii): a bar along the top, from the grain knob's ticks (22 px
  // left of the name 'grain': g_gx + g_glo, from the wire above) towards 'jitter off', its top on g_ct, and a tongue
  // under it over 'grain' (the key centred 52 px in, 30 down), left of 'jitter', above 'grain' and
  // clear of the ring's 200 mark. The key in the bulb (Tahoma 20 bold), white as the sample's own, in the lamp colour with the key knob
  // turned, "?" after it when unsure, "-" when unknown; in the tail "key" grey, or the key knob's semitones lit when
  // turned. Without the image a plain readout. Click = KEY SYNC (as U), Shift+click = the key knob back to 0
  len > 0 ? (
    g_krw = 126; g_krx = g_fl(g_gx + g_glo - 22, g_krw); g_kry = g_ct - 4;
    g_kyc = ky_eff(); ky_txt(g_kyc, #g_kys); g_kyc < 1 ? strcpy(#g_kys, "-");
    SMY[sm_cur] > 24.5 && g_kyc > 0 ? strcat(#g_kys, "?");
    g_tx_kw >= 0 ? (
      gfx_x = g_krx; gfx_y = g_kry; gfx_blit(29, 1, 0, g_mr ? 126 : 0, 0, 126, 48);
      g_kyf = 9; gfx_setfont(9, "Tahoma", 20, 'b'); gfx_measurestr(#g_kys, g_kyw, g_th); g_kyw > 38 ? (g_kyf = 6; gfx_setfont(6); gfx_measurestr(#g_kys, g_kyw, g_th));
      g_kyc < 1 ? g_grey(0.50) : slider217 != 0 ? g_led_col() : g_grey(0.92);
      g_text(#g_kys, floor(g_krx + (g_mr ? 126 - 52 : 52) - g_kyw / 2), g_kry + 18 - floor(g_th / 2) + 1);
      gfx_setfont(5);
      slider217 != 0 && g_kyc > 0 ? (g_led_col(); sprintf(#g_kyd, slider217 > 0 ? "+%d" : "%d", slider217)) : (g_grey(0.55); strcpy(#g_kyd, "key"));
      gfx_measurestr(#g_kyd, g_kyw, g_th); g_text(#g_kyd, floor(g_krx + (g_mr ? 126 - 92 : 92) - g_kyw / 2), g_kry + 10);
    ) : (
      slider217 != 0 && g_kyc > 0 ? strcat(#g_kys, sprintf(#g_kyd, slider217 > 0 ? " (+%d)" : " (%d)", slider217));
