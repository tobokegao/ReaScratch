      preset_pad(dk + 2, 0, dk + 2); preset_sm(dk + 2, 32); preset_vfx(0, -1); preset_te(128, 93); preset_mx(79, 97);
      preset_rd(0, 1, 64);
    );
    // Akai APC40 mkII, two decks (⚪76; Akai's MIDI list v1.2 and the user's ReaLearn setup;
    // user's choices 2026-10-07): no jog (the mouse); the knobs and buttons as printed. Everything on ch 1
    // but the track columns (deck A = column 1, deck B = 5; ⚪91). Clip grid (notes 0-39, the bottom row 0-7), left 4 columns =
    // deck A, right 4 = deck B: row 1 (top) = hot cues 1-4, 2 = hot cues 5-8 (SHIFT + pad = clear; ⚪89 / ⚪91), 3 = samples
    // 1-4, 4 = MEMORY / CALL back / next / DELETE, 5 = held moves (SHIFT: loop / SYNC / Q / SLIP; ⚪91). TRACK SELECT 1 / 5
    // = which deck the shared controls drive: PLAY 91, RECORD 93 = CUE, STOP ALL CLIPS 81 = stop, SCENE 1-4 = samples 5-8,
    // SCENE 5 = SYNC, TEMPO CC 13 = tempo, NUDGE - / + 100 / 101, TAP TEMPO 99. Track faders 1 / 5 (CC 7) = volume, SOLO
