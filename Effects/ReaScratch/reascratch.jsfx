      preset_apc_buddy(1);
    );
    // Akai APC40 (the first, mkI; Akai's protocol rev 1 via the Internet Archive):
    // as the mkII, but its clip grid is note 53 (top row) .. 57 on channels 1-8 (the columns): pads across channels
