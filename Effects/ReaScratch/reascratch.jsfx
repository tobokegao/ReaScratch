                 g_srow(109, g_sy, 0xa8433a); g_sy += 20; g_s = 89; loop(4, g_s != 91 ? (g_srow(g_s, g_sy, 0xa8433a); g_sy += 20); g_s += 1); g_srow(231, g_sy, 0xa8433a); g_sy += 20) :   // ((⚪111) + REAPER tempo)
