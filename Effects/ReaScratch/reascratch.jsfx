      preset_pad(dkv(1, 5), 53, 0); preset_n(4, 4); preset_hc2(1, 98); preset_sm(dkv(1, 5), 55); preset_vfx(dkv(1, 5), -1);
      CV[88] = dk == 1 ? 14 : -1; CV[107] = -1;
      CV[55] = dkv(1, 5); CV[56] = 56;
