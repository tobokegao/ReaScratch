  );

  hopcnt <= 0 ? (
    ui_seek ? (
      // search: SEEK_SNIP grains, always forward, no jitter, no WSOLA
      hopcnt = hop_sk; dir = 1; start = head - glen_sk * 0.5; pf_f = 0;
      vp = VOICE + pick_v(); vp[32] = glen_sk;
    ) : (
    hopcnt = hop;
    pf_f = pf_a > 0;                                    // this grain follows the speed
    dir = pf_f ? (pf_r < 0 ? -1 : 1) : (slider20 && head < head_grain) ? -1 : 1;
    // grain centred on the head; following grains: in the middle of its life the grain is (1 - a) x half a grain
    // behind the head (0 = the plain grains, 1 = on the head, so all grains read the same place = tape)
    nominal = pf_f ? head - glen * 0.5 * (pf_rk - pf_a * pf_v) * srate / fsr : head - dir * glen * 0.5 * kshift;
    spd = abs(head - head_grain) / hop_f;               // head speed over the last hop (x)
    jamt = jit * max(0, 1 - spd / jit_fade) * (1 - pf_a);
