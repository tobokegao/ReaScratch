// the setup screen's Preset menu, by maker > model > deck (user's request 2026-10-07: 64 presets did not fit a 1080p
// screen). In each maker the models are grouped by series (DDJ-FLX, DDJ-REV, DDJ-200/400/800/1000, DDJ-SB/SX, CDJ, XDJ,
// Reloop Buddy/Ready, Mixon, Terminal Mix, ...), newer series first, the cheapest model first in a series (user's requests).
// Since 2026-10-08 the Preset slider itself is in this order (makers A-Z, user's request; po_s in @init), so pmn_s = the
// slider values in menu order is 0, 1, 2, ... (three digits each; the developer's consistency check: every preset once); the menu
// returns the position (1..n), pmn_val turns it back into the slider value. The submenus are menu positions a..b; the
// current preset is ticked. "⚠ " in front of a name = not tried on the hardware (user's request 2026-10-08)
pmn_s = "";
function pmn_val(k) ( (str_getchar(pmn_s, 3 * k - 3) - 48) * 100 + (str_getchar(pmn_s, 3 * k - 2) - 48) * 10 + str_getchar(pmn_s, 3 * k - 1) - 48; );
// a deck 1 / deck 2 (CDJ: ch 1 / ch 2) pair: presets v and v + 1, shown as one model with its own submenu (user's request)
function pmn_pair_o(v) ( v == 2 || v == 6 || v == 8 || v == 10 || v == 12 || (v >= 14 && v <= 134 && !(v & 1)); );
function pmn_pair(v) ( v < 133 && pmn_pair_o(p_old(v)) && p_old(v + 1) == p_old(v) + 1; );   // v = slider 1 value
// one menu item: closes = how many submenus it is the last item of; short = only the "deck 1" / "(ch 1)" end of the name
function pmn_leaf(v, closes, short) (
  loop(closes, strcat(#pmn_m, "<"));
  v == pmn_cur ? strcat(#pmn_m, "!");
  short ? (strcpy_substr(#pmn_t, g_valstr(1, v), strlen(g_valstr(1, v)) - 6, 6); strcat(#pmn_m, #pmn_t))
        : strcat(#pmn_m, g_valstr(pmn_sl, v));
  strcat(#pmn_m, "|");
);
function pmn_items(a, b, sub) local(k, v, last) (
  k = a;
  while (k <= b) (
    v = pmn_val(k);
    k < b && pmn_pair(v) && pmn_val(k + 1) == v + 1 ? (
      last = sub && k + 1 == b;
      last ? strcat(#pmn_m, "<");   // the maker's last item is this model's submenu: the "<" goes on its header
      pmn_cur == v || pmn_cur == v + 1 ? strcat(#pmn_m, "!");
      strcat(#pmn_m, ">"); strcpy(#pmn_t, g_valstr(1, v)); str_setlen(#pmn_t, strlen(#pmn_t) - 7);   // " deck 1" / " (ch 1)"
      strcat(#pmn_m, #pmn_t); strcat(#pmn_m, "|");
      pmn_leaf(v, 0, 1); pmn_leaf(v + 1, 1, 1);
      k += 2;
    ) : (
