CVM[248] = 2; CV[248] = -1;   //ctl:slider248:-1<-1,127,1>-Sound / key knob CC (browser channel, relative: the sound of the video FX last touched; with the push held, the key threshold; with SHIFT + push, the key softness; -1 = none. Reloop Buddy BROWSE 0)
// the More tab's rows: range, label, help (the parameter's name as it was), menu items (0 = a number) and their count.
// cvd copies the default from CV. LSG[group * 24 + k] = the group's rows, LSGN the count, LSGT the title
CVLO = 62600; CVHI = 62900; CVST = 63200; CVLB = 63500; CVHL = 63800; CVMS = 64100; CVDF = 64400; CVMN = 64700;
LSG = 65000; LSGN = 65200; LSGT = 65220;
function cvd(s, lo, hi, st, lb, hl, ms, mn) ( CVLO[s] = lo; CVHI[s] = hi; CVST[s] = st; CVLB[s] = lb; CVHL[s] = hl; CVMS[s] = ms; CVMN[s] = mn; CVDF[s] = CV[s]; );
