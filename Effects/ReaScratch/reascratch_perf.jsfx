desc: DJ performance lanes
//tags: reascratch performance automation
//author: ReaScratch
//
// (⚪178) The performance lanes of one ReaScratch deck: put by the setup script on the deck's engine track, BEFORE the
// ReaScratch JSFX (then the engine reads this block's values in the same block; after it, one block late). It only holds
// the lanes: REAPER's own envelopes on these sliders, laid on REAPER's timeline (not the deck's time), so that what was
// played - transport, the head, slot, tempo, key ... - plays again with REAPER's transport.
// The name must not contain "ReaScratch" (reascratch_lib.lua finds the engine by that name).
//
// RULES for the sliders (the recorded envelopes are tied to REAPER's parameter numbers):
//   - slider1 = Deck. The lanes start at slider2: lane i = slider i + 1 (the engine's records and reascratch_lib.lua's
//     PF_LANES use the same numbers)
//   - a new lane is added ONLY AT THE END of the list; never insert, remove or reorder one (the parameter numbers move and
//     recorded lanes would drive another parameter)
//   - each slider's minimum is the "nothing recorded" mark, outside the values it records; the lane's own envelope
//     (outside the automation items) stays at that mark, the recorded values live only inside the items
//
// Each block the values go to gmem (ReaScratch_video) from 14000000 (deck A) / 14000256 (deck B): [0] blocks, [1]
// play_position, [2] play_state, [3] REAPER plays (1; 0 = not playing: the values are then not the lanes' and are not
// played), [8 + i] lane i. [4] - [7] are the engine's (counts for the tests, see prp_jump in the ReaScratch JSFX). The ReaScratch JSFX after this one plays them back in the same block (⚪178 stage 2, prp_on).
// MIDI and audio pass through untouched.
options:gmem=ReaScratch_video

slider1:1<1,2,1>Deck (1 = A, 2 = B; set by the setup script)
slider2:-1<-1,1,1>Perf transport (-1 = none, 0 stop, 1 play)
slider3:-1<-1,3600,0.000001>Perf head (s of the sample, -1 = none)
slider4:-1<-1,1,1>Perf driven (-1 = none, 1 = hand / spin / reverse / seek)
slider5:-1<-1,8,1>Perf slot (-1 = none, 1-8)
slider6:-51<-51,50,0.0001>Perf tempo (%, -51 = none)
slider7:-13<-13,12,1>Perf key (semitones, -13 = none)
slider8:-1<-1,1,1>Perf loop on (-1 = none, 0 off, 1 on)
slider9:-1<-1,3600,0.000001>Perf loop start (s of the sample, -1 = none)
slider10:-1<-1,3600,0.000001>Perf loop end (s of the sample, -1 = none)
slider11:-1<-1,1,1>Perf loop roll (-1 = none, 1 = a roll)
slider12:-1<-1,1,1>Perf sync (-1 = none; recorded only, not played)
slider13:-1<-1,3600,0.000001>Perf cue position (s of the sample, -1 = none)
slider14:-2<-2,3600,0.000001>Perf hot cue 1 (s, -1 = empty, -2 = none)
slider15:-2<-2,3600,0.000001>Perf hot cue 2 (s, -1 = empty, -2 = none)
slider16:-2<-2,3600,0.000001>Perf hot cue 3 (s, -1 = empty, -2 = none)
slider17:-2<-2,3600,0.000001>Perf hot cue 4 (s, -1 = empty, -2 = none)
slider18:-2<-2,3600,0.000001>Perf hot cue 5 (s, -1 = empty, -2 = none)
slider19:-2<-2,3600,0.000001>Perf hot cue 6 (s, -1 = empty, -2 = none)
slider20:-2<-2,3600,0.000001>Perf hot cue 7 (s, -1 = empty, -2 = none)
slider21:-2<-2,3600,0.000001>Perf hot cue 8 (s, -1 = empty, -2 = none)
slider22:-3602<-3602,3601,0.000001>Perf memory cue (event: t + 1 = added at t s, -(t + 1) = deleted, 0 = none, -3602 = none)
slider23:-25<-25,24,0.0001>Perf pitch play (PITCH PLAY's key, semitones, -25 = none)
slider24:-2<-2,1,0.0001>Perf xfader position (0 left .. 1 right; -2 = none)
slider25:-2<-2,1,1>Perf xfader cut (1 = cut: the Z key; -2 = none)
slider26:-2<-2,2,1>Perf xfader side (slider 33: 0 off, 1 left, 2 right; -2 = none)
slider27:-2<-2,1,0.0001>Perf channel volume (the volume fader; -2 = none)
slider28:-2<-2,1,1>Perf mute (slider 196; -2 = none)
slider29:-2<-2,1,0.0001>Perf video opacity (slider 195; -2 = none)
slider30:-2<-2,37,1>Perf video blend (slider 78, deck A; -2 = none)
slider31:-2<-2,1,0.0001>Perf blend key threshold (slider 79, deck A; -2 = none)
slider32:-2<-2,1,0.0001>Perf blend key softness (slider 80, deck A; -2 = none)
slider33:-2<-2,7,1>Perf filter type (slider 153; -2 = none)
slider34:-2<-2,1,0.0001>Perf filter cutoff (slider 152; -2 = none)
slider35:-2<-2,1,0.0001>Perf filter resonance (slider 154; -2 = none)
slider36:-2<-2,0.5,0.0001>Perf filter morph (slider 150; -2 = none)
slider37:-2<-2,15,1>Perf video FX type (slider 82; -2 = none)
slider38:-2<-2,1,0.0001>Perf video FX amount (slider 83; -2 = none)
slider39:-2<-2,15,1>Perf master FX type (slider 86, deck A; -2 = none)
slider40:-2<-2,1,0.0001>Perf master FX amount (slider 87, deck A; -2 = none)
slider41:-2<-2,1,0.0001>Perf FX knob 1 (slider 200; -2 = none)
slider42:-2<-2,1,0.0001>Perf FX knob 2 (slider 201; -2 = none)
slider43:-2<-2,1,0.0001>Perf FX knob 3 (slider 202; -2 = none)
slider44:-2<-2,1,0.0001>Perf FX knob 4 (slider 203; -2 = none)
slider45:-2<-2,1,0.0001>Perf FX knob 5 (slider 204; -2 = none)
slider46:-2<-2,1,0.0001>Perf FX knob 6 (slider 205; -2 = none)
slider47:-2<-2,1,0.0001>Perf FX knob 7 (slider 206; -2 = none)
slider48:-2<-2,1,0.0001>Perf FX knob 8 (slider 151; -2 = none)
slider49:-2<-2,1,0.0001>Perf Strobe knob (slider 207; -2 = none)
slider50:-2<-2,1,0.0001>Perf echo amount (slider 197; -2 = none)
slider51:-2<-2,1,0.0001>Perf bitcrusher amount (slider 198; -2 = none)
slider52:-2<-2,1,0.0001>Perf vibrato amount (slider 199; -2 = none)
slider53:-2<-2,1,0.0001>Perf sound of video FX (slider 209; -2 = none)
slider54:-2<-2,255,1>Perf touch FX row 1 (pads 1-8 on: bits; -2 = none)
slider55:-2<-2,255,1>Perf touch FX row 2 (SHIFT pads 1-8 on: bits; -2 = none)
slider56:-2<-2,1,0.0001>Perf touch FX 1-1 amount (row 1 pad 1; -2 = none)
slider57:-2<-2,1,0.0001>Perf touch FX 1-2 amount (row 1 pad 2; -2 = none)
slider58:-2<-2,1,0.0001>Perf touch FX 1-3 amount (row 1 pad 3; -2 = none)
slider59:-2<-2,1,0.0001>Perf touch FX 1-4 amount (row 1 pad 4; -2 = none)
slider60:-2<-2,1,0.0001>Perf touch FX 1-5 amount (row 1 pad 5; -2 = none)
slider61:-2<-2,1,0.0001>Perf touch FX 1-6 amount (row 1 pad 6; -2 = none)
slider62:-2<-2,1,0.0001>Perf touch FX 1-7 amount (row 1 pad 7; -2 = none)
slider63:-2<-2,1,0.0001>Perf touch FX 1-8 amount (row 1 pad 8; -2 = none)
slider64:-2<-2,1,0.0001>Perf touch FX 2-1 amount (row 2 pad 1; -2 = none)
slider65:-2<-2,1,0.0001>Perf touch FX 2-2 amount (row 2 pad 2; -2 = none)
slider66:-2<-2,1,0.0001>Perf touch FX 2-3 amount (row 2 pad 3; -2 = none)
slider67:-2<-2,1,0.0001>Perf touch FX 2-4 amount (row 2 pad 4; -2 = none)
slider68:-2<-2,1,0.0001>Perf touch FX 2-5 amount (row 2 pad 5; -2 = none)
slider69:-2<-2,1,0.0001>Perf touch FX 2-6 amount (row 2 pad 6; -2 = none)
slider70:-2<-2,1,0.0001>Perf touch FX 2-7 amount (row 2 pad 7; -2 = none)
slider71:-2<-2,1,0.0001>Perf touch FX 2-8 amount (row 2 pad 8; -2 = none)
slider72:-2<-2,1,0.0001>Perf pitch mode (slider 52; -2 = none)
slider73:-2<-2,5,1>Perf vibrato step (slider 220; -2 = none)
slider74:-2<-2,12,1>Perf vibrato width (SHIFT + the vibrato step knob; -2 = none)
slider75:-2<-2,1,0.0001>Perf fader lanes gain (the fader lane / a pattern pad's fader; -2 = none)
slider76:-2<-2,255,1>Perf CLIP STOP held (the helper APC40's CLIP STOP 1-8 held: bits; -2 = none)
slider77:-2<-2,4,1>Perf video FX LFO shape (-2 = none)
slider78:-2<-2,5,1>Perf video FX LFO rate (-2 = none)
slider79:-2<-2,1,0.0001>Perf video FX LFO depth (-2 = none)
slider80:-2<-2,1,1>Perf picture mute (the picture only, the sound stays; -2 = none)
slider81:-2<-2,1,0.0001>Perf FX boost (the helper APC40, deck A; -2 = none)
slider82:-2<-2,1,0.0001>Perf master level (the helper APC40, deck A; -2 = none)
slider83:-2<-2,1,1>Perf blackout (the helper APC40, deck A; -2 = none)

@init
ext_noinit = 1;
PL_N = 82;   // lanes (sliders 2 .. PL_N + 1)

@block
pl_b = 14000000 + (slider1 == 2 ? 256 : 0);
gmem[pl_b] += 1; gmem[pl_b + 1] = play_position; gmem[pl_b + 2] = play_state; gmem[pl_b + 3] = (play_state & 1) ? 1 : 0;
pl_i = 1;
loop(PL_N, gmem[pl_b + 8 + pl_i] = slider(pl_i + 1); pl_i += 1);
