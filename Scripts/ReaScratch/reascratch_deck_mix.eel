      gfx_dest = i == 0 ? DST : DSH; gfx_mode = 0x100; gfx_a = 1;
      gfx_deltablit(img, 0, 0, floor(q / 2), floor(H / 2), W / 2 - 2 * (c * q / 4 + sn * H / 4), H / 2 - 2 * (-sn * q / 4 + c * H / 4), 2 * c, -2 * sn, 2 * sn, 2 * c, 0, 0);
      i > 0 ? (gfx_dest = DST; gfx_mode = 0; gfx_a = 1 / (i + 1); gfx_blit(DSH, 0));   // (the running mean)
