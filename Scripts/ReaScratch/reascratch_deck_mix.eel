    gfx_set(1, 1, 1, 0.92); gfx_str_draw("PLAY ▶", x, y); gfx_str_draw("SP", W - x - vh_fs * 1.3, y);
    gfx_a = 1;
  );
);
function vfx(img, t, k, ph, col, slot) local(stp, i, a, c, s, n, d, sw, sh, gx, gy, x, y, r, ang, seg, sx, sy, kx, ky, kqx, kqy, kdir, rot, trh, tn) (
  t >= 1 && k > 0.001 ? (
    t == 1 ? (
      // tint: the picture's brightness from the dark colour to the light colour (⚪114, user's request 2026-10-10: two
      // colours; before, black to the deck's lamp colour, which is the default still), mixed in by the amount. The light
      // colour x 1.3 as before (the mid greys come out bright). [121] / [122] deck A dark / light, [123] / [124] deck B
      // (the mix: deck A's); each a number in tpal's list (2 = the lamp colour)
      tpal(gmem[slot == 1 ? 123 : 121], col); vdr = tp_r; vdg = tp_g; vdb = tp_b;
      tpal(gmem[slot == 1 ? 124 : 122], col); vr = tp_r * 1.3 - vdr; vg = tp_g * 1.3 - vdg; vb = tp_b * 1.3 - vdb; vk = k;
      vdr *= 255; vdg *= 255; vdb *= 255;
