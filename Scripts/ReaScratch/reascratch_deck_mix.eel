  n == 1 ? (
    c = cos(a); sn = sin(a); gfx_dest = TMP1; gfx_mode = 0x100; gfx_a = 1;
    gfx_deltablit(img, x0, 0, q, H, W / 2 + c * (x0 - W / 2) - sn * H / 2, H / 2 - sn * (x0 - W / 2) - c * H / 2, c, -sn, sn, c, 0, 0);
  ) : (
    DSH = iget(DSH, floor(q / 2), floor(H / 2)); DST = iget(DST, floor(q / 2), floor(H / 2));
    i = 0;
    loop(n,
