);
// ((⚪160) VHS's straight overlays, drawn after everything else on the picture (deck_fx: after the vibrato's raster;
// the mix: after its effect): the fine grain, the scan lines and the on-screen text. (user's report 2026-10-13: with
// the raster before VHS its top and bottom wave was smeared away; with the grain inside VHS the raster smoothed it)
function vh_over(img, k, slot) local(n, x, y) (
  // ((⚪161) the fine grain that was here went: ntsc's noise (streaks trailing right) replaced it
  // ((⚪160) scan lines over 30 % of the amount (every other line of 240, up to 10 % darker), then the on-screen
  // text (setup More > Video FX "VHS on-screen text": gmem [275] deck A and the mix / [276] B), drawn last: straight
  vh_sl = (k - 0.3) / 0.7 * 0.1;
  vh_sl > 0.002 ? (
    vh_sp = max(2, floor(H / 240 + 0.5)); gfx_dest = img; gfx_mode = 0; gfx_set(0, 0, 0, vh_sl); n = 0;
    loop(floor(H / vh_sp), gfx_fillrect(0, n * vh_sp, W, max(1, floor(vh_sp / 2))); n += 1);
    gfx_a = 1;
  );
  gmem[slot == 1 ? 276 : 275] > 0.5 ? (
    vh_fs = max(10, floor(H / 16)); gfx_dest = img; gfx_mode = 0; gfx_setfont(vh_fs, "Courier New");
    x = floor(W * 0.06); y = floor(H * 0.07);
