        gfx_mode = 0xfa; gfx_blit(TMP1, 0, 0, 0, W - d - 3, H, d, 0, W - d - 3, H); gfx_blit(TMP1, 0, W - d - 3, 0, d + 3, H, W - d - 3, 0, d + 3, H);
        gfx_mode = 0xf0; gfx_blit(TMP1, 0, d + 3, 0, W - d - 3, H, 3, 0, W - d - 3, H); gfx_blit(TMP1, 0, 0, 0, d + 3, H, 0, 0, d + 3, H);
