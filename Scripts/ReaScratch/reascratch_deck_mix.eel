      h10 = 0.213 - 0.213 * c + 0.143 * s; h11 = 0.715 + 0.285 * c + 0.140 * s; h12 = 0.072 - 0.072 * c - 0.283 * s;
      h20 = 0.213 - 0.213 * c - 0.787 * s; h21 = 0.715 - 0.715 * c + 0.715 * s; h22 = 0.072 + 0.928 * c + 0.072 * s;
      gfx_dest = img; gfx_evalrect(0, 0, W, H, "_1=r;_2=g;_3=b; r=max(0,min(255,h00*_1+h01*_2+h02*_3)); g=max(0,min(255,h10*_1+h11*_2+h12*_3)); b=max(0,min(255,h20*_1+h21*_2+h22*_3));");
    ) : t == 3 ? (
