// ReaScratch deck mix
// (the first line is the name REAPER shows for this Video processor: kept short, ⚪100 - the long one was cut off)
// Deck A (this track, "video") and deck B (the track above with video, "video B view")
// mixed by the crossfader. reascratch_setup.lua puts this code into a Video processor on the "video" track.
// The ReaScratch JSFX writes into the shared memory below: [0] deck A gain, [1] deck B gain (0..1, after the
// crossfader curve, cut and Z key), [2] blend (0 mix, 1 add, 2 subtract, 3 multiply, 4 overlay, 5 soft light,
// 6 hard light, 7 luma key, 8 chroma key; 9 .. the transitions and camera moves, see m below), [3] key threshold, [4] key softness (both 0..1; written by deck A).
// Crossfader at deck A's end = A only, at deck B's end = B only, in the middle = the blend of the two (for "mix" a
// plain crossfade). Both cut = black. Input 0 is this track's own picture, which is also the framebuffer, so both
// inputs are copied first. Blend: B on top of A (subtract = A - B; the keys make parts of B see-through).
// Video FX (2026-10-04, after Resolume's effects): [10..13] deck A / [20..23] deck B = effect (0 off, 1 tint,
// 2 hue rotate, 3 invert, 4 threshold, 5 mirror, 6 kaleidoscope, 7 LoRez, 8 shift RGB, 9 strobe, 10 trails, 11 VHS, 12 disc, 13 line art, 14 halftone, 15 zoom blur), amount
// (0..1), beat position (beats from the deck's grid, -1 = no BPM), lamp colour (0 yellow, 1 blue: the tint);
// [5] / [6] = the effect and amount on the mixed picture (deck A's settings; its beat position for the strobe).
// (⚪128) [131] / [132] / [133] = the camera moves' (the remapped m 25 .. 36, see m below) blur, overshoot, shake (deck A's setup page).
// [99] = the time the last frame took to draw (s; written here, ⚪99). [100] / [101] = deck B / A shows without a frame (⚪100). [102] / [103] = deck A / B Strobe step (⚪101).
// [16] / [26] = deck A / B head moved in the last block (1) or stands still (0). (⚪132) [134] / [135] = deck A / B platter turns (the Disc).
// (⚪135) [136..138] / [139..141] = deck A / B video FX LFO: shape, rate, depth (see lfo below).
// [7] / [27] = deck A / B crossfader flips so far, [8] / [28] = the gain of the last flip.
// (⚪151) [270] / [271] = deck A / B clip changes so far (the JSFX counts them up when it changes the slot): the deck's
// trails and still-picture history are let go (deck B also by [29], the video sync script's; never written: nothing is
// let go). (⚪179) Also read, explained where they are used: [32] / [33] picture fade, [34] / [35] filter tilt, [126] /
// [127], [142] / [143] the crossfader's place and end, [170..177] the TOUCH FX second rows, [188], [241..243],
// [273..276], [372] / [373] (⚪188). Written here: the label pictures at 9000000 / 9010000 and the preview's at 9020000 (see PVN below).
// A deck's effect is drawn only while the deck shows.
//@gmem=ReaScratch_video
//@param1:redraw 'redraw (the video sync script)' 0 0 1 0.5 0.001

t_draw0 = time_precise();   // (⚪99, see the end)
inA = 0; inB = input_track(0);
okA = input_info(inA, wA, hA);
okB = input_info(inB, wB, hB);
// (user's report 2026-10-10: the transitions blurred) project size on auto took deck A's size: a 320 x 240 deck A made
// the mix (deck B's 1280 x 720 too) at 320 x 240. Now the largest picture either deck has handed (kept, so the size
// does not jump when a deck hands no frame)
okA && wA * hA > vmx_w * vmx_h ? (vmx_w = wA; vmx_h = hA);
okB && wB * hB > vmx_w * vmx_h ? (vmx_w = wB; vmx_h = hB);
project_wh_valid === 0 && vmx_w > 0 ? (project_w = vmx_w; project_h = vmx_h);
colorspace = 'RGBA';
// (⚪174, user's choice 2026-10-14: as rekordbox's deck previews, each deck's picture in its record's label in the JSFX) a
// PVN x PVN grid of the deck's picture with its own video effects (also while it is hidden in the mix: see shA below),
// the square in its middle, as r * 65536 + g * 256 + b: deck A gmem [9000000 ..], deck B [9010000 ..], each with a count
// of the grids written at + PVN * PVN. gfx_getpixel reads 0..255 (tried 2026-10-14). ((user 2026-10-14: larger,
// sharper, with the effects) 32 -> 64)
// (⚪179, 2026-10-15: moved from 3000000 / 3010000, which lay inside deck B's scratch lane 2100000 .. 3099999; the JSFX reads the same)
PVN = 64;
function pv_take(pv_in, pv_w, pv_h, pv_o) local(pv_s, pv_x0, pv_y0, pv_i, pv_j, pv_r, pv_g, pv_b) (
  pv_s = min(pv_w, pv_h); pv_x0 = (pv_w - pv_s) * 0.5; pv_y0 = (pv_h - pv_s) * 0.5;
  pv_j = 0;
  loop(PVN,
    pv_i = 0;
    loop(PVN,
      pv_r = pv_g = pv_b = 0;
      gfx_getpixel(pv_in, pv_x0 + (pv_i + 0.5) * pv_s / PVN, pv_y0 + (pv_j + 0.5) * pv_s / PVN, pv_r, pv_g, pv_b);
      gmem[pv_o + pv_j * PVN + pv_i] = floor(max(0, min(255, pv_r))) * 65536 + floor(max(0, min(255, pv_g))) * 256 + floor(max(0, min(255, pv_b)));
      pv_i += 1;
    );
    pv_j += 1;
  );
  gmem[pv_o + PVN * PVN] += 1;
);
// work at 1280x720 at most (2026-10-04): with a 1920x1080 deck A the per-pixel blends drew only 15-22 frames/s.
// Project size on auto: the output itself becomes this size (REAPER scales it to the window). Project size set by
// hand: the mix is made at this size and stretched to the project size at the end.
sc = min(1, min(1280 / max(1, project_w), 720 / max(1, project_h)));
// ((⚪169, user's choice 2026-10-14: a 320 x 240 video made every effect at 320 x 240, coarse when stretched to the window)
// at least as large as fits in 960 x 720 (aspect kept: 320 x 240 -> 960 x 720, 640 x 360 -> 960 x 540); the pictures
// are grown into it (put: filtered), the effects drawn at that size
sc >= 1 ? sc = max(1, min(960 / max(1, project_w), 720 / max(1, project_h)));
W = max(2, floor(project_w * sc * 0.5) * 2); H = max(2, floor(project_h * sc * 0.5) * 2);
project_wh_valid === 0 ? (project_w = W; project_h = H);
OW = project_w; OH = project_h;
// (⚪151) the working size changed this frame: the kept pictures (deck B's, the trails, the histories) hold nothing
// usable at the new size (taken again / started afresh below)
sz_ch = W != szW || H != szH; szW = W; szH = H;

gA = max(0, min(1, gmem[0])); gB = max(0, min(1, gmem[1]));
// a crossfader flip (counted by each deck: [7] / [27], its gain [8] / [28]) is drawn for 2 frames even if it is over
// before this frame (a 16th-note cut fell between two redraws and never showed, 2026-10-05)
// (⚪151) the first frame after the code is loaded takes the counts as they are: fnA = 0 drew an old flip's gain for 2 frames
!fn_ok ? (fnA = gmem[7]; fnB = gmem[27]; clA = gmem[270]; clB = gmem[271]; fn_ok = 1);
gmem[7] != fnA ? (fnA = gmem[7]; fkA = 2; fgA = gmem[8]); fkA > 0 ? (gA = max(0, min(1, fgA)); fkA -= 1);
gmem[27] != fnB ? (fnB = gmem[27]; fkB = 2; fgB = gmem[28]); fkB > 0 ? (gB = max(0, min(1, fgB)); fkB -= 1);
// (⚪91) [34] / [35] = each deck's filter tilt (-1 the lows .. +1 the highs): the mixed picture's look follows the decks
// that show (weighted by their gains). [32] / [33] = each deck's picture fade (1 - opacity; the APC40's faders): the
// sound stays, the picture goes (the other deck takes its place, as on the crossfader)
tw = gA + gB; tlt = tw > 0.0001 ? max(-1, min(1, (gA * gmem[34] + gB * gmem[35]) / tw)) : 0; abs(tlt) < 0.02 ? tlt = 0;
gA *= 1 - max(0, min(1, gmem[32])); gB *= 1 - max(0, min(1, gmem[33]));
m = max(0, min(37, gmem[2] | 0)); m = m <= 12 ? m : m <= 25 ? m + 1 : m <= 30 ? m + 2 : m == 31 ? 33 : m == 32 ? 36 : m + 4;   // ((2026-10-12, user's choice) 32 = Tilt down (it was Tilt up, 35))
// ((2026-10-12, user's choices) taken out of the JSFX's list: Push (13 here), then Whip left (27), Tilt left (34) and
// Tilt up (35) (going back runs the mirror image of Whip right / Tilt right / Tilt down instead): the JSFX's numbers
// turned into these, which are not reached for the four (⚪150: this said Tilt down (36); 36 is the one in use))
 th = gmem[3]; soft = gmem[4];   // ((⚪116) 9 .. 24 = the transitions, (⚪128) 25 .. 36 the camera moves, (⚪136) 37 .. the transitions again)
s = gA + gB;
xf = s > 0.0001 ? gB / s : 0.5;
// ((2026-10-12) the transitions and camera moves (9 ..) by the crossfader's place (deck A writes gmem [142], see the JSFX):
// by the gains' ratio they jumped to a quarter at the cut-in and stopped at three quarters)
m >= 9 && gmem[142] >= 0 ? xf = max(0, min(1, gmem[142]));
vis = min(1, s);
cA = xf < 0.5 ? 1 - 2 * xf : 0;
cY = xf < 0.5 ? 2 * xf : 2 - 2 * xf;
cB = xf < 0.5 ? 0 : 2 * xf - 1;
cA *= vis; cY *= vis; cB *= vis;
m == 0 ? (cA += cY * 0.5; cB += cY * 0.5; cY = 0);   // plain mix = straight crossfade
// ((⚪116) a transition: between the ends only its picture (T), at the ends the deck there
m >= 9 ? (cY = xf > 0.0001 && xf < 0.9999 ? vis : 0; cA = xf <= 0.0001 ? vis : 0; cB = xf >= 0.9999 ? vis : 0);

function clear(img) ( gfx_dest = img; gfx_mode = 0; gfx_a = 1; gfx_set(0, 0, 0, 1); gfx_fillrect(0, 0, W, H); );
function put(img, a, md) ( a > 0 ? ( gfx_mode = md | 0x100; gfx_a = a; gfx_blit(img, 1); ); );
// ((2026-10-12, the user's report: deck B showed deck A's video at the crossfader's B end) a Video processor holds 32
// images at most, and with the effects and transitions added on 2026-10-12 about 60 could be made: once the user had
// gone through them, a new one (deck B's trails picture) came out as -1 = this track's own picture, deck A's video.
// ((⚪151, counted again) kept for good: imA, imB, BKEEP, T, Oimg, the trails TPIC [0..2], the histories HPIC [0..2], DSK,
// HTD, QBM (14) and the scratch TMP1 / TMP3 / TMPS (3): 17. Every other picture is let go at the end of the function that
// made it (ifree: the handle back to 0, so the next resize makes a new one). The most alive at once on top of the 17: a
// camera move (TBL + CMT, CMM, CMU, CMS + one half copy + one bordered copy: 7; 9 if both decks' copies were made) or the
// Defocus (TBL + 7 levels: 8); a deck's VHS 2 (TMPV2 / TMPV4, ⚪161), Halftone or Line art 4: 26 at most
// ((⚪160) + the VHS afterglow VHP [0..2] kept while VHS is drawn (freed at the frame's end when not): 29 at most
function ifree(im) ( im > 0 ? gfx_img_free(im); 0; );   // ((⚪150) not "h": that is H)
// (⚪151) every picture is made / resized here: gfx_img_resize gives -1 (= this track's own picture) when it cannot make
// one, and a handle kept at -1 drew every frame after into the output itself (and resized it). Failed: 0 (none), so the
// next frame tries again; the callers that keep a picture by its size forget the size then
function iget(im, iw, ih) local(r) ( r = gfx_img_resize(im > 0 ? im : 0, iw, ih); r > 0 ? r : 0; );
function cp(dst, src) ( gfx_dest = dst; gfx_mode = 0; gfx_a = 1; gfx_blit(src, 0); );
// (⚪151) the usual 0..1 hash of a number (the fraction of a large sine), used for the "random" places and times
function hash(x) ( x = sin(x) * 43758.5453; x - floor(x); );
// (⚪151) a copy of the picture (W x H) put at (ox, oy) in a larger one (gw x gh) whose edges are the picture's own
// stretched round it (the LoRez, the Halftone, the Brush wipe's card): returns the larger one's handle
function pad_cp(dst, src, gw, gh, ox, oy) (
  dst = iget(dst, gw, gh);
  gfx_dest = dst; gfx_mode = 0x100; gfx_a = 1; gfx_blit(src, 0, 0, 0, gw, gh);   // the stretched edges
  gfx_mode = 0; gfx_blit(src, 0, ox, oy, W, H);
  dst;
);
// (⚪151) the lookup table's red part (LUT [0..255], 0..1) copied to the three channels times lr / lg / lb (up to 1)
function lut_fill(lr, lg, lb) local(i, v) (
  i = 0; loop(256, v = LUT[i]; LUT[i] = min(1, v * lr); LUT[256 + i] = min(1, v * lg); LUT[512 + i] = min(1, v * lb); i += 1);
);
// (⚪151, was in the Strobe and lfo twice) a deck's beat position comes in steps (one an audio block, about 23 ms):
// while it moves forward, the place between its steps from the time since it came at the beats a second it moves.
// o [0] the last position, o [1] when it changed, o [2] beats a second (smoothed). bp_mv = it is moving forward now
function bp_est(o, ph) local(t, d, dt) (
  t = time_precise();
  ph != o[0] ? (
    d = ph - o[0]; dt = t - o[1];
    d > 0 && d < 1 && dt > 0.001 && dt < 0.25 ? o[2] += (d / dt - o[2]) * (o[2] > 0 ? 0.15 : 1) : (o[2] = 0);
    o[0] = ph; o[1] = t;
  );
  bp_mv = o[2] > 0 && t - o[1] < 0.25;
  bp_mv ? ph + o[2] * (t - o[1]) : ph;
);

// (⚪116, user's request and choices 2026-10-10: transitions from deck A to B, after After Effects / Premiere / Resolve /
// Resolume / gl-transitions) blends 9 .. 24: the crossfader's place p (0 = deck A .. 1 = deck B) is how far it has gone,
// and T is the picture between the ends (no blend of the two). Wipe right / down / diagonal, Split (from the centre),
// Push, Slide, Blinds (8 bands), Iris box / diamond / circle, Clock (from 12, clockwise), Blocks (16 x 9, each at its
// own time), Dip to black / white, Pixelate (coarsest in the middle), Zoom. The edges: see tr_m below
// ((⚪116 follow-up, user's reports 2026-10-10: jagged, then coarse / blurred edges) each pixel of the mask (white =
// deck B) is worked out from its distance to the shape's edge (px): 0.5 + d / (1 + 40 x key softness), so the edge is
// smooth at any angle and the softness is exact (before: the shapes drawn in strips, shrunk and grown again - REAPER
// picks pixels without averaging when it shrinks, so the steps of slanted and round edges stayed, blurred). The mask is
// worked out at half size (one evalrect, in order: _1 counts the pixels) and grown. Blocks keeps its sharp rects (tr_m,
// user's choice). QMK = the mask at 1x, QMH = at half. The wipes start and end a blur's width outside the picture
function tr_m(qx, qy, qw, qh) ( qw > 0 && qh > 0 ? gfx_fillrect(qx, qy, qw, qh); );   // a rect of the mask
function tr_draw(qm, qp) local(qx, qy, qw, qh, qi, qj, qr, qa, qcx, qcy, qf, qsw, qsh, qs, qmg, i) (
  qcx = W / 2; qcy = H / 2;
  qm == 14 || (qm >= 21 && qm <= 24) ? (   // ((⚪150) Push (13) is out of the list: its branch went)
    clear(T);
    qm == 14 ? (gfx_dest = T; gfx_mode = 0x100; gfx_a = 1; gfx_blit(imA, 0, 0, 0, W, H); gfx_blit(imB, 0, tr_mr ? W - qp * W : qp * W - W, 0, W, H)) :   // ((user's request 2026-10-12) B in from the left (before: from the right); going back from the right)
    qm == 21 || qm == 22 ? (gfx_dest = T; gfx_mode = 0x100; gfx_a = 1; gfx_blit(qp < 0.5 ? imA : imB, 0, 0, 0, W, H);
                            qa = qp < 0.5 ? 2 * qp : 2 - 2 * qp; gfx_mode = 0; gfx_set(qm == 22, qm == 22, qm == 22, qa, 0); gfx_fillrect(0, 0, W, H)) :
    qm == 23 ? (qf = 1 + 31 * (1 - abs(2 * qp - 1)); qsw = max(1, floor(W / qf)); qsh = max(1, floor(H / qf)); TRP = iget(TRP, qsw, qsh);
                gfx_dest = TRP; gfx_mode = 0x100; gfx_a = 1; gfx_blit(qp < 0.5 ? imA : imB, 0, 0, 0, qsw, qsh);
                gfx_dest = T; gfx_mode = 0; gfx_a = 1; gfx_blit(TRP, 0, 0, 0, W, H)) :
    (gfx_dest = T; gfx_mode = 0x100; qs = 1 + qp; gfx_a = 1; gfx_blit(imA, 0, qcx - qcx * qs, qcy - qcy * qs, W * qs, H * qs);
     qs = 2 - qp; gfx_a = qp; gfx_blit(imB, 0, qcx - qcx * qs, qcy - qcy * qs, W * qs, H * qs));
  ) : (
    QMK = iget(QMK, W, H);
    qm == 20 ? (
      gfx_dest = QMK; gfx_mode = 0; gfx_a = 1; gfx_set(0, 0, 0, 1); gfx_fillrect(0, 0, W, H); gfx_set(1, 1, 1, 1);
      qw = W / 16; qh = H / 9; qj = 0; loop(9, qi = 0; loop(16, qr = hash(qi * 12.9898 + qj * 78.233); qr < qp ? tr_m(qi * qw, qj * qh, qw, qh); qi += 1); qj += 1);
    ) : (
      qf = 1 + max(0, min(1, soft)) * 40; qmg = qf + 2;   // the blur's width (px) and the wipes' margin
      tq_fi = 1 / qf; tq_cx = qcx; tq_cy = qcy;
      qsw = max(2, floor(W / 2)); qsh = max(2, floor(H / 2));
      // ((⚪150) the Brush wipe (37) is br_draw's since 2026-10-12: its mask code here (a margin tq_mh round the mask, the
      // torn edge, the shadow and white edge, the turned stop-motion steps) went; (⚪179) its margin, always 0, too)
      QMH = iget(QMH, qsw, qsh);
      tq_mw = qsw; tq_mi = 1 / tq_mw; tq_sx = W / qsw; tq_sy = H / qsh;
      // the pixel's place in 1x units: _6, _7; the distance into deck B's side: _9
      strcpy(#tq, "_2=floor((_1+0.5)*tq_mi); _3=_1-_2*tq_mw; _1+=1; _6=(_3+0.5)*tq_sx; _7=(_2+0.5)*tq_sy; ");
      tr_mr ? (tq_W = W; strcat(#tq, "_6=tq_W-_6; "));   // ((2026-10-12) mirrored left-right going back (see tr_mr))
      qm == 9 ? (tq_e = -qmg + qp * (W + 2 * qmg); strcat(#tq, "_9=tq_e-_6;")) :
      qm == 10 ? (tq_e = -qmg + qp * (H + 2 * qmg); strcat(#tq, "_9=tq_e-_7;")) :
      // the edge slants: x at row y = e + (1 - y / H) * 0.6 H
      qm == 11 ? (tq_e = -qmg - H * 0.6 + qp * (W + H * 0.6 + 2 * qmg); tq_k = H * 0.6; tq_ih = 1 / H; tq_n = 1 / sqrt(1.36);
                  strcat(#tq, "_9=(tq_e+(1-_7*tq_ih)*tq_k-_6)*tq_n;")) :
      qm == 12 ? (tq_e = -qmg + qp * (W / 2 + qmg); strcat(#tq, "_9=tq_e-abs(_6-tq_cx);")) :
      // 8 bands, each filled from its top
      qm == 15 ? (tq_bh = H / 8; tq_bi = 1 / tq_bh; tq_e = qp * (tq_bh + qmg) - qmg * 0.5; strcat(#tq, "_9=tq_e-(_7-floor(_7*tq_bi)*tq_bh);")) :
      qm == 16 ? (tq_w2 = -qmg * 0.5 + qp * (W / 2 + qmg); tq_h2 = tq_w2 * H / W; strcat(#tq, "_9=min(tq_w2-abs(_6-tq_cx),tq_h2-abs(_7-tq_cy));")) :
      qm == 17 ? (tq_ax = 2 / W; tq_ay = 2 / H; tq_n = 1 / sqrt(tq_ax * tq_ax + tq_ay * tq_ay); qa = qmg / tq_n; tq_e = -qa * 0.5 + qp * (2 + qa);
                  strcat(#tq, "_9=(tq_e-abs(_6-tq_cx)*tq_ax-abs(_7-tq_cy)*tq_ay)*tq_n;")) :
      qm == 18 ? (tq_e = -qmg * 0.5 + qp * (sqrt(qcx * qcx + qcy * qcy) + qmg); strcat(#tq, "_4=_6-tq_cx; _5=_7-tq_cy; _9=tq_e-sqrt(_4*_4+_5*_5);")) :
      // the angle from 12, clockwise (0 .. 2 pi); the distance to the nearer of the two rays, as the arc at that radius
      (tq_e = qp * 2 * $pi; tq_e >= 2 * $pi - 0.0001 ? tq_e = 100;
       strcat(#tq, "_4=_6-tq_cx; _5=_7-tq_cy; _8=atan2(_4,-_5); _8<0?_8+=2*$pi; _2=sqrt(_4*_4+_5*_5); _9=tq_e>=100?1000:_8<tq_e?min(_8,tq_e-_8)*_2:-min(_8-tq_e,2*$pi-_8)*_2;"));
      strcat(#tq, " _9=max(0,min(255,(0.5+_9*tq_fi)*255)); r=_9; g=_9; b=_9; a=255;");
      gfx_dest = QMH; gfx_evalrect(0, 0, qsw, qsh, #tq, 1, -2, "_1=0;");
      gfx_dest = QMK; gfx_mode = 0x100; gfx_a = 1; gfx_blit(QMH, 0, 0, 0, W, H, 0, 0, qsw, qsh);
    );
    // ((⚪169, lighter) A x (1 - mask) + B x mask by blits (multiply, the mask turned over by a table, add): it was one
    // per-pixel pass
    TMP1 = iget(TMP1, W, H); TMP3 = iget(TMP3, W, H);
    cp(T, imB); gfx_dest = T; gfx_mode = 3; gfx_a = 1; gfx_blit(QMK, 0);
    cp(TMP1, QMK); i = 0; loop(256, LUT[i] = LUT[256 + i] = LUT[512 + i] = 1 - i / 255; i += 1); gfx_dest = TMP1; gfx_procrect(0, 0, W, H, LUT);
    cp(TMP3, imA); gfx_dest = TMP3; gfx_mode = 3; gfx_a = 1; gfx_blit(TMP1, 0);
    gfx_dest = T; gfx_mode = 1; gfx_a = 1; gfx_blit(TMP3, 0);
  );
  QMK = ifree(QMK); QMH = ifree(QMH); TRP = ifree(TRP);
  gfx_mode = 0; gfx_a = 1;
);

// ((⚪118) moved here, before vfx: VHS calls raster, and EEL2 needs a function defined before it is used)
// the raster wave (⚪93 / ⚪95 / ⚪97 / ⚪98, user's requests 2026-10-08 / 09; the vibrato fader's picture): the picture bent up and
// down in waves across it, as AviUtl's raster (vertical): each column moved, and the picture's top and bottom edges wave
// too (black shows where the picture moved away, as in the picture the user showed). Measured there (2026-10-09): crest
// to trough 14-16 px of a 540 px tall picture, a wave every 32 px, and from a crest down 0,1,3,5,8,10,12,13,14 px: sharper
// crests and rounder troughs than a sine -> the shape 0.7 sin + 0.3 (a cusp at the crest), a wave every H / 17, up to
// 1.6 % of H (against the height: across the width a 4:3 picture in 16:9 got fewer, gentler waves), standing still.
// The picture is put into one with black margins above and below (TMPR) and read through four grids (quarters of the
// width) of 32 source points a wave (16 looked jagged on curves, user's report 2026-10-09), 2 rows (gfx_xformblit took nothing at 271 x 2: about 250 columns a call at most).
// The picture shrinks by the wave's height above and below (up to 3 %), so both its top and bottom edges stay inside the
// screen and wave all the way (a picture filling the screen showed only the half that moved in, as drops)
function rs_wave(ph) local(c) ( c = cos(ph); 0.7 * c + 0.3 * (1 - 2 * abs(sin(ph * 0.5))); );
// one quarter of the width through the grid: dest rect (dx, dy, dw, dh) shows the rows from ya to yb of the warped picture
// (rows of the output, may be fractional), the columns of quarter q
function rs_quarter(k, q, n4, nc, m, a0, dx, dy, dw, dh, ya, yb) local(i, gx, ph, sy, sx, f) (
  f = (H - 1 + 2 * a0) / (H - 1); i = 0; gx = 0;
  loop(nc,
    ph = (q + gx / (nc - 1)) * n4 * 2 * $pi;
    sy = k * 0.016 * H * rs_wave(ph);   // (this way the sharp crests point up, as in the picture the user showed)
    sx = q * W / 4 + gx / (nc - 1) * (W / 4 - 1);
    KT[i] = sx; KT[i + 1] = m - a0 + sy + ya * f;
    KT[2 * nc + i] = sx; KT[2 * nc + i + 1] = m - a0 + sy + yb * f;
    i += 2; gx += 1;
  );
  gfx_xformblit(TMPR, dx, dy, dw, dh, nc, 2, KT);
);
function raster(img, k) local(n, n4, nc, m, a0, q, hb, band, yb, ss) (
  n = max(4, floor(W / (H / 17) * 0.25 + 0.5) * 4); n4 = n / 4; nc = min(250, n4 * 32 + 1);   // (4 parts, 32 points a wave)
  m = ceil(2 * 0.016 * H) + 2; a0 = k * 0.016 * H;
  TMPR = iget(TMPR, W, H + 2 * m);
  gfx_dest = TMPR; gfx_mode = 0; gfx_a = 1; gfx_set(0, 0, 0, 1); gfx_fillrect(0, 0, W, H + 2 * m);
  gfx_blit(img, 0, 0, m, W, H);
  // a small picture is warped at 4 x 4 (up to 320 wide) / 2 x 2 (up to 640) its pixels and brought down by halves (2 x 2
  // averages): at 320 x 240 the warped edges showed the pixels in steps (user's question 2026-10-09: "can supersampling
  // smooth it at the small size?"). A bigger one is warped at its size, and only its top and bottom edges as below
  ss = W <= 320 ? 4 : W <= 640 ? 2 : 1;
  ss > 1 ? (
    TMPU = iget(TMPU, W * ss, H * ss);
    gfx_dest = TMPU; gfx_mode = 0x100; gfx_a = 1;
    q = 0; loop(4, rs_quarter(k, q, n4, nc, m, a0, q * W * ss / 4, 0, W * ss / 4, H * ss, 0, H - 1); q += 1);
    ss == 4 ? (TMPU2 = iget(TMPU2, W * 2, H * 2); gfx_dest = TMPU2; gfx_mode = 0x100; gfx_blit(TMPU, 0, 0, 0, W * 2, H * 2));
    gfx_dest = img; gfx_mode = 0x100; gfx_a = 1; gfx_blit(ss == 4 ? TMPU2 : TMPU, 0, 0, 0, W, H);
  ) : (
  gfx_dest = img; gfx_mode = 0x100; gfx_a = 1;
  q = 0; loop(4, rs_quarter(k, q, n4, nc, m, a0, q * W / 4, 0, W / 4, H, 0, H - 1); q += 1);
  // the top and bottom edges again at 4 x 4 the pixels, brought down by halves (2 x 2 averages): their slopes showed steps
  // (user's report 2026-10-09: "the top and bottom edges still look rough")
  hb = ceil(2 * a0) + 4;
  a0 > 0.3 ? (
    band = 0;
    loop(2,
      yb = band == 0 ? 0 : H - hb;
      TMPB = iget(TMPB, W * 4, hb * 4); TMPB2 = iget(TMPB2, W * 2, hb * 2);
      gfx_dest = TMPB; gfx_mode = 0x100; gfx_a = 1;
      q = 0; loop(4, rs_quarter(k, q, n4, nc, m, a0, q * W, 0, W, hb * 4, yb, yb + hb); q += 1);
      gfx_dest = TMPB2; gfx_mode = 0x100; gfx_blit(TMPB, 0, 0, 0, W * 2, hb * 2);
      gfx_dest = img; gfx_mode = 0x100; gfx_blit(TMPB2, 0, 0, yb, W, hb);
      band += 1;
    );
  );
  );
  TMPR = ifree(TMPR); TMPU = ifree(TMPU); TMPU2 = ifree(TMPU2); TMPB = ifree(TMPB); TMPB2 = ifree(TMPB2);
  gfx_mode = 0; gfx_a = 1;
);
// ---- video FX on one picture (img, W x H). t = effect, k = amount (0 = off), ph = beat position, col = lamp colour,
// slot = 0 deck A / 1 deck B / 2 the mix (its own trails picture). EEL2 names ignore case: a local h would hide H, cy
// would hide cY, and the blend code's x1 would overwrite a picture named X1 - keep names apart. Scratch pictures: TMP1, TMP3 (W x H), TMPS (small).
// Per-pixel results are clamped to 0..255. Local memory: LUT (768, invert), KT (kaleidoscope grid), TRF (frame each trails picture was last drawn),
// TRK (it holds a real frame). vok = the picture is a frame REAPER handed over (set before each call)
// ((⚪151) TRT = when each trails picture was last added to, HLC = when each history was last looked at; the pictures'
// handles: TPIC [slot] the trails, HPIC [slot] the histories, as TRA / TRB / TRM and HIA / HIB / HIM were)
LUT = 0; KT = 1000; TRF = 9000; TRK = 9010; HMV = 9020; HSD = 9030; HTM = 9040; STB = 9300;
HLC = 9050; TRT = 9060; HPIC = 9070; TPIC = 9080; VHP = 9090; VHF = 9094; VNB = 20000;   // ((⚪160) VHS's afterglow: the last frame per picture / when drawn
fr += 1;
stb_ft = time_precise(); stb_ft - STB[20] > 0.001 && stb_ft - STB[20] < 0.2 ? STB[21] += (stb_ft - STB[20] - STB[21]) * (STB[21] > 0 ? 0.05 : 1); STB[20] = stb_ft;   // ((⚪114) the frame time, for the Strobe)
// (⚪151) a picture's trails and history start afresh (no ghost of the last clip or of another size): the size changed,
// or the deck's clip changed (deck A [270], deck B [271] and [29] below; the mix's with either deck's)
function pic_reset(slot) ( HSD[slot] = 0; TRF[slot] = -10; );
sz_ch ? (hasBK = 0; pic_reset(0); pic_reset(1); pic_reset(2));
gmem[270] != clA ? (clA = gmem[270]; pic_reset(0); pic_reset(2));
gmem[271] != clB ? (clB = gmem[271]; pic_reset(1); pic_reset(2));
// (⚪100, user's choice 2026-10-09) the echo fader on a standing picture: trails show only the motion they saw, and a still
// picture showed nothing at all. So each picture keeps a history of its last frames while it moves, whatever the effects
// (each frame laid over at 0.07 as the trails at amount 1, at most every 1/30 s; started afresh from the first frame of a move, so a jump
// or another slot leaves no old ghost), frozen while it stands. Standing, the trails show that history over the picture
// at the trails' strength: the afterimage of the motion just before it stopped. HPIC [0..2] = deck A / B / the mix,
// HMV = it moved last frame, HSD = it holds frames, HTM = when it was last added to. mv = it moves now
// ((⚪151) not looked at for over 1 s (the deck hidden): the history is dropped, not shown again as it was)
function hist_upd(img, slot, mv) local(hh, t) (
  t = time_precise();
  t - HLC[slot] > 1 ? HSD[slot] = 0; HLC[slot] = t;
  HPIC[slot] = iget(HPIC[slot], W, H); hh = HPIC[slot]; hh <= 0 ? HSD[slot] = 0;
  hh > 0 && mv && vok && (t - HTM[slot] >= 0.03 || !HMV[slot]) ? (   // (at most every 1/30 s: REAPER draws several times a frame)
    !HMV[slot] || !HSD[slot] ? cp(hh, img) : (gfx_dest = hh; gfx_mode = 0; gfx_a = 0.07; gfx_blit(img, 0));
    HSD[slot] = 1; HTM[slot] = t;
  );
  HMV[slot] = mv;
);
// (⚪114) the Tint's colours: Black, White, the lamp colour (col: 0 yellow, 1 blue), Red, Orange, Yellow, Lime, Green,
// Cyan, Sky, Blue, Navy, Purple, Magenta, Pink (the JSFX's sliders 249 / 250) -> tp_r / tp_g / tp_b (0..1)
function tpal(i, col) (
  i = i | 0;
  i == 1 ? (tp_r = 1; tp_g = 1; tp_b = 1) :
  i == 2 ? (col ? (tp_r = 0.31; tp_g = 0.70; tp_b = 0.88) : (tp_r = 0.98; tp_g = 0.84; tp_b = 0.26)) :
  i == 3 ? (tp_r = 0.95; tp_g = 0.15; tp_b = 0.15) : i == 4 ? (tp_r = 1; tp_g = 0.55; tp_b = 0.1) :
  i == 5 ? (tp_r = 1; tp_g = 0.9; tp_b = 0.15) : i == 6 ? (tp_r = 0.65; tp_g = 0.95; tp_b = 0.2) :
  i == 7 ? (tp_r = 0.1; tp_g = 0.75; tp_b = 0.3) : i == 8 ? (tp_r = 0.1; tp_g = 0.9; tp_b = 0.95) :
  i == 9 ? (tp_r = 0.45; tp_g = 0.75; tp_b = 1) : i == 10 ? (tp_r = 0.15; tp_g = 0.35; tp_b = 1) :
  i == 11 ? (tp_r = 0.05; tp_g = 0.08; tp_b = 0.35) : i == 12 ? (tp_r = 0.55; tp_g = 0.2; tp_b = 0.9) :
  i == 13 ? (tp_r = 1; tp_g = 0.15; tp_b = 0.85) : i == 14 ? (tp_r = 1; tp_g = 0.55; tp_b = 0.75) :
  (tp_r = 0; tp_g = 0; tp_b = 0);
);
// (⚪132, user's choice 2026-10-12: the round panels of a motion graphics reel) the Disc: the picture cut out as a record
// (a circle as high as the picture, a spindle hole, a darker ring at the rim and two faint ones between the tracks: fine
// grooves made moire, 2026-10-12), turned by the deck's
// platter (as the sticker on the front page: forward = clockwise, a scratch turns it back), black round it; mixed in by
// the amount. The mask (DSK, white = the record) is worked out once for each size (one evalrect, in order: _1 counts
// the pixels); the turn is a gfx_deltablit round the centre (a circle as high as the picture reads only inside it)
// ((user's request for the camera moves, 2026-10-11, applied here too: an AviUtl-like blur when turning) while the record
// turns fast (a scratch, a spin back), copies along the arc it turned since the last frame (DSL [slot]: the last turns),
// as long as the camera moves' blur (gmem [131]) says, averaged (up to 16; at most 1.6 rad)
DSL = 9620;
function disc(img, k, turns, slot) local(c, sn, a, x0, q, sp, n, i, aa) (
  (DSK_w != W || DSK_h != H) ? (
    DSK = iget(DSK, W, H); DSK_w = DSK > 0 ? W : 0; DSK_h = H;   // ((⚪151) not made: tried again next frame)
    dk_w = W; dk_iw = 1 / W; dk_cx = W / 2; dk_cy = H / 2; dk_R = H * 0.47; dk_h = H * 0.012;
    dk_rr = dk_R - H * 0.012; dk_ri = 1 / max(1, H * 0.006); dk_r1 = dk_R * 0.62; dk_r2 = dk_R * 0.8; dk_ti = 1 / max(1, H * 0.003);
    DSK > 0 ? (gfx_dest = DSK; gfx_evalrect(0, 0, W, H, "_2=floor((_1+0.5)*dk_iw); _3=_1-_2*dk_w; _1+=1; _4=_3+0.5-dk_cx; _5=_2+0.5-dk_cy; _6=sqrt(_4*_4+_5*_5); _7=max(0,min(1,dk_R-_6+0.5))*max(0,min(1,_6-dk_h+0.5)); _8=max(0,1-abs(_6-dk_rr)*dk_ri); _9=max(0,1-abs(_6-dk_r1)*dk_ti)+max(0,1-abs(_6-dk_r2)*dk_ti); _7*=(1-0.5*_8)*(1-0.3*_9)*255; r=_7; g=_7; b=_7; a=255;", 1, -2, "_1=0;"));
  );
  DSK > 0 ? (   // ((⚪151) no mask: no Disc this frame)
  // only the square the record is in (x0 .. x0 + q): the source of a pixel = the centre + its offset turned back by a
  a = 2 * $pi * turns; q = min(W, H); x0 = floor((W - q) / 2);
  // (a jump (CUE, a hot cue, the first frame) is more than 0.4 turns a frame: no blur)
  sp = abs(turns - DSL[slot]) < 0.4 ? 2 * $pi * (turns - DSL[slot]) * max(0, min(1, gmem[131])) : 0; DSL[slot] = turns; sp = max(-1.6, min(1.6, sp));
  // (while blurring, as the camera moves: the copies at half size (DSH / DST, 0.006 rad apart, up to 24: 0.02 apart at
  // full size showed steps and took 41 ms) and the mean grown back)
  n = abs(sp) > 0.012 ? min(24, ceil(abs(sp) / 0.006) + 1) : 1;
