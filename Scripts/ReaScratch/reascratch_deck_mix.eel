      gfx_dest = TMPS; gfx_mode = 0x100; gfx_blit(TMPP, 0, 0, 0, sw, sh, d * 0.5 - 0.5, d * 0.5 - 0.5, gx, gy);
      gfx_dest = TMPP; gfx_mode = 0; gfx_blit(TMPS, 0, 0, 0, gx, gy);
