);
// (⚪133, user's choice 2026-10-12: a line drawing on purple paper in the reel) Line art: the outlines only, white lines
// on black (the colours: with the Tint after it, e.g. Purple / White). The picture at half size (each pixel the mean of
// 2 x 2: less noise, lines about 2 px wide at full size) against copies moved by 1 px right and down (an evalrect reads
// no other pixel): the brightness steps across and down are the line. la_lines(img) leaves the lines (0..255 grey) in
// LAF (W x H); ⚪140 uses it too. Pictures LA0 / LA1 / LA2 (half size)
// ((⚪167, user's choice 2026-10-14) la_lines(img, d): the work picture at 1 / d of the size (d = 2: half, thin
// lines, the details; up to 8: an eighth, thick lines, only the big outlines). Made smaller by halves first (a mean of
// 2 x 2 each; LA1 / LA2 lent for it), the last step at most 2 x, so the small picture is a mean, not a few pixels picked
// ((⚪167, user's report the same day: poor even at the least; asked for a known good method) tried a difference of
// Gaussians (DoG, from Winnemoeller et al., "XDoG", 2012): crisp, but heavier (about +10..20 ms) and still not the look
// asked for: ((user's report: "not yet crisp and smooth like an X-ray"; lighter wanted) the X-ray look as the usual
// recipes make it (After Effects: Find Edges + Invert + Glow, added; the Proto-Monitor shader: the brightness inverted,
// the steps to the neighbours added): the gradient's size not cut by a threshold (smooth), a little under 3 grey levels
// dropped (the MJPEG's blocks on flat backgrounds), a curve (^0.8), plus a glow (the edges blurred at half the work
// size) and the picture's brightness inverted, faint (the "body"). Worked out at 1 / d of the size (d = 2: half, as
// before: light), grown back; the edges made steep again by d / 2 (the glow and the body left smooth). Tried in Python
// on the test videos . la_box: a 3 x 3 box, a mean of copies 1 px apart (LA1 the scratch)
// (the top-left sw x sh of im / LA1 only: the pictures may be larger, e.g. the glow at half size in LA2)
function la_box(im, sw, sh) (
  gfx_dest = LA1; gfx_mode = 0; gfx_a = 1; gfx_blit(im, 0, 0, 0, sw, sh, 0, 0, sw, sh);
  gfx_a = 0.5; gfx_blit(im, 0, -1, 0, sw, sh, 0, 0, sw, sh); gfx_a = 1 / 3; gfx_blit(im, 0, 1, 0, sw, sh, 0, 0, sw, sh);
  gfx_dest = im; gfx_a = 1; gfx_blit(LA1, 0, 0, 0, sw, sh, 0, 0, sw, sh);
  gfx_a = 0.5; gfx_blit(LA1, 0, 0, -1, sw, sh, 0, 0, sw, sh); gfx_a = 1 / 3; gfx_blit(LA1, 0, 0, 1, sw, sh, 0, 0, sw, sh); gfx_a = 1;
);
function la_lines(img, d) local(sw, sh, gw, gh, src) (
  d = max(2, min(8, d)); sw = max(4, floor(W / d)); sh = max(4, floor(H / d)); gw = floor(sw / 2); gh = floor(sh / 2);
  LA1 = iget(LA1, max(2, floor(W / 2)), max(2, floor(H / 2))); gfx_dest = LA1; gfx_mode = 0x100; gfx_a = 1; gfx_blit(img, 0, 0, 0, max(2, floor(W / 2)), max(2, floor(H / 2))); src = LA1;
  d > 4 ? (LA2 = iget(LA2, max(2, floor(W / 4)), max(2, floor(H / 4))); gfx_dest = LA2; gfx_mode = 0x100; gfx_blit(LA1, 0, 0, 0, max(2, floor(W / 4)), max(2, floor(H / 4))); src = LA2);
  LA0 = iget(LA0, sw, sh); gfx_dest = LA0; gfx_mode = d > 2.001 ? 0x100 : 0; gfx_a = 1; gfx_blit(src, 0, 0, 0, sw, sh);
  LA1 = iget(LA1, sw, sh); LA2 = iget(LA2, sw, sh);
  la_box(LA0, sw, sh);
  // the steps to the right / lower neighbour (copies moved by 1 px; the last column / row kept); r = the edge, g = inverted
  gfx_dest = LA1; gfx_mode = 0; gfx_a = 1; gfx_blit(LA0, 0, -1, 0, sw, sh); gfx_blit(LA0, 0, sw - 1, 0, 1, sh, sw - 1, 0, 1, sh);
  gfx_dest = LA2; gfx_blit(LA0, 0, 0, -1, sw, sh); gfx_blit(LA0, 0, 0, sh - 1, sw, 1, 0, sh - 1, sw, 1);
  gfx_dest = LA0; gfx_evalrect(0, 0, sw, sh, "_1=0.299*r+0.587*g+0.114*b; _2=abs(_1-0.299*sr-0.587*sg-0.114*sb)+abs(_1-0.299*s2r-0.587*s2g-0.114*s2b); _3=max(0,min(1,(_2-3)*(7/255))); r=255*_3^0.8; g=255-_1; b=0; a=255;", 0, LA1, "", LA2);
  // the glow: the edges at half the work size, two boxes, grown to the full size (LAF); the edges and the body grown too (LA1)
  gfx_dest = LA2; gfx_mode = 0x100; gfx_a = 1; gfx_blit(LA0, 0, 0, 0, gw, gh); la_box(LA2, gw, gh); la_box(LA2, gw, gh);
  LAF = iget(LAF, W, H);
  // (lighter, user's request) below d = 3 (the edges grown at most 1.5 x: their softness hardly shows) the three put
  // together at the work size and grown once; from 3 at the full size, the edges made steep there
  d < 3 ? (
    gfx_dest = LA1; gfx_mode = 0x100; gfx_a = 1; gfx_blit(LA2, 0, 0, 0, sw, sh, 0, 0, gw, gh);
    gfx_dest = LA0; gfx_mode = 0; gfx_evalrect(0, 0, sw, sh, "_1=max(0,min(255,r+0.7*sr+0.3*g)); r=_1; g=_1; b=_1; a=255;", 0, LA1);
    gfx_dest = LAF; gfx_mode = 0x100; gfx_blit(LA0, 0, 0, 0, W, H);
  ) : (
    // (r = the edges, g = the glow and the body: grown once together, then the edges made steep and the two added)
    gfx_dest = LA1; gfx_mode = 0x100; gfx_a = 1; gfx_blit(LA2, 0, 0, 0, sw, sh, 0, 0, gw, gh);
    gfx_dest = LA0; gfx_mode = 0; gfx_evalrect(0, 0, sw, sh, "g=max(0,min(255,0.7*sr+0.3*g)); b=0; a=255;", 0, LA1);
    la_g = d / 2; gfx_dest = LAF; gfx_mode = 0x100; gfx_blit(LA0, 0, 0, 0, W, H); gfx_mode = 0;
    gfx_evalrect(0, 0, W, H, "_1=max(0,min(255,max(0,min(255,(r-110)*la_g+110))+g)); r=_1; g=_1; b=_1; a=255;");
  );
  gfx_mode = 0;
);
// (⚪134, user's choice 2026-10-12: magenta dots on cream paper in the reel) Halftone: black dots on white, one in each
// cell of a grid (a 48th of the height), as large as the cell is dark (its area: white = none, black = nearly the whole
// cell); the colours: with the Tint after it (e.g. Magenta / White). The picture is put into one of whole cells (HTP,
// its edges stretched round it, as the LoRez), halved (2 x 2 means), read once a cell (HTS) and grown without smoothing
// (HTU: the cell's brightness); the dot's edge from each pixel's distance to its cell's centre, worked out once for
// each size (HTD, one evalrect in order: 255 = 0.75 cells), 1 px soft
// ((user's report on the LoRez, 2026-10-08, applied here too) the grid from the centre: an odd number of cells each way,
// the middle one on the picture's centre (ox / oy = where the picture sits in HTP)
function la_free() ( LA0 = ifree(LA0); LA1 = ifree(LA1); LA2 = ifree(LA2); LAF = ifree(LAF); );
function halftone(img, k) local(c, sw, sh, gw, gh, ox, oy, gw2, gh2) (
  c = max(4, floor(H / (12 * 8 ^ max(0, min(1, k))) + 0.5));   // ((⚪163) the cells by the amount: 12 down the height at 0 .. 96 at 1 (it was 48)
  sw = 2 * ceil((W / c - 1) / 2) + 1; sh = 2 * ceil((H / c - 1) / 2) + 1; gw = sw * c; gh = sh * c;
